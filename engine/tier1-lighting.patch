diff --git a/gpu/shadps4/video_core/renderer_vulkan/vk_tier1_effects.inc b/gpu/shadps4/video_core/renderer_vulkan/vk_tier1_effects.inc
new file mode 100644
--- /dev/null
+++ b/gpu/shadps4/video_core/renderer_vulkan/vk_tier1_effects.inc
@@ -0,0 +1,154 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Based on LanternEngine 573f83fd366d70bf26ce788edb9775a1b863676a.
+// Narrow dispatcher adapted to the existing recording thread, without the RT/volumetric systems.
+void Rasterizer::Tier1BeforeTargets(const GraphicsPipeline* pipeline) {
+    if (!BbSettings::Get().startup_modern_ssr && !BbSettings::Get().startup_pcss) return;
+    if (pipeline->IsCompute()) return;
+    const auto* ps = pipeline->GetStages()[u32(Shader::SwStage::Fragment)];
+    const u64 hash = ps ? ps->pgm_hash : 0;
+    if (hash != Tier1Shaders::SsrHash) ssr_temporal->Flush(upscaler->Jitter());
+    contact_shadow->Flush(hash == 0x11ffdfb5);
+}
+
+void Rasterizer::Tier1Scene() {
+    if (BbSettings::Get().startup_ssgi && tier1_scene_color)
+        ssgi->OnOpaqueScene(tier1_scene_color, camera_motion->Depth(), upscaler->Jitter());
+}
+
+void Rasterizer::Tier1BeforeBind(const GraphicsPipeline* pipeline) {
+    if (!BbSettings::Get().startup_modern_ssr && !BbSettings::Get().startup_pcss) return;
+    if (pipeline->IsCompute()) return;
+    const auto* ps = pipeline->GetStages()[u32(Shader::SwStage::Fragment)];
+    if (!ps) return;
+    const auto hash = ps->pgm_hash;
+    u32 offsets = 0;
+    static_assert(offsetof(Shader::PushData, buf_offsets) == 80);
+    std::memcpy(&offsets, push_data.buf_offsets.data(), sizeof(offsets));
+    if (hash == Tier1Shaders::SsrHash && Tier1Shaders::ssr_active.load()) {
+        push_data.motion_param = ssr_frame++;
+        if (cb_descs[0].first && !buffer_infos.empty() && image_infos.size() == 6) {
+            ssr_temporal->OnSsrDraw(cb_descs[0].first,
+                {.constants = buffer_infos[0].buffer, .constants_offset = buffer_infos[0].offset,
+                 .constants_range = buffer_infos[0].range, .constants_dword_offset = offsets,
+                 .normals_view = image_infos[1].imageView, .color_view = image_infos[2].imageView,
+                 .normals_layout = image_infos[1].imageLayout, .color_layout = image_infos[2].imageLayout,
+                 .frame_index = push_data.motion_param});
+        }
+    } else if (hash == Tier1Shaders::CompositeHash && Tier1Shaders::composite_active.load()) {
+        const float intensity = BbSettings::Get().graphics_ssr_intensity;
+        push_data.motion_param = std::bit_cast<u32>(std::clamp(std::isfinite(intensity) ? intensity : 1.0f, 0.0f, 3.0f));
+        if (const auto full = ssr_temporal->FullResult(); full && image_infos.size() == 12) {
+            image_infos[6].imageView = full;
+            image_infos[6].imageLayout = vk::ImageLayout::eGeneral;
+        }
+    } else if (hash == 0x11ffdfb5 && BbSettings::Get().startup_pcss && cb_descs[0].first) {
+        contact_shadow->OnBlurDraw(cb_descs[0].first, ps->images.empty() ? 0 : ps->images[0].GetSharp(*ps).Address());
+    } else if (hash == 0xf55643de && BbSettings::Get().startup_pcss && cb_descs[0].first &&
+               !buffer_infos.empty() && buffer_infos[0].buffer) {
+        const bool uniforms = buffer_infos.size() > 1 && buffer_infos[1].buffer;
+        const bool map = image_infos.size() > 1 && image_infos[1].imageView;
+        contact_shadow->OnShadowDraw(cb_descs[0].first,
+            {.constants = buffer_infos[0].buffer, .constants_offset = buffer_infos[0].offset,
+             .constants_range = buffer_infos[0].range,
+             .uniforms = uniforms ? buffer_infos[1].buffer : vk::Buffer{},
+             .uniforms_offset = uniforms ? buffer_infos[1].offset : 0,
+             .uniforms_range = uniforms ? buffer_infos[1].range : 0,
+             .shadow_map = map ? image_infos[1].imageView : vk::ImageView{},
+             .shadow_layout = map ? image_infos[1].imageLayout : vk::ImageLayout::eUndefined,
+             .constants_offset_word = offsets, .frame_index = shadow_frame++});
+    }
+}
+
+void Rasterizer::HqAoAfterDraw(const GraphicsPipeline* pipeline, const RenderState& state) {
+    const auto* ps_info = pipeline->GetStages()[u32(Shader::SwStage::Fragment)];
+    const auto& dynamic = scheduler.GetDynamicState();
+    const auto draw_region = [&]() -> std::optional<vk::Rect2D> {
+        if (dynamic.scissors.size() != 1 || dynamic.viewports.size() != 1) {
+            return std::nullopt;
+        }
+        const auto& vp = dynamic.viewports[0];
+        const auto& scissor = dynamic.scissors[0];
+        const s32 left =
+            std::max(scissor.offset.x, s32(std::ceil(std::min(vp.x, vp.x + vp.width))));
+        const s32 top =
+            std::max(scissor.offset.y, s32(std::ceil(std::min(vp.y, vp.y + vp.height))));
+        const s32 right = std::min<s32>(
+            state.width, std::min<s32>(scissor.offset.x + s32(scissor.extent.width),
+                                       s32(std::floor(std::max(vp.x, vp.x + vp.width)))));
+        const s32 bottom = std::min<s32>(
+            state.height, std::min<s32>(scissor.offset.y + s32(scissor.extent.height),
+                                        s32(std::floor(std::max(vp.y, vp.y + vp.height)))));
+        return vk::Rect2D{{left, top},
+                          {u32(std::max(right - left, 0)), u32(std::max(bottom - top, 0))}};
+    };
+    if (spatial_ao->UpscalePending()) {
+        const auto gather = spatial_ao->GatherTarget();
+        s32 depth_index = -1;
+        bool reads_gather = false;
+        // bound_images lists the render target first, then the sampled images in binding order.
+        if (ps_info && cb_descs[0].first && state.num_color_attachments == 1 &&
+            state.num_layers == 1 && ps_info->images.size() == 2 &&
+            ps_info->buffers.size() == 2 && bound_images.size() == 3 &&
+            bound_images[0] == cb_descs[0].first && image_infos.size() >= 2 &&
+            buffer_infos.size() >= 2) {
+            for (s32 i = 0; i < 2; ++i) {
+                const auto id = bound_images[i + 1];
+                if (id == gather) {
+                    reads_gather = true;
+                } else if (texture_cache.GetImage(id).info.pixel_format ==
+                           vk::Format::eR32Sfloat) {
+                    depth_index = i;
+                }
+            }
+        }
+        const auto region = draw_region();
+        if (reads_gather && depth_index >= 0 && region && region->offset.x == 0 &&
+            region->offset.y == 0 && region->extent.width == state.width &&
+            region->extent.height == state.height) {
+            const float k = 1.0f; // AoDraw already adjusted the shared constants once
+            const u32 offsets = u32(push_data.buf_offsets[0]) | (u32(push_data.buf_offsets[1]) << 8);
+            spatial_ao->FullResolution(cb_descs[0].first, cb_descs[0].second.view_info,
+                                       image_infos[depth_index], buffer_infos[0],
+                                       buffer_infos[1], offsets, k);
+        } else {
+            spatial_ao->SkipUpscale(fmt::format(
+                "next draw: colors={} ps_images={} ps_buffers={} bound={} gather={} depth={} "
+                "region={}",
+                state.num_color_attachments, ps_info ? ps_info->images.size() : 0,
+                ps_info ? ps_info->buffers.size() : 0, bound_images.size(), reads_gather,
+                depth_index,
+                region ? fmt::format("{},{} {}x{} of {}x{}", region->offset.x, region->offset.y,
+                                     region->extent.width, region->extent.height, state.width,
+                                     state.height)
+                       : std::string{"none"}));
+        }
+    }
+    if (!ps_info || ps_info->pgm_hash != Gtao::SsaoHash || !Gtao::active.load(std::memory_order_relaxed)) {
+        return;
+    }
+    // Descriptors are appended per stage with the fragment stage first, so its Cb0 and normals
+    // stay at the front while other stages may append their own buffers.
+    if (cb_descs[0].first && state.num_color_attachments == 1 && state.num_layers == 1 &&
+        ps_info->buffers.size() == 3 && ps_info->images.size() == 3 &&
+        buffer_infos.size() >= 3 && image_infos.size() >= 6 && dynamic.scissors.size() == 1 &&
+        dynamic.viewports.size() == 1) {
+        const auto region = *draw_region();
+        if (region.extent.width && region.extent.height) {
+            spatial_ao->Filter(cb_descs[0].first, cb_descs[0].second.view_info, image_infos[1],
+                               buffer_infos[0], push_data.buf_offsets[0], push_data.scene_size,
+                               state.width, state.height, region);
+            spatial_ao->NoteGather(cb_descs[0].first, image_infos[1]);
+        } else {
+            spatial_ao->WarnUnsupported(fmt::format("empty region {},{} {}x{}", region.offset.x,
+                                                    region.offset.y, region.extent.width,
+                                                    region.extent.height));
+        }
+    } else {
+        spatial_ao->WarnUnsupported(fmt::format(
+            "cb={} colors={} layers={} ps_buffers={} ps_images={} images={} buffers={} "
+            "scissors={} viewports={}",
+            bool(cb_descs[0].first), state.num_color_attachments, state.num_layers,
+            ps_info->buffers.size(), ps_info->images.size(), image_infos.size(),
+            buffer_infos.size(), dynamic.scissors.size(), dynamic.viewports.size()));
+    }
+}
diff --git a/gpu/shadps4/video_core/renderer_vulkan/vk_tier1_shaders.h b/gpu/shadps4/video_core/renderer_vulkan/vk_tier1_shaders.h
new file mode 100644
--- /dev/null
+++ b/gpu/shadps4/video_core/renderer_vulkan/vk_tier1_shaders.h
@@ -0,0 +1,94 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Selective current LanternEngine effect shader replacements; original cache binaries retained.
+#pragma once
+#include <bit>
+#include <vector>
+#include "video_core/renderer_vulkan/vk_gtao.h"
+#include "video_core/host_shaders/ssr_frag.h"
+#include "video_core/renderer_vulkan/vk_ssr_composite_patch.h"
+
+namespace Vulkan::Tier1Shaders {
+inline constexpr u64 SsrHash = 0x6c2323c2, CompositeHash = 0x3fe9e964;
+inline std::atomic<bool> ssr_active{false}, composite_active{false};
+inline u32 Checksum(std::span<const u32> words) {
+    u32 result = 2166136261u;
+    for (u32 word : words) result = (result ^ word) * 16777619u;
+    return result;
+}
+inline bool PatchWater(std::vector<u32>& spv) {
+    constexpr size_t Words = 13751;
+    constexpr u32 OriginalChecksum = 0xf7a3a6ee;
+    constexpr u32 OffsetResultId = 1307;
+    constexpr u32 OpConstant = 43, OpFMul = 133;
+    if (spv.size() != Words || Checksum(spv) != OriginalChecksum) {
+        return false;
+    }
+    size_t fmul = 0;
+    for (size_t i = 5; i < spv.size(); i += spv[i] >> 16) {
+        if ((spv[i] & 0xffff) == OpFMul && spv[i + 2] == OffsetResultId) {
+            fmul = i;
+            break;
+        }
+    }
+    if (!fmul) {
+        return false;
+    }
+    const u32 type_id = spv[fmul + 1];
+    u32 half_id = 0;
+    for (size_t i = 5; i < spv.size() && !half_id; i += spv[i] >> 16) {
+        if ((spv[i] & 0xffff) == OpConstant && spv[i + 1] == type_id &&
+            spv[i + 3] == std::bit_cast<u32>(0.5f)) {
+            half_id = spv[i + 2];
+        }
+    }
+    if (!half_id) {
+        return false;
+    }
+    const u32 scaled_id = spv[3]++;
+    spv[fmul + 2] = scaled_id;
+    const std::array<u32, 5> scale{(5u << 16) | OpFMul, type_id, OffsetResultId, scaled_id, half_id};
+    spv.insert(spv.begin() + fmul + 5, scale.begin(), scale.end());
+    return true;
+}
+
+inline std::optional<vk::ShaderModule> CreateModule(
+    const Shader::Info& info, const Shader::Profile& profile,
+    const Shader::Backend::Bindings& start, vk::Device device, std::span<const u32> original) {
+    if (info.pgm_hash == Gtao::SsaoHash) return Gtao::CreateModule(info, profile, start, device);
+    if (!BbSettings::Get().startup_modern_ssr || info.hw_stage != Shader::HwStage::Fragment)
+        return std::nullopt;
+    std::vector<u32> patched;
+    std::span<const u32> replacement;
+    if (info.pgm_hash == SsrHash && info.sw_stage == Shader::SwStage::Fragment &&
+        start.unified == 0 && start.buffer == 0 && profile.uniform_dword_layout &&
+        !profile.uniform_exact_base && info.buffers.size() == 1 && info.images.size() == 3 &&
+        info.samplers.size() == 3 && info.fmasks.empty() && info.buffers[0].is_uniform) {
+        replacement = SSR_FRAG;
+    } else if (info.pgm_hash == CompositeHash &&
+               original.size() == kSsrCompositeOriginalWords &&
+               Checksum(original) == kSsrCompositeOriginalChecksum) {
+        replacement = kSsrCompositeSpv;
+    }
+    if (info.pgm_hash == 0xe3021062) {
+        patched.assign(original.begin(), original.end());
+        if (PatchWater(patched)) replacement = patched;
+    }
+    if (replacement.empty()) {
+        if (info.pgm_hash == CompositeHash) {
+            static std::atomic<bool> warned{false};
+            if (!warned.exchange(true)) std::printf("Stochastic SSR: composite profile differs (%zu words, %08x); original composite retained\n", original.size(), Checksum(original));
+        }
+        return std::nullopt;
+    }
+    const auto [result, module] = device.createShaderModule(
+        {.codeSize = replacement.size_bytes(), .pCode = replacement.data()});
+    if (result != vk::Result::eSuccess) {
+        std::printf("Stochastic SSR: shader module failed; original shader retained\n");
+        return std::nullopt;
+    }
+    if (info.pgm_hash == 0xe3021062) return module;
+    auto& active = info.pgm_hash == SsrHash ? ssr_active : composite_active;
+    if (!active.exchange(true)) std::printf("Stochastic SSR: replacement module %08x ready\n", u32(info.pgm_hash));
+    return module;
+}
+} // namespace Vulkan::Tier1Shaders

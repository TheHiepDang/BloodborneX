diff --git a/gpu/shadps4/video_core/host_shaders/contact_shadow.comp b/gpu/shadps4/video_core/host_shaders/contact_shadow.comp
new file mode 100644
--- /dev/null
+++ b/gpu/shadps4/video_core/host_shaders/contact_shadow.comp
@@ -0,0 +1,318 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#version 450
+#extension GL_EXT_scalar_block_layout : require
+
+layout(local_size_x = 8, local_size_y = 8) in;
+
+layout(scalar, set = 0, binding = 0) readonly buffer Cb { uint d[]; } cbuf;
+layout(set = 0, binding = 1) uniform sampler2D depth_tex;
+layout(set = 0, binding = 2, rgba8) uniform image2D shadow_img;
+layout(set = 0, binding = 3) uniform sampler2D shadow_map;
+layout(scalar, set = 0, binding = 4) readonly buffer Ub { uint d[]; } ubuf;
+
+layout(push_constant) uniform Constants {
+    uint buf_off;
+    uint frame_index;
+    vec2 size;
+    float length_m;
+    float thickness_m;
+    float strength;
+    float flip;
+    uint debug;
+    uint contact_on;
+    uint pcss_on;
+    float light_tan;
+    float max_penumbra_m;
+    float min_penumbra_m;
+    float bias_m;
+    uint filter_on;
+    float cascade_blend;
+};
+
+layout(constant_id = 0) const uint optimizations = 1u;
+
+const int STEPS = 20;
+const int BLOCKER_TAPS = 64;
+
+uint base;
+float cb(int i) { return uintBitsToFloat(cbuf.d[base + uint(i)]); }
+vec4 row(int i) { return vec4(cb(i), cb(i + 1), cb(i + 2), cb(i + 3)); }
+
+float sceneDepth(vec2 uv) { return textureLod(depth_tex, uv, 0.0).x; }
+
+mat4 invMat;
+mat4 projMat;
+bool fullyFaded;
+
+vec3 viewPosAt(vec2 uv, float depth) {
+    vec4 c = vec4(uv.x * 2.0 - 1.0, 1.0 - uv.y * 2.0, depth, 1.0);
+    vec4 v = invMat * c;
+    return v.xyz / v.w;
+}
+
+float hash(vec2 p) {
+    return fract(52.9829189 * fract(dot(p, vec2(0.06711056, 0.00583715))));
+}
+
+float d0;
+vec3 P0;
+int cascade;
+vec4 rA, rB, rW, rZ;
+float lu, lv, lz;
+vec2 tileMin, tileMax;
+
+bool setupCascade(int index) {
+    cascade = index;
+    tileMin = vec2(index & 1, index >> 1) * 0.5;
+    tileMax = tileMin + 0.5;
+    int m = 16 + 16 * cascade;
+
+    mat4 shadowMat = transpose(mat4(row(m), row(m + 4), row(m + 12), row(m + 8)));
+    mat4 T = shadowMat * projMat;
+    rA = vec4(T[0][0], T[1][0], T[2][0], T[3][0]);
+    rB = vec4(T[0][1], T[1][1], T[2][1], T[3][1]);
+    rW = vec4(T[0][2], T[1][2], T[2][2], T[3][2]);
+    rZ = vec4(T[0][3], T[1][3], T[2][3], T[3][3]);
+    vec4 p4 = vec4(P0, 1.0);
+    float wl = dot(rW, p4);
+    if (abs(wl) < 1e-9) {
+        return false;
+    }
+    lu = dot(rA, p4) / wl;
+    lv = dot(rB, p4) / wl;
+    lz = dot(rZ, p4) / wl;
+    return true;
+}
+
+bool setup(vec2 uv0) {
+    if (optimizations == 0u) d0 = sceneDepth(uv0);
+    if (!(d0 < 1.0) || !(d0 > 0.0)) return false;
+    P0 = viewPosAt(uv0, d0);
+    if (!(P0.z > 0.0)) return false;
+    int index = int(P0.z > cb(80)) + int(P0.z > cb(81)) + int(P0.z > cb(82));
+    return setupCascade(index);
+}
+
+float contact(vec2 uv0) {
+    vec3 dir = cross(rA.xyz - lu * rW.xyz, rB.xyz - lv * rW.xyz);
+    float dl = length(dir);
+    if (!(dl > 1e-12)) {
+        return 1.0;
+    }
+    dir /= dl;
+
+    if (dot(rZ.xyz - lz * rW.xyz, dir) > 0.0) {
+        dir = -dir;
+    }
+    dir *= flip;
+
+    float jitter = hash(uv0 * size);
+    for (int i = 0; i < STEPS; ++i) {
+        float t = (float(i) + 0.5 + jitter) / float(STEPS);
+        vec3 P = P0 + dir * (t * length_m);
+        if (!(P.z > 0.0)) {
+            break;
+        }
+        vec4 n4 = projMat * vec4(P, 1.0);
+        if (!(n4.w != 0.0)) {
+            break;
+        }
+        vec3 ndc = n4.xyz / n4.w;
+        vec2 uv = vec2(ndc.x * 0.5 + 0.5, 0.5 - ndc.y * 0.5);
+        if (uv.x < 0.0 || uv.x > 1.0 || uv.y < 0.0 || uv.y > 1.0) {
+            break;
+        }
+        float sd = sceneDepth(uv);
+        if (!(sd < 1.0) || !(sd > 0.0)) {
+            continue;
+        }
+        float zs = viewPosAt(uv, sd).z;
+        float diff = P.z - zs;
+        float bias = 0.03 + 0.004 * P0.z + 0.04 * t * length_m;
+        if (diff > bias && diff < thickness_m) {
+            return 1.0 - strength * (1.0 - 0.5 * t);
+        }
+    }
+    return 1.0;
+}
+
+bool lightCoords(vec2 uv, out vec3 l, out float viewZ) {
+    float d = sceneDepth(uv);
+    if (!(d < 1.0) || !(d > 0.0)) {
+        return false;
+    }
+    vec3 P = viewPosAt(uv, d);
+    vec4 p4 = vec4(P, 1.0);
+    float wl = dot(rW, p4);
+    if (abs(wl) < 1e-9) {
+        return false;
+    }
+    l = vec3(dot(rA, p4), dot(rB, p4), dot(rZ, p4)) / wl;
+    viewZ = P.z;
+    return true;
+}
+
+vec2 vogel(int i, int n, float phi) {
+    float r = sqrt((float(i) + 0.5) / float(n));
+    float a = float(i) * 2.399963 + phi;
+    return r * vec2(cos(a), sin(a));
+}
+
+float mapDepth(vec2 uv) {
+    ivec2 extent = textureSize(shadow_map, 0);
+    ivec2 lo = ivec2(tileMin * vec2(extent));
+    ivec2 hi = ivec2(tileMax * vec2(extent)) - 1;
+    return texelFetch(shadow_map, clamp(ivec2(floor(uv * vec2(extent))), lo, hi), 0).x;
+}
+
+float compareBilinear(vec2 uv, vec2 center, vec2 slope, float bias) {
+    ivec2 extent = textureSize(shadow_map, 0);
+    vec2 p = uv * vec2(extent) - 0.5;
+    ivec2 origin = ivec2(floor(p));
+    vec2 f = fract(p);
+    ivec2 lo = ivec2(tileMin * vec2(extent));
+    ivec2 hi = ivec2(tileMax * vec2(extent)) - 1;
+    vec4 lit;
+    for (int j = 0; j < 4; ++j) {
+        ivec2 at = clamp(origin + ivec2(j & 1, j >> 1), lo, hi);
+        vec2 delta = (vec2(at) + 0.5) / vec2(extent) - center;
+        float receiver = lz + dot(slope, delta);
+        lit[j] = float(texelFetch(shadow_map, at, 0).x >= receiver - bias);
+    }
+    return mix(mix(lit.x, lit.y, f.x), mix(lit.z, lit.w, f.x), f.y);
+}
+
+float pcss(vec2 uv0) {
+    vec2 texel = 1.0 / vec2(textureSize(shadow_map, 0));
+    vec2 center = vec2(lu, lv);
+    if (any(lessThan(center, tileMin)) || any(greaterThanEqual(center, tileMax)) ||
+        !(lz >= 0.0 && lz <= 1.0)) return -1.0;
+
+    float gu = length(rA.xyz - lu * rW.xyz);
+    float gv = length(rB.xyz - lv * rW.xyz);
+    float gz = length(rZ.xyz - lz * rW.xyz);
+    if (!(gu > 1e-9) || !(gv > 1e-9) || !(gz > 1e-9)) {
+        return -1.0;
+    }
+    if (fullyFaded) return 1.0;
+
+    vec2 slope = vec2(0.0);
+    vec3 l1, l2;
+    float z1, z2;
+    vec2 px = 1.0 / size;
+    if (lightCoords(uv0 + vec2(px.x, 0.0), l1, z1) && lightCoords(uv0 + vec2(0.0, px.y), l2, z2)) {
+        float tol = 0.1 + 0.02 * P0.z;
+        if (abs(z1 - P0.z) < tol && abs(z2 - P0.z) < tol) {
+            vec3 e1 = l1 - vec3(lu, lv, lz);
+            vec3 e2 = l2 - vec3(lu, lv, lz);
+            float det = e1.x * e2.y - e2.x * e1.y;
+            if (abs(det) > 1e-14) {
+                slope = vec2(e1.z * e2.y - e2.z * e1.y, e1.x * e2.z - e2.x * e1.z) / det;
+                float limit = 3.0 * gz / min(gu, gv);
+                slope = clamp(slope, vec2(-limit), vec2(limit));
+            }
+        }
+    }
+
+    vec2 uvPerMetre = vec2(gu, gv);
+    float worldTexel = max(texel.x / gu, texel.y / gv);
+    float bias = min(bias_m, 0.5 * worldTexel) * gz;
+    float phi = 6.2831853 * hash(uv0 * size + 17.0);
+
+    if (pcss_on == 0u) {
+        float lit = 0.0;
+        for (int i = 0; i < 8; ++i) {
+            vec2 off = vogel(i, 8, phi) * (1.5 * texel);
+            lit += compareBilinear(center + off, center, slope, bias);
+        }
+        return lit / 8.0;
+    }
+
+    vec2 searchRadius = max_penumbra_m * uvPerMetre;
+    float blockerSum = 0.0;
+    int blockers = 0;
+    for (int i = 0; i < BLOCKER_TAPS; ++i) {
+        float radius = sqrt(float(i) / float(BLOCKER_TAPS - 1));
+        float angle = float(i) * 2.399963 + phi;
+        vec2 off = radius * vec2(cos(angle), sin(angle)) * searchRadius;
+        vec2 sampleUv = clamp(center + off, tileMin + 0.5 * texel, tileMax - 0.5 * texel);
+        vec2 sampledUv = (floor(sampleUv / texel) + 0.5) * texel;
+        float plane = dot(slope, sampledUv - center);
+        float receiver = lz + plane;
+        float sz = mapDepth(sampleUv);
+        if (sz < receiver - bias) {
+            blockerSum += sz - plane;
+            ++blockers;
+        }
+    }
+    if (blockers == 0) {
+        return 1.0;
+    }
+
+    float blockerDist = max(lz - blockerSum / float(blockers), 0.0) / gz;
+    float penumbra = clamp(blockerDist * light_tan, min_penumbra_m, max_penumbra_m);
+
+    vec2 filterRadius = max(penumbra * uvPerMetre, 0.5 * texel);
+    float radiusTexels = max(filterRadius.x / texel.x, filterRadius.y / texel.y);
+    int filterTaps = radiusTexels <= 1.0 ? 16 : radiusTexels <= 4.0 ? 32 : 64;
+    float lit = 0.0;
+
+    for (int i = 0; i < filterTaps; ++i) {
+        vec2 off = vogel(i, filterTaps, phi + 1.7) * filterRadius;
+        lit += compareBilinear(center + off, center, slope, bias);
+    }
+    return lit / float(filterTaps);
+}
+
+void main() {
+    base = (buf_off & 0xffu) >> 2;
+    const ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
+    if (any(greaterThanEqual(pixel, ivec2(size)))) {
+        return;
+    }
+    const vec2 uv = (vec2(pixel) + 0.5) / size;
+    if (optimizations != 0u) {
+        d0 = sceneDepth(uv);
+        if (!(d0 < 1.0) || !(d0 > 0.0)) return;
+    }
+    invMat = transpose(mat4(row(0), row(4), row(8), row(12)));
+    projMat = inverse(invMat);
+    vec4 c = imageLoad(shadow_img, pixel);
+    if (!setup(uv)) {
+        return;
+    }
+    float alpha = c.a;
+
+    if (filter_on != 0u) {
+        const uint ub = ((buf_off >> 8) & 0xffu) >> 2;
+        float fade = clamp(uintBitsToFloat(ubuf.d[ub + 73u]) *
+                               (uintBitsToFloat(ubuf.d[ub + 72u]) - length(P0)),
+                           0.0, 1.0);
+
+        fullyFaded = optimizations != 0u && fade == 0.0;
+        float vis = pcss(uv);
+        int primary = cascade;
+        if (!fullyFaded && vis >= 0.0 && primary < 3 && cascade_blend > 0.0) {
+            float split = cb(80 + primary);
+            float previous = primary == 0 ? 0.0 : cb(79 + primary);
+            float band = cascade_blend * max(split - previous, 0.0);
+            if (band > 0.0 && P0.z > split - band && setupCascade(primary + 1)) {
+                float next = pcss(uv);
+                if (next >= 0.0)
+                    vis = mix(vis, next, smoothstep(split - band, split, P0.z));
+            }
+            if (optimizations == 0u || contact_on != 0u)
+                setupCascade(primary);
+        }
+        if (vis >= 0.0) {
+            alpha = 1.0 - fade * (1.0 - vis);
+        }
+    }
+    if (contact_on != 0u) {
+        float k = contact(uv);
+        alpha = debug != 0u ? k : min(alpha, k);
+    }
+    c.a = alpha;
+    imageStore(shadow_img, pixel, c);
+}
diff --git a/gpu/shadps4/video_core/host_shaders/gtao_denoise.comp b/gpu/shadps4/video_core/host_shaders/gtao_denoise.comp
new file mode 100644
--- /dev/null
+++ b/gpu/shadps4/video_core/host_shaders/gtao_denoise.comp
@@ -0,0 +1,80 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#version 450
+#extension GL_EXT_samplerless_texture_functions : require
+#extension GL_EXT_scalar_block_layout : require
+
+layout(local_size_x = 8, local_size_y = 8) in;
+layout(set = 0, binding = 0) uniform texture2D ao_input;
+layout(set = 0, binding = 1) uniform texture2D normal_input;
+#ifdef FULLRES
+layout(r8, set = 0, binding = 2) uniform writeonly image2D ao_output;
+#else
+layout(rgba8, set = 0, binding = 2) uniform writeonly image2D ao_output;
+#endif
+layout(scalar, set = 0, binding = 3) uniform Cb0 { uint d[16384]; } ubo_0;
+layout(push_constant) uniform Params {
+    ivec2 origin;
+    uvec2 extent;
+    uint scene_size;
+    uint buf_off;
+};
+
+float depth(vec4 packed) {
+    return packed.a + packed.b / 255.0 + packed.g / 65025.0;
+}
+
+vec3 normalAt(ivec2 p) {
+#ifdef FULLRES
+    // Full internal resolution: the output covers the whole target.
+    vec2 size = vec2(imageSize(ao_output));
+#else
+    // Use the gather's exact UV denominator, not a potentially padded AO allocation.
+    const uint base = (buf_off & 255u) >> 2u;
+    vec2 size = vec2(uintBitsToFloat(ubo_0.d[base + 16u]), uintBitsToFloat(ubo_0.d[base + 17u]));
+    if (scene_size != 0u)
+        size *= vec2(scene_size & 65535u, scene_size >> 16) / vec2(1920.0, 1080.0);
+#endif
+    ivec2 nsize = textureSize(normal_input, 0);
+    ivec2 q = clamp(ivec2((vec2(p) + 0.5) / size * vec2(nsize)),
+                    ivec2(0), nsize - 1);
+    vec3 n = texelFetch(normal_input, q, 0).xyz * 2.0 - 1.0;
+    return n / max(length(n), 1e-4);
+}
+
+void main() {
+    uvec2 local = gl_GlobalInvocationID.xy;
+    if (any(greaterThanEqual(local, extent))) return;
+    ivec2 p = origin + ivec2(local);
+    vec4 center = texelFetch(ao_input, p, 0);
+#ifdef COPY
+    imageStore(ao_output, p, center);
+#else
+    float z = depth(center);
+    vec3 n = normalAt(p);
+    const float weights[5] = float[5](1.0, 4.0, 6.0, 4.0, 1.0);
+    float sum = 0.0, total = 0.0;
+    for (int y = -2; y <= 2; ++y) {
+        for (int x = -2; x <= 2; ++x) {
+            ivec2 q = p + ivec2(x, y);
+            if (any(lessThan(q, origin)) ||
+                any(greaterThanEqual(q, origin + ivec2(extent)))) continue;
+            vec4 sampleAO = texelFetch(ao_input, q, 0);
+            float relative = abs(depth(sampleAO) - z) / max(z, 1e-4);
+            if (relative >= 0.02) continue;
+            float cosine = dot(n, normalAt(q));
+            if (cosine <= 0.9 && (x != 0 || y != 0)) continue;
+            float w = weights[x + 2] * weights[y + 2] *
+                      (1.0 - smoothstep(0.0, 0.02, relative)) *
+                      (x == 0 && y == 0 ? 1.0 : pow(max(cosine, 0.0), 32.0));
+            sum += w * sampleAO.r;
+            total += w;
+        }
+    }
+    // Only visibility is filtered. The original center's packed-depth bytes survive both passes.
+#ifdef FULLRES
+    imageStore(ao_output, p, vec4(sum / max(total, 1e-4)));
+#else
+    imageStore(ao_output, p, vec4(sum / max(total, 1e-4), center.gba));
+#endif
+#endif
+}
diff --git a/gpu/shadps4/video_core/host_shaders/ssgi.comp b/gpu/shadps4/video_core/host_shaders/ssgi.comp
new file mode 100644
--- /dev/null
+++ b/gpu/shadps4/video_core/host_shaders/ssgi.comp
@@ -0,0 +1,414 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#version 450
+#extension GL_EXT_samplerless_texture_functions : require
+
+layout(local_size_x = 8, local_size_y = 8) in;
+
+layout(push_constant) uniform Constants {
+    vec4 proj;
+    vec4 reproject[3];
+    vec2 size;
+    vec2 jitter;
+    vec2 prev_jitter;
+    vec2 prev_proj;
+    uint frame;
+    uint history;
+    float strength;
+    float radius;
+    float feedback;
+    float ao_amount;
+    float albedo_on;
+    float step_size;
+};
+#define gi_size (floor((size + 1.0) * 0.5))
+
+const float PI = 3.14159265358979;
+const float HALF_PI = 1.57079632679490;
+
+float viewZ(float depth) {
+    return proj.w / min(depth - proj.z, -1e-8);
+}
+
+vec3 viewPos(vec2 pixel, float z) {
+    const vec2 ndc = (pixel - jitter) / size * 2.0 - 1.0;
+    return vec3(ndc.x * z / proj.x, ndc.y * z / proj.y, z);
+}
+
+#if defined(PREP)
+
+layout(binding = 0) uniform texture2D depth_tex;
+layout(binding = 1, rgba32f) uniform writeonly image2D geo_img;
+layout(binding = 2) uniform texture2D normal_tex;
+
+float depthAt(ivec2 p) {
+    return texelFetch(depth_tex, clamp(p, ivec2(0), ivec2(size) - 1), 0).r;
+}
+
+void main() {
+    const ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
+    if (pixel.x >= int(size.x) || pixel.y >= int(size.y)) {
+        return;
+    }
+    const float depth = depthAt(pixel);
+    if (depth >= 1.0) {
+        imageStore(geo_img, pixel, vec4(0.0, 0.0, -1.0, 0.0));
+        return;
+    }
+    const float z = viewZ(depth);
+    const vec3 c = viewPos(vec2(pixel) + 0.5, z);
+
+    vec3 px[2], py[2];
+    for (int i = 0; i < 2; ++i) {
+        const int s = i == 0 ? -1 : 1;
+        float dx = depthAt(pixel + ivec2(s, 0));
+        float dy = depthAt(pixel + ivec2(0, s));
+        float zx = dx >= 1.0 ? 1e6 : viewZ(dx);
+        float zy = dy >= 1.0 ? 1e6 : viewZ(dy);
+        px[i] = viewPos(vec2(pixel + ivec2(s, 0)) + 0.5, zx);
+        py[i] = viewPos(vec2(pixel + ivec2(0, s)) + 0.5, zy);
+    }
+    const vec3 ex = abs(px[1].z - c.z) < abs(c.z - px[0].z) ? px[1] - c : c - px[0];
+    const vec3 ey = abs(py[1].z - c.z) < abs(c.z - py[0].z) ? py[1] - c : c - py[0];
+    vec3 n = cross(ey, ex);
+    n = dot(n, n) > 1e-12 ? normalize(n) : -normalize(c);
+    if (dot(n, c) > 0.0) {
+        n = -n;
+    }
+
+    if (step_size > 0.0) {
+        const ivec2 normal_size = textureSize(normal_tex, 0);
+        vec3 wn = texelFetch(normal_tex, min(pixel, normal_size - 1), 0).xyz * 2.0 - 1.0;
+        if (dot(wn, wn) > 0.25) {
+            wn = normalize(wn);
+            vec3 vn = normalize(vec3(dot(reproject[0].xyz, wn), dot(reproject[1].xyz, wn),
+                                     dot(reproject[2].xyz, wn)));
+            if (dot(vn, c) > 0.0) {
+                vn = -vn;
+            }
+            if (dot(vn, n) > 0.5) {
+                n = normalize(mix(n, vn, step_size));
+            }
+        }
+    }
+    imageStore(geo_img, pixel, vec4(n, z));
+}
+
+#elif defined(GATHER)
+
+layout(binding = 0) uniform texture2D geo_tex;
+layout(binding = 1) uniform texture2D color_tex;
+layout(binding = 2) uniform texture2D prev_tex;
+layout(binding = 3, rgba16f) uniform writeonly image2D gi_img;
+layout(binding = 4) uniform texture2D albedo_tex;
+
+const int SLICES = 2;
+const int STEPS = 8;
+const int SECTORS = 32;
+const float MIN_RADIUS_PX = 6.0;
+const float MAX_RADIUS_FRAC = 0.18;
+const float ALBEDO = 0.5;
+const float RADIANCE_CLAMP = 6.0;
+const float TEMPORAL = 0.2;
+const float HISTORY_TOLERANCE = 0.04;
+
+shared float sector_weight[SECTORS];
+
+bool historyCoord(vec3 pos, out vec2 hf, out float zp) {
+    const vec4 v = vec4(pos, 1.0);
+    const vec3 p = vec3(dot(reproject[0], v), dot(reproject[1], v), dot(reproject[2], v));
+    zp = p.z;
+    hf = vec2(0.0);
+    if (p.z < 1e-3) {
+        return false;
+    }
+    const vec2 uv = p.xy * prev_proj / p.z * 0.5 + 0.5;
+    hf = ((uv * size + prev_jitter) - 0.5) * 0.5;
+    return true;
+}
+
+vec3 sampleHistory(vec2 hf, float zp, out float conf) {
+    const ivec2 gmax = ivec2(gi_size) - 1;
+    const ivec2 b = ivec2(floor(hf));
+    const vec2 f = hf - vec2(b);
+    vec3 sum = vec3(0.0);
+    float wsum = 0.0;
+    for (int i = 0; i < 4; ++i) {
+        const ivec2 o = ivec2(i & 1, i >> 1);
+        const ivec2 t = b + o;
+        if (any(lessThan(t, ivec2(0))) || any(greaterThan(t, gmax))) {
+            continue;
+        }
+        const vec4 pv = texelFetch(prev_tex, t, 0);
+        if (pv.a <= 0.0 || abs(pv.a - zp) > HISTORY_TOLERANCE * zp) {
+            continue;
+        }
+        const float w = (o.x == 0 ? 1.0 - f.x : f.x) * (o.y == 0 ? 1.0 - f.y : f.y);
+        sum += pv.rgb * w;
+        wsum += w;
+    }
+    conf = wsum;
+    return wsum > 1e-4 ? sum / wsum : vec3(0.0);
+}
+
+float fastAcos(float x) {
+    float a = abs(x);
+    float r = sqrt(1.0 - a) * (1.5707963267948966 + a * (-0.2146018 + a * (0.0889789 + a * -0.0501743)));
+    return x >= 0.0 ? r : PI - r;
+}
+
+uint sectorMask(vec3 d, float l, vec3 v, float side, float lo, float thick) {
+    const vec3 db = d - v * thick;
+    const float af = side * fastAcos(clamp(dot(d, v) / l, -1.0, 1.0));
+    const float ab = side * fastAcos(clamp(dot(db, v) / max(length(db), 1e-4), -1.0, 1.0));
+    const float s0 = clamp((min(af, ab) - lo) * (1.0 / PI), 0.0, 1.0) * float(SECTORS);
+    const float s1 = clamp((max(af, ab) - lo) * (1.0 / PI), 0.0, 1.0) * float(SECTORS);
+    const uint a = uint(s0 + 0.5);
+    const uint n = uint(s1 + 0.5) - a;
+    if (n == 0u || a >= uint(SECTORS)) {
+        return 0u;
+    }
+    const uint m = n >= 32u ? 0xFFFFFFFFu : ((1u << n) - 1u);
+    return m << a;
+}
+
+void main() {
+    if (gl_LocalInvocationIndex < uint(SECTORS)) {
+        const float k = float(gl_LocalInvocationIndex);
+        sector_weight[gl_LocalInvocationIndex] =

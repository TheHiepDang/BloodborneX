+        t.Dispatch(1, p, (W + 7) / 8, (H + 7) / 8);
+        t.Dispatch(2, p, 1, 1);
+        t.Dispatch(6, p, 1, 1);
+        t.Dispatch(3, p, (HW + 7) / 8, (HH + 7) / 8);
+        t.Dispatch(4, p, (HW + 7) / 8, (HH + 7) / 8);

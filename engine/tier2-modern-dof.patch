+    assert(run() == stock);
+    constants[C + 11] = 1;
+    constants[C + 76] = 0;
+    assert(run() == stock);
+    constants[C + 76] = 1;
+    fill(false, 2);
+    for (uint32_t y = 0; y < H; ++y) {

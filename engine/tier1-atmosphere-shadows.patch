+        BbSettings::Get().graphics_shadow_resolution.load(std::memory_order_relaxed), 0, 2);
+    if (quality == 0) return false;
+    const std::uint32_t atlas = 2048u << quality;
+    const std::array<std::uint32_t, 4> sizes{atlas, atlas, atlas, atlas};
+    if (!WriteCode(image + kDirectionalSizeTable, sizes.data(), sizeof sizes) ||
+        !WriteCode(image + kDirectionalSizeDefault + 1, &atlas, sizeof atlas)) {
+        std::printf("Engine: directional shadow resolution incomplete: cannot write native allocation settings\n");
+        return false;
+    }
+    std::printf("Engine: directional shadow atlas %ux%u, four %ux%u cascades (restart to change)\n",
+                atlas, atlas, atlas / 2, atlas / 2);
+    return true;
+}
+
+bool InstallDirectionalShadows(std::uint8_t* image, std::size_t size) {
+    const auto& settings = BbSettings::Get();
+    if (!settings.startup_directional_filter &&
+        !false) {
+        return false;
+    }
+    Hook hook;
+    if (!image || !Matches(image, size, kCascadeRange, kCascadeRangeEntry, sizeof kCascadeRangeEntry) ||
+        !Prepare(hook, image, size, kCascadeRangeTail, kCascadeRangeStores, BeforeCascadeRangeStores, true)) {
+        std::printf("Engine: directional overlap off: cascade code does not match 1.09 or hook unavailable\n");
+        return false;
+    }
+    Commit(std::span<Hook>{&hook, 1});
+    g_cascade_overlap.store(true, std::memory_order_relaxed);
+    std::printf("Engine: directional cascades overlap by 10%%; authored splits and atlas size retained\n");
+    return true;
+}
+
+bool InstallLocalShadowSoftness(std::uint8_t* image, std::size_t size, bool point, bool spot) {
+    if ((!point && !spot) || LocalShadowQuality() == 0) return true;
+    const auto radius_matches = [&](std::size_t at) {
+        return Matches(image, size, at, reinterpret_cast<const std::uint8_t*>(&kOriginalLocalShadowRadius),
+                       sizeof kOriginalLocalShadowRadius);
+    };
+    if (!image ||
+        (point && (!radius_matches(kPointShadowRadius) ||
+                   !Matches(image, size, kPointShadowRadiusLoad, kPointShadowRadiusCode,
+                            sizeof kPointShadowRadiusCode))) ||
+        (spot && (!radius_matches(kSpotShadowRadius) ||
+                  !Matches(image, size, kSpotShadowRadiusLoad, kSpotShadowRadiusCode,
+                           sizeof kSpotShadowRadiusCode) ||
+                  !Matches(image, size, kSpotShadowRadiusLoadFallback, kSpotShadowRadiusFallbackCode,
+                           sizeof kSpotShadowRadiusFallbackCode)))) {
+        std::printf("Engine: local-shadow filter tuning unavailable: the filter code is not 1.09's\n");
+        return false;
+    }
+    const float radius = LocalShadowQuality() == 1 ? 3.2f : 6.4f;
+    for (const auto at : {point ? kPointShadowRadius : 0, spot ? kSpotShadowRadius : 0}) {
+        if (at && !WriteCode(image + at, &radius, sizeof radius)) {
+            std::printf("Engine: local-shadow filter tuning incomplete: cannot write filter radius at %zx\n", at);
+            return false;
+        }
+    }
+    std::printf("Engine: local-shadow filter radius %.1f texels (point %s, spotlight %s); high-resolution maps kept\n",
+                radius, point ? "on" : "unchanged", spot ? "on" : "unchanged");
+    return true;
+}
+
+bool InstallLocalShadows(std::uint8_t* image, std::size_t size) {
+    const int quality = LocalShadowQuality();
+    if (quality == 0) return false;
+    if (!image ||
+        !Matches(image, size, kLocalShadowPool, kLocalShadowPoolEntry, sizeof kLocalShadowPoolEntry) ||
+        !Matches(image, size, kLocalShadowSize, kLocalShadowSizeRead, sizeof kLocalShadowSizeRead) ||
+        !Matches(image, size, kLocalShadowTier, kLocalShadowTierCode, sizeof kLocalShadowTierCode)) {
+        std::printf("Engine: higher-resolution point shadows off: the pool code is not 1.09's\n");
+        return false;
+    }
+    const std::uint32_t base = quality == 1 ? 1024u : 2048u;
+    std::array<std::uint8_t, 5> resolution{0xb8};
+    std::memcpy(resolution.data() + 1, &base, sizeof base);
+    if (!WriteCode(image + kLocalShadowSize, resolution.data(), resolution.size())) {
+        std::printf("Engine: higher-resolution point shadows off: cannot write the pool size\n");
+        return false;
+    }
+    std::printf("Engine: native point-shadow faces %u/%u/%u/%u; other pools untouched by point patch\n",
+                base, base / 2, base / 4, base / 8);
+    return true;
+}
+
+bool InstallSpotShadows(std::uint8_t* image, std::size_t size) {
+    const int quality = LocalShadowQuality();
+    if (quality == 0) return false;
+    if (!image ||
+        !Matches(image, size, kLocalShadowPool, kLocalShadowPoolEntry, sizeof kLocalShadowPoolEntry) ||
+        !Matches(image, size, kSpotShadowSize, kSpotShadowSizeRead, sizeof kSpotShadowSizeRead) ||
+        !Matches(image, size, kSpotShadowTier, kSpotShadowTierCode, sizeof kSpotShadowTierCode)) {
+        std::printf("Engine: higher-resolution spotlight shadows off: the pool code is not 1.09's\n");
+        return false;
+    }
+    const std::uint8_t resolution[] = {0x31, 0xc0, 0xb4, std::uint8_t(quality == 1 ? 8 : 16)};
+    if (!WriteCode(image + kSpotShadowSize, resolution, sizeof resolution)) {
+        std::printf("Engine: higher-resolution spotlight shadows off: cannot write the pool size\n");
+        return false;
+    }
+    const unsigned base = quality == 1 ? 2048u : 4096u;
+    std::printf("Engine: native spotlight shadow maps %u/%u/%u/%u; directional pool unchanged\n",
+                base, base / 2, base / 4, base / 8);
+    return true;
+}
+
+}
diff --git a/tests/test_lamp_fog_lights.cpp b/tests/test_lamp_fog_lights.cpp
new file mode 100644
--- /dev/null
+++ b/tests/test_lamp_fog_lights.cpp
@@ -0,0 +1,694 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#include <algorithm>
+#include <array>
+#include <bit>
+#include <cassert>
+#include <cmath>
+#include <cstdio>
+#include <limits>
+#include <tuple>
+#include <vector>
+#include "gpu/shadps4/video_core/renderer_vulkan/lamp_fog_lights.h"
+
+using namespace LampFog;
+
+namespace {
+Light Make(float x, float y, float z, float radius, float r = 1, float g = 1, float b = 1) {
+    Light light{};
+    const std::array<float, 7> values{x, y, z, 1 / (radius * radius), r, g, b};
+    std::ranges::transform(values, light.begin(), [](float v) { return std::bit_cast<uint32_t>(v); });
+    return light;
+}
+
+std::vector<uint32_t> Records(const std::vector<Light>& lights) {
+    std::vector<uint32_t> words;
+    for (const auto& light : lights) {
+        words.insert(words.end(), light.begin(), light.end());
+    }
+    return words;
+}
+
+float Z(const Light& light) {
+    return std::bit_cast<float>(light[2]);
+}
+
+float Word(const Light& light, size_t i) {
+    return std::bit_cast<float>(light[i]);
+}
+
+// A camera at x along the world's x axis, looking down z.
+Camera At(float x) {
+    return {.world_to_view = {1, 0, 0, -x, 0, 1, 0, 0, 0, 0, 1, 0},
+            .view_to_world = {1, 0, 0, x, 0, 1, 0, 0, 0, 0, 1, 0},
+            .valid = true};
+}
+
+// The same place, turned around the world's y axis.
+Camera Turned(float angle) {
+    const float c = std::cos(angle), s = std::sin(angle);
+    return {.world_to_view = {c, 0, -s, 0, 0, 1, 0, 0, s, 0, c, 0},
+            .view_to_world = {c, 0, s, 0, 0, 1, 0, 0, -s, 0, c, 0},
+            .valid = true};
+}
+
+constexpr float Frame = 1.0f / 60.0f;
+// Frames a new standing lamp takes to reach full strength.
+constexpr int FadedIn = int(Memory::FadeIn / Frame) + 2;
+}
+
+int main() {
+    // Steady fog off: the first lights to arrive, in that order, whatever they are worth. What the
+    // pass drew before it remembered or ranked anything, down to the lights Select would drop.
+    {
+        std::vector<Light> arrived;
+        arrived.push_back(Make(0, 0, -100, 1)); // behind the camera
+        arrived.push_back(Make(0, 0, 10, 5));
+        arrived.push_back(Make(0, 0, 10, 5)); // the same light in another tile
+        for (int i = 0; i < 100; ++i) {
+            arrived.push_back(Make(float(i), 0, 200.0f - float(i), 1));
+        }
+        const auto words = Records(arrived);
+        FrameLights frame;
+        frame.Add(words.data(), uint32_t(arrived.size()));
+        const auto listed = AsListed(frame.Lights());
+        assert(listed.size() == AsListedLimit);
+        assert(listed[0] == arrived[0] && listed[1] == arrived[1]);
+        for (size_t i = 2; i < listed.size(); ++i) {
+            assert(listed[i] == arrived[i + 1]);
+        }
+        const std::vector<Light> few{arrived[0], arrived[1]};
+        assert(AsListed(few).size() == few.size());
+        assert(AsListed({}).empty());
+    }
+
+    // Repeated in many tiles: one light, however the colour words differ.
+    {
+        FrameLights frame;
+        const auto light = Make(1, 2, 10, 5);
+        auto recoloured = light;
+        recoloured[4] = std::bit_cast<uint32_t>(0.5f);
+        const auto words = Records({light, recoloured, light, Make(1, 2, 11, 5)});
+        frame.Add(words.data(), 4);
+        frame.Add(words.data(), 4);
+        const auto selection = Select(frame.Lights(), 64);
+        assert(selection.lights.size() == 2 && selection.visible == 2);
+        frame.Clear();
+        assert(frame.Empty() && Select(frame.Lights(), 64).lights.empty());
+    }
+    // Under the limit: everything the shader can draw is kept.
+    {
+        std::vector<Light> lights;
+        for (int i = 0; i < 64; ++i) {
+            lights.push_back(Make(float(i), 0, 20 + float(i), 8));
+        }
+        FrameLights frame;
+        const auto words = Records(lights);
+        frame.Add(words.data(), uint32_t(lights.size()));
+        assert(Select(frame.Lights(), 256).lights.size() == 64);
+    }
+    // Over it: the nearest stay and the same set comes out whatever order the tiles arrive in.
+    {
+        std::vector<Light> lights;
+        for (int i = 0; i < 300; ++i) {
+            lights.push_back(Make(0, 0, 5 + float(i), 6));
+        }
+        std::vector<std::vector<Light>> selected;
+        for (int order = 0; order < 3; ++order) {
+            auto arrival = lights;
+            if (order == 1) std::ranges::reverse(arrival);
+            if (order == 2) std::ranges::rotate(arrival, arrival.begin() + 137);
+            FrameLights frame;
+            const auto words = Records(arrival);
+            frame.Add(words.data(), uint32_t(arrival.size()));
+            auto selection = Select(frame.Lights(), 256);
+            assert(selection.lights.size() == 256 && selection.visible == 300);
+            std::ranges::sort(selection.lights);
+            selected.push_back(selection.lights);
+            for (const auto& light : selection.lights) {
+                assert(Z(light) < 5 + 256);
+            }
+        }
+        assert(selected[0] == selected[1] && selected[0] == selected[2]);
+    }
+    // Equal lights at the limit: broken by the record, so still independent of arrival order.
+    {
+        std::vector<Light> lights;
+        for (int i = 0; i < 8; ++i) {
+            const float angle = float(i) * 0.7853981f;
+            lights.push_back(Make(10 * std::cos(angle), 10 * std::sin(angle), 0, 4));
+        }
+        FrameLights forward, backward;
+        const auto words = Records(lights);
+        forward.Add(words.data(), 8);
+        auto reversed = lights;
+        std::ranges::reverse(reversed);
+        const auto reversed_words = Records(reversed);
+        backward.Add(reversed_words.data(), 8);
+        auto a = Select(forward.Lights(), 3).lights, b = Select(backward.Lights(), 3).lights;
+        std::ranges::sort(a);
+        std::ranges::sort(b);
+        assert(a.size() == 3 && a == b);
+    }
+    // Brighter, wider and nearer each count for more; a light around the camera still counts.
+    {
+        const float base = Importance(Make(0, 0, 30, 5));
+        assert(Importance(Make(0, 0, 30, 5, 2, 2, 2)) > base);
+        assert(Importance(Make(0, 0, 30, 10)) > base);
+        assert(Importance(Make(0, 0, 60, 5)) < base);
+        assert(Importance(Make(0, 0, 1, 5)) > 0);
+        assert(Importance(Make(0, 0, 0, 5)) > 0);
+    }
+    // The shader's own limit on colour: past 4 only the hue matters.
+    {
+        const float at_limit = Importance(Make(0, 0, 30, 5, 4, 4, 4));
+        assert(std::abs(Importance(Make(0, 0, 30, 5, 400, 400, 400)) - at_limit) < at_limit * 1e-4f);
+    }
+    // Nothing the shader would skip takes a place.
+    {
+        const float nan = std::numeric_limits<float>::quiet_NaN();
+        const float inf = std::numeric_limits<float>::infinity();
+        auto zero_radius = Make(0, 0, 10, 5);
+        zero_radius[3] = 0;
+        auto negative_radius = Make(0, 0, 11, 5);
+        negative_radius[3] = std::bit_cast<uint32_t>(-1.0f);
+        const auto words = Records({Make(nan, 0, 10, 5), Make(0, inf, 12, 5), zero_radius,
+                                    negative_radius, Make(0, 0, 13, 5, 0, 0, 0),
+                                    Make(0, 0, 14, 5, -1, -1, -1), Make(0, 0, 15, 5, nan, 1, 1),
+                                    Make(0, 0, -50, 5), Make(0, 0, 16, 5)});
+        FrameLights frame;
+        frame.Add(words.data(), 9);
+        const auto selection = Select(frame.Lights(), 256);
+        assert(selection.visible == 1 && selection.lights.size() == 1);
+        assert(Z(selection.lights[0]) == 16);
+    }
+    // A light behind the camera whose sphere still reaches past it is in the frame's fog.
+    assert(Importance(Make(0, 0, -2, 5)) > 0);
+    // Bad guest data cannot grow this without bound.
+    {
+        FrameLights frame;
+        std::vector<Light> lights;
+        for (size_t i = 0; i < FrameLights::MaxGathered + 50; ++i) {
+            lights.push_back(Make(float(i) * 0.01f, 0, 20, 5));
+        }
+        const auto words = Records(lights);
+        frame.Add(words.data(), uint32_t(lights.size()));
+        assert(Select(frame.Lights(), lights.size()).visible == FrameLights::MaxGathered);
+    }
+    // A lamp near the camera stays for as long as the camera does, listed or not, moved with the
+    // camera.
+    {
+        Memory memory;
+        const std::vector<Light> lamp{Make(0, 0, 20, 7.5f, 2, 1, 1)};
+        std::vector<Light> drawn;
+        for (int i = 0; i < FadedIn; ++i) drawn = memory.Update(lamp, At(0), Frame);
+        assert(drawn.size() == 1 && Word(drawn[0], 4) == 2.0f);
+        for (int i = 0; i < int(2 * Memory::HoldStill / Frame); ++i) {
+            drawn = memory.Update({}, At(5), Frame);
+            assert(drawn.size() == 1 && Word(drawn[0], 4) == 2.0f);
+            assert(Word(drawn[0], 0) == -5.0f && Z(drawn[0]) == 20.0f);
+            assert(drawn[0][3] == lamp[0][3]);
+        }
+    }
+    // How near counts from the edge of the lamp's fog: a wide lamp stays from further off.
+    {
+        const float x = Memory::KeepNear + 5;
+        for (const float radius : {2.0f, 30.0f}) {
+            Memory memory;
+            const std::vector<Light> lamp{Make(0, 0, 0, radius)};
+            // Listed for longer than a flash is.
+            for (int i = 0; i < int((Memory::ShortLived + 0.5f) / Frame); ++i) {
+                memory.Update(lamp, At(0), Frame);
+            }
+            std::vector<Light> drawn;
+            for (float walked = 0; walked < x; walked += 10) {
+                drawn = memory.Update({}, At(std::min(walked + 10, x)), Frame);
+            }
+            for (int i = 0; i < int((Memory::HoldStill + Memory::FadeOut + 1) / Frame); ++i) {
+                drawn = memory.Update({}, At(x), Frame);
+            }
+            assert(drawn.empty() == (radius == 2.0f));
+        }
+    }
+    // Once the camera has gone from it, a lamp the game drops stays where it was for the hold. Then
+    // it fades, and it is gone.
+    {
+        Memory memory;
+        const std::vector<Light> lamp{Make(0, 0, 20, 7.5f, 2, 1, 1)};
+        std::vector<Light> drawn;
+        for (int i = 0; i < FadedIn; ++i) drawn = memory.Update(lamp, At(0), Frame);
+        const float far = Memory::KeepNear + 40;
+        float held = 0;
+        for (float x = 0; x < far; x += 15) {
+            memory.Update({}, At(x), Frame);
+            held += Frame;
+        }
+        while (held < Memory::HoldStill - 0.1f) {
+            drawn = memory.Update({}, At(far), Frame);
+            held += Frame;
+            assert(drawn.size() == 1 && Word(drawn[0], 4) == 2.0f);
+            assert(Word(drawn[0], 0) == -far && Z(drawn[0]) == 20.0f);
+        }
+        float fading = Word(drawn[0], 4);
+        int frames = 0;
+        while (!(drawn = memory.Update({}, At(far), Frame)).empty()) {
+            const float now = Word(drawn[0], 4);
+            assert(now <= fading);
+            fading = now;
+            ++frames;
+            assert(float(frames) * Frame < 0.1f + Memory::FadeOut + 0.1f);
+        }
+        // From the last frame at strength to none, in about the fade's time past the hold.
+        assert(float(frames) * Frame > Memory::FadeOut * 0.8f);
+    }
+    // Back before the hold is over: the same lamp, once, with no dip and no second copy.
+    {
+        Memory memory;
+        const std::vector<Light> lamp{Make(0, 0, 20, 7.5f)};
+        for (int i = 0; i < FadedIn; ++i) memory.Update(lamp, At(0), Frame);
+        for (int i = 0; i < int(20.0f / Frame); ++i) memory.Update({}, At(0), Frame);
+        const auto drawn = memory.Update(lamp, At(0), Frame);
+        assert(drawn.size() == 1 && Word(drawn[0], 4) == 1.0f);
+    }
+    // The camera moving does not make a standing lamp look like a new one.
+    {
+        Memory memory;
+        std::vector<Light> drawn;
+        float x = 0;
+        for (int i = 0; i < FadedIn; ++i) {
+            x = float(i) * 0.2f;
+            drawn = memory.Update(std::vector<Light>{Make(10 - x, 0, 20, 5)}, At(x), Frame);
+            assert(drawn.size() == 1);
+        }
+        assert(Word(drawn[0], 4) == 1.0f);
+        // And it still counts as standing: the long hold.
+        for (int i = 0; i < 60; ++i) drawn = memory.Update({}, At(x), Frame);
+        assert(drawn.size() == 1 && Word(drawn[0], 4) == 1.0f);
+    }
+    // A new light fades in, at the same pace at any frame rate.
+    {
+        for (const float step : {1.0f / 30.0f, 1.0f / 60.0f, 1.0f / 144.0f}) {
+            Memory memory;
+            const std::vector<Light> lamp{Make(0, 0, 20, 5)};
+            std::vector<Light> drawn;
+            float time = 0;
+            while (time < Memory::FadeIn * 0.5f) {
+                drawn = memory.Update(lamp, At(0), step);
+                time += step;
+            }
+            assert(std::abs(Word(drawn[0], 4) - time / Memory::FadeIn) < 0.01f);
+            for (int i = 0; i < int(Memory::FadeIn / step) + 2; ++i) {
+                drawn = memory.Update(lamp, At(0), step);
+            }
+            assert(Word(drawn[0], 4) == 1.0f);
+        }
+    }
+    // A turning camera does not make a standing lamp count as moving, though its position comes
+    // out off by what the camera turned: it stays when the game drops it.
+    {
+        Memory memory;
+        float angle = 0, before = 0;
+        std::vector<Light> drawn;
+        for (int i = 0; i < FadedIn; ++i) {
+            const float x = -std::sin(before) * 30, z = std::cos(before) * 30;
+            before = angle;
+            angle += i % 2 ? 0.04f : 0.01f;
+            drawn = memory.Update(std::vector<Light>{Make(x, 0, z, 5)}, Turned(angle), Frame);
+            assert(drawn.size() == 1);
+        }
+        assert(Word(drawn[0], 4) == 1.0f);
+        for (int i = 0; i < 60; ++i) drawn = memory.Update({}, Turned(angle), Frame);
+        assert(drawn.size() == 1 && Word(drawn[0], 4) == 1.0f);
+    }
+    // A light that moves comes up quickly and is held only briefly: a carried torch does not stay
+    // behind for seconds, whether it walks in front of a still camera or beside a moving one.
+    for (const bool camera_follows : {false, true}) {
+        Memory memory;
+        std::vector<Light> drawn;
+        float x = 0;
+        for (int i = 0; i < 60; ++i) {
+            x = float(i) * 0.1f;
+            drawn = memory.Update(std::vector<Light>{camera_follows ? Make(0, 0, 10, 5)
+                                                                    : Make(x, 0, 10, 5)},
+                                  At(camera_follows ? x : 0), Frame);
+        }
+        assert(Word(drawn[0], 4) == 1.0f);
+        const auto camera = At(camera_follows ? x : 0);
+        float time = 0;
+        while (!memory.Update({}, camera, Frame).empty()) {
+            time += Frame;
+            assert(time < Memory::HoldMoving + Memory::FadeOutMoving + 0.1f);
+        }
+        assert(time >= Memory::HoldMoving);
+    }
+    // A carried torch that stops, then goes when its carrier dies, is not taken for a standing lamp
+    // because it stood still a while: it is gone as quickly as one that was moving.
+    {
+        Memory memory;
+        std::vector<Light> drawn;
+        for (int i = 0; i < 60; ++i) {
+            drawn = memory.Update(std::vector<Light>{Make(float(i) * 0.1f, 0, 10, 5)}, At(0), Frame);
+        }
+        const std::vector<Light> stopped{Make(5.9f, 0, 10, 5)};
+        for (int i = 0; i < int(10.0f / Frame); ++i) drawn = memory.Update(stopped, At(0), Frame);
+        assert(drawn.size() == 1 && Word(drawn[0], 4) == 1.0f);
+        float time = 0;
+        while (!memory.Update({}, At(0), Frame).empty()) {
+            time += Frame;
+            assert(time < Memory::HoldMoving + Memory::FadeOutMoving + 0.1f);
+        }
+    }
+    // A flash (a thrown fire bottle's lights): listed for under a second close to the camera and
+    // then dropped, it goes as fast as a moving light. The same light far off, or listed for
+    // longer, is a lamp the game left out and is held.
+    for (const auto& [distance, listed_seconds, goes] :
+         {std::tuple{8.0f, 0.5f, true}, std::tuple{8.0f, 1.9f, true}, std::tuple{8.0f, 3.0f, false},
+          std::tuple{14.0f, 0.5f, true}, std::tuple{16.0f, 0.5f, false},
+          std::tuple{30.0f, 0.5f, false}}) {
+        Memory memory;
+        const std::vector<Light> flash{Make(0, 0, distance, 5, 2.4f, 1.2f, 0.6f)};
+        std::vector<Light> drawn;
+        for (int i = 0; i < int(listed_seconds / Frame); ++i) {
+            drawn = memory.Update(flash, At(0), Frame);
+        }
+        float time = 0;
+        while (!memory.Update({}, At(0), Frame).empty() && time < 5.0f) {
+            time += Frame;
+        }
+        if (goes) {
+            assert(time < Memory::HoldMoving + Memory::FadeOutMoving + 0.1f);
+        } else {
+            assert(time >= 5.0f);
+        }
+    }
+    // An idle enemy's torch that jumps further in one frame than a light moves is still one light:
+    // no copy of it is left behind to glow where the enemy stood once it is dead.
+    {
+        Memory memory;
+        auto torch = Make(0, 0, 6, 8.5f, 2.4f, 1.4f, 0.6f);
+        torch[7] = std::bit_cast<uint32_t>(0.5f);
+        auto jumped = Make(0.4f, -1.7f, 6, 8.5f, 2.45f, 1.4f, 0.6f);
+        jumped[7] = torch[7];
+        std::vector<Light> drawn;
+        for (int i = 0; i < int(10.0f / Frame); ++i) {
+            drawn = memory.Update(std::vector<Light>{torch}, At(0), Frame);
+        }
+        for (int i = 0; i < 60; ++i) {
+            drawn = memory.Update(std::vector<Light>{jumped}, At(0), Frame);
+            assert(drawn.size() == 1);
+        }
+        float time = 0;
+        while (!memory.Update({}, At(0), Frame).empty()) {
+            time += Frame;
+            assert(time < Memory::HoldMoving + Memory::FadeOutMoving + 0.1f);
+        }
+    }
+    // The takeover is for the lights the game spawns, of the same kind, in the same moment: the
+    // map's own lamps, a light of another reach or colour, a jump too far and a light the game
+    // dropped a while ago all stay as they were.
+    for (const int what : {0, 1, 2, 3, 4}) {
+        Memory memory;
+        auto first = Make(0, 0, 6, 8.5f, 2.4f, 1.4f, 0.6f);
+        first[7] = std::bit_cast<uint32_t>(what == 0 ? 20.0f : 0.5f);
+        auto second = Make(0.4f, -1.7f, 6, what == 1 ? 5.0f : 8.5f, what == 2 ? 0.5f : 2.4f, 1.4f, 0.6f);
+        if (what == 3) second = Make(0.4f, -3.5f, 6, 8.5f, 2.4f, 1.4f, 0.6f);
+        second[7] = first[7];
+        std::vector<Light> drawn;
+        for (int i = 0; i < int(10.0f / Frame); ++i) memory.Update(std::vector<Light>{first}, At(0), Frame);
+        if (what == 4) {
+            for (int i = 0; i < 12; ++i) memory.Update({}, At(0), Frame);
+        }
+        drawn = memory.Update(std::vector<Light>{second}, At(0), Frame);
+        for (int i = 0; i < 60; ++i) drawn = memory.Update(std::vector<Light>{second}, At(0), Frame);
+        assert(drawn.size() == 2);
+    }
+    // A lamp prop the game spawns (colour about 1.2), listed for a moment close by and left out for
+    // a second, is a lamp, not a flash: held, and back at full when listed again. Not judged late
+    // either: a flash's colour is read as the game drops it, not when the camera comes by.
+    {
+        Memory memory;
+        const std::vector<Light> prop{Make(0, 0, 8, 7.5f, 1.2f, 0.78f, 0.43f)};
+        std::vector<Light> drawn;
+        for (int i = 0; i < int(0.5f / Frame); ++i) memory.Update(prop, At(0), Frame);
+        for (int i = 0; i < 60; ++i) drawn = memory.Update({}, At(0), Frame);
+        assert(drawn.size() == 1);
+        Memory far_then_near;
+        const std::vector<Light> bright{Make(40, 0, 5, 5, 2.4f, 1.2f, 0.6f)};
+        for (int i = 0; i < int(0.5f / Frame); ++i) far_then_near.Update(bright, At(0), Frame);
+        for (int i = 0; i < 120; ++i) drawn = far_then_near.Update({}, At(0), Frame);
+        assert(drawn.size() == 1);
+        // The camera walks up to it: close now, but not judged as a flash.
+        for (int i = 1; i <= 70; ++i) drawn = far_then_near.Update({}, At(float(i) * 0.5f), Frame);
+        assert(drawn.size() == 1);
+    }
+    // One of the map's own lamps (word 7 is 20, 50 or 1000) listed that briefly and dropped close
+    // by is a lamp the game left out: held, whatever its colour.
+    for (const float word7 : {20.0f, 50.0f, 1000.0f}) {
+        Memory memory;
+        auto lamp = Make(0, 0, 8, 5, 2.4f, 1.2f, 0.6f);
+        lamp[7] = std::bit_cast<uint32_t>(word7);
+        const std::vector<Light> listed{lamp};
+        for (int i = 0; i < int(0.5f / Frame); ++i) memory.Update(listed, At(0), Frame);
+        std::vector<Light> drawn;
+        for (int i = 0; i < 60; ++i) drawn = memory.Update({}, At(0), Frame);
+        assert(drawn.size() == 1);
+        // And one the game spawned (word 7 is 1) is not.
+        Memory spawned;
+        lamp[7] = std::bit_cast<uint32_t>(1.0f);
+        const std::vector<Light> flash{lamp};
+        for (int i = 0; i < int(0.5f / Frame); ++i) spawned.Update(flash, At(0), Frame);
+        for (int i = 0; i < 60; ++i) drawn = spawned.Update({}, At(0), Frame);
+        assert(drawn.empty());
+    }
+    // A light that was dropped close and young comes back as the same light, with no second copy.
+    {
+        Memory memory;
+        const std::vector<Light> lamp{Make(0, 0, 8, 5)};
+        std::vector<Light> drawn;
+        for (int i = 0; i < 30; ++i) memory.Update(lamp, At(0), Frame);
+        for (int i = 0; i < 6; ++i) memory.Update({}, At(0), Frame);
+        for (int i = 0; i < 2 * FadedIn; ++i) drawn = memory.Update(lamp, At(0), Frame);
+        assert(drawn.size() == 1 && Word(drawn[0], 4) == 1.0f);
+        // Listed long enough now: the long hold.
+        for (int i = 0; i < 60; ++i) drawn = memory.Update({}, At(0), Frame);
+        assert(drawn.size() == 1 && Word(drawn[0], 4) == 1.0f);
+    }
+    // A standing lamp whose position comes out a little different each frame is not taken for a
+    // carried torch, however long it is watched, though the camera walks up to it from far off and
+    // the estimate gets better.
+    for (const bool walks_up : {false, true}) {
+        Memory memory;
+        std::vector<Light> drawn;
+        float camera_x = walks_up ? -70.0f : 0.0f;
+        for (int i = 0; i < 20 * 60; ++i) {
+            if (walks_up) camera_x = std::min(25.0f, camera_x + 0.1f);
+            const float distance = 30.0f - camera_x;
+            const float wobble = 0.4f * (Memory::SameLight + Memory::SameLightPerMetre * distance);
+            drawn = memory.Update(
+                std::vector<Light>{Make(30.0f - camera_x, i % 2 ? wobble : -wobble, 10, 5)},
+                At(camera_x), Frame);
+        }
+        assert(drawn.size() == 1 && Word(drawn[0], 4) == 1.0f);
+        for (int i = 0; i < 60; ++i) drawn = memory.Update({}, At(camera_x), Frame);
+        assert(drawn.size() == 1 && Word(drawn[0], 4) == 1.0f);
+    }
+    // Two lamps side by side stay two, and each keeps its own colour.
+    {
+        Memory memory;
+        const std::vector<Light> lamps{Make(0, 0, 20, 5, 1, 0, 0), Make(0.3f, 0, 20, 5, 0, 1, 0)};
+        std::vector<Light> drawn;
+        for (int i = 0; i < FadedIn; ++i) drawn = memory.Update(lamps, At(0), Frame);
+        assert(drawn.size() == 2);
+        if (Word(drawn[0], 0) != 0.0f) std::swap(drawn[0], drawn[1]);
+        assert(Word(drawn[0], 4) == 1.0f && Word(drawn[0], 5) == 0.0f);
+        assert(Word(drawn[1], 4) == 0.0f && Word(drawn[1], 5) == 1.0f);
+    }
+    // Two lamps closer than the distance that counts as one, with different reaches (a blue river
+    // light under a warm bridge lamp), listed one at a time: still two, each with its own colour.
+    {
+        Memory memory;
+        const auto warm = Make(0, 0, 20, 2, 1, 0.5f, 0.25f);
+        const auto blue = Make(0.4f, 0, 20, 0.6f, 0, 0.5f, 1);
+        std::vector<Light> drawn;
+        for (int i = 0; i < 4 * FadedIn; ++i) {
+            drawn = memory.Update(std::vector<Light>{i % 3 ? warm : blue}, At(0), Frame);
+            for (const auto& light : drawn) {
+                const auto& own = light[3] == warm[3] ? warm : blue;
+                assert(light[3] == warm[3] || light[3] == blue[3]);
+                // Fading in, but never the other lamp's colour.
+                assert(std::abs(Word(light, 4) * Word(own, 6) - Word(light, 6) * Word(own, 4)) <
+                       1e-6f);
+            }
+        }
+        assert(drawn.size() == 2);
+        for (const auto& light : drawn) {
+            const auto& own = light[3] == warm[3] ? warm : blue;
+            assert(Word(light, 4) == Word(own, 4) && Word(light, 5) == Word(own, 5) &&
+                   Word(light, 6) == Word(own, 6));
+        }
+    }
+    // A lamp whose reach comes out a little different from frame to frame is still one lamp.
+    {
+        Memory memory;
+        std::vector<Light> drawn;
+        for (int i = 0; i < FadedIn; ++i) {
+            drawn = memory.Update(std::vector<Light>{Make(0, 0, 20, i % 2 ? 5.0f : 5.25f)}, At(0),
+                                  Frame);
+        }
+        assert(drawn.size() == 1 && Word(drawn[0], 4) == 1.0f);
+    }
+    // The game turning a lamp's colour off and back on at full in one frame: the fog follows over
+    // the fade times, at the same pace at any frame rate, and ends on the game's colour.
+    {
+        std::vector<float> halfway;
+        for (const float step : {1.0f / 30.0f, 1.0f / 60.0f, 1.0f / 144.0f}) {
+            Memory memory;
+            const std::vector<Light> lit{Make(0, 0, 20, 5, 2, 2, 2)};
+            const std::vector<Light> dark{Make(0, 0, 20, 5, 0, 0, 0)};
+            std::vector<Light> drawn;
+            for (int i = 0; i < int(Memory::FadeIn / step) + 2; ++i) {
+                drawn = memory.Update(lit, At(0), step);
+            }
+            assert(Word(drawn[0], 4) == 2.0f);
+            float before = 2.0f;
+            for (float time = 0; time < Memory::FadeOut; time += step) {
+                drawn = memory.Update(dark, At(0), step);
+                const float now = drawn.empty() ? 0.0f : Word(drawn[0], 4);
+                assert(now <= before && before - now < 2.0f * 4.0f * step / Memory::FadeOut);
+                before = now;
+            }
+            assert(before < 2.0f * 0.1f);
+            for (int i = 0; i < int(2 * Memory::FadeOut / step); ++i) {
+                memory.Update(dark, At(0), step);
+            }
+            drawn = memory.Update(lit, At(0), step);
+            assert(!drawn.empty() && Word(drawn[0], 4) < 2.0f * 4.0f * step / Memory::FadeIn);
+            float time = step;
+            while (time < Memory::FadeIn * 0.5f) {
+                drawn = memory.Update(lit, At(0), step);
+                time += step;
+            }
+            halfway.push_back(Word(drawn[0], 4));
+            for (int i = 0; i < int(4 * Memory::FadeIn / step); ++i) {
+                drawn = memory.Update(lit, At(0), step);
+            }
+            assert(Word(drawn[0], 4) == 2.0f);
+        }
+        for (const float value : halfway) {
+            assert(std::abs(value - halfway[0]) < 0.05f && value > 0.5f && value < 2.0f * 0.95f);
+        }
+    }
+    // Over the limit: never more drawn than it takes. A lamp that comes in waits for the one it
+    // pushes out to fade, then fades in; nothing switches off or on in a frame.
+    {
+        Memory memory;
+        constexpr size_t Limit = 4;
+        std::vector<Light> lamps;
+        for (int i = 0; i < 6; ++i) {
+            lamps.push_back(Make(float(i) * 3, 0, 20 + float(i), 5));
+        }
+        std::vector<Light> drawn;
+        for (int i = 0; i < FadedIn; ++i) drawn = memory.Update(lamps, At(0), Frame, Limit);
+        assert(drawn.size() == Limit);
+        for (const auto& light : drawn) {
+            assert(Z(light) < 24 && Word(light, 4) == 1.0f);
+        }
+        lamps.push_back(Make(0, 0, 6, 5));
+        const auto strength = [&](float z) {
+            for (const auto& light : drawn) {
+                if (Z(light) == z) return Word(light, 4);
+            }
+            return 0.0f;
+        };
+        float leaving = strength(23), coming = 0;
+        int frames = 0;
+        while (coming < 1.0f) {
+            drawn = memory.Update(lamps, At(0), Frame, Limit);
+            assert(drawn.size() <= Limit);
+            const float now_leaving = strength(23), now_coming = strength(6);
+            assert(now_leaving <= leaving && leaving - now_leaving <= Frame / Memory::FadeOut + 1e-4f);
+            // Its own fade in and the limit's can overlap.
+            assert(now_coming >= coming &&
+                   now_coming - coming <= 2 * Frame / Memory::FadeIn + 1e-4f);
+            leaving = now_leaving;
+            coming = now_coming;
+            if (coming > 0) assert(leaving == 0);
+            ++frames;
+            assert(float(frames) * Frame < Memory::FadeOut + 2 * Memory::FadeIn + 0.5f);
+        }
+        assert(float(frames) * Frame > Memory::FadeOut);
+        for (const float z : {20.0f, 21.0f, 22.0f}) assert(strength(z) == 1.0f);
+    }
+    // Lights close in importance do not trade places as one gets a little ahead; one well ahead
+    // does take the place.
+    {
+        Memory memory;
+        const auto a = Make(0, 0, 20, 5), b = Make(5, 0, 20, 5);
+        std::vector<Light> drawn;
+        for (int i = 0; i < FadedIn; ++i) {
+            drawn = memory.Update(std::vector<Light>{a, b}, At(0), Frame, 1);
+        }
+        assert(drawn.size() == 1 && Word(drawn[0], 0) == 0.0f);
+        const float ahead = 1.1f * Importance(a) / Importance(b);
+        for (int i = 0; i < 4 * FadedIn; ++i) {
+            drawn = memory.Update(std::vector<Light>{a, Make(5, 0, 20, 5, ahead, ahead, ahead)},
+                                  At(0), Frame, 1);
+            assert(drawn.size() == 1 && Word(drawn[0], 0) == 0.0f);
+        }
+        const float well_ahead = 2.0f * Importance(a) / Importance(b);
+        for (int i = 0; i < 4 * FadedIn; ++i) {
+            drawn = memory.Update(
+                std::vector<Light>{a, Make(5, 0, 20, 5, well_ahead, well_ahead, well_ahead)},
+                At(0), Frame, 1);
+            assert(drawn.size() <= 1);
+        }
+        assert(drawn.size() == 1 && Word(drawn[0], 0) == 5.0f);
+    }
+    // A fade dims a bright light from the start: the shader's limit on colour does not undo it.
+    {
+        Memory memory;
+        const std::vector<Light> lamp{Make(0, 0, 20, 5, 400, 200, 0)};
+        auto drawn = memory.Update(lamp, At(0), Memory::FadeIn * 0.5f);
+        assert(std::abs(Word(drawn[0], 4) - 2.0f) < 0.001f);
+        assert(std::abs(Word(drawn[0], 5) - 1.0f) < 0.001f);
+        for (int i = 0; i < FadedIn; ++i) drawn = memory.Update(lamp, At(0), Frame);
+        assert(Word(drawn[0], 4) == 4.0f && Word(drawn[0], 5) == 2.0f);
+    }
+    // A warp forgets what was around the old place.
+    {
+        Memory memory;
+        const std::vector<Light> lamp{Make(0, 0, 20, 5)};
+        for (int i = 0; i < 30; ++i) memory.Update(lamp, At(0), Frame);
+        assert(memory.Update({}, At(Memory::CameraJump + 1), Frame).empty());
+    }
+    // Without a camera: the game's list as it is, and nothing kept from it.
+    {
+        Memory memory;
+        const std::vector<Light> lamp{Make(0, 0, 20, 5)};
+        const auto drawn = memory.Update(lamp, Camera{}, Frame);
+        assert(drawn == lamp);
+        assert(memory.Update({}, At(0), Frame).empty());
+    }
+    // Records the shader would skip are not remembered.
+    {
+        Memory memory;
+        const float nan = std::numeric_limits<float>::quiet_NaN();
+        auto zero_radius = Make(0, 0, 10, 5);
+        zero_radius[3] = 0;
+        const std::vector<Light> bad{Make(nan, 0, 10, 5), zero_radius, Make(0, 0, 12, 5, nan, 1, 1)};
+        assert(memory.Update(bad, At(0), Frame).empty());
+    }
+    // Bad guest data cannot grow the memory without bound.
+    {
+        Memory memory;
+        std::vector<Light> lights;
+        for (size_t i = 0; i < Memory::MaxRemembered + 50; ++i) {
+            lights.push_back(Make(float(i) * 2, 0, 20, 5));
+        }
+        assert(memory.Update(lights, At(0), Frame).size() == Memory::MaxRemembered);
+    }
+    std::puts("Lamp fog lights: PASS (each light once, kept by importance in any arrival order, "
+              "lights the shader skips left out, bounded; remembered through the hold, moved with "
+              "the camera, faded in and out at any frame rate, forgotten on a warp; neighbours with "
+              "other reaches kept apart, the game's colour followed over the fades, faded at the "
+              "light limit)");
+}
diff --git a/tests/test_native_local_shadows.cpp b/tests/test_native_local_shadows.cpp
new file mode 100644
--- /dev/null
+++ b/tests/test_native_local_shadows.cpp
@@ -0,0 +1,387 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#include "../gpu/shim/engine/graphics.h"
+#include "../gpu/shim/bbport_platform.h"
+#include "../gpu/shim/bbport_settings.h"
+#include <array>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <vector>
+#ifdef _WIN32
+#include <windows.h>
+#else
+#include <sys/mman.h>
+#include <signal.h>
+#include <unistd.h>
+#endif
+
+#ifdef _WIN32
+namespace BbPlatform {
+bool ReadProcessMemory(const void* p, void* out, size_t n) {
+    if (!p) return false;
+    std::memcpy(out, p, n);
+    return true;
+}
+}
+#endif
+
+namespace {
+int failures = 0;
+void Check(bool ok, const char* what) {
+    if (!ok) { std::printf("FAIL: %s\n", what); ++failures; }
+}
+void Stock(bool enabled) {
+    BbSettings::Get().graphics_local_shadow_resolution = enabled ? 0 : 2;
+}
+void Directional(bool enabled) {
+    BbSettings::Get().startup_directional_filter = enabled;
+}
+}
+
+#ifndef _WIN32
+void WritableAgain(int, siginfo_t* info, void*) {
+    const auto page = reinterpret_cast<std::uintptr_t>(info->si_addr) & ~std::uintptr_t(4095);
+    if (mprotect(reinterpret_cast<void*>(page), 4096, PROT_READ | PROT_WRITE | PROT_EXEC)) _exit(2);
+}
+#endif
+
+int main() {
+#ifndef _WIN32
+    struct sigaction action{};
+    action.sa_sigaction = WritableAgain;
+    action.sa_flags = SA_SIGINFO;
+    sigaction(SIGSEGV, &action, nullptr);
+#endif
+    std::setvbuf(stdout, nullptr, _IONBF, 0);
+    Stock(false);
+    constexpr std::size_t pool = 0x22440b0, size_at = 0x224443f, tier = 0x2244cb0;
+    constexpr std::uint8_t entry[] = {
+        0x55, 0x48, 0x89, 0xe5, 0x41, 0x57, 0x41, 0x56, 0x41, 0x55, 0x41, 0x54, 0x53,
+        0x48, 0x81, 0xe4, 0xe0, 0xff, 0xff, 0xff, 0x48, 0x81, 0xec, 0x20, 0x01, 0x00, 0x00};
+    constexpr std::uint8_t read[] = {
+        0x41, 0x8b, 0x44, 0x24, 0x14, 0x4d, 0x89, 0xe6, 0x4c, 0x89, 0x74, 0x24, 0x58,
+        0x89, 0x44, 0x24, 0x44};
+    constexpr std::uint8_t tiers[] = {0x41, 0xd1, 0xed, 0x48, 0xff, 0xc1, 0x48, 0x83, 0xf9, 0x04};
+    std::vector<std::uint8_t> image(tier + sizeof tiers, 0xcc);
+    std::memcpy(image.data() + pool, entry, sizeof entry);
+    std::memcpy(image.data() + size_at, read, sizeof read);
+    std::memcpy(image.data() + tier, tiers, sizeof tiers);
+    const auto original = image;
+    Stock(false);
+    Check(!BbEngine::Graphics::InstallLocalShadows(nullptr, image.size()), "null images are refused");
+    Check(!BbEngine::Graphics::InstallLocalShadows(image.data(), tier + sizeof tiers - 1),
+          "truncated images are refused");
+    Check(image == original, "a truncated image is not modified");
+    for (const auto at : {pool, size_at, size_at + sizeof read - 1, tier}) {
+        image[at] ^= 1;
+        const auto foreign = image;
+        Check(!BbEngine::Graphics::InstallLocalShadows(image.data(), image.size()),
+              "foreign pool, size-load and tier code are refused");
+        Check(image == foreign, "a refused patch changes no bytes");
+        image[at] ^= 1;
+    }
+    Stock(true);
+    Check(!BbEngine::Graphics::InstallLocalShadows(image.data(), image.size()), "stock opt-out is honored");
+    Check(image == original, "stock mode leaves the whole image unchanged");
+    Stock(false);
+    Check(BbEngine::Graphics::InstallLocalShadows(image.data(), image.size()), "1.09 pool code is accepted");
+    Check(image[size_at] == 0xb8, "the native point base load becomes mov eax,imm32");
+    std::uint32_t base = 0;
+    std::memcpy(&base, image.data() + size_at + 1, sizeof base);
+    Check(base == 2048, "the point base size is 2048");
+    const std::array<std::uint32_t, 4> expected{2048, 1024, 512, 256};
+    for (unsigned i = 0; i < expected.size(); ++i)
+        Check((base >> i) == expected[i], "native halving generates the requested tiers");
+    std::memcpy(image.data() + size_at, read, 5);
+    Check(image == original, "only the five-byte point-size load changed; counts and other pools stay native");
+
+    constexpr std::size_t spot_size = 0x22440ed, spot_tier = 0x224442a;
+    constexpr std::uint8_t spot_read[] = {
+        0x41, 0x8b, 0x04, 0x24, 0x89, 0x44, 0x24, 0x68, 0x48, 0x8d, 0x4b, 0x10,
+        0x48, 0x89, 0x4c, 0x24, 0x50, 0x49, 0x89, 0xdd, 0x45, 0x31, 0xff, 0x89, 0x44, 0x24, 0x60};
+    constexpr std::uint8_t spot_tiers[] = {
+        0xd1, 0x6c, 0x24, 0x68, 0xd1, 0x6c, 0x24, 0x60, 0x49, 0xff, 0xc7, 0x49, 0x83, 0xff, 0x04};
+    std::memcpy(image.data() + spot_size, spot_read, sizeof spot_read);
+    std::memcpy(image.data() + spot_tier, spot_tiers, sizeof spot_tiers);
+    const auto spot_original = image;
+    Stock(false);
+    Check(!BbEngine::Graphics::InstallSpotShadows(nullptr, image.size()), "null spotlight images are refused");
+    Check(!BbEngine::Graphics::InstallSpotShadows(image.data(), spot_tier + sizeof spot_tiers - 1),
+          "truncated spotlight images are refused");
+    Check(image == spot_original, "a truncated spotlight image is not modified");
+    for (const auto at : {pool, spot_size, spot_size + sizeof spot_read - 1, spot_tier}) {
+        image[at] ^= 1;
+        const auto foreign = image;
+        Check(!BbEngine::Graphics::InstallSpotShadows(image.data(), image.size()),
+              "foreign spotlight initialization and tier code are refused");
+        Check(image == foreign, "a refused spotlight patch changes no bytes");
+        image[at] ^= 1;
+    }
+    Stock(true);
+    Check(!BbEngine::Graphics::InstallSpotShadows(image.data(), image.size()), "spotlight opt-out is honored");
+    Check(image == spot_original, "stock spotlight mode leaves the whole image unchanged");
+    Stock(false);
+    Check(BbEngine::Graphics::InstallSpotShadows(image.data(), image.size()), "spotlight upgrade installs");
+    constexpr std::uint8_t spot_resolution[] = {0x31, 0xc0, 0xb4, 0x10};
+    Check(!std::memcmp(image.data() + spot_size, spot_resolution, sizeof spot_resolution),
+          "the spotlight base load sets EAX to 4096");
+#ifdef _WIN32
+    auto* code = static_cast<std::uint8_t*>(
+        VirtualAlloc(nullptr, 4096, MEM_RESERVE | MEM_COMMIT, PAGE_EXECUTE_READWRITE));
+#else
+    void* memory = mmap(nullptr, 4096, PROT_READ | PROT_WRITE | PROT_EXEC, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+    auto* code = memory == MAP_FAILED ? nullptr : static_cast<std::uint8_t*>(memory);
+#endif
+    Check(code != nullptr, "executable memory for spotlight instruction regression");
+    if (code) {
+        constexpr std::uint8_t incoming[] = {0x48, 0xc7, 0xc0, 0xff, 0xff, 0xff, 0xff};
+        std::memcpy(code, incoming, sizeof incoming);
+        std::memcpy(code + sizeof incoming, image.data() + spot_size, sizeof spot_resolution);
+        code[sizeof incoming + sizeof spot_resolution] = 0xc3;
+        using Size = std::uint64_t (__attribute__((sysv_abi)) *)();
+        const auto spot_base = reinterpret_cast<Size>(code)();
+        constexpr std::array<std::uint32_t, 4> spot_expected{4096, 2048, 1024, 512};
+        for (unsigned i = 0; i < spot_expected.size(); ++i)
+            Check((spot_base >> i) == spot_expected[i], "executed spotlight base generates all four tiers");
+#ifdef _WIN32
+        VirtualFree(code, 0, MEM_RELEASE);
+#else
+        munmap(code, 4096);
+#endif
+    }
+    std::memcpy(image.data() + spot_size, spot_read, sizeof spot_resolution);
+    Check(image == spot_original, "only the four-byte spotlight load changed");
+    Check(BbEngine::Graphics::InstallLocalShadows(image.data(), image.size()) &&
+          BbEngine::Graphics::InstallSpotShadows(image.data(), image.size()),
+          "point and spotlight upgrades install together");
+
+    constexpr std::size_t point_radius = 0x4929c80, spot_radius = 0x4929c84;
+    constexpr std::size_t point_load = 0x22b7011, spot_load = 0x22b7220, spot_fallback = 0x22b7298;
+    constexpr std::uint8_t point_code[] = {0xc5, 0xfa, 0x10, 0x05, 0x67, 0x2c, 0x67, 0x02};
+    constexpr std::uint8_t spot_code[] = {0xc5, 0xfa, 0x10, 0x05, 0x5c, 0x2a, 0x67, 0x02};
+    constexpr std::uint8_t fallback_code[] = {0xc5, 0xfa, 0x10, 0x05, 0xe4, 0x29, 0x67, 0x02};
+    image.resize(spot_radius + sizeof(float), 0xcc);
+    std::memcpy(image.data() + point_load, point_code, sizeof point_code);
+    std::memcpy(image.data() + spot_load, spot_code, sizeof spot_code);
+    std::memcpy(image.data() + spot_fallback, fallback_code, sizeof fallback_code);
+    const auto reset_radii = [&] {
+        const float radius = 3.2f;
+        std::memcpy(image.data() + point_radius, &radius, sizeof radius);
+        std::memcpy(image.data() + spot_radius, &radius, sizeof radius);
+    };
+    const auto radius_at = [&](std::size_t at) {
+        float radius = 0;
+        std::memcpy(&radius, image.data() + at, sizeof radius);
+        return radius;
+    };
+    reset_radii();
+    Check(BbEngine::Graphics::InstallLocalShadowSoftness(image.data(), image.size(), false, false) &&
+          radius_at(point_radius) == 3.2f && radius_at(spot_radius) == 3.2f,
+          "stock allocation keeps stock softness for both light types");
+    Check(!BbEngine::Graphics::InstallLocalShadowSoftness(nullptr, image.size(), true, true),
+          "null filter images are refused");
+    Check(!BbEngine::Graphics::InstallLocalShadowSoftness(image.data(), image.size() - 1, true, true) &&
+          radius_at(point_radius) == 3.2f, "a truncated spotlight radius changes neither filter");
+    for (const auto at : {point_load, spot_load, spot_fallback, point_radius, spot_radius}) {
+        image[at] ^= 1;
+        const auto altered = image[at];
+        Check(!BbEngine::Graphics::InstallLocalShadowSoftness(image.data(), image.size(), true, true),
+              "foreign radius constants and all three load sites are refused");
+        Check(image[at] == altered, "filter refusal preserves foreign bytes");
+        image[at] ^= 1;
+        Check(radius_at(point_radius) == 3.2f && radius_at(spot_radius) == 3.2f,
+              "filter guard failure leaves both radii unchanged");
+    }
+    Check(BbEngine::Graphics::InstallLocalShadowSoftness(image.data(), image.size(), true, false) &&
+          radius_at(point_radius) == 6.4f && radius_at(spot_radius) == 3.2f,
+          "point-only resolution upgrade compensates only point softness");
+    reset_radii();
+    Check(BbEngine::Graphics::InstallLocalShadowSoftness(image.data(), image.size(), false, true) &&
+          radius_at(point_radius) == 3.2f && radius_at(spot_radius) == 6.4f,
+          "spotlight-only resolution upgrade compensates only spotlight softness");
+    reset_radii();
+    Check(BbEngine::Graphics::InstallLocalShadowSoftness(image.data(), image.size(), true, true),
+          "both upgraded light types accept softness compensation");
+    for (unsigned tier_index = 0; tier_index < 4; ++tier_index) {
+        Check(radius_at(point_radius) / float(2048u >> tier_index) == 0.25f * 3.2f / float(256u >> tier_index),
+              "point filter UV footprint is one quarter of stock at every tier");
+        Check(radius_at(spot_radius) / float(4096u >> tier_index) == 0.25f * 3.2f / float(512u >> tier_index),
+              "spotlight filter UV footprint is one quarter of stock at every tier");
+    }
+    constexpr std::size_t range = 0xeac540, tail = 0xeac657;
+
+    std::memcpy(image.data() + size_at, read, 5);
+    std::memcpy(image.data() + spot_size, spot_read, 4);
+    reset_radii();
+    const auto local_original = image;
+    for (int quality = 0; quality < 3; ++quality) {
+        BbSettings::Get().graphics_local_shadow_resolution = quality;
+        const bool point = BbEngine::Graphics::InstallLocalShadows(image.data(), image.size());
+        const bool spot = BbEngine::Graphics::InstallSpotShadows(image.data(), image.size());
+        Check(point == (quality != 0) && spot == (quality != 0),
+              "local dropdown enables both upgrades only for High and Very high");
+        Check(BbEngine::Graphics::InstallLocalShadowSoftness(image.data(), image.size(), point, spot),
+              "selected local quality accepts matching softness");
+        if (quality == 0) {
+            Check(image == local_original, "Default keeps native allocation instructions and filters byte-for-byte");
+        } else {
+            const unsigned point_base = quality == 1 ? 1024 : 2048;
+            const unsigned spot_base = point_base * 2;
+            std::uint32_t immediate = 0;
+            std::memcpy(&immediate, image.data() + size_at + 1, 4);
+            Check(immediate == point_base && image[size_at] == 0xb8, "selected point base immediate");
+            Check(image[spot_size] == 0x31 && image[spot_size + 1] == 0xc0 &&
+                  image[spot_size + 2] == 0xb4 &&
+                  unsigned(image[spot_size + 3]) * 256 == spot_base, "selected spotlight base instruction");
+            for (unsigned i = 0; i < 4; ++i) {
+                Check(radius_at(point_radius) / float(point_base >> i) == 0.25f * 3.2f / float(256u >> i),
+                      "selected point tiers preserve quarter-stock normalized softness");
+                Check(radius_at(spot_radius) / float(spot_base >> i) == 0.25f * 3.2f / float(512u >> i),
+                      "selected spotlight tiers preserve quarter-stock normalized softness");
+            }
+        }
+        std::memcpy(image.data() + size_at, read, 5);
+        std::memcpy(image.data() + spot_size, spot_read, 4);
+        reset_radii();
+        Check(image == local_original, "local dropdown changes only sizes and successful light-type radii");
+    }
+    BbSettings::Get().graphics_local_shadow_resolution = 2;
+    constexpr std::uint8_t range_entry[] = {
+        0xc5, 0xf8, 0x28, 0x02, 0xc5, 0xf8, 0x29, 0x06, 0xc5, 0xf8, 0x28, 0x42, 0x10,
+        0xc5, 0xf8, 0x29, 0x46, 0x10};
+    constexpr std::uint8_t range_stores[] = {
+        0xc5, 0xfa, 0x11, 0x46, 0x54, 0xc5, 0xf2, 0x5d, 0x42, 0x58, 0xc5, 0xfa, 0x11, 0x46, 0x58, 0xc3};
+    std::memcpy(image.data() + range, range_entry, sizeof range_entry);
+    std::memcpy(image.data() + tail, range_stores, sizeof range_stores);
+    Check(BbEngine::Graphics::DirectionalShadowBlend() == 0, "blending is off before native overlap");
+    Directional(true);
+    Check(!BbEngine::Graphics::InstallDirectionalShadows(nullptr, image.size()), "null cascade image refused");
+    Check(!BbEngine::Graphics::InstallDirectionalShadows(image.data(), tail + 14),
+          "truncated cascade stores refused");
+    for (const auto at : {range, tail, tail + 14}) {
+        image[at] ^= 1;
+        Check(!BbEngine::Graphics::InstallDirectionalShadows(image.data(), image.size()) &&
+              BbEngine::Graphics::DirectionalShadowBlend() == 0, "foreign cascade code cannot enable blending");
+        image[at] ^= 1;
+    }
+    Directional(false);
+    Check(!BbEngine::Graphics::InstallDirectionalShadows(image.data(), image.size()),
+          "overlap stays off unless an effect asks for it");
+    Directional(true);
+    Check(BbEngine::Graphics::InstallDirectionalShadows(image.data(), image.size()) &&
+          BbEngine::Graphics::DirectionalShadowBlend() == 0.1f, "guarded overlap enables matching blend band");
+    auto* tail_page = reinterpret_cast<void*>(
+        reinterpret_cast<std::uintptr_t>(image.data() + tail) & ~std::uintptr_t(4095));
+#ifdef _WIN32
+    DWORD old_protection = 0;
+    const bool executable = VirtualProtect(tail_page, 4096, PAGE_EXECUTE_READWRITE, &old_protection) != 0;
+#else
+    const bool executable = mprotect(tail_page, 4096, PROT_READ | PROT_WRITE | PROT_EXEC) == 0;
+#endif
+    Check(executable, "cascade tail test is executable");
+    if (executable) {
+        alignas(16) std::array<std::uint8_t, 0x700> owner{};
+        alignas(16) std::array<float, 36> camera{}, output{};
+        const float split0 = 20, split1 = 40;
+        std::memcpy(owner.data() + 0x6dc, &split0, 4);
+        std::memcpy(owner.data() + 0x6e0, &split1, 4);
+        camera[0x54 / 4] = 0.05f;
+        camera[0x58 / 4] = 600;
+        using Tail = void (__attribute__((sysv_abi)) *)(void*, void*, void*, void*, unsigned, float, float);
+        const auto run = reinterpret_cast<Tail>(image.data() + tail);
+        const std::array<float, 4> starts{0.05f, 20, 40, 150};
+        const std::array<float, 4> expected_near{0.05f, 18, 38, 139};
+        for (unsigned c = 0; c < 4; ++c) {
+            run(owner.data(), output.data(), camera.data(), nullptr, c, starts[c], 800);
+            Check(output[0x54 / 4] == expected_near[c], "executed hook expands exactly the shader blend interval");
+            Check(output[0x58 / 4] == 600, "native far-camera clamp is preserved");
+        }
+        camera[0x54 / 4] = 19;
+        run(owner.data(), output.data(), camera.data(), nullptr, 1, 20, 40);
+        Check(output[0x54 / 4] == 19, "overlap cannot extend behind camera near plane");
+#ifdef _WIN32
+        DWORD ignored = 0;
+        VirtualProtect(tail_page, 4096, old_protection, &ignored);
+#else
+        mprotect(tail_page, 4096, PROT_READ | PROT_WRITE);
+#endif
+    }
+    constexpr std::size_t table = 0x48a9668, selection = 0xeac238;
+    constexpr std::uint32_t native_sizes[] = {2048, 1024, 2048, 4096};
+    constexpr std::uint8_t select_code[] = {
+        0xb8, 0x00, 0x08, 0x00, 0x00, 0x48, 0x83, 0xf9, 0x03, 0x77, 0x0a,
+        0x48, 0x8d, 0x05, 0x1e, 0xd4, 0x9f, 0x03, 0x8b, 0x04, 0x88};
+    const auto reset_atlas = [&] {
+        std::memcpy(image.data() + table, native_sizes, sizeof native_sizes);
+        std::memcpy(image.data() + selection, select_code, sizeof select_code);
+    };
+    reset_atlas();
+    Check(!BbEngine::Graphics::InstallDirectionalShadowResolution(nullptr, image.size()),
+          "null atlas allocation image refused");
+    Check(!BbEngine::Graphics::InstallDirectionalShadowResolution(image.data(), table + sizeof native_sizes - 1),
+          "truncated atlas table refused");
+    for (const auto at : {table, table + sizeof native_sizes - 1, selection, selection + sizeof select_code - 1}) {
+        image[at] ^= 1;
+        const auto before = image;
+        Check(!BbEngine::Graphics::InstallDirectionalShadowResolution(image.data(), image.size()) &&
+              image == before, "foreign atlas table and selection code refused without writes");
+        image[at] ^= 1;
+    }
+    const auto atlas_original = image;
+    alignas(4096) std::array<std::uint8_t, 4096> selection_test{};
+#ifdef _WIN32
+    DWORD selection_protection = 0;
+    const bool selection_executable = VirtualProtect(selection_test.data(), selection_test.size(),
+        PAGE_EXECUTE_READWRITE, &selection_protection) != 0;
+#else
+    const bool selection_executable = mprotect(selection_test.data(), selection_test.size(),
+        PROT_READ | PROT_WRITE | PROT_EXEC) == 0;
+#endif
+    Check(selection_executable, "atlas selection test is executable");
+    reset_atlas();
+    BbSettings::Get().graphics_shadow_resolution = 0;
+    Check(!BbEngine::Graphics::InstallDirectionalShadowResolution(image.data(), image.size()) &&
+          image == atlas_original, "the game's own atlas changes no bytes");
+    for (int quality = 1; quality < 3; ++quality) {
+        reset_atlas();
+        BbSettings::Get().graphics_shadow_resolution = quality;
+        Check(BbEngine::Graphics::InstallDirectionalShadowResolution(image.data(), image.size()),
+              "atlas quality accepted");
+        const std::uint32_t expected_atlas = 2048u << quality;
+        std::array<std::uint32_t, 4> actual{};
+        std::memcpy(actual.data(), image.data() + table, sizeof actual);
+        for (auto dimension : actual) Check(dimension == expected_atlas, "all map quality entries use requested atlas");
+        std::uint32_t fallback = 0;
+        std::memcpy(&fallback, image.data() + selection + 1, sizeof fallback);
+        Check(fallback == expected_atlas, "out-of-range native selector uses requested atlas too");
+        if (selection_executable) {
+            std::memcpy(selection_test.data(), image.data() + selection, sizeof select_code);
+            selection_test[sizeof select_code] = 0xc3;
+            std::memcpy(selection_test.data() + 256, actual.data(), sizeof actual);
+
+            const std::int32_t displacement = 256 - 18;
+            std::memcpy(selection_test.data() + 14, &displacement, sizeof displacement);
+            using Select = unsigned (__attribute__((sysv_abi)) *)(void*, void*, void*, std::int64_t);
+            const auto select = reinterpret_cast<Select>(selection_test.data());
+            for (std::int64_t profile : {-1, 0, 1, 2, 3, 4})
+                Check(select(nullptr, nullptr, nullptr, profile) == expected_atlas,
+                      "executed native selection handles every map profile and fallback");
+        }
+        reset_atlas();
+        Check(image == atlas_original, "atlas upgrade changes only resolution table and fallback immediate");
+    }
+#ifdef _WIN32
+    DWORD selection_ignored = 0;
+    if (selection_executable)
+        VirtualProtect(selection_test.data(), selection_test.size(), selection_protection, &selection_ignored);
+#else
+    if (selection_executable)
+        mprotect(selection_test.data(), selection_test.size(), PROT_READ | PROT_WRITE);
+#endif
+    if (failures) return 1;
+    std::puts("Native local shadows: PASS (point and spotlight code guards, independent opt-outs, "
+              "1024/2048 bases, four tiers, instruction execution, isolated writes, combined install, "
+              "guarded per-type softness and quarter-stock filter footprints, "
+              "directional cascade overlap and 2048/4096/8192 atlas selection)");
+    return 0;
+}

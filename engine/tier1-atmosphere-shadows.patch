new file mode 100644
--- /dev/null
+++ b/tests/test_shadow_context.cpp
@@ -0,0 +1,49 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Owned instruction fixture: a mid-function cascade hook must keep RAX and edit only saved XMM0.
+#include "gpu/shim/engine/engine_hooks.h"
+#include <array>
+#include <cassert>
+#include <cstdio>
+#include <cstring>
+#ifdef _WIN32
+#include <windows.h>
+#else
+#include <sys/mman.h>
+#endif
+static std::int64_t __attribute__((sysv_abi)) Callback(std::uint64_t, const std::uint64_t* saved) {
+    double x=0;
+    std::memcpy(&x,BbEngine::SavedContextXmm(saved,0),sizeof x);
+    x+=1;
+    std::memcpy(const_cast<std::uint8_t*>(BbEngine::SavedContextXmm(saved,0)),&x,sizeof x);
+    __asm__ volatile("xorps %%xmm0, %%xmm0" ::: "xmm0");
+    return 0;
+}
+int main() {
+#ifdef _WIN32
+    auto* code=static_cast<std::uint8_t*>(VirtualAlloc(nullptr,4096,MEM_RESERVE|MEM_COMMIT,PAGE_EXECUTE_READWRITE));
+#else
+    auto* code=static_cast<std::uint8_t*>(mmap(nullptr,4096,PROT_READ|PROT_WRITE|PROT_EXEC,MAP_PRIVATE|MAP_ANONYMOUS,-1,0));
+    if(code==MAP_FAILED) return 1;
+#endif
+    assert(code);
+    constexpr std::uint64_t magic=0x1234567812345678ull;
+    code[0]=0x48; code[1]=0xb8; std::memcpy(code+2,&magic,8); // movabs rax,magic
+    std::array<std::uint8_t,14> displaced; displaced.fill(0x90);
+    std::memcpy(code+10,displaced.data(),displaced.size());
+    const std::uint8_t tail[]={0x48,0x89,0x07,0xc3}; // mov [rdi],rax; ret
+    std::memcpy(code+24,tail,sizeof tail);
+    BbEngine::Hook hook;
+    assert(BbEngine::Prepare(hook,code,4096,10,displaced,Callback,true));
+    BbEngine::Commit(std::span<BbEngine::Hook>{&hook,1});
+    using Fn=double (__attribute__((sysv_abi)) *)(std::uint64_t*,double);
+    std::uint64_t actual=0;
+    const double result=reinterpret_cast<Fn>(code)(&actual,2.5);
+    assert(result==3.5 && actual==magic);
+    BbEngine::Discard(hook);
+#ifdef _WIN32
+    VirtualFree(code,0,MEM_RELEASE);
+#else
+    munmap(code,4096);
+#endif
+    std::puts("PASS: opt-in shadow hook preserves incoming RAX and applies saved XMM0 edit");
+}

diff --git a/gpu/shim/bbport_guest_hooks_win.cpp b/gpu/shim/bbport_guest_hooks_win.cpp
new file mode 100644
index 0000000..bfb7d51
--- /dev/null
+++ b/gpu/shim/bbport_guest_hooks_win.cpp
@@ -0,0 +1,183 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+// bbport: the hooks of bbport_guest_hooks.cpp (the game's resource copies and GPU memory
+// allocators, for BB_GUEST_IN_PLACE) on Windows: the same sites, each checked byte for byte, an
+// int3 there and a vectored exception handler instead of SIGTRAP. Each site is a call, a return or
+// a function entry, so nothing live lies below the stack pointer where Windows builds the
+// exception frame (the System V red zone of the game's code).
+#ifdef _WIN32
+#include "bbport_guest_hooks.h"
+#include "bbport_heap_sites.h"
+#include "bbport_toggles.h"
+
+#include <array>
+#include <atomic>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <windows.h>
+
+extern "C" void runtime_memory_note_write(uintptr_t address, uint64_t size);
+
+namespace BbGuestHooks {
+namespace {
+using u64 = std::uint64_t;
+constexpr u64 ImageBase = 0x800000000ull;
+
+// The sites and their code: see bbport_guest_hooks.cpp, which documents each.
+constexpr u64 AllocReturn = 0x26aa255;
+constexpr unsigned char AllocReturnCode[4] = {0x48, 0x83, 0xc4, 0x18};
+RangeCallback on_range_allocated = nullptr;
+constexpr std::array<u64, 3> HeapAllocReturns = {0x11e6629, 0x11e6736, 0x11e6846};
+constexpr unsigned char HeapAllocReturnCode[3] = {0x48, 0x89, 0xc3};
+constexpr u64 CollectorEntry = 0x26aa860;
+constexpr unsigned char CollectorEntryCode[1] = {0x55};
+constexpr u64 ReleaseCheck = 0xbb5fb0;
+constexpr unsigned char ReleaseCheckCode[2] = {0x78, 0x15};
+struct CallSite {
+    u64 offset;
+    unsigned char code[5];
+};
+constexpr std::array<CallSite, 2> MemcpySites = {{
+    {0x216d5ea, {0xe8, 0xc1, 0xcb, 0x4a, 0x00}},
+    {0x2171fea, {0xe8, 0xc1, 0x81, 0x4a, 0x00}},
+}};
+std::array<std::atomic<u64>, MemcpySites.size()> hits{};
+
+/// The game's memcpy at those sites (called by the game: System V), then the GPU side is told.
+__attribute__((sysv_abi)) void* LoaderCopy(void* dst, const void* src, std::size_t size) {
+    std::memcpy(dst, src, size);
+    runtime_memory_note_write(reinterpret_cast<u64>(dst), size);
+    return dst;
+}
+
+LONG CALLBACK OnBreakpoint(EXCEPTION_POINTERS* info) {
+    if (info->ExceptionRecord->ExceptionCode != EXCEPTION_BREAKPOINT) {
+        return EXCEPTION_CONTINUE_SEARCH;
+    }
+    CONTEXT& c = *info->ContextRecord;
+    const u64 rip = reinterpret_cast<u64>(info->ExceptionRecord->ExceptionAddress); // the int3
+    if (rip < ImageBase || rip >= ImageBase + 0x10000000) {
+        return EXCEPTION_CONTINUE_SEARCH;
+    }
+    if (rip == ImageBase + ReleaseCheck) {
+        const auto result = static_cast<std::int32_t>(c.Rax & 0xffffffff);
+        BbHeapSites::NoteReleaseCheck(std::uint32_t(result));
+        c.Rip = ImageBase + (result < 0 ? 0xbb5fc7 : ReleaseCheck + 2);
+        return EXCEPTION_CONTINUE_EXECUTION;
+    }
+    if (rip == ImageBase + CollectorEntry) {
+        const u64 allocator = c.Rdi;
+        for (std::size_t i = 0; i < BbStats::range_allocators.size(); ++i) {
+            u64 expected = 0;
+            if (BbStats::range_allocators[i].load(std::memory_order_relaxed) == allocator ||
+                BbStats::range_allocators[i].compare_exchange_strong(expected, allocator)) {
+                BbStats::range_live[i].store(*reinterpret_cast<const u64*>(allocator + 0xc8),
+                                             std::memory_order_relaxed);
+                BbStats::range_bytes[i].store(*reinterpret_cast<const u64*>(allocator + 0xd0),
+                                              std::memory_order_relaxed);
+                break;
+            }
+        }
+        c.Rsp -= 8; // push rbp
+        *reinterpret_cast<u64*>(c.Rsp) = c.Rbp;
+        c.Rip = ImageBase + CollectorEntry + 1;
+        return EXCEPTION_CONTINUE_EXECUTION;
+    }
+    for (const u64 site : HeapAllocReturns) {
+        if (rip != ImageBase + site) {
+            continue;
+        }
+        const u64 address = c.Rax;
+        const u64 size = *reinterpret_cast<const u64*>(c.Rbp - 0x50);
+        if (address != 0 && size != 0 && size < (u64(1) << 32) && on_range_allocated) {
+            on_range_allocated(address, size);
+        }
+        c.Rbx = c.Rax;
+        c.Rip = ImageBase + site + sizeof(HeapAllocReturnCode);
+        return EXCEPTION_CONTINUE_EXECUTION;
+    }
+    if (rip == ImageBase + AllocReturn) {
+        if (const u64 node = c.Rax; node && on_range_allocated) {
+            const u64 start = *reinterpret_cast<const u64*>(node + 8);
+            const u64 next = *reinterpret_cast<const u64*>(node + 0x18);
+            const u64 end = next ? *reinterpret_cast<const u64*>(next + 8) : start;
+            if (end > start && end - start < (u64(1) << 32)) {
+                on_range_allocated(start, end - start);
+            }
+        }
+        c.Rsp += 0x18;
+        c.Rip = ImageBase + AllocReturn + sizeof(AllocReturnCode);
+        return EXCEPTION_CONTINUE_EXECUTION;
+    }
+    for (std::size_t i = 0; i < MemcpySites.size(); ++i) {
+        const auto& site = MemcpySites[i];
+        if (rip != ImageBase + site.offset) {
+            continue;
+        }
+        hits[i].fetch_add(1, std::memory_order_relaxed);
+        // The call, to LoaderCopy instead of the game's memcpy: push the return address, jump.
+        c.Rsp -= 8;
+        *reinterpret_cast<u64*>(c.Rsp) = ImageBase + site.offset + 5;
+        c.Rip = reinterpret_cast<u64>(&LoaderCopy);
+        return EXCEPTION_CONTINUE_EXECUTION;
+    }
+    return EXCEPTION_CONTINUE_SEARCH;
+}
+
+bool Patch(u64 address, const unsigned char* expected, std::size_t size) {
+    auto* code = reinterpret_cast<unsigned char*>(address);
+    MEMORY_BASIC_INFORMATION mbi{};
+    if (VirtualQuery(code, &mbi, sizeof(mbi)) == 0 || mbi.State != MEM_COMMIT ||
+        std::memcmp(code, expected, size) != 0) {
+        return false;
+    }
+    DWORD old = 0;
+    if (!VirtualProtect(code, size, PAGE_EXECUTE_READWRITE, &old)) {
+        return false;
+    }
+    __atomic_store_n(code, static_cast<unsigned char>(0xcc), __ATOMIC_SEQ_CST);
+    VirtualProtect(code, size, old, &old);
+    FlushInstructionCache(GetCurrentProcess(), code, size);
+    return true;
+}
+} // namespace
+
+void Install(RangeCallback on_gpu_range_allocated) {
+    static std::atomic<bool> installed{false};
+    if (installed.exchange(true)) {
+        return;
+    }
+    on_range_allocated = on_gpu_range_allocated;
+    // First in line: the engine's fault handlers see no breakpoints of ours.
+    AddVectoredExceptionHandler(1, &OnBreakpoint);
+    int patched = 0;
+    for (const auto& site : MemcpySites) {
+        patched += Patch(ImageBase + site.offset, site.code, sizeof(site.code));
+    }
+    std::printf("Guest hooks: %d of %zu resource copy sites tell the GPU side of their writes\n",
+                patched, MemcpySites.size());
+    const bool allocator = Patch(ImageBase + AllocReturn, AllocReturnCode, sizeof(AllocReturnCode));
+    const char* heap_env = std::getenv("BB_HEAP_HOOKS");
+    const bool heap_hooks = !heap_env || heap_env[0] != '0';
+    if (BbStats::enabled) {
+        Patch(ImageBase + CollectorEntry, CollectorEntryCode, sizeof(CollectorEntryCode));
+    }
+    int heap_sites = 0;
+    for (const u64 site : HeapAllocReturns) {
+        if (!heap_hooks) {
+            break;
+        }
+        heap_sites += Patch(ImageBase + site, HeapAllocReturnCode, sizeof(HeapAllocReturnCode));
+    }
+    std::printf("Guest hooks: GPU heap allocations seen at %d of %zu call sites\n", heap_sites,
+                HeapAllocReturns.size());
+    std::printf("Guest hooks: GPU memory allocator %s\n",
+                allocator ? "tells the GPU side of new ranges" : "not found");
+    BbHeapSites::Install();
+    if (const char* env = std::getenv("BB_HEAP_SITES"); env && env[0] == '1') {
+        Patch(ImageBase + ReleaseCheck, ReleaseCheckCode, sizeof(ReleaseCheckCode));
+    }
+}
+} // namespace BbGuestHooks
+#endif
diff --git a/gpu/shim/bbport_guest_memory_win.cpp b/gpu/shim/bbport_guest_memory_win.cpp
new file mode 100644
index 0000000..bd6dbe9
--- /dev/null
+++ b/gpu/shim/bbport_guest_memory_win.cpp
@@ -0,0 +1,249 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+// bbport: the PC memory model on Windows (BB_GUEST_IN_PLACE=1). The game's memory is a pagefile
+// section (src/win32_memory.c) the runtime also maps whole as its backing view; direct memory phys
+// lives at backing + phys in every view of it. Here the GPU imports that view in 256 MiB chunks
+// (VK_EXT_external_memory_host), each when the GPU side first asks for it (Find): the GPU then
+// reads and writes the game's memory in place, with no page protection, write faults or uploads.
+// tools/host_import_probe_win.cpp checks a driver by hand (CPU and GPU see each other's writes in
+// every view; imports at any 4 KiB offset; the arena binds them).
+#ifdef _WIN32
+#include "bbport_guest_memory.h"
+
+#include <array>
+#include <atomic>
+#include <cstdio>
+#include <cstdlib>
+#include <mutex>
+#include <thread>
+#include <windows.h>
+#include "video_core/renderer_vulkan/vk_instance.h"
+
+extern "C" unsigned char* runtime_memory_backing(uint64_t* direct_size);
+
+namespace BbGuestMemory {
+namespace {
+using u64 = std::uint64_t;
+constexpr u64 ChunkSize = u64(256) << 20;
+constexpr std::size_t MaxChunks = 256;
+
+const Vulkan::Instance* vk_instance = nullptr;
+std::uint32_t import_types = 0; // memory types a host import may use (from the self-test)
+std::mutex mutex;
+std::array<Chunk*, MaxChunks> chunks{}; // by chunk number: phys / ChunkSize
+std::array<bool, MaxChunks> failed{};
+std::atomic<u64> chunk_bytes{0};
+
+constexpr auto ChunkUsage =
+    vk::BufferUsageFlagBits::eTransferSrc | vk::BufferUsageFlagBits::eTransferDst |
+    vk::BufferUsageFlagBits::eStorageBuffer | vk::BufferUsageFlagBits::eUniformBuffer |
+    vk::BufferUsageFlagBits::eVertexBuffer | vk::BufferUsageFlagBits::eIndexBuffer |
+    vk::BufferUsageFlagBits::eIndirectBuffer;
+
+std::uint32_t PickType(std::uint32_t bits) {
+    const auto props = vk_instance->GetPhysicalDevice().getMemoryProperties();
+    for (std::uint32_t i = 0; i < props.memoryTypeCount; ++i) {
+        if ((bits & (1u << i)) &&
+            (props.memoryTypes[i].propertyFlags & vk::MemoryPropertyFlagBits::eHostVisible)) {
+            return i;
+        }
+    }
+    return ~0u;
+}
+
+/// A buffer over `size` bytes of host memory at `pointer`, imported; false (nothing kept) if not.
+bool Import(void* pointer, u64 size, vk::Buffer& buffer, vk::DeviceMemory& memory,
+            const char** failed_step) {
+    const vk::Device dev = vk_instance->GetDevice();
+    const auto [props_result, props] = dev.getMemoryHostPointerPropertiesEXT(
+        vk::ExternalMemoryHandleTypeFlagBits::eHostAllocationEXT, pointer);
+    const std::uint32_t type = props_result == vk::Result::eSuccess
+                                   ? PickType(props.memoryTypeBits & (import_types ? import_types : ~0u))
+                                   : ~0u;
+    if (type == ~0u) {
+        *failed_step = "the driver's host pointer check";
+        return false;
+    }
+    const vk::ExternalMemoryBufferCreateInfo external{
+        .handleTypes = vk::ExternalMemoryHandleTypeFlagBits::eHostAllocationEXT,
+    };
+    const auto [buffer_result, made] = dev.createBuffer({
+        .pNext = &external,
+        .size = size,
+        .usage = ChunkUsage,
+        .sharingMode = vk::SharingMode::eExclusive,
+    });
+    if (buffer_result != vk::Result::eSuccess) {
+        *failed_step = "buffer creation";
+        return false;
+    }
+    const vk::ImportMemoryHostPointerInfoEXT import_info{
+        .handleType = vk::ExternalMemoryHandleTypeFlagBits::eHostAllocationEXT,
+        .pHostPointer = pointer,
+    };
+    const auto [memory_result, imported] = dev.allocateMemory({
+        .pNext = &import_info,
+        .allocationSize = size,
+        .memoryTypeIndex = type,
+    });
+    if (memory_result != vk::Result::eSuccess) {
+        dev.destroyBuffer(made);
+        *failed_step = "the import";
+        return false;
+    }
+    if (dev.bindBufferMemory(made, imported, 0) != vk::Result::eSuccess) {
+        dev.freeMemory(imported);
+        dev.destroyBuffer(made);
+        *failed_step = "binding";
+        return false;
+    }
+    buffer = made;
+    memory = imported;
+    return true;
+}
+} // namespace
+
+bool PcModelGpu(const Vulkan::Instance& instance) {
+    static const bool ok = [&] {
+        if (instance.GetVendorID() != 0x1002) {
+            std::printf("Guest memory: the PC memory model on this GPU (vendor 0x%04x) is new; "
+                        "\"Write fault sites\" name writers its hooks miss\n",
+                        instance.GetVendorID());
+        }
+        return true;
+    }();
+    return ok;
+}
+
+bool Usable(const Vulkan::Instance& instance) {
+    static const bool usable = [&] {
+        if (!instance.IsGuestMemoryImportSupported()) {
+            std::printf("Guest memory: the driver cannot import system memory "
+                        "(VK_EXT_external_memory_host)\n");
+            return false;
+        }
+        vk_instance = &instance;
+        // A section view, as the game's memory is: imported, then dropped.
+        constexpr u64 Size = 2 << 20;
+        HANDLE section = CreateFileMappingW(INVALID_HANDLE_VALUE, nullptr, PAGE_READWRITE, 0,
+                                            DWORD(Size), nullptr);
+        void* view = section ? MapViewOfFile(section, FILE_MAP_ALL_ACCESS, 0, 0, Size) : nullptr;
+        vk::Buffer buffer;
+        vk::DeviceMemory memory;
+        const char* step = "mapping a test section";
+        const bool imported = view && Import(view, Size, buffer, memory, &step);
+        if (imported) {
+            const vk::Device dev = instance.GetDevice();
+            // The arena (a sparse buffer) binds this memory at its blocks. Outside the types the
+            // arena lists the binding is outside the spec; NVIDIA's driver binds it all the same
+            // (tools/host_import_probe_win.cpp checks the data), so it is reported, not refused.
+            const auto [arena_result, arena] = dev.createBuffer({
+                .flags = vk::BufferCreateFlagBits::eSparseBinding |
+                         vk::BufferCreateFlagBits::eSparseResidency,
+                .size = u64(1) << 30,
+                .usage = ChunkUsage,
+                .sharingMode = vk::SharingMode::eExclusive,
+            });
+            if (arena_result == vk::Result::eSuccess) {
+                const auto arena_types = dev.getBufferMemoryRequirements(arena).memoryTypeBits;
+                const auto [props_result, props] = dev.getMemoryHostPointerPropertiesEXT(
+                    vk::ExternalMemoryHandleTypeFlagBits::eHostAllocationEXT, view);
+                import_types = props_result == vk::Result::eSuccess ? props.memoryTypeBits : 0;
+                if ((arena_types & import_types) == 0) {
+                    std::printf("Guest memory: the arena lists no memory type a host import may "
+                                "use (0x%x, imports 0x%x): its blocks are bound to imports anyway, "
+                                "outside the Vulkan spec\n",
+                                arena_types, import_types);
+                }
+                dev.destroyBuffer(arena);
+            }
+            dev.destroyBuffer(buffer);
+            dev.freeMemory(memory);
+        } else {
+            std::printf("Guest memory: importing a section view failed at %s\n", step);
+            vk_instance = nullptr; // Find imports nothing
+        }
+        if (view) {
+            UnmapViewOfFile(view);
+        }
+        if (section) {
+            CloseHandle(section);
+        }
+        return imported;
+    }();
+    return usable;
+}
+
+void Install(const Vulkan::Instance& instance) {
+    // Nothing to hand the runtime: its pool section already holds direct memory; chunks are
+    // imported on demand (Find). Usable() ran the self-test and set vk_instance.
+    const char* in_place = std::getenv("BB_GUEST_IN_PLACE");
+    if (!(in_place && in_place[0] == '1') || !Usable(instance)) {
+        return;
+    }
+    std::printf("Guest memory: the GPU imports the game's memory in %llu MiB chunks as it uses "
+                "them (VK_EXT_external_memory_host)\n",
+                (unsigned long long)(ChunkSize >> 20));
+}
+
+namespace {
+std::array<bool, MaxChunks> queued{};
+
+/// Imports chunk n on a thread of its own: an import pins every page of 256 MiB (65536 page
+/// faults, up to a second). Inline on the draw thread it froze the first frame after a load for
+/// 2.8 s (three chunks at once).
+void ImportChunk(u64 n) {
+    u64 direct_size = 0;
+    unsigned char* backing = runtime_memory_backing(&direct_size);
+    const u64 size = std::min(ChunkSize, direct_size - n * ChunkSize);
+    vk::Buffer buffer;
+    vk::DeviceMemory memory;
+    const char* step = "";
+    if (!Import(backing + n * ChunkSize, size, buffer, memory, &step)) {
+        {
+            std::scoped_lock lk{mutex};
+            failed[n] = true;
+        }
+        static std::atomic<int> reports{0};
+        if (reports++ < 4) {
+            std::fprintf(stderr, "Guest memory: importing direct memory %#llx+%llu MiB failed at "
+                         "%s; it stays copied as before\n",
+                         (unsigned long long)(n * ChunkSize), (unsigned long long)(size >> 20), step);
+        }
+        return;
+    }
+    auto* chunk = new Chunk{n * ChunkSize, size, buffer, memory, 0};
+    {
+        std::scoped_lock lk{mutex};
+        static std::uint32_t next_index = 0;
+        chunk->index = next_index++;
+        chunks[n] = chunk;
+    }
+    const u64 total = chunk_bytes.fetch_add(size) + size;
+    std::printf("Guest memory: direct memory %#llx+%llu MiB imported for the GPU, %llu MiB so far\n",
+                (unsigned long long)(n * ChunkSize), (unsigned long long)(size >> 20),
+                (unsigned long long)(total >> 20));
+}
+} // namespace
+
+const Chunk* Find(std::uint64_t phys) {
+    if (!vk_instance) {
+        return nullptr;
+    }
+    const u64 n = phys / ChunkSize;
+    if (n >= MaxChunks) {
+        return nullptr;
+    }
+    std::scoped_lock lk{mutex};
+    if (chunks[n] || failed[n] || queued[n]) {
+        return chunks[n]; // null while the import runs: the block keeps a VRAM copy meanwhile
+    }
+    u64 direct_size = 0;
+    if (!runtime_memory_backing(&direct_size) || n * ChunkSize >= direct_size) {
+        return nullptr; // no pool yet, or not direct memory: asked again later
+    }
+    queued[n] = true;
+    std::thread([n] { ImportChunk(n); }).detach();
+    return nullptr;
+}
+} // namespace BbGuestMemory
+#endif

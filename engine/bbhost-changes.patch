+bool DlssPresetValid(int preset) {
+    // NVSDK_NGX_DLSS_Hint_Render_Preset (DLSS SDK 310.9): E, F, J, K, L, M.
+    return preset == DlssPresetDefault || preset == 5 || preset == 6 || (preset >= 10 && preset <= 13);

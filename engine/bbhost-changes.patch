diff --git a/tools/fetch_streamline.sh b/tools/fetch_streamline.sh
new file mode 100644
index 0000000..6e6b26d
--- /dev/null
+++ b/tools/fetch_streamline.sh
@@ -0,0 +1,47 @@
+#!/usr/bin/env bash
+# Downloads NVIDIA Streamline's runtime for DLSS Frame Generation (frame_gen=dlss,
+# docs/dlss_frame_generation.md) from NVIDIA's release of the Streamline SDK
+# (github.com/NVIDIA-RTX/Streamline): sl.interposer.dll and the DLSS-G, Reflex and PCL plugins
+# (MIT, license.txt there), nvngx_dlssg.dll (the NVIDIA RTX SDKs licence,
+# nvngx_dlss.license.txt) and NvLowLatencyVk.dll (reflex.license.txt). They are not part of this
+# repository. The engine loads them from next to the executable (out/ by default) or
+# BB_STREAMLINE_DIR, only with frame_gen=dlss. Windows x64 only; production (unwatermarked) builds.
+# The package ships the three licence texts in engine\licenses (package-template): build.ps1 keeps
+# only programs in engine\out.
+set -euo pipefail
+cd -- "$(dirname -- "$0")/.."
+version=v2.14.16
+dest=${1:-out}
+files=(sl.interposer.dll sl.common.dll sl.dlss_g.dll sl.reflex.dll sl.pcl.dll nvngx_dlssg.dll
+       NvLowLatencyVk.dll nvngx_dlss.license.txt reflex.license.txt)
+mkdir -p "$dest"
+missing=0
+for file in "${files[@]}"; do
+    [[ -s $dest/$file ]] || missing=1
+done
+if [[ $missing == 0 ]]; then
+    echo "Streamline: $dest has the $version runtime"
+    exit 0
+fi
+work=$(mktemp -d)
+trap 'rm -rf -- "$work"' EXIT
+# The whole SDK (about 280 MB); only the runtime files above are kept.
+curl -fSL --retry 3 -o "$work/sdk.zip" \
+    "https://github.com/NVIDIA-RTX/Streamline/releases/download/$version/streamline-sdk-$version.zip"
+# python3, or python where python3 is only the Windows Store stub.
+py=python3
+"$py" -c '' 2>/dev/null || py=python
+"$py" - "$work/sdk.zip" "$dest" "${files[@]}" <<'EOF'
+import os, sys, zipfile
+archive, dest, names = sys.argv[1], sys.argv[2], sys.argv[3:]
+with zipfile.ZipFile(archive) as z:
+    for name in names:
+        data = z.read('bin/x64/' + name)
+        part = os.path.join(dest, name + '.part')
+        with open(part, 'wb') as f:
+            f.write(data)
+        os.replace(part, os.path.join(dest, name))
+    with open(os.path.join(dest, 'LICENSE-Streamline.txt'), 'wb') as f:
+        f.write(z.read('license.txt'))
+EOF
+echo "Streamline: $version runtime in $dest"
diff --git a/tools/host_import_probe_win.cpp b/tools/host_import_probe_win.cpp
new file mode 100644
index 0000000..14a3316
--- /dev/null
+++ b/tools/host_import_probe_win.cpp
@@ -0,0 +1,188 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+// Windows probe for the PC memory model (step 6 of the direct path): can the GPU use the game's
+// section-backed memory in place? Mirrors src/win32_memory.c: a pagefile section, views placed with
+// MapViewOfFile3 into VirtualAlloc2 placeholders, a second (alias) view of the same pages.
+// Build: clang++ -O2 -std=c++20 host_import_probe_win.cpp -o bb-host-import-probe.exe -lvulkan-1
+#define WIN32_LEAN_AND_MEAN
+#include <windows.h>
+#include <vulkan/vulkan.h>
+#include <chrono>
+#include <cstdio>
+#include <cstring>
+#include <vector>
+
+typedef PVOID(WINAPI* VirtualAlloc2Fn)(HANDLE, PVOID, SIZE_T, ULONG, ULONG, MEM_EXTENDED_PARAMETER*, ULONG);
+typedef PVOID(WINAPI* MapViewOfFile3Fn)(HANDLE, HANDLE, PVOID, ULONG64, SIZE_T, ULONG, ULONG, MEM_EXTENDED_PARAMETER*, ULONG);
+
+#define CHECK(x) do { VkResult r_ = (x); if (r_ != VK_SUCCESS) { std::printf("FAIL %s -> %d\n", #x, r_); return 1; } } while (0)
+
+static uint32_t FindType(const VkPhysicalDeviceMemoryProperties& p, uint32_t bits, VkMemoryPropertyFlags want) {
+    for (uint32_t i = 0; i < p.memoryTypeCount; ++i)
+        if ((bits >> i & 1) && (p.memoryTypes[i].propertyFlags & want) == want) return i;
+    return ~0u;
+}
+
+int main() {
+    constexpr size_t Size = 64ull << 20;
+    HMODULE k = GetModuleHandleW(L"kernelbase.dll");
+    auto va2 = (VirtualAlloc2Fn)(void*)GetProcAddress(k, "VirtualAlloc2");
+    auto mv3 = (MapViewOfFile3Fn)(void*)GetProcAddress(k, "MapViewOfFile3");
+    HANDLE section = CreateFileMappingW(INVALID_HANDLE_VALUE, nullptr, PAGE_READWRITE, 0, (DWORD)Size, nullptr);
+    void* place = va2(GetCurrentProcess(), nullptr, Size, MEM_RESERVE | MEM_RESERVE_PLACEHOLDER, PAGE_NOACCESS, nullptr, 0);
+    auto* guest = (uint8_t*)mv3(section, GetCurrentProcess(), place, 0, Size, MEM_REPLACE_PLACEHOLDER, PAGE_READWRITE, nullptr, 0);
+    auto* alias = (uint8_t*)MapViewOfFile(section, FILE_MAP_ALL_ACCESS, 0, 0, Size);
+    if (!guest || !alias) { std::printf("FAIL mapping (%lu)\n", GetLastError()); return 1; }
+    std::printf("guest view %p, alias view %p\n", guest, alias);
+
+    VkApplicationInfo app{VK_STRUCTURE_TYPE_APPLICATION_INFO, nullptr, "hostimport", 1, nullptr, 0, VK_API_VERSION_1_3};
+    VkInstanceCreateInfo ici{VK_STRUCTURE_TYPE_INSTANCE_CREATE_INFO, nullptr, 0, &app};
+    VkInstance inst; CHECK(vkCreateInstance(&ici, nullptr, &inst));
+    uint32_t n = 0; vkEnumeratePhysicalDevices(inst, &n, nullptr);
+    std::vector<VkPhysicalDevice> pds(n); vkEnumeratePhysicalDevices(inst, &n, pds.data());
+    VkPhysicalDevice pd = VK_NULL_HANDLE;
+    for (auto d : pds) { VkPhysicalDeviceProperties p; vkGetPhysicalDeviceProperties(d, &p); if (p.deviceType == VK_PHYSICAL_DEVICE_TYPE_DISCRETE_GPU) { pd = d; std::printf("GPU %s\n", p.deviceName); } }
+    if (!pd) pd = pds[0];
+    VkPhysicalDeviceExternalMemoryHostPropertiesEXT hostp{VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_EXTERNAL_MEMORY_HOST_PROPERTIES_EXT};
+    VkPhysicalDeviceProperties2 p2{VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_PROPERTIES_2, &hostp};
+    vkGetPhysicalDeviceProperties2(pd, &p2);
+    std::printf("minImportedHostPointerAlignment %llu\n", (unsigned long long)hostp.minImportedHostPointerAlignment);
+
+    float prio = 1;
+    uint32_t qf = 0;
+    VkDeviceQueueCreateInfo qci{VK_STRUCTURE_TYPE_DEVICE_QUEUE_CREATE_INFO, nullptr, 0, qf, 1, &prio};
+    const char* exts[] = {VK_EXT_EXTERNAL_MEMORY_HOST_EXTENSION_NAME};
+    VkPhysicalDeviceFeatures feats{}; feats.sparseBinding = VK_TRUE; feats.sparseResidencyBuffer = VK_TRUE;
+    VkDeviceCreateInfo dci{VK_STRUCTURE_TYPE_DEVICE_CREATE_INFO, nullptr, 0, 1, &qci, 0, nullptr, 1, exts, &feats};
+    VkDevice dev; CHECK(vkCreateDevice(pd, &dci, nullptr, &dev));
+    auto getHostProps = (PFN_vkGetMemoryHostPointerPropertiesEXT)vkGetDeviceProcAddr(dev, "vkGetMemoryHostPointerPropertiesEXT");
+    VkPhysicalDeviceMemoryProperties mp; vkGetPhysicalDeviceMemoryProperties(pd, &mp);
+
+    VkExternalMemoryHandleTypeFlagBits types[] = {VK_EXTERNAL_MEMORY_HANDLE_TYPE_HOST_ALLOCATION_BIT_EXT,
+                                                  VK_EXTERNAL_MEMORY_HANDLE_TYPE_HOST_MAPPED_FOREIGN_MEMORY_BIT_EXT};
+    const char* names[] = {"host allocation", "host mapped foreign memory"};
+    int chosen = -1; uint32_t bits = 0;
+    for (int t = 0; t < 2; ++t) {
+        VkMemoryHostPointerPropertiesEXT hp{VK_STRUCTURE_TYPE_MEMORY_HOST_POINTER_PROPERTIES_EXT};
+        VkResult r = getHostProps(dev, types[t], guest, &hp);
+        std::printf("%s: result %d, memoryTypeBits 0x%x\n", names[t], r, hp.memoryTypeBits);
+        if (r == VK_SUCCESS && hp.memoryTypeBits && chosen < 0) { chosen = t; bits = hp.memoryTypeBits; }
+    }
+    if (chosen < 0) { std::printf("RESULT: the driver does not import section views\n"); return 2; }
+    const uint32_t type = FindType(mp, bits, VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT);
+    std::printf("import as %s, memory type %u (flags 0x%x)\n", names[chosen], type, mp.memoryTypes[type].propertyFlags);
+
+    // Import the guest view; a buffer over it.
+    VkExternalMemoryBufferCreateInfo ebci{VK_STRUCTURE_TYPE_EXTERNAL_MEMORY_BUFFER_CREATE_INFO, nullptr, (VkExternalMemoryHandleTypeFlags)types[chosen]};
+    VkBufferCreateInfo bci{VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO, &ebci, 0, Size,
+                           VK_BUFFER_USAGE_TRANSFER_SRC_BIT | VK_BUFFER_USAGE_TRANSFER_DST_BIT | VK_BUFFER_USAGE_STORAGE_BUFFER_BIT};
+    VkBuffer gbuf; CHECK(vkCreateBuffer(dev, &bci, nullptr, &gbuf));
+    VkImportMemoryHostPointerInfoEXT imp{VK_STRUCTURE_TYPE_IMPORT_MEMORY_HOST_POINTER_INFO_EXT, nullptr, types[chosen], guest};
+    VkMemoryAllocateInfo mai{VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO, &imp, Size, type};
+    VkDeviceMemory gmem; CHECK(vkAllocateMemory(dev, &mai, nullptr, &gmem));
+    CHECK(vkBindBufferMemory(dev, gbuf, gmem, 0));
+
+    // VRAM buffer for the copies and a timing baseline.
+    VkBufferCreateInfo vbci{VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO, nullptr, 0, Size,
+                            VK_BUFFER_USAGE_TRANSFER_SRC_BIT | VK_BUFFER_USAGE_TRANSFER_DST_BIT};
+    VkBuffer vbuf, vbuf2; CHECK(vkCreateBuffer(dev, &vbci, nullptr, &vbuf)); CHECK(vkCreateBuffer(dev, &vbci, nullptr, &vbuf2));
+    VkMemoryRequirements vr; vkGetBufferMemoryRequirements(dev, vbuf, &vr);
+    VkMemoryAllocateInfo vmai{VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO, nullptr, vr.size, FindType(mp, vr.memoryTypeBits, VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT)};
+    VkDeviceMemory vmem, vmem2; CHECK(vkAllocateMemory(dev, &vmai, nullptr, &vmem)); CHECK(vkAllocateMemory(dev, &vmai, nullptr, &vmem2));
+    CHECK(vkBindBufferMemory(dev, vbuf, vmem, 0)); CHECK(vkBindBufferMemory(dev, vbuf2, vmem2, 0));
+    // Readback buffer.
+    VkBuffer rbuf; CHECK(vkCreateBuffer(dev, &vbci, nullptr, &rbuf));
+    VkMemoryRequirements rr; vkGetBufferMemoryRequirements(dev, rbuf, &rr);
+    VkMemoryAllocateInfo rmai{VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO, nullptr, rr.size, FindType(mp, rr.memoryTypeBits, VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT | VK_MEMORY_PROPERTY_HOST_COHERENT_BIT | VK_MEMORY_PROPERTY_HOST_CACHED_BIT)};
+    VkDeviceMemory rmem; CHECK(vkAllocateMemory(dev, &rmai, nullptr, &rmem)); CHECK(vkBindBufferMemory(dev, rbuf, rmem, 0));
+    void* rmap; CHECK(vkMapMemory(dev, rmem, 0, Size, 0, &rmap));
+
+    VkQueue q; vkGetDeviceQueue(dev, qf, 0, &q);
+    VkCommandPoolCreateInfo cpci{VK_STRUCTURE_TYPE_COMMAND_POOL_CREATE_INFO, nullptr, VK_COMMAND_POOL_CREATE_RESET_COMMAND_BUFFER_BIT, qf};
+    VkCommandPool pool; CHECK(vkCreateCommandPool(dev, &cpci, nullptr, &pool));
+    VkCommandBufferAllocateInfo cbai{VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO, nullptr, pool, VK_COMMAND_BUFFER_LEVEL_PRIMARY, 1};
+    VkCommandBuffer cb; CHECK(vkAllocateCommandBuffers(dev, &cbai, &cb));
+    VkFenceCreateInfo fci{VK_STRUCTURE_TYPE_FENCE_CREATE_INFO};
+    VkFence fence; CHECK(vkCreateFence(dev, &fci, nullptr, &fence));
+    auto run = [&](auto&& record) -> double {
+        vkResetCommandBuffer(cb, 0);
+        VkCommandBufferBeginInfo bi{VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO, nullptr, VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT};
+        vkBeginCommandBuffer(cb, &bi);
+        record();
+        vkEndCommandBuffer(cb);
+        VkSubmitInfo si{VK_STRUCTURE_TYPE_SUBMIT_INFO, nullptr, 0, nullptr, nullptr, 1, &cb};
+        const auto t0 = std::chrono::steady_clock::now();
+        vkQueueSubmit(q, 1, &si, fence);
+        vkWaitForFences(dev, 1, &fence, VK_TRUE, UINT64_MAX);
+        vkResetFences(dev, 1, &fence);
+        return std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - t0).count();
+    };
+    auto barrier = [&] {
+        VkMemoryBarrier mb{VK_STRUCTURE_TYPE_MEMORY_BARRIER, nullptr, VK_ACCESS_TRANSFER_WRITE_BIT, VK_ACCESS_TRANSFER_READ_BIT | VK_ACCESS_TRANSFER_WRITE_BIT};
+        vkCmdPipelineBarrier(cb, VK_PIPELINE_STAGE_TRANSFER_BIT, VK_PIPELINE_STAGE_TRANSFER_BIT, 0, 1, &mb, 0, nullptr, 0, nullptr);
+    };
+    VkBufferCopy whole{0, 0, Size};
+    int failures = 0;
+
+    // 1. CPU writes through the guest view, the GPU reads them.
+    for (size_t i = 0; i < Size; i += 4) *(uint32_t*)(guest + i) = (uint32_t)(i * 2654435761u);
+    run([&] { vkCmdCopyBuffer(cb, gbuf, rbuf, 1, &whole); });
+    failures += std::memcmp(rmap, guest, Size) != 0;
+    std::printf("1 GPU reads CPU writes: %s\n", std::memcmp(rmap, guest, Size) ? "MISMATCH" : "ok");
+    // 2. CPU writes again through the ALIAS view: no re-import, no upload.
+    for (size_t i = 0; i < Size; i += 4096) *(uint32_t*)(alias + i) = 0xC0FFEE00u + (uint32_t)(i >> 12);
+    run([&] { vkCmdCopyBuffer(cb, gbuf, rbuf, 1, &whole); });
+    bool ok2 = true;
+    for (size_t i = 0; i < Size; i += 4096) ok2 &= ((uint32_t*)rmap)[i / 4] == 0xC0FFEE00u + (uint32_t)(i >> 12);
+    failures += !ok2;
+    std::printf("2 GPU sees later writes through the alias view: %s\n", ok2 ? "ok" : "MISMATCH");
+    // 3. The GPU writes into the guest memory; the CPU reads them through both views.
+    run([&] { vkCmdFillBuffer(cb, gbuf, 1 << 20, 1 << 20, 0x5A5A5A5Au); });
+    bool ok3 = *(uint32_t*)(guest + (1 << 20) + 4096) == 0x5A5A5A5Au && *(uint32_t*)(alias + (2 << 20) - 4) == 0x5A5A5A5Au;
+    failures += !ok3;
+    std::printf("3 CPU sees GPU writes in both views: %s\n", ok3 ? "ok" : "MISMATCH");
+    // 4. Read bandwidth: from guest memory (over PCIe) vs from VRAM.
+    run([&] { vkCmdCopyBuffer(cb, gbuf, vbuf, 1, &whole); });
+    double host_ms = 0, vram_ms = 0;
+    for (int i = 0; i < 5; ++i) host_ms += run([&] { vkCmdCopyBuffer(cb, gbuf, vbuf, 1, &whole); });
+    for (int i = 0; i < 5; ++i) vram_ms += run([&] { vkCmdCopyBuffer(cb, vbuf, vbuf2, 1, &whole); barrier(); });
+    std::printf("4 64 MiB GPU copy: from guest memory %.2f ms (%.1f GB/s), VRAM to VRAM %.2f ms\n",
+                host_ms / 5, 64.0 / 1024 / (host_ms / 5 / 1000), vram_ms / 5);
+    // 5. An import of a 4 KiB-aligned piece inside the view (the engine maps per allocation).
+    VkMemoryAllocateInfo part{VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO, &imp, 1 << 20, type};
+    imp.pHostPointer = guest + (8 << 20) + 4096 * 3;
+    VkDeviceMemory pmem; VkResult pr = vkAllocateMemory(dev, &part, nullptr, &pmem);
+    std::printf("5 import at a 4 KiB offset: %d\n", pr);
+    // 6. The engine's arena: a sparse buffer whose blocks are bound to guest memory (BindInPlace).
+    {
+        constexpr VkDeviceSize ArenaSize = 1ull << 30;
+        VkBufferCreateInfo sci{VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO, &ebci,
+                               VK_BUFFER_CREATE_SPARSE_BINDING_BIT | VK_BUFFER_CREATE_SPARSE_RESIDENCY_BIT, ArenaSize,
+                               VK_BUFFER_USAGE_TRANSFER_SRC_BIT | VK_BUFFER_USAGE_TRANSFER_DST_BIT | VK_BUFFER_USAGE_STORAGE_BUFFER_BIT};
+        VkBuffer arena; VkResult ar = vkCreateBuffer(dev, &sci, nullptr, &arena);
+        std::printf("6a sparse arena with the host import handle type: %d\n", ar);
+        if (ar != VK_SUCCESS) {
+            sci.pNext = nullptr;
+            ar = vkCreateBuffer(dev, &sci, nullptr, &arena);
+            std::printf("6a sparse arena without it: %d\n", ar);
+        }
+        VkMemoryRequirements sr; vkGetBufferMemoryRequirements(dev, arena, &sr);
+        std::printf("6b sparse block alignment %llu, memory types 0x%x (import type %u %s)\n",
+                    (unsigned long long)sr.alignment, sr.memoryTypeBits, type,
+                    (sr.memoryTypeBits >> type & 1) ? "allowed" : "NOT allowed");
+        VkSparseMemoryBind mb{64ull << 20, 16ull << 20, gmem, 4ull << 20, 0};
+        VkSparseBufferMemoryBindInfo bbi{arena, 1, &mb};
+        VkBindSparseInfo bsi{VK_STRUCTURE_TYPE_BIND_SPARSE_INFO, nullptr, 0, nullptr, 1, &bbi};
+        VkResult br = vkQueueBindSparse(q, 1, &bsi, fence);
+        vkWaitForFences(dev, 1, &fence, VK_TRUE, UINT64_MAX);
+        vkResetFences(dev, 1, &fence);
+        std::printf("6c sparse bind of imported memory: %d\n", br);
+        for (size_t i = 0; i < (16u << 20); i += 4) *(uint32_t*)(guest + (4u << 20) + i) = 0xA5000000u ^ (uint32_t)i;
+        VkBufferCopy c{64ull << 20, 0, 16ull << 20};
+        run([&] { vkCmdCopyBuffer(cb, arena, rbuf, 1, &c); });
+        const bool ok6 = br == VK_SUCCESS && std::memcmp(rmap, guest + (4u << 20), 16u << 20) == 0;
+        failures += !ok6;
+        std::printf("6d GPU reads guest memory through the sparse arena: %s\n", ok6 ? "ok" : "MISMATCH");
+    }
+    std::printf("RESULT: %s\n", failures ? "imported, but wrong data" : "the GPU can use the game's memory in place");
+    return failures ? 3 : 0;
+}
diff --git a/tools/re/fps_constants.py b/tools/re/fps_constants.py
new file mode 100644
index 0000000..95a662c
--- /dev/null
+++ b/tools/re/fps_constants.py
@@ -0,0 +1,114 @@
+#!/usr/bin/env python3
+"""Lantern Engine: where the game's code still assumes 30 frames a second.
+
+Usage: fps_constants.py out/eboot.elf [patched-addresses.txt]
+
+Finds the float constants of a 30 fps frame in the data (1/30, 30.0, 1/60 and 60.0 as written by
+the 60 fps patches' style), then every instruction that reads one RIP-relative (movss/vmovss,
+mulss/divss/addss/subss and their VEX forms, cvt, comiss) and every `mov dword [..], imm32` that
+stores one. Each site is printed with its function (from .eh_frame_hdr) and whether a frame-rate
+patch already writes it (a list of addresses, one per line, from patches.py).
+"""
+import bisect
+import struct
+import sys
+
+CONSTANTS = {
+    struct.pack('<f', 1 / 30): '1/30',
+    struct.pack('<f', 30.0): '30.0',
+    struct.pack('<d', 1 / 30): '1/30 (double)',
+    struct.pack('<d', 30.0): '30.0 (double)',
+}
+
+
+def load(path):
+    f = open(path, 'rb').read()
+    phoff, = struct.unpack_from('<Q', f, 0x20)
+    phnum, = struct.unpack_from('<H', f, 0x38)
+    segs = [struct.unpack_from('<IIQQQQQQ', f, phoff + 56 * i) for i in range(phnum)]
+    loads = [s for s in segs if s[0] == 1]
+    ehh = next(s for s in segs if s[0] == 0x6474e550)
+    funcs = []
+    text = next(s for s in loads if s[1] & 1)
+    toff, tva = text[2], text[3]
+    h, hva = ehh[2], ehh[3]
+    count, = struct.unpack_from('<i', f, h + 8)
+    for i in range(count):
+        loc, fde = struct.unpack_from('<ii', f, h + 12 + 8 * i)
+        fde_off = hva + fde - tva + toff
+        size, = struct.unpack_from('<i', f, fde_off + 12)
+        funcs.append((hva + loc, size))
+    funcs.sort()
+    return f, loads, funcs
+
+
+def main():
+    f, loads, funcs = load(sys.argv[1])
+    patched = set()
+    if len(sys.argv) > 2:
+        patched = {int(line.split()[0], 0) for line in open(sys.argv[2]) if line.strip()}
+    starts = [s for s, _ in funcs]
+
+    def owner(va):
+        k = bisect.bisect_right(starts, va) - 1
+        return starts[k] if k >= 0 and va < funcs[k][0] + funcs[k][1] else None
+
+    # Constant locations (virtual addresses) in every loaded segment.
+    where = {}
+    for seg in loads:
+        off, va, size = seg[2], seg[3], seg[5]
+        data = f[off:off + size]
+        for raw, name in CONSTANTS.items():
+            at = data.find(raw)
+            while at != -1:
+                if at % 4 == 0:
+                    where[va + at] = name
+                at = data.find(raw, at + 1)
+
+    text = next(s for s in loads if s[1] & 1)
+    toff, tva, tsz = text[2], text[3], text[5]
+    code = f[toff:toff + tsz]
+    sites = []
+    # RIP-relative operands: ModRM mod=00 rm=101, disp32 follows. The instruction ends 4 bytes
+    # after the displacement (no immediate for the float ops looked for here).
+    for i in range(len(code) - 8):
+        modrm = code[i]
+        if modrm & 0xC7 != 0x05:
+            continue
+        disp, = struct.unpack_from('<i', code, i + 1)
+        end = tva + i + 5
+        target = end + disp
+        name = where.get(target)
+        if not name:
+            continue
+        # The opcode bytes before ModRM: a scalar float op (0F 10/11/51/58/59/5C/5E/5A/2F/2E...).
+        op = code[i - 1]
+        if op not in (0x10, 0x11, 0x2E, 0x2F, 0x51, 0x58, 0x59, 0x5A, 0x5C, 0x5D, 0x5E, 0x5F):
+            continue
+        sites.append((tva + i - 1, target, name))
+    # mov dword [..], imm32 of a float constant (C7 /0).
+    for raw, name in CONSTANTS.items():
+        if len(raw) != 4:
+            continue
+        at = code.find(raw)
+        while at != -1:
+            if at >= 2 and code[at - 2] == 0xC7 or (at >= 3 and code[at - 3] == 0xC7):
+                sites.append((tva + at, None, name + ' (immediate)'))
+            at = code.find(raw, at + 1)
+
+    sites.sort()
+    by_func = {}
+    for va, target, name in sites:
+        by_func.setdefault(owner(va), []).append((va, target, name))
+    print(f'{len(where)} constant slots, {len(sites)} code sites in {len(by_func)} functions')
+    for func, items in sorted(by_func.items(), key=lambda x: (x[0] or 0)):
+        hit = lambda va, target: any(a in patched for a in range(va, va + 9)) or target in patched
+        fixed = sum(1 for va, target, _ in items if hit(va, target))
+        label = f'{func:#x}' if func is not None else '?'
+        print(f'{label}: {len(items)} sites, {fixed} patched: ' +
+              ', '.join(f'{va:#x} {name}' + ('*' if hit(va, target) else '')
+                        for va, target, name in items[:6]))
+
+
+if __name__ == '__main__':
+    main()
diff --git a/tools/re/fps_patched.py b/tools/re/fps_patched.py
new file mode 100644
index 0000000..f6a02c0
--- /dev/null
+++ b/tools/re/fps_patched.py
@@ -0,0 +1,27 @@
+#!/usr/bin/env python3
+"""Lantern Engine: every executable address the frame-rate presets write (for fps_constants.py).
+
+Usage: fps_patched.py out/eboot.elf [uncap|60|90|120|144] > patched.txt
+One address per line: each byte a preset's writes (frame-rate patch, corrections, sprint fix) touch.
+"""
+import sys
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[2] / 'scripts'))
+import patches as P  # noqa: E402
+
+elf = Path(sys.argv[1])
+fps = sys.argv[2] if len(sys.argv) > 2 else 'uncap'
+xml = Path(__file__).resolve().parents[2] / 'patches' / 'Bloodborne.xml'
+elf_bytes = elf.read_bytes()
+segments = P.eboot_segments(elf_bytes)
+preset = P.FPS_PRESETS[fps] if fps in P.FPS_PRESETS else [P.SCALED_BASE, 'Sprint Fix (High FPS)']
+writes = P.compile_patches(xml, preset, '01.09', segments)
+if fps in P.SCALED_FPS:
+    writes = P.rate_scaled(writes, P.SCALED_FPS[fps])
+writes = P.frame_rate_fixes(writes, {"60": 60, "90": 90, **P.SCALED_FPS}.get(fps), elf_bytes)
+covered = set()
+for offset, data in writes:
+    covered.update(range(offset, offset + len(data)))
+for address in sorted(covered):
+    print(hex(address))
diff --git a/tools/redzone_functions.py b/tools/redzone_functions.py
new file mode 100644
index 0000000..547e540
--- /dev/null
+++ b/tools/redzone_functions.py
@@ -0,0 +1,157 @@
+"""Recipes that move a red-zone leaf function's locals above rsp: patches/redzone_functions.json.
+
+link_modules.protect_red_zones runs the stores of red-zone leaf functions with rsp 128 bytes
+lower, so a write fault on a GPU-tracked page does not land on the function's locals. Anything
+else Windows writes below a guest thread's rsp (another fault kind, a context the kernel pushes)
+still does, and the effect ribbon writers (0x28ce7b0, 0x28ceec0) kept losing [rsp-0x60] on a 14th
+gen Intel CPU with every store protected (guest+0x28cf0d6, GXWorker).
+
+This tool describes each listed function so the linker can run a copy of it whose whole body
+sits 128 bytes lower: `lea rsp, [rsp-0x80]` after the prologue's `sub rsp`, `lea rsp, [rsp+0x80]`
+before the epilogue's `add rsp`, and every [rsp+d] operand in between as [rsp+d+0x80]. The red
+zone then lies inside the frame, so nothing below rsp is live any more. The recipe holds no game
+code: the function's sha256 and, per instruction, its length and what to change.
+
+Instruction kinds (link_modules.rewrite_red_zone_functions and start/prepare.cpp follow them):
+  [n]                      copy n bytes
+  [n, 1, modrm, disp, w]   [rsp+d] operand: ModRM at `modrm`, displacement at `disp`, w bytes (0/1/4)
+  [n, 2, disp]             rip-relative operand: disp32 at `disp`, retargeted for the copy
+  [n, 3, cc, target]       jump inside the function (cc 0-15: jcc, 16: jmp), emitted as rel32;
+                           target: offset from the function start
+  [n, 4]                   the prologue's `sub rsp`: copied, then lea rsp, [rsp-0x80]
+  [n, 5]                   the epilogue's `add rsp`: lea rsp, [rsp+0x80], then copied
+
+Developer tool (pip install capstone):
+  python tools/redzone_functions.py <game dir with eboot.bin> [function offsets, hex]
+"""
+import argparse
+import hashlib
+import json
+from pathlib import Path
+import sys
+import capstone
+from capstone import x86
+
+ROOT = Path(__file__).resolve().parent.parent
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+from redzone_sites import load  # noqa: E402
+
+RSP, RIP = x86.X86_REG_RSP, x86.X86_REG_RIP
+# The effect ribbon writers (attack trails, boss effect ribbons): link_modules.protect_red_zones.
+DEFAULT = (0x28ce7b0, 0x28ceec0)
+JCC = {0x70 + cc: cc for cc in range(16)}
+
+
+def recipe(md, image, start, end, relocs=()):
+    insns = list(md.disasm(image[start:end], start))
+    if not insns or sum(i.size for i in insns) != end - start:
+        raise ValueError(f'{start:#x}: does not disassemble to its end')
+    while insns and insns[-1].mnemonic in ('nop', 'int3'):
+        insns.pop()  # alignment padding before the next function
+    end = insns[-1].address + insns[-1].size
+    if any(start <= r < end + 8 and r + 8 > start for r in relocs):
+        raise ValueError(f'{start:#x}: holds a relocation')
+    out, state = [], 'prologue'
+    for i in insns:
+        ops = i.operands
+        if i.group(capstone.CS_GRP_CALL):
+            raise ValueError(f'{i.address:#x}: call (not a leaf)')
+        is_rsp_imm = len(ops) == 2 and ops[0].type == x86.X86_OP_REG and ops[0].reg == RSP and \
+            ops[1].type == x86.X86_OP_IMM
+        if state == 'prologue':
+            if i.mnemonic == 'mov' and 'rbp, rsp' in i.op_str:
+                raise ValueError(f'{i.address:#x}: frame pointer (rbp-based red zone) not supported')
+            if i.mnemonic == 'push':
+                out.append([i.size])
+                continue
+            if i.mnemonic == 'sub' and is_rsp_imm:
+                out.append([i.size, 4])
+                state = 'body'
+                continue
+            raise ValueError(f'{i.address:#x}: {i.mnemonic} {i.op_str} before the frame is set up')
+        if state == 'body' and i.mnemonic == 'add' and is_rsp_imm:
+            out.append([i.size, 5])
+            state = 'epilogue'
+            continue
+        if state == 'epilogue':
+            if i.mnemonic in ('pop', 'ret'):
+                out.append([i.size])
+                if i.mnemonic == 'ret':
+                    state = 'done'
+                continue
+            raise ValueError(f'{i.address:#x}: {i.mnemonic} in the epilogue')
+        if state == 'done':
+            raise ValueError(f'{i.address:#x}: code after the return (several exits)')
+        _, written = i.regs_access()
+        if RSP in written or x86.X86_REG_ESP in written or i.mnemonic in ('push', 'pop', 'ret', 'leave', 'enter'):
+            raise ValueError(f'{i.address:#x}: {i.mnemonic} {i.op_str} changes rsp in the body')
+        if i.group(capstone.CS_GRP_JUMP):
+            op = ops[0]
+            if op.type != x86.X86_OP_IMM or not start <= op.imm < end:
+                raise ValueError(f'{i.address:#x}: jump out of the function or indirect')
+            first = i.bytes[0]
+            if first == 0xeb or first == 0xe9:
+                cc = 16
+            elif first in JCC:
+                cc = JCC[first]
+            elif first == 0x0f and 0x80 <= i.bytes[1] <= 0x8f:
+                cc = i.bytes[1] - 0x80
+            else:
+                raise ValueError(f'{i.address:#x}: {i.mnemonic} (loop/jrcxz) not supported')
+            out.append([i.size, 3, cc, op.imm - start])
+            continue
+        mem = [op for op in ops if op.type == x86.X86_OP_MEM]
+        if any(op.mem.index == RSP for op in mem):
+            raise ValueError(f'{i.address:#x}: rsp as an index')
+        rsp = [op for op in mem if op.mem.base == RSP]
+        if rsp:
+            if i.modrm_offset == 0 or image[i.address + i.modrm_offset] & 7 != 4:
+                raise ValueError(f'{i.address:#x}: unexpected [rsp] encoding')
+            if i.disp_size not in (0, 1, 4):
+                raise ValueError(f'{i.address:#x}: displacement size {i.disp_size}')
+            out.append([i.size, 1, i.modrm_offset, i.disp_offset if i.disp_size else i.modrm_offset + 2,
+                        i.disp_size])
+        elif any(op.mem.base == RIP for op in mem):
+            if i.disp_size != 4:
+                raise ValueError(f'{i.address:#x}: rip-relative without disp32')
+            out.append([i.size, 2, i.disp_offset])
+        else:
+            out.append([i.size])
+    if state != 'done':
+        raise ValueError(f'{start:#x}: prologue/body/epilogue not found ({state})')
+    # Merge runs of plain copies (smaller file); a jump target starts an item of its own.
+    targets = {item[3] for item in out if len(item) > 1 and item[1] == 3}
+    merged, pos = [], 0
+    for item in out:
+        if len(item) == 1 and merged and len(merged[-1]) == 1 and pos not in targets:
+            merged[-1][0] += item[0]
+        else:
+            merged.append(item)
+        pos += item[0]
+    return dict(offset=start, size=end - start, sha256=hashlib.sha256(image[start:end]).hexdigest(),
+                insns=merged)
+
+
+def main():
+    p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    p.add_argument('game', type=Path)
+    p.add_argument('functions', nargs='*', help='function start offsets (hex); default: the ribbon writers')
+    p.add_argument('-o', '--out', type=Path, default=ROOT / 'patches' / 'redzone_functions.json')
+    a = p.parse_args()
+    image, starts = load(a.game)
+    md = capstone.Cs(capstone.CS_ARCH_X86, capstone.CS_MODE_64)
+    md.detail = True
+    wanted = [int(f, 16) for f in a.functions] or list(DEFAULT)
+    functions = []
+    for start in wanted:
+        if start not in starts:
+            raise SystemExit(f'{start:#x} is not a function start in .eh_frame_hdr')
+        end = starts[starts.index(start) + 1]
+        functions.append(recipe(md, image, start, end))
+    a.out.write_text(json.dumps(dict(eboot='Bloodborne 01.09', functions=functions),
+                                separators=(',', ':')) + '\n', encoding='ascii')
+    print(f'{len(functions)} functions -> {a.out}')
+
+
+if __name__ == '__main__':
+    main()

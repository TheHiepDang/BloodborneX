+s32 PS4_SYSV_ABI sceNetSocketClose(OrbisNetId s) {
+    const auto r = Core::Net::SocketClose(s);
+    if (r.error == Error::Ok) {
+        LogSocketClosed(s);
+    }
+    return Return(r);
+}

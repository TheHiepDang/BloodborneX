+s32 PS4_SYSV_ABI sceNpTssCreateNpTitleCtx(OrbisNpServiceLabel serviceLabel, OrbisNpId* npId) {
+    LOG_INFO(Lib_NpTus, "redirecting to sceNpTusCreateNpTitleCtx");
+    return sceNpTusCreateNpTitleCtx(serviceLabel, npId);
+}

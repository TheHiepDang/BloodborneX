+int ModelPreset(int preset) {
+    if (preset != PresetCustom) {
+        return std::clamp(preset, 0, PresetCustom - 1);
+    }
+    // The fixed preset whose ratio is nearest: a 1.3 ratio runs the Quality model, 1.0 Native.
+    const float scale = PresetScale(preset);
+    int nearest = NativeAA;
+    for (int p = NativeAA; p < PresetCustom; ++p) {
+        if (std::abs(PresetScale(p) - scale) < std::abs(PresetScale(nearest) - scale)) {
+            nearest = p;
+        }
+    }
+    return nearest;
+}
+
+std::pair<int, int> DlssNrSize(int output_width, int output_height, int preset) {
+    const auto& v = Get();
+    if (!v.dlss_nr || v.upscaler != UpscalerDlss) {
+        const float scale = PresetScale(preset);
+        return {std::max(4, int(std::lround(output_width / scale / 4.0f)) * 4),
+                std::max(4, int(std::lround(output_height / scale / 4.0f)) * 4)};
+    }
+    if (preset == NativeAA || v.dlss_nr_height == 0 || output_height <= 0) {
+        return {output_width / 4 * 4, output_height / 4 * 4};
+    }
+    const int h = std::clamp(v.dlss_nr_height.load(), 4, output_height) / 4 * 4;
+    const double aspect = double(output_width) / output_height;
+    const int w = std::min(output_width / 4 * 4,
+                           std::max(4, int(std::lround(h * aspect / 4.0)) * 4));
+    return {w, h};
+}
+
+int DlssNrModelPreset(int output_width, int output_height, int preset) {
+    if (!Get().dlss_nr || Get().upscaler != UpscalerDlss || preset == NativeAA) {
+        return ModelPreset(preset);
+    }
+    const auto [width, height] = DlssNrSize(output_width, output_height, preset);
+    (void)width;
+    const float scale = height ? float(output_height) / height : 1.0f;
+    int nearest = NativeAA;
+    for (int p = NativeAA; p < PresetCustom; ++p) {
+        if (std::abs(PresetScale(p) - scale) < std::abs(PresetScale(nearest) - scale)) nearest = p;
+    }
+    return nearest;
+}

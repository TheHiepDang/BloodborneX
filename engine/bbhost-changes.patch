+
+// One cap of several.
+std::string ActionLabel(int action) {
+    if (const int key = host_binding_key(action)) {
+        return KeyLabel(key);
+    }
+    static constexpr const char* kMouse[] = {"-", "LMB", "RMB", "MMB", "M4", "M5", "WhUp", "WhDn"};
+    const int m = host_binding_mouse(action);
+    return kMouse[m >= 0 && m <= 7 ? m : 0];
+}

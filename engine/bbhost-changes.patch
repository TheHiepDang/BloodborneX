+                                                           "j", "k", "l", "m", "n", "o", "p", "q", "r",
+                                                           "s", "t", "u", "v", "w", "x", "y", "z"};
+    return preset >= 1 && preset <= DlssPresetMax ? letters[preset - 1] : "default";

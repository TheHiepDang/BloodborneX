+bool DatagramSocket::GetPeer(Endpoint* peer, u16* peer_vport) const {
+    std::scoped_lock lock{transport_->mutex_};
+    if (!peer_) {
+        return false;
+    }
+    *peer = peer_->first;
+    *peer_vport = peer_->second;
+    return true;
+}

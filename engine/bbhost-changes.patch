+float SliderDefault(const std::atomic<float>& value) {
+    static const Values defaults;
+    const auto& current = Get();
+    const std::atomic<float> Values::* members[] = {
+        &Values::sharpness, &Values::reactive_scale, &Values::reactive_threshold, &Values::reactive_max,
+        &Values::hdr_paper_white, &Values::hdr_peak, &Values::hdr_boost,
+        &Values::hdr_ui_brightness, &Values::hdr_ui_color, &Values::render_scale, &Values::mip_bias,
+        &Values::graphics_brightness, &Values::graphics_contrast, &Values::graphics_saturation,
+        &Values::graphics_hue, &Values::graphics_fog, &Values::graphics_bloom,
+        &Values::graphics_ao_strength, &Values::graphics_shadow_scale,
+        &Values::camera_fov_scale, &Values::camera_distance_scale, &Values::camera_height_scale,
+        &Values::fps_scale, &Values::fps_text_opacity, &Values::fps_bg_opacity,
+        &Values::dlss_nr_intensity, &Values::dlss_nr_local_structure, &Values::dlss_nr_local_tone,
+        &Values::dlss_nr_skin_structure, &Values::dlss_nr_white_point,
+    };
+    for (auto member : members) if (&value == &(current.*member)) return (defaults.*member).load();
+    for (int pass = 0; pass < 2; ++pass) {
+        const auto& extra = current.dlss_nr_extra[pass];
+        if (&value == &extra.skin) return -1.0f;
+        if (&value == &extra.intensity || &value == &extra.structure || &value == &extra.tone) return 1.0f;
+    }
+    return 1.0f;
+}

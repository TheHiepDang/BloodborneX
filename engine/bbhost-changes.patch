+    if (arrayLen > TusMaxUsersPerRequest) {
+        LOG_ERROR(Lib_NpTus, "too many users: arrayLen={} (max {})", arrayLen,
+                  TusMaxUsersPerRequest);
+        return ORBIS_NP_COMMUNITY_ERROR_TOO_MANY_NPID;

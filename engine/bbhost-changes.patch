+    ORBIS_NET_IP_MAXTTL = 31,
+    ORBIS_NET_IP_DONTFRAG = 67,
+};
+
+enum OrbisNetSocketTcpOption : u32 {
+    ORBIS_NET_TCP_NODELAY = 1,
+    ORBIS_NET_TCP_MAXSEG = 2,
+    ORBIS_NET_TCP_MSS_TO_ADVERTISE = 3,

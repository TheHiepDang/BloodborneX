+DlssNrTuning DlssNrPassTuning(const Values& v, int pass) {
+    if (pass > 0 && pass <= 2 && v.dlss_nr_customize_passes) {
+        const auto& extra = v.dlss_nr_extra[pass - 1];
+        return {extra.intensity, extra.structure, extra.tone, extra.skin,
+                extra.style < 0 ? v.dlss_nr_style.load() : extra.style.load()};
+    }
+    return {v.dlss_nr_intensity, v.dlss_nr_local_structure, v.dlss_nr_local_tone,
+            v.dlss_nr_skin_structure, v.dlss_nr_style};
+}

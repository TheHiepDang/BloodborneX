-        *it = Epoll(name);
-        const auto ret = std::distance(epolls.begin(), it);
-        LOG_DEBUG(Lib_Net, "epollid = {}", ret);
-        return ret;
-    } else {
-        epolls.emplace_back(name);
-        const auto ret = epolls.size() - 1;

+    if (auto ret = ResolveTus(reqId, &req, &svc, &uid, &self); ret < 0) {
+        return ret;
+    }
+    // Account ids map straight to the server's owner key, no npid resolution.
+    std::vector<s64> accounts;
+    accounts.reserve(arrayLen);
+    for (int i = 0; i < arrayLen; ++i) {

+    void* cbFuncArg;
+    std::uint32_t timeout;
+    std::uint16_t appReqId;
+    std::uint16_t pad;
+};
+// KICKEDOUT and ROOM_DESTROYED: the game reads optData only when it is 4 bytes long.
+struct RoomUpdateInfo {

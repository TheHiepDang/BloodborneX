+/// BB_SHADER_CAPTURE_DIR, else "shaders" beside the session log (BB_LOG_FILE), else logs\shaders.
+std::filesystem::path CaptureDir() {
+    if (const char* dir = std::getenv("BB_SHADER_CAPTURE_DIR"); dir && dir[0]) {
+        return dir;
+    }
+    if (const char* log = std::getenv("BB_LOG_FILE"); log && log[0]) {
+        return std::filesystem::path(log).parent_path() / "shaders";
+    }
+    return std::filesystem::path("logs") / "shaders";
+}
+
+u64 Fnv(const void* data, size_t size, u64 h = 0xcbf29ce484222325ull) {
+    const auto* p = static_cast<const unsigned char*>(data);
+    for (size_t i = 0; i < size; ++i) {
+        h = (h ^ p[i]) * 0x100000001b3ull;
+    }
+    return h;
+}
+
+/// The fetch shader's dwords, up to and including its s_setpc_b64 (at most 1024 dwords).
+std::span<const u32> FetchCode(const Info& info) {
+    if (!info.has_fetch_shader) {
+        return {};
+    }
+    const auto ud = info.UserData();
+    if (info.fetch_shader_sgpr_base + 1 >= ud.size()) {
+        return {};
+    }
+    const u32* code;
+    std::memcpy(&code, &ud[info.fetch_shader_sgpr_base], sizeof(code));
+    if (!code) {
+        return {};
+    }
+    Gcn::GcnCodeSlice slice(code, code + 1024);
+    Gcn::GcnDecodeContext decoder;
+    while (!slice.atEnd()) {
+        const auto inst = decoder.decodeInstruction(slice);
+        if (inst.opcode == Gcn::Opcode::S_SETPC_B64) {
+            return {code, static_cast<size_t>(slice.position() - code)};
+        }
+    }
+    return {};
+}
+
+/// What a compile reads besides the RuntimeInfo, copied out of guest memory. A draw-preparation
+/// worker calls this under its fault guard (a fault jumps out of here): no lock may be held.
+struct Collected {
+    std::vector<u32> ud, words, fetch, flat;
+    std::vector<CaptureSharp> sharps;
+    CaptureTess tess{};
+    std::vector<u8> tess_bytes;
+    /// The Info fields the file header needs, and the geometry stage's copy shader (the
+    /// RuntimeInfo only points to it): the file may be written after the compile is gone.
+    u32 hw_stage = 0, sw_stage = 0, fetch_sgpr = ~0u;
+    u64 hash = 0;
+    std::vector<u32> vs_copy;
+};
+
+Collected Collect(const Info& info, const RuntimeInfo& runtime_info, std::span<const u32> code) {
+    Collected c;
+    c.hw_stage = u32(info.hw_stage);
+    c.sw_stage = u32(info.sw_stage);
+    c.hash = info.pgm_hash;
+    c.fetch_sgpr = info.has_fetch_shader ? info.fetch_shader_sgpr_base : ~0u;
+    if (info.hw_stage == HwStage::Geometry) {
+        const auto& copy = runtime_info.hw.gs.vs_copy;
+        c.vs_copy.assign(copy.begin(), copy.end());
+    }
+    const auto ud = info.UserData();
+    c.ud.assign(ud.begin(), ud.end());
+    c.words.assign(code.begin(), code.end());
+    const auto fetch = FetchCode(info);
+    c.fetch.assign(fetch.begin(), fetch.end());
+    const auto flat = info.FlatUserData();
+    c.flat.assign(flat.begin(), flat.end());
+    // The vertex attributes' V#s: the compile reads each one's format and swizzle through a table
+    // pointer in the user data (Gcn::VertexAttribute::GetSharp).
+    if (!c.fetch.empty()) {
+        if (const auto data = Gcn::ParseFetchShader(info)) {
+            for (const auto& attrib : data->attributes) {
+                if (attrib.sgpr_base == IR::NumScalarRegs) {
+                    continue; // in the user data itself
+                }
+                const auto buffer = info.ReadUdReg<AmdGpu::Buffer>(attrib.sgpr_base, attrib.dword_offset);
+                CaptureSharp sharp{attrib.sgpr_base, attrib.dword_offset, {}};
+                static_assert(sizeof(buffer) == sizeof(sharp.words));
+                std::memcpy(sharp.words, &buffer, sizeof(sharp.words));
+                c.sharps.push_back(sharp);
+            }
+        }
+    }
+    // Hull and domain shaders read the tessellation constants while they compile
+    // (Info::ReadTessConstantBuffer).
+    if (info.tess_consts_dword_offset >= 0) {
+        const auto sgpr = static_cast<u32>(info.tess_consts_ptr_base);
+        const auto offset = static_cast<u32>(info.tess_consts_dword_offset);
+        const auto buffer = info.ReadUdReg<AmdGpu::Buffer>(sgpr, offset);
+        if (buffer.base_address) {
+            c.tess.size = sizeof(TessellationDataConstantBuffer);
+            c.tess.sgpr_base = sgpr;
+            c.tess.dword_offset = offset;
+            std::memcpy(c.tess.words, &buffer, sizeof(c.tess.words));
+            const auto* bytes = reinterpret_cast<const u8*>(VAddr(buffer.base_address));
+            c.tess_bytes.assign(bytes, bytes + c.tess.size);
+        }
+    }
+    return c;
+}
+
+/// Written under a temporary name and renamed into place: a crash leaves no cut-short file.
+bool WriteFile(const std::filesystem::path& path, const RuntimeInfo& runtime_info, const Collected& c) {
+    auto temporary = path;
+    temporary += ".tmp";
+    FILE* f = std::fopen(temporary.string().c_str(), "wb");
+    if (!f) {
+        return false;
+    }
+    CaptureHeader header{};
+    std::memcpy(header.magic, CaptureMagic, sizeof(header.magic));
+    header.version = CaptureVersion;
+    header.hw_stage = c.hw_stage;
+    header.sw_stage = c.sw_stage;
+    header.hash = c.hash;
+    header.runtime_info_size = sizeof(RuntimeInfo);
+    header.user_data_count = u32(c.ud.size());
+    header.code_dwords = u32(c.words.size());
+    header.fetch_dwords = u32(c.fetch.size());
+    header.fetch_sgpr = c.fetch_sgpr;
+    header.flat_dwords = u32(c.flat.size());
+    bool ok = std::fwrite(&header, sizeof(header), 1, f) == 1 &&
+              std::fwrite(&runtime_info, sizeof(RuntimeInfo), 1, f) == 1;
+    const auto put = [&](const auto& v) {
+        if (!v.empty()) {
+            ok = ok && std::fwrite(v.data(), sizeof(v[0]), v.size(), f) == v.size();
+        }
+    };
+    put(c.ud);
+    put(c.words);
+    put(c.fetch);
+    put(c.flat);
+    const u32 sharp_count = u32(c.sharps.size());
+    ok = ok && std::fwrite(&sharp_count, sizeof(sharp_count), 1, f) == 1;
+    put(c.sharps);
+    ok = ok && std::fwrite(&c.tess, sizeof(c.tess), 1, f) == 1;
+    put(c.tess_bytes);
+    if (HwStage(c.hw_stage) == HwStage::Geometry && !c.vs_copy.empty()) {
+        const auto& copy = c.vs_copy;
+        const u32 trailer[2] = {u32(copy.size()), CopyTrailerMagic};
+        ok = ok && std::fwrite(copy.data(), 4, copy.size(), f) == copy.size() &&
+             std::fwrite(trailer, sizeof(trailer), 1, f) == 1;
+    }
+    ok = std::fclose(f) == 0 && ok;
+    std::error_code error;
+    if (ok) {
+        std::filesystem::rename(temporary, path, error);
+    }
+    if (!ok || error) {
+        std::filesystem::remove(temporary, error);
+        return false;
+    }
+    return true;
+}
+
+/// bbport: the files are written on a thread of their own. They were written where the shader
+/// compiles (the GPU thread, or a draw-preparation worker): a create, writes, close and rename in
+/// the cache folder (the user's sits in a cloud-synced Desktop; the virus scanner reads each new
+/// file at close) inside the compile time a new shader costs the frame. What a file holds is
+/// collected at once (it is read from guest memory); only the writing waits.
+/// BB_SHADER_FILE_ASYNC=0: written at once, as before.
+bool AsyncFiles() {
+    static const bool enabled = [] {
+        const char* env = std::getenv("BB_SHADER_FILE_ASYNC");
+        return !(env && env[0] == '0');
+    }();
+    return enabled;
+}
+class FileWriter {
+public:
+    static void Run(std::function<void()> job) {
+        if (!AsyncFiles()) {
+            job();
+            return;
+        }
+        static FileWriter* writer = new FileWriter(); // never stopped: pending files at exit are lost
+        {
+            std::scoped_lock lk{writer->lock};
+            writer->jobs.push_back(std::move(job));
+        }
+        writer->ready.notify_one();
+    }
+
+private:
+    FileWriter() {
+        std::thread([this] {
+            for (;;) {
+                std::function<void()> job;
+                {
+                    std::unique_lock lk{lock};
+                    ready.wait(lk, [this] { return !jobs.empty(); });
+                    job = std::move(jobs.front());
+                    jobs.pop_front();
+                }
+                job();
+            }
+        }).detach();
+    }
+    std::mutex lock;
+    std::condition_variable ready;
+    std::deque<std::function<void()>> jobs;
+};
+
+std::mutex mutex;
+std::unordered_set<u64> written;
+bool profile_written = false;
+bool failed = false;
+u32 count = 0;
+
+std::mutex state_mutex;
+std::unordered_set<u64> states_seen;
+bool states_failed = false;
+u32 states_written = 0;
+
+} // namespace
+
+bool CaptureEnabled() {
+    static const bool enabled = [] {
+        const char* env = std::getenv("BB_SHADER_CAPTURE");
+        return env && env[0] == '1';
+    }();
+    return enabled;
+}
+
+void Capture(const Info& info, const RuntimeInfo& runtime_info, std::span<const u32> code,
+             const Profile& profile) {
+    if (!CaptureEnabled() || code.empty()) {
+        return;
+    }
+    const u64 key = Fnv(&runtime_info, sizeof(runtime_info), info.pgm_hash * 0x9e3779b97f4a7c15ull);
+    {
+        std::scoped_lock lk{mutex};
+        if (failed || !written.insert(key).second) {
+            return;
+        }
+    }
+    auto c = std::make_shared<const Collected>(Collect(info, runtime_info, code));
+    char name[64];
+    std::snprintf(name, sizeof(name), "%u_%016llx_%016llx.bbs", u32(info.hw_stage),
+                  (unsigned long long)info.pgm_hash, (unsigned long long)key);
+    FileWriter::Run([c, runtime_info, profile, file = std::string(name)] {
+        std::scoped_lock lk{mutex};
+        if (failed) {
+            return;
+        }
+        const auto dir = CaptureDir();
+        std::error_code error;
+        std::filesystem::create_directories(dir, error);
+        if (!profile_written) {
+            profile_written = true;
+            if (FILE* f = std::fopen((dir / "profile.bin").string().c_str(), "wb")) {
+                const u32 size = sizeof(Profile);
+                std::fwrite(&size, sizeof(size), 1, f);
+                std::fwrite(&profile, sizeof(Profile), 1, f);
+                std::fclose(f);
+            }
+        }
+        if (!WriteFile(dir / file, runtime_info, *c)) {
+            failed = true;
+            std::printf("Shader capture: cannot write in %s; capture off\n", dir.string().c_str());
+            return;
+        }
+        if (++count == 1 || count % 500 == 0) {
+            std::printf("Shader capture: %u shaders written to %s\n", count, dir.string().c_str());
+        }
+    });
+}
+
+bool StatesEnabled() {
+    static const bool enabled = [] {
+        const char* env = std::getenv("BB_SHADER_STATES");
+        return !(env && env[0] == '0');
+    }();
+    return enabled;
+}
+
+void StoreState(const Info& info, const RuntimeInfo& runtime_info, std::span<const u32> code,
+                size_t perm_idx) {
+    if (!StatesEnabled() || code.empty() || perm_idx >= 4096) {
+        return;
+    }
+    {
+        std::scoped_lock lk{state_mutex};
+        if (states_failed || !states_seen.insert(info.pgm_hash * 4096 + perm_idx).second) {
+            return;
+        }
+    }
+    const auto dir = Storage::DataBase::Instance().FolderPath();
+    if (dir.empty()) {
+        return; // no cache, or the archive form of it
+    }
+    char name[64];
+    std::snprintf(name, sizeof(name), "0x%016llx_%zu%s", (unsigned long long)info.pgm_hash,
+                  perm_idx, StateExtension);
+    const auto path = dir / name;
+    const auto write = [path, dir, runtime_info](const Collected& c) {
+        std::scoped_lock lk{state_mutex};
+        if (states_failed) {
+            return;
+        }
+        if (!WriteFile(path, runtime_info, c)) {
+            states_failed = true;
+            std::printf("Shader states: cannot write in %s; off for this session\n", dir.string().c_str());
+            return;
+        }
+        if (++states_written == 1) {
+            std::printf("Shader states: new shaders' compile inputs kept beside the cache, so a new "
+                        "compiler rebuilds it before the game starts (BB_SHADER_STATES=0 turns it off)\n");
+        }
+    };
+    if (!AsyncFiles()) {
+        std::error_code error;
+        if (std::filesystem::exists(path, error)) {
+            return;
+        }
+        write(Collect(info, runtime_info, code));
+        return;
+    }
+    // The existence check goes with the write: a state already stored costs a collect here
+    // (copies of a few KiB) instead of a file system query on this thread.
+    auto c = std::make_shared<const Collected>(Collect(info, runtime_info, code));
+    FileWriter::Run([path, write, c] {
+        std::error_code error;
+        if (!std::filesystem::exists(path, error)) {
+            write(*c);
+        }
+    });
+}
+
+} // namespace Shader::Native
diff --git a/gpu/shadps4/shader_recompiler/native/capture.h b/gpu/shadps4/shader_recompiler/native/capture.h
new file mode 100644
index 0000000..959d8cf
--- /dev/null
+++ b/gpu/shadps4/shader_recompiler/native/capture.h
@@ -0,0 +1,85 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+// bbport: shader capture (BB_SHADER_CAPTURE=1). Every shader the game draws or dispatches with is
+// written once per distinct runtime state, with all a compile reads: the GCN code, the stage's
+// user data, the RuntimeInfo, the fetch shader's code and the device's Profile. The shader lab
+// (tools/shader_lab.cpp) compiles the captures offline with the current recompiler and the native
+// one and compares them, without the game.
+#pragma once
+
+#include <span>
+#include "common/types.h"
+
+namespace Shader {
+struct Info;
+struct RuntimeInfo;
+struct Profile;
+} // namespace Shader
+
+namespace Shader::Native {
+
+/// The capture file's layout (little endian), followed by RuntimeInfo (runtime_info_size bytes),
+/// the user data (user_data_count dwords), the code (code_dwords), the fetch shader's code
+/// (fetch_dwords; its address is user data dwords fetch_sgpr and fetch_sgpr + 1) and the flattened
+/// user data the resource table walker read from the game's memory for this draw (flat_dwords;
+/// the compile reads sharps from it). Version 3 then holds the vertex attributes' V#s the compile
+/// reads through table pointers in the user data: a u32 count, then per V# its pointer's SGPR,
+/// its dword offset in that table and its four dwords (CaptureSharp). Version 4 then holds the
+/// tessellation constants hull and domain shaders read while they compile (CaptureTess, then
+/// its bytes; size 0 for other shaders). Version 5 ends a geometry shader's state with the copy
+/// shader its compile reads (RuntimeInfo's hw.gs.vs_copy, game code): its dwords, then their count
+/// and CopyTrailerMagic, read from the end of the file.
+struct CaptureHeader {
+    char magic[4];
+    u32 version;
+    u32 hw_stage;
+    u32 sw_stage;
+    u64 hash;
+    u32 runtime_info_size;
+    u32 user_data_count;
+    u32 code_dwords;
+    u32 fetch_dwords;
+    u32 fetch_sgpr;
+    u32 flat_dwords;
+};
+inline constexpr char CaptureMagic[4] = {'B', 'B', 'S', '1'};
+inline constexpr u32 CaptureVersion = 5;
+inline constexpr u32 CopyTrailerMagic = 0x50435356; // "VSCP"
+
+struct CaptureSharp {
+    u32 sgpr_base;
+    u32 dword_offset;
+    u32 words[4];
+};
+
+/// The tessellation constants' V# (its table pointer's SGPR, NumScalarRegs when it sits in the
+/// user data itself) and the size of the constants that follow.
+struct CaptureTess {
+    u32 size;
+    u32 sgpr_base;
+    u32 dword_offset;
+    u32 words[4];
+};
+
+/// Whether BB_SHADER_CAPTURE=1 (read once).
+bool CaptureEnabled();
+
+/// bbport: shader states. Each shader permutation the cache holds also keeps its compile inputs
+/// (the capture format) beside it in the cache folder, "<pgm_hash>_<perm>.bbs" as its ".spv": when
+/// the shader compiler changes, bb-start has bb-shader-lab recompile the cache from them before
+/// the game starts (tests/shader_lab.cpp --recompile-cache) instead of every shader compiling
+/// again in play. On unless BB_SHADER_STATES=0.
+inline constexpr const char* StateExtension = ".bbs";
+bool StatesEnabled();
+
+/// Keeps the compile inputs of this program's permutation `perm_idx` if the cache folder has none
+/// yet (once per session per permutation). Thread safe; reads guest memory like Capture.
+void StoreState(const Info& info, const RuntimeInfo& runtime_info, std::span<const u32> code,
+                size_t perm_idx);
+
+/// Writes the shader's capture if this shader and runtime state were not written yet. `info` must
+/// hold this draw's user data, the program's fetch shader fields and this draw's flattened user
+/// data (after RefreshFlatBuf). Thread safe.
+void Capture(const Info& info, const RuntimeInfo& runtime_info, std::span<const u32> code,
+             const Profile& profile);
+
+} // namespace Shader::Native
diff --git a/gpu/shadps4/shader_recompiler/native/table_plan.cpp b/gpu/shadps4/shader_recompiler/native/table_plan.cpp
new file mode 100644
index 0000000..bcaee83
--- /dev/null
+++ b/gpu/shadps4/shader_recompiler/native/table_plan.cpp
@@ -0,0 +1,334 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#include "shader_recompiler/native/table_plan.h"
+
+#include <algorithm>
+#include <atomic>
+#include <cstdio>
+#include <cstdlib>
+#include <set>
+#include "shader_recompiler/info.h"
+#include "shader_recompiler/ir/basic_block.h"
+#include "shader_recompiler/ir/program.h"
+#include "shader_recompiler/ir/opcodes.h"
+#include "shader_recompiler/ir/passes/srt.h"
+#include "shader_recompiler/ir/reg.h"
+
+namespace Shader::Native {
+namespace {
+
+/// The place a table read was given in the flattened user data (0: none, it reads memory).
+u32 FlatOffset(const IR::Inst& inst) {
+    switch (inst.GetOpcode()) {
+    case IR::Opcode::ReadConst:
+        return inst.Flags<u16>();
+    case IR::Opcode::ReadConstBuffer:
+        return u32(inst.Flags<IR::BufferInstInfo>().flatbuf_off_dw.Value());
+    default:
+        return 0;
+    }
+}
+
+struct Compiler {
+    std::vector<TablePlan::ExprOp>& ops;
+    u32 dst;
+    u32 depth = 0;
+    u32 max_depth = 0;
+    std::string error;
+
+    void Push(TablePlan::Op op, u32 value = 0) {
+        ops.push_back({op, value});
+        if (op == TablePlan::Op::Imm || op == TablePlan::Op::Flat) {
+            max_depth = std::max(max_depth, ++depth);
+        } else if (op != TablePlan::Op::Not) {
+            depth -= op == TablePlan::Op::Bfe ? 2 : 1;
+        }
+    }
+
+    bool Value(const IR::Value& value) {
+        if (value.IsImmediate()) {
+            Push(TablePlan::Op::Imm, value.U32());
+            return true;
+        }
+        const IR::Inst* inst = value.Inst();
+        using IR::Opcode;
+        const auto args = [&](size_t count, TablePlan::Op op) {
+            for (size_t i = 0; i < count; ++i) {
+                if (!Value(inst->Arg(i))) {
+                    return false;
+                }
+            }
+            Push(op);
+            return true;
+        };
+        switch (inst->GetOpcode()) {
+        case Opcode::GetUserData:
+            Push(TablePlan::Op::Flat, static_cast<u32>(inst->Arg(0).ScalarReg()));
+            return true;
+        case Opcode::ReadConst:
+        case Opcode::ReadConstBuffer: {
+            const u32 at = FlatOffset(*inst);
+            if (at == 0 || at >= dst) {
+                error = "offset from a value not flattened before it";
+                return false;
+            }
+            Push(TablePlan::Op::Flat, at);
+            return true;
+        }
+        case Opcode::IAdd32:
+            return args(2, TablePlan::Op::Add);
+        case Opcode::ISub32:
+            return args(2, TablePlan::Op::Sub);
+        case Opcode::IMul32:
+            return args(2, TablePlan::Op::Mul);
+        case Opcode::ShiftLeftLogical32:
+            return args(2, TablePlan::Op::Shl);
+        case Opcode::ShiftRightLogical32:
+            return args(2, TablePlan::Op::Shr);
+        case Opcode::BitwiseAnd32:
+            return args(2, TablePlan::Op::And);
+        case Opcode::BitwiseOr32:
+            return args(2, TablePlan::Op::Or);
+        case Opcode::BitwiseXor32:
+            return args(2, TablePlan::Op::Xor);
+        case Opcode::BitwiseNot32:
+            return args(1, TablePlan::Op::Not);
+        case Opcode::UMin32:
+            return args(2, TablePlan::Op::UMin);
+        case Opcode::UMax32:
+            return args(2, TablePlan::Op::UMax);
+        case Opcode::BitFieldUExtract:
+            return args(3, TablePlan::Op::Bfe);
+        default:
+            error = std::string("offset computed by ") + std::string(IR::NameOf(inst->GetOpcode()));
+            return false;
+        }
+    }
+};
+
+} // namespace
+
+void TablePlan::Build(const IR::Program& program) {
+    entries.clear();
+    ops.clear();
+    table_dwords.clear();
+    error.clear();
+    valid = false;
+    roots = tables = depth = dynamic = 0;
+    flat_dwords = program.info.srt_info.flattened_bufsize_dw;
+    if (flat_dwords < FirstFlat) {
+        error = "flattened user data smaller than the user data";
+        return;
+    }
+    entries.assign(flat_dwords - FirstFlat, Entry{});
+    std::vector<bool> filled(entries.size());
+    std::vector<std::vector<ExprOp>> exprs(entries.size());
+    for (const IR::Block* block : program.blocks) {
+        for (const IR::Inst& inst : block->Instructions()) {
+            const u32 dst = FlatOffset(inst);
+            if (dst == 0) {
+                continue;
+            }
+            if (dst < FirstFlat || dst >= flat_dwords) {
+                error = "table read outside the flattened user data";
+                return;
+            }
+            const IR::Inst* base = inst.Arg(0).TryInst();
+            const IR::Inst* lo = base ? base->Arg(0).TryInst() : nullptr;
+            if (!lo) {
+                error = "table pointer not from the user data or a table";
+                return;
+            }
+            u32 parent = 0;
+            if (lo->GetOpcode() == IR::Opcode::GetUserData) {
+                parent = static_cast<u32>(lo->Arg(0).ScalarReg());
+                if (parent >= FirstFlat) {
+                    error = "table pointer in a register beyond the user data";
+                    return;
+                }
+            } else {
+                parent = FlatOffset(*lo);
+                if (parent < FirstFlat || parent >= dst) {
+                    error = "table pointer not flattened before the values below it";
+                    return;
+                }
+            }
+            Entry entry{.parent = u16(parent)};
+            std::vector<ExprOp> expr;
+            if (inst.Arg(1).IsImmediate()) {
+                entry.offset = inst.Arg(1).U32();
+            } else {
+                Compiler compiler{expr, dst};
+                if (!compiler.Value(inst.Arg(1))) {
+                    error = compiler.error;
+                    return;
+                }
+                if (compiler.max_depth > MaxStack) {
+                    error = "offset expression too deep";
+                    return;
+                }
+                entry.expr_len = u16(expr.size());
+            }
+            const u32 i = dst - FirstFlat;
+            if (filled[i]) {
+                // A duplicate the pass gave the same place: it must be the same read.
+                const Entry& old = entries[i];
+                const bool same_expr =
+                    expr.size() == exprs[i].size() &&
+                    std::equal(expr.begin(), expr.end(), exprs[i].begin(),
+                               [](const ExprOp& a, const ExprOp& b) {
+                                   return a.op == b.op && a.value == b.value;
+                               });
+                if (old.parent != entry.parent || old.expr_len != entry.expr_len ||
+                    (entry.expr_len == 0 && old.offset != entry.offset) || !same_expr) {
+                    error = "two different table reads given one place";
+                    return;
+                }
+                continue;
+            }
+            filled[i] = true;
+            entries[i] = entry;
+            exprs[i] = std::move(expr);
+        }
+    }
+    std::set<u32> parents;
+    std::vector<u32> level(flat_dwords, 0);
+    table_dwords.assign(flat_dwords, 0);
+    for (u32 i = 0; i < entries.size(); ++i) {
+        if (!filled[i]) {
+            error = "a flattened value no table read fills";
+            return;
+        }
+        Entry& entry = entries[i];
+        if (entry.expr_len) {
+            entry.offset = u32(ops.size());
+            ops.insert(ops.end(), exprs[i].begin(), exprs[i].end());
+            ++dynamic;
+        }
+        parents.insert(entry.parent);
+        if (!entry.expr_len) {
+            table_dwords[entry.parent] = std::max(table_dwords[entry.parent], entry.offset + 1);
+        }
+        roots += entry.parent < FirstFlat && level[entry.parent] == 0;
+        level[entry.parent] = entry.parent < FirstFlat ? 1 : std::max(level[entry.parent], 1u);
+        level[FirstFlat + i] = entry.parent < FirstFlat ? 1 : level[entry.parent] + 1;
+        depth = std::max(depth, level[FirstFlat + i]);
+    }
+    tables = u32(parents.size());
+    valid = true;
+}
+
+u32 TablePlan::Offset(const Entry& entry, const u32* flat) const {
+    if (entry.expr_len == 0) {
+        return entry.offset;
+    }
+    u32 stack[MaxStack];
+    u32 top = 0;
+    for (u32 i = entry.offset; i < entry.offset + entry.expr_len; ++i) {
+        const ExprOp& op = ops[i];
+        switch (op.op) {
+        case Op::Imm:
+            stack[top++] = op.value;
+            continue;
+        case Op::Flat:
+            stack[top++] = flat[op.value];
+            continue;
+        case Op::Not:
+            stack[top - 1] = ~stack[top - 1];
+            continue;
+        case Op::Bfe: {
+            const u32 base = stack[top - 3], offset = stack[top - 2] & 31, count = stack[top - 1] & 31;
+            top -= 2;
+            stack[top - 1] = (base >> offset) & ((1u << count) - 1);
+            continue;
+        }
+        default:
+            break;
+        }
+        const u32 b = stack[--top];
+        u32& a = stack[top - 1];
+        switch (op.op) {
+        case Op::Add:
+            a += b;
+            break;
+        case Op::Sub:
+            a -= b;
+            break;
+        case Op::Mul:
+            a *= b;
+            break;
+        case Op::Shl:
+            a <<= b & 31;
+            break;
+        case Op::Shr:
+            a >>= b & 31;
+            break;
+        case Op::And:
+            a &= b;
+            break;
+        case Op::Or:
+            a |= b;
+            break;
+        case Op::Xor:
+            a ^= b;
+            break;
+        case Op::UMin:
+            a = std::min(a, b);
+            break;
+        case Op::UMax:
+            a = std::max(a, b);
+            break;
+        default:
+            break;
+        }
+    }
+    return top ? stack[top - 1] : 0;
+}
+
+TablePlan::Mode TablePlan::GetMode() {
+    static const Mode mode = [] {
+        const char* env = std::getenv("BB_NATIVE_TABLES");
+        const Mode chosen = !env || env[0] == '0' ? Mode::Walker
+                            : env[0] == 'v' || env[0] == 'V' ? Mode::Verify
+                                                             : Mode::Plan;
+        std::printf("Native shaders: resource tables read by %s (BB_NATIVE_TABLES=0/1/verify)\n",
+                    chosen == Mode::Walker ? "the walkers"
+                    : chosen == Mode::Plan ? "table plans"
+                                           : "table plans, the walkers compared");
+        return chosen;
+    }();
+    return mode;
+}
+
+void TablePlan::CompareWithWalker(const void* walker, const u32* user_data, const u32* flat,
+                                  u64 pgm_hash) const {
+    static std::atomic<u32> reports{0}, fault_reports{0};
+    thread_local std::vector<u32> by_walker;
+    by_walker.assign(flat_dwords, 0);
+    std::memcpy(by_walker.data(), flat, std::min(flat_dwords, FirstFlat) * sizeof(u32));
+    // The walker's faults (a read of a table that is not mapped) skip the draw only when the
+    // walker's values are used; here the plan's are.
+    const u32 faults = Info::srt_walk_faults;
+    reinterpret_cast<PFN_SrtWalker>(const_cast<void*>(walker))(user_data, by_walker.data());
+    const u32 walker_faults = Info::srt_walk_faults - faults;
+    Info::srt_walk_faults = faults;
+    if (walker_faults && fault_reports.fetch_add(1, std::memory_order_relaxed) < 16) {
+        std::printf("Native shaders: shader %016llx: the walker faulted %u times on its resource "
+                    "tables (the walker path skips this draw); the plan read them without a "
+                    "fault\n",
+                    static_cast<unsigned long long>(pgm_hash), walker_faults);
+    }
+    u32 first = 0, count = 0;
+    for (u32 d = FirstFlat; d < flat_dwords; ++d) {
+        if (by_walker[d] != flat[d]) {
+            first = count++ ? first : d;
+        }
+    }
+    if (count && reports.fetch_add(1, std::memory_order_relaxed) < 32) {
+        std::printf("Native shaders: shader %016llx: table plan and walker differ in %u of %u "
+                    "words (first %u: walker %#x, plan %#x)\n",
+                    static_cast<unsigned long long>(pgm_hash), count, flat_dwords - FirstFlat,
+                    first, by_walker[first], flat[first]);
+    }
+}
+
+} // namespace Shader::Native
diff --git a/gpu/shadps4/shader_recompiler/native/table_plan.h b/gpu/shadps4/shader_recompiler/native/table_plan.h
new file mode 100644
index 0000000..299e441
--- /dev/null
+++ b/gpu/shadps4/shader_recompiler/native/table_plan.h
@@ -0,0 +1,185 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+// bbport: the native compiler's resource table plan (docs/native_shader_compiler.md, step 1).
+// A shader reads its constants and resource descriptors (T#, V#, S#) through tables in the game's
+// memory: a pointer in the user data, pointers in those tables, and so on. The inherited compiler
+// generates x86 code per shader (the "SRT walker", flatten_extended_userdata_pass.cpp) that copies
+// every value the shader reads from those tables into the flattened user data; a table pointer
+// into unmapped memory faults there, a Windows exception per read. The plan is the same walk as
+// data: one entry per flattened value (where its table pointer is, at which offset it sits), run
+// by an interpreter whose every read of the game's memory is checked first. A table that cannot be
+// read (null, or not mapped) reads as zeros, as its whole subtree does, and nothing faults. Plans
+// are plain data: a shader catalog or pipeline cache can carry them, unlike machine code.
+//
+// Built from the program right after FlattenExtendedUserdataPass, which assigned each table read
+// its place in the flattened user data. bb-shader-lab --tables compares every capture's plan with
+// its walker; the game runs plans with BB_NATIVE_TABLES (GetMode), the walkers by default.
+#pragma once
+
+#include <cstring>
+#include <string>
+#include <vector>
+#include "common/types.h"
+
+namespace Serialization {
+struct Archive;
+}
+
+namespace Shader::IR {
+struct Program;
+}
+
+namespace Shader::Native {
+
+struct TablePlan {
+    /// The postfix operations of a dynamic offset (dwords, 32-bit arithmetic as the walker's).
+    enum class Op : u8 {
+        Imm,  ///< push value
+        Flat, ///< push flat[value] (the user data are flat[0..16))
+        Add,
+        Sub,
+        Mul,
+        Shl, ///< shifts take the count's low 5 bits, as x86 does
+        Shr,
+        And,
+        Or,
+        Xor,
+        Not,
+        UMin,
+        UMax,
+        Bfe, ///< (base >> offset) & ((1 << count) - 1), offset and count & 31
+    };
+    struct ExprOp {
+        Op op;
+        u32 value;
+    };
+    static constexpr u32 MaxStack = 16;
+
+    /// flat[FirstFlat + i] = the dword at table(parent) + 4 * offset. `parent` names where the
+    /// table's pointer is: a user data register (below 16; the pointer is user data parent and
+    /// parent + 1) or a flattened value (the pointer is the 64 bits at that value's own place).
+    /// Pointers keep their low 48 bits, as the walker does.
+    struct Entry {
+        u16 parent;
+        u16 expr_len; ///< 0: the offset is `offset`, else ops[offset, offset + expr_len)
+        u32 offset;
+    };
+    static constexpr u32 FirstFlat = 16;
+    /// Below this a table pointer is null: no guest memory is mapped there.
+    static constexpr u64 NullBelow = 0x10000;
+
+    std::vector<Entry> entries;
+    std::vector<ExprOp> ops;
+    /// Per flattened value that is a table's pointer (and per user data register): the dwords its
+    /// constant offsets span, so a readable table is checked once, not per read. 0 elsewhere.
+    std::vector<u32> table_dwords;
+    u32 flat_dwords = FirstFlat;
+    bool valid = false;
+    std::string error; ///< why Build failed
+
+    // For the census.
+    u32 roots = 0;    ///< user data registers that hold table pointers
+    u32 tables = 0;   ///< tables read, roots included
+    u32 depth = 0;    ///< pointer levels below the user data (1: tables the user data point at)
+    u32 dynamic = 0;  ///< entries with a computed offset
+
+    /// The plan of `program`, after FlattenExtendedUserdataPass.
+    void Build(const IR::Program& program);
+
+    /// Reads the tables of `user_data` into flat[FirstFlat, flat_dwords), as the walker does, with
+    /// every read of guest memory checked by `readable(address, bytes)` first; flat[0, FirstFlat)
+    /// must hold the user data (Info::RefreshFlatBuf). Returns the number of reads refused.
+    template <class Readable>
+    u32 Run(const u32* user_data, u32* flat, Readable&& readable) const;
+
+    /// An entry's offset in its table, in dwords, from the values flattened before it.
+    u32 Offset(const Entry& entry, const u32* flat) const;
+
+    /// The pipeline cache's shader record carries the plan after the walker (a record without one
+    /// runs the walker). Defined with the other records, vk_pipeline_serialization.cpp.
+    void Serialize(Serialization::Archive& ar) const;
+    bool Deserialize(Serialization::Archive& ar);
+
+    /// BB_NATIVE_TABLES: who reads the resource tables in the game. Walker (0, the default), Plan
+    /// (1), or Verify: the plan's values are used, the walker runs beside it into a copy and every
+    /// difference is logged. A shader without a valid plan (a record from an older engine) runs
+    /// the walker in every mode.
+    enum class Mode : u8 { Walker, Plan, Verify };
+    static Mode GetMode();
+
+    /// Verify: the walker over the same user data, compared with the plan's `flat`. Its faults
+    /// are not counted as the draw's (the plan's values are used). Logs the first differences.
+    /// `walker` is a PFN_SrtWalker.
+    void CompareWithWalker(const void* walker, const u32* user_data, const u32* flat,
+                           u64 pgm_hash) const;
+
+    /// Whether [address, address + bytes) is mapped guest memory: set by the engine at start
+    /// (shim/bbgpu.cpp). Plans do not run without it.
+    static inline bool (*guest_readable)(u64 address, u64 bytes) = nullptr;
+
+    /// bb-shader-lab: when set, TranslateProgram builds the plan of each program it translates
+    /// there too (shader_recompiler/recompiler.cpp).
+    static inline thread_local TablePlan* lab_target = nullptr;
+};
+
+template <class Readable>
+u32 TablePlan::Run(const u32* user_data, u32* flat, Readable&& readable) const {
+    if (!valid) {
+        return 0;
+    }
+    // Per flattened value (or user data register) that is a table's pointer: the table's address
+    // once read (0: null or unreadable), and whether its constant offsets were checked at once.
+    // Pointers are read when the first entry below them needs them, after the value itself.
+    static constexpr u64 Unread = ~u64{0};
+    thread_local std::vector<u64> table, place;
+    thread_local std::vector<u8> whole;
+    table.assign(flat_dwords, Unread);
+    place.assign(flat_dwords, 0); ///< where each flattened value was read
+    whole.assign(flat_dwords, 0);
+    u32 refused = 0;
+    const auto pointer_of = [&](u16 parent) -> u64 {
+        u64& ptr = table[parent];
+        if (ptr != Unread) {
+            return ptr;
+        }
+        u64 value = 0;
+        if (parent < FirstFlat) {
+            value = u64(user_data[parent]) |
+                    (parent + 1 < FirstFlat ? u64(user_data[parent + 1]) << 32 : 0);
+        } else if (const u64 at = place[parent]; at != 0) {
+            if (readable(at, 8)) {
+                std::memcpy(&value, reinterpret_cast<const void*>(at), 8);
+            } else {
+                ++refused;
+            }
+        }
+        value &= 0xFFFFFFFFFFFFull;
+        ptr = value < NullBelow ? 0 : value;
+        if (ptr && table_dwords[parent] && readable(ptr, u64(table_dwords[parent]) * 4)) {
+            whole[parent] = 1;
+        }
+        return ptr;
+    };
+    for (size_t i = 0; i < entries.size(); ++i) {
+        const Entry& entry = entries[i];
+        const u32 dst = FirstFlat + u32(i);
+        const u64 base = pointer_of(entry.parent);
+        if (base == 0) {
+            flat[dst] = 0; // its table, or one above it, is null or could not be read
+            continue;
+        }
+        const u64 at = base + u64(u32(Offset(entry, flat) << 2));
+        u32 value = 0;
+        if ((entry.expr_len == 0 && whole[entry.parent] &&
+             entry.offset < table_dwords[entry.parent]) ||
+            readable(at, 4)) {
+            std::memcpy(&value, reinterpret_cast<const void*>(at), 4);
+            place[dst] = at;
+        } else {
+            ++refused;
+        }
+        flat[dst] = value;
+    }
+    return refused;
+}
+
+} // namespace Shader::Native
diff --git a/gpu/shadps4/shader_recompiler/native/tone_curve.cpp b/gpu/shadps4/shader_recompiler/native/tone_curve.cpp
new file mode 100644
index 0000000..2312138
--- /dev/null
+++ b/gpu/shadps4/shader_recompiler/native/tone_curve.cpp
@@ -0,0 +1,434 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#include "shader_recompiler/native/tone_curve.h"
+
+#include <algorithm>
+#include <cstdio>
+#include <cstdlib>
+#include <map>
+#include <set>
+#include "shader_recompiler/info.h"
+#include "shader_recompiler/ir/basic_block.h"
+#include "shader_recompiler/ir/ir_emitter.h"
+#include "shader_recompiler/ir/program.h"
+
+namespace Shader::Native {
+namespace {
+
+using IR::Opcode;
+
+/// `value`'s instruction when it is one of `op`, else null.
+IR::Inst* As(const IR::Value& value, Opcode op) {
+    if (value.IsImmediate()) {
+        return nullptr;
+    }
+    IR::Inst* inst = value.TryInst();
+    return inst && inst->GetOpcode() == op ? inst : nullptr;
+}
+
+bool IsImm(const IR::Value& value, f32 wanted) {
+    return value.IsImmediate() && value.Type() == IR::Type::F32 && value.F32() == wanted;
+}
+
+/// The constant buffer dword a value reads as a float (BitCastF32U32 of ReadConstBuffer), or -1.
+s64 ConstWord(const IR::Value& value) {
+    const IR::Inst* cast = As(value, Opcode::BitCastF32U32);
+    if (!cast) {
+        return -1;
+    }
+    const IR::Inst* read = As(cast->Arg(0), Opcode::ReadConstBuffer);
+    if (!read || !read->Arg(1).IsImmediate()) {
+        return -1;
+    }
+    return read->Arg(1).U32();
+}
+
+/// Whether `inst` is the two-operand `op` of `a` and `b` in either order; the matchers are
+/// called with (operand, is it the first?) and must both hold.
+template <class A, class B>
+bool Both(const IR::Inst* inst, Opcode op, A&& a, B&& b) {
+    if (!inst || inst->GetOpcode() != op) {
+        return false;
+    }
+    return (a(inst->Arg(0)) && b(inst->Arg(1))) || (a(inst->Arg(1)) && b(inst->Arg(0)));
+}
+
+bool SameInst(const IR::Value& value, const IR::Inst* inst) {
+    return !value.IsImmediate() && value.TryInst() == inst;
+}
+
+/// y = A * B * B with A = 1 - exp2(#1.442695 * (-x * k)), B = 1 + c * (#-1 + A).
+bool MatchExponential(IR::Inst* clamp, ToneCurveMatch& m) {
+    IR::Inst* product = As(clamp->Arg(0), Opcode::FPMul32);
+    if (!product) {
+        return false;
+    }
+    IR::Inst *a = nullptr, *b = nullptr;
+    // product = B * (A * B), in any order.
+    for (int i = 0; i < 2 && !a; ++i) {
+        IR::Inst* candidate_b = As(product->Arg(i), Opcode::FPAdd32);
+        IR::Inst* inner = As(product->Arg(1 - i), Opcode::FPMul32);
+        if (!candidate_b || !inner) {
+            continue;
+        }
+        for (int j = 0; j < 2; ++j) {
+            if (SameInst(inner->Arg(j), candidate_b)) {
+                if (IR::Inst* candidate_a = As(inner->Arg(1 - j), Opcode::FPSub32)) {
+                    a = candidate_a;
+                    b = candidate_b;
+                }
+            }
+        }
+    }
+    if (!a || !IsImm(a->Arg(0), 1.0f)) {
+        return false;
+    }
+    IR::Inst* exp = As(a->Arg(1), Opcode::FPExp2);
+    if (!exp) {
+        return false;
+    }
+    IR::Inst* exponent = As(exp->Arg(0), Opcode::FPMul32);
+    IR::Inst* negated_scaled = nullptr;
+    if (!Both(exponent, Opcode::FPMul32, [](const IR::Value& v) { return IsImm(v, 1.442695f); },
+              [&](const IR::Value& v) { return (negated_scaled = As(v, Opcode::FPMul32)); })) {
+        return false;
+    }
+    IR::Inst* scene = nullptr;
+    IR::Value k;
+    if (!Both(negated_scaled, Opcode::FPMul32,
+              [&](const IR::Value& v) {
+                  const IR::Inst* neg = As(v, Opcode::FPNeg32);
+                  return neg && (scene = As(neg->Arg(0), Opcode::FPMax32));
+              },
+              [&](const IR::Value& v) { return ConstWord(v) >= 0 && (k = v, true); })) {
+        return false;
+    }
+    if (!Both(scene, Opcode::FPMax32, [](const IR::Value& v) { return IsImm(v, 6.1035156e-05f); },
+              [](const IR::Value&) { return true; })) {
+        return false;
+    }
+    // B = (c * (#-1 + A)) + #1
+    IR::Value c;
+    const bool shoulder = Both(
+        b, Opcode::FPAdd32, [](const IR::Value& v) { return IsImm(v, 1.0f); },
+        [&](const IR::Value& v) {
+            return Both(As(v, Opcode::FPMul32), Opcode::FPMul32,
+                        [&](const IR::Value& w) { return ConstWord(w) >= 0 && (c = w, true); },
+                        [&](const IR::Value& w) {
+                            return Both(As(w, Opcode::FPAdd32), Opcode::FPAdd32,
+                                        [](const IR::Value& u) { return IsImm(u, -1.0f); },
+                                        [&](const IR::Value& u) { return SameInst(u, a); });
+                        });
+        });
+    if (!shoulder) {
+        return false;
+    }
+    m = ToneCurveMatch{.family = ToneCurveMatch::Family::Exponential,
+                       .result = clamp,
+                       .product = product,
+                       .scene = scene,
+                       .exponent = exponent,
+                       .k = k,
+                       .shoulder = c,
+                       .k_word = u32(ConstWord(k)),
+                       .shoulder_word = u32(ConstWord(c))};
+    return true;
+}
+
+/// y = (k*x + (k*x) * (w * (k*x))) * recip(k*x + #1), x = max(#6.1035156e-05, s).
+bool MatchReinhard(IR::Inst* clamp, ToneCurveMatch& m) {
+    IR::Inst* product = As(clamp->Arg(0), Opcode::FPMul32);
+    IR::Inst *numerator = nullptr, *recip = nullptr;
+    if (!Both(product, Opcode::FPMul32,
+              [&](const IR::Value& v) { return (numerator = As(v, Opcode::FPAdd32)); },
+              [&](const IR::Value& v) { return (recip = As(v, Opcode::FPRecip32)); })) {
+        return false;
+    }
+    IR::Inst* scene = nullptr;
+    IR::Value k;
+    s64 k_word = -1;
+    // k * x, the same k and x everywhere.
+    const auto kx = [&](const IR::Value& v) {
+        IR::Inst* scene_here = nullptr;
+        IR::Value k_here;
+        const bool is = Both(As(v, Opcode::FPMul32), Opcode::FPMul32,
+                             [&](const IR::Value& w) { return (scene_here = As(w, Opcode::FPMax32)); },
+                             [&](const IR::Value& w) { return ConstWord(w) >= 0 && (k_here = w, true); });
+        if (!is || (scene && scene_here != scene) || (k_word >= 0 && ConstWord(k_here) != k_word)) {
+            return false;
+        }
+        scene = scene_here;
+        k = k_here;
+        k_word = ConstWord(k_here);
+        return true;
+    };
+    IR::Inst* exponent = nullptr;
+    if (!Both(As(recip->Arg(0), Opcode::FPAdd32), Opcode::FPAdd32,
+              [&](const IR::Value& v) { return kx(v) && (exponent = v.Inst()); },
+              [](const IR::Value& v) { return IsImm(v, 1.0f); })) {
+        return false;
+    }
+    IR::Value w;
+    const bool shape = Both(
+        numerator, Opcode::FPAdd32, kx, [&](const IR::Value& v) {
+            return Both(As(v, Opcode::FPMul32), Opcode::FPMul32, kx, [&](const IR::Value& u) {
+                return Both(As(u, Opcode::FPMul32), Opcode::FPMul32,
+                            [&](const IR::Value& t) { return ConstWord(t) >= 0 && (w = t, true); },
+                            kx);
+            });
+        });
+    if (!shape || !Both(scene, Opcode::FPMax32,
+                        [](const IR::Value& v) { return IsImm(v, 6.1035156e-05f); },
+                        [](const IR::Value&) { return true; })) {
+        return false;
+    }
+    m = ToneCurveMatch{.family = ToneCurveMatch::Family::Reinhard,
+                       .result = clamp,
+                       .product = product,
+                       .scene = scene,
+                       .exponent = exponent,
+                       .k = k,
+                       .shoulder = w,
+                       .k_word = u32(k_word),
+                       .shoulder_word = u32(ConstWord(w))};
+    return true;
+}
+
+} // namespace
+
+std::vector<ToneCurveMatch> FindToneCurves(const IR::Program& program) {
+    std::vector<ToneCurveMatch> matches;
+    for (IR::Block* block : program.blocks) {
+        for (IR::Inst& inst : block->Instructions()) {
+            if (inst.GetOpcode() != Opcode::FPSaturate32) {
+                continue;
+            }
+            ToneCurveMatch m;
+            if (MatchExponential(&inst, m) || MatchReinhard(&inst, m)) {
+                matches.push_back(m);
+            }
+        }
+    }
+    return matches;
+}
+
+bool IsComposite(const std::vector<ToneCurveMatch>& matches) {
+    if (matches.size() != 3) {
+        return false;
+    }
+    std::set<const IR::Inst*> scenes;
+    for (const auto& m : matches) {
+        if (m.family != matches[0].family || m.k_word != matches[0].k_word ||
+            m.shoulder_word != matches[0].shoulder_word) {
+            return false;
+        }
+        scenes.insert(m.scene);
+    }
+    return scenes.size() == 3;
+}
+
+bool ToneCurveEnabled() {
+    if (tone_curve_lab_override >= 0) {
+        return tone_curve_lab_override != 0;
+    }
+    static const bool enabled = [] {
+        const char* env = std::getenv("BB_HDR_SCENE_CURVE");
+        const bool on = env && env[0] == '1';
+        if (on) {
+            std::printf("Native shaders: the composite's tone curve extended above its knee for "
+                        "HDR (BB_HDR_SCENE_CURVE=1; shader caches kept apart)\n");
+        }
+        return on;
+    }();
+    return enabled;
+}
+
+bool ExtendToneCurve(IR::Program& program) {
+    if (program.info.sw_stage != SwStage::Fragment) {
+        return false;
+    }
+    auto matches = FindToneCurves(program);
+    if (!IsComposite(matches)) {
+        return false;
+    }
+    // Branch-free composites: the curve and everything it reaches in one block.
+    IR::Block& block = *matches[0].result->GetParent();
+    for (const auto& m : matches) {
+        if (m.result->GetParent() != &block) {
+            return false;
+        }
+    }
+    // Program order: the first channel's clamp is where the shared values go.
+    std::map<const IR::Inst*, size_t> order;
+    size_t index = 0;
+    for (IR::Inst& inst : block.Instructions()) {
+        order[&inst] = index++;
+    }
+    std::ranges::sort(matches, [&](const auto& a, const auto& b) {
+        return order.at(a.result) < order.at(b.result);
+    });
+
+    // The clamps the curve's values reach on their way to the outputs (before any change), with
+    // the channels that reach each.
+    std::map<IR::Inst*, std::set<size_t>> later_clamps;
+    for (size_t channel = 0; channel < matches.size(); ++channel) {
+        std::vector<IR::Inst*> work{matches[channel].result};
+        std::set<IR::Inst*> seen;
+        while (!work.empty()) {
+            IR::Inst* inst = work.back();
+            work.pop_back();
+            for (const IR::Use& use : inst->Uses()) {
+                IR::Inst* user = use.user;
+                if (!seen.insert(user).second) {
+                    continue;
+                }
+                if (user->GetParent() != &block) {
+                    return false;
+                }
+                if (user->GetOpcode() == Opcode::FPSaturate32) {
+                    later_clamps[user].insert(channel);
+                }
+                work.push_back(user);
+            }
+        }
+    }
+
+    using F32 = IR::F32;
+    const auto first_at = IR::Block::InstructionList::s_iterator_to(*matches[0].result);
+    IR::IREmitter ir{block, std::next(first_at)};
+    const auto f = [](const IR::Value& v) { return F32{v}; };
+    const auto imm = [&](f32 v) { return ir.Imm32(v); };
+    const auto add = [&](F32 a, F32 b) { return f(ir.FPAdd(a, b)); };
+    const auto sub = [&](F32 a, F32 b) { return f(ir.FPSub(a, b)); };
+    const auto mul = [&](F32 a, F32 b) { return f(ir.FPMul(a, b)); };
+    const auto div = [&](F32 a, F32 b) { return f(ir.FPDiv(a, b)); };
+
+    // Parameters (push data).
+    const F32 knee = f(ir.FPClamp(ir.ToneCurveParam(0), imm(0.05f), imm(0.99f)));
+    const F32 peak = ir.ToneCurveParam(1);
+    const F32 strength = f(ir.FPClamp(ir.ToneCurveParam(2), imm(0.0f), imm(1.0f)));
+    const IR::U1 on = ir.LogicalAnd(ir.FPGreaterThan(ir.ToneCurveParam(3), imm(0.5f)),
+                                    ir.FPGreaterThan(peak, imm(1.0f)));
+    const F32 top = ir.FPLog2(f(ir.FPMax(peak, imm(1.0f))));
+    const F32 start = mul(top, imm(float(ToneCurveRollOff) / 100.0f));
+    const F32 room = f(ir.FPMax(sub(top, start), imm(1e-6f)));
+
+    // The knee in the curve's units (z_k, increasing with the scene), the curve's value there
+    // (log2) and its slope in log2-log2 (g): where the extension starts, continuous in value and
+    // slope.
+    const auto& m0 = matches[0];
+    const F32 k = F32{m0.k};
+    const F32 shoulder = F32{m0.shoulder};
+    F32 z_knee, log_knee, slope;
+    if (m0.family == ToneCurveMatch::Family::Exponential) {
+        // (1 - e) * (1 - c e)^2 = knee for e = exp(-u); Newton from the c = 0 answer.
+        F32 e = sub(imm(1.0f), knee);
+        for (int i = 0; i < 5; ++i) {
+            const F32 b = sub(imm(1.0f), mul(shoulder, e));
+            const F32 a = sub(imm(1.0f), e);
+            const F32 value = sub(mul(a, mul(b, b)), knee);
+            const F32 derivative = f(ir.FPNeg(add(mul(b, b), mul(imm(2.0f), mul(shoulder, mul(a, b))))));
+            e = f(ir.FPClamp(sub(e, div(value, derivative)), imm(1e-7f), imm(1.0f - 1e-6f)));
+        }
+        const F32 a = sub(imm(1.0f), e);
+        const F32 b = sub(imm(1.0f), mul(shoulder, e));
+        const F32 y = mul(a, mul(b, b));
+        // u = -ln e; the shader's own coordinate is the exp2 argument, -u * log2(e).
+        const F32 u = mul(f(ir.FPNeg(ir.FPLog2(e))), imm(0.6931472f));
+        z_knee = f(ir.FPNeg(ir.FPLog2(e)));
+        log_knee = ir.FPLog2(y);
+        slope = div(mul(u, mul(e, mul(b, add(b, mul(imm(2.0f), mul(shoulder, a)))))), y);
+    } else {
+        // v (1 + w v) / (1 + v) = knee: w v^2 + (1 - knee) v - knee = 0.
+        const F32 w = f(ir.FPMax(shoulder, imm(0.0f)));
+        const F32 one_minus = sub(imm(1.0f), knee);
+        const F32 root = ir.FPSqrt(add(mul(one_minus, one_minus), mul(imm(4.0f), mul(w, knee))));
+        const F32 quadratic = div(sub(root, one_minus), f(ir.FPMax(mul(imm(2.0f), w), imm(1e-30f))));
+        const F32 linear = div(knee, one_minus);
+        const F32 v = F32{ir.Select(ir.FPGreaterThan(w, imm(1e-12f)), quadratic, linear)};
+        const F32 one_plus = add(imm(1.0f), v);
+        const F32 y = div(mul(v, add(imm(1.0f), mul(w, v))), one_plus);
+        const F32 dy = div(sub(mul(add(imm(1.0f), mul(imm(2.0f), mul(w, v))), one_plus),
+                               mul(v, add(imm(1.0f), mul(w, v)))),
+                           mul(one_plus, one_plus));
+        z_knee = v;
+        log_knee = ir.FPLog2(y);
+        slope = div(mul(v, dy), y);
+    }
+    (void)k;
+
+    // Per channel: the extension, and the select.
+    std::vector<IR::U1> above(matches.size());
+    std::vector<F32> extended(matches.size());
+    for (size_t channel = 0; channel < matches.size(); ++channel) {
+        const auto& m = matches[channel];
+        IR::IREmitter at{block, std::next(IR::Block::InstructionList::s_iterator_to(*m.result))};
+        if (channel == 0) {
+            at = ir; // after the shared values
+        }
+        const auto F = [](const IR::Value& v) { return F32{v}; };
+        const F32 z = m.family == ToneCurveMatch::Family::Exponential
+                          ? F(at.FPNeg(F32{IR::Value{m.exponent}}))
+                          : F32{IR::Value{m.exponent}};
+        above[channel] = at.LogicalAnd(on, at.FPGreaterThan(z, z_knee));
+        // Linear in log2 from the knee with the curve's slope there...
+        const F32 stops = at.FPLog2(F(at.FPDiv(F(at.FPMax(z, at.Imm32(1e-30f))), z_knee)));
+        const F32 linear = F(at.FPAdd(log_knee, F(at.FPMul(slope, stops))));
+        // ...to `ToneCurveRollOff` of the stops to the peak, then towards the peak.
+        const F32 over = F(at.FPDiv(F(at.FPSub(linear, start)), room));
+        const F32 rolled = F(at.FPAdd(
+            start, F(at.FPMul(room, F(at.FPSub(at.Imm32(1.0f),
+                                                at.FPExp2(F(at.FPMul(F(at.FPNeg(over)),
+                                                                      at.Imm32(1.442695f))))))))));
+        const F32 target = F32{at.Select(at.FPGreaterThan(linear, start), rolled, linear)};
+        // Strength: the share of the extension in log2 against the game's curve (as shown, so at
+        // most 1: Reinhard's grows past its white without a bound). Both meet at the knee.
+        const F32 game = at.FPLog2(F(at.FPMax(F32{IR::Value{m.result}}, at.Imm32(1e-30f))));
+        const F32 mixed = F(at.FPAdd(game, F(at.FPMul(strength, F(at.FPSub(target, game))))));
+        extended[channel] = F32{at.Select(above[channel], at.FPExp2(mixed),
+                                          F32{IR::Value{m.result}})};
+    }
+    // The game's uses of each channel's clamp (`order` holds the game's instructions) take the
+    // select instead.
+    for (size_t channel = 0; channel < matches.size(); ++channel) {
+        IR::Inst* clamp = matches[channel].result;
+        IR::Inst* select = extended[channel].Inst();
+        std::vector<IR::Use> uses(clamp->Uses().begin(), clamp->Uses().end());
+        for (const IR::Use& use : uses) {
+            if (!order.contains(use.user)) {
+                continue; // ours
+            }
+            IR::Value replacement = IR::Value{select};
+            if (use.user->GetOpcode() == Opcode::FPNeg32) {
+                // A screen blend (a + g - a g): above 1 the glow no longer darkens the highlight.
+                IR::IREmitter before{block, IR::Block::InstructionList::s_iterator_to(*use.user)};
+                replacement = before.FPMin(F32{IR::Value{select}}, before.Imm32(1.0f));
+            }
+            use.user->SetArg(use.operand, replacement);
+        }
+    }
+    // The later clamps: to the peak where a channel reaching them is above the knee, else to 1
+    // (the same FClamp to 1: bit for bit).
+    for (const auto& [clamp, channels] : later_clamps) {
+        IR::IREmitter before{block, IR::Block::InstructionList::s_iterator_to(*clamp)};
+        IR::U1 any = before.Imm1(false);
+        for (const size_t channel : channels) {
+            any = before.LogicalOr(any, above[channel]);
+        }
+        const IR::Value upper = before.Select(any, before.Imm32(3.0e38f), before.Imm32(1.0f));
+        const IR::Value value = clamp->Arg(0);
+        clamp->ReplaceOpcode(Opcode::FPClamp32);
+        clamp->SetArg(0, value);
+        clamp->SetArg(1, before.Imm32(0.0f));
+        clamp->SetArg(2, upper);
+    }
+    program.info.uses_tone_curve = true;
+    if (tone_curve_lab_channels) {
+        tone_curve_lab_channels->clear();
+        for (const F32& value : extended) {
+            tone_curve_lab_channels->push_back(value.Inst());
+        }
+    }
+    return true;
+}
+
+} // namespace Shader::Native
diff --git a/gpu/shadps4/shader_recompiler/native/tone_curve.h b/gpu/shadps4/shader_recompiler/native/tone_curve.h
new file mode 100644
index 0000000..67dd268
--- /dev/null
+++ b/gpu/shadps4/shader_recompiler/native/tone_curve.h
@@ -0,0 +1,77 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+// bbport: the game's tone curve in its final composite pixel shaders, found in the IR and extended
+// above a knee for HDR (docs/hdr-scene-path.md, steps 1 and 2; docs/native_shader_compiler.md).
+//
+// The composites apply the curve per channel to the scene (bloom added) clamped below at 2^-14:
+//   exponential:        y = A * B * B,  A = 1 - exp2(-1.442695 * k * x),  B = 1 + c * (A - 1)
+//                       (k, c: constant buffer words 832, 833)
+//   extended Reinhard:  y = v * (1 + w * v) / (1 + v),  v = k * x
+//                       (k, w: constant buffer words 833, 834)
+// each followed by a clamp to [0, 1] (FPSaturate32). FindToneCurves recognises them by that IR
+// shape; a composite has one per colour channel.
+//
+// ExtendToneCurve (off unless BB_HDR_SCENE_CURVE=1) replaces each channel's clamped curve by a
+// select: the game's value below the knee (its own instructions: bit for bit), above it an
+// extension continuous in value and slope that rolls off towards the peak over paper white, as
+// native mode's gain does. The clamps after the curve on its way to the colour output stop at the
+// peak instead of 1 only where a channel is above the knee. Its parameters are push data
+// (ToneCurvePush), so they change live.
+#pragma once
+
+#include <vector>
+#include "common/types.h"
+#include "shader_recompiler/ir/value.h"
+
+namespace Shader::IR {
+struct Program;
+}
+
+namespace Shader::Native {
+
+struct ToneCurveMatch {
+    enum class Family : u8 { Exponential, Reinhard };
+    Family family{};
+    IR::Inst* result{};  ///< the clamp: FPSaturate32 of `product`
+    IR::Inst* product{}; ///< the curve before the clamp
+    IR::Inst* scene{};   ///< FPMax32(#6.1035156e-05, scene value)
+    /// The scene value in the curve's own units, increasing with it: exponential: the exp2
+    /// argument (-1.442695 * k * x, so it decreases: negated when used); Reinhard: k * x.
+    IR::Inst* exponent{};
+    IR::Value k;         ///< the curve's scale (F32)
+    IR::Value shoulder;  ///< exponential: c; Reinhard: w (F32)
+    u32 k_word{};        ///< constant buffer dwords of k and the shoulder
+    u32 shoulder_word{};
+};
+
+/// Every tone curve channel in `program` (any stage; the composites have three).
+std::vector<ToneCurveMatch> FindToneCurves(const IR::Program& program);
+
+/// Whether the curves in `matches` are one composite's: three channels, one family, the same
+/// constants, three scene values.
+bool IsComposite(const std::vector<ToneCurveMatch>& matches);
+
+/// BB_HDR_SCENE_CURVE=1 (read once): composites are compiled with the extension. Shader caches
+/// then live beside the usual ones (cache_storage.cpp), so turning it on or off never mixes them.
+bool ToneCurveEnabled();
+
+/// Extends a composite's curve in place (a fragment program in one block). Returns whether it
+/// did; sets Info::uses_tone_curve.
+bool ExtendToneCurve(IR::Program& program);
+
+/// bb-shader-lab: overrides BB_HDR_SCENE_CURVE for this thread (-1: the variable decides), and
+/// when set receives each channel's new value (the select) in the clamps' program order.
+inline thread_local int tone_curve_lab_override = -1;
+inline thread_local std::vector<IR::Inst*>* tone_curve_lab_channels = nullptr;
+
+/// The extension's parameters, pushed after Shader::PushData by pipelines whose fragment shader
+/// uses them (Info::uses_tone_curve).
+struct ToneCurvePush {
+    float knee;     ///< the curve's output (0..1, SDR) where the extension starts
+    float peak;     ///< peak / paper white: the most a channel reaches (SDR white = 1)
+    float strength; ///< share of the extension in log2 (0: the game's curve, 1: all of it)
+    float enabled;  ///< 0: the game's curve everywhere (bit for bit)
+};
+inline constexpr u32 ToneCurvePushOffset = 128;
+inline constexpr u32 ToneCurveRollOff = 70; ///< percent of the stops to the peak kept linear
+
+} // namespace Shader::Native

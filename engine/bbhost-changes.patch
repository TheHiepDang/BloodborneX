+
+bool Fsr4Vk::FilesPresent() {
+#ifdef _WIN32
+    const char* setting = std::getenv("BB_FSR4VK");
+    if (setting && setting[0] == '0') {
+        return false;
+    }
+    std::error_code error;
+    return std::filesystem::is_regular_file(Directory() / LibraryName, error);
+#else
+    return false;
+#endif

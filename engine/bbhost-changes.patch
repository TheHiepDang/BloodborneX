@@ -0,0 +1,150 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Vulkan-only caller-gate forwarder derived from OptiScaler_DLSSNR.
+#define WIN32_LEAN_AND_MEAN
+#include <windows.h>
+#include <initializer_list>
+#include <cstdio>
+
+namespace {
+constexpr int SetUll = 0;
+// The caller supplies NVIDIA's Windows/MSVC parameter object, whose overloaded
+// methods are reversed within the Set/Get group. OptiScaler's own object uses
+// declaration order and must not supply the indices for this object.
+constexpr int SetUint = 4;
+constexpr int SetFloat = 6;
+using ParamSetUll = void(__thiscall*)(void*, const char*, unsigned long long);
+using ParamSetUint = void(__thiscall*)(void*, const char*, unsigned int);
+using ParamSetFloat = void(__thiscall*)(void*, const char*, float);
+void SetUI(void* parameters, const char* name, unsigned value) {
+    auto** table = *reinterpret_cast<void***>(parameters);
+    reinterpret_cast<ParamSetUint>(table[SetUint])(parameters, name, value);
+}
+void SetF(void* parameters, const char* name, float value) {
+    auto** table = *reinterpret_cast<void***>(parameters);
+    reinterpret_cast<ParamSetFloat>(table[SetFloat])(parameters, name, value);
+}
+void SetP(void* parameters, const char* name, void* value) {
+    auto** table = *reinterpret_cast<void***>(parameters);
+    reinterpret_cast<ParamSetUll>(table[SetUll])(
+        parameters, name, reinterpret_cast<unsigned long long>(value));
+}
+using Init = int(__cdecl*)(unsigned long long, const wchar_t*, void*, void*, void*, const void*, int);
+using Create = int(__cdecl*)(void*, int, const void*, void**);
+using Evaluate = int(__cdecl*)(void*, const void*, const void*, void*);
+using Release = int(__cdecl*)(void*);
+HMODULE module;
+Init init;
+Create create;
+Evaluate evaluate;
+Release release;
+bool initialized;
+bool traced_parameters;
+void TraceParameters(void* parameters) {
+    if (traced_parameters || !GetEnvironmentVariableW(L"BB_DLSS_NR_DEBUG", nullptr, 0)) return;
+    traced_parameters = true;
+    auto** table = *reinterpret_cast<void***>(parameters);
+    using GetUI = int(__thiscall*)(void*, const char*, unsigned*);
+    using GetF = int(__thiscall*)(void*, const char*, float*);
+    for (const char* name : {"DLSSNR.Enabled", "DLSSNR.Width", "DLSSNR.UseAutoMask", "DLSSNR.Reset"}) {
+        unsigned value = 0xdeadbeef;
+        int result = reinterpret_cast<GetUI>(table[12])(parameters, name, &value);
+        std::printf("DLSS NR parameter: %s=%u (get=0x%08x)\n", name, value, unsigned(result));
+    }
+    for (const char* name : {"DLSSNR.Intensity", "DLSSNR.MVecScaleX", "DLSSNR.LocalToneStrength"}) {
+        float value = -999.0f;
+        int result = reinterpret_cast<GetF>(table[14])(parameters, name, &value);
+        std::printf("DLSS NR parameter: %s=%g (get=0x%08x)\n", name, value, unsigned(result));
+    }
+    std::fflush(stdout);
+}
+bool Load(const wchar_t* path) {
+    if (module) return init && create && evaluate && release;
+    module = LoadLibraryExW(path, nullptr, LOAD_WITH_ALTERED_SEARCH_PATH);
+    if (!module) return false;
+    init = reinterpret_cast<Init>(GetProcAddress(module, "NVSDK_NGX_VULKAN_Init_Ext"));
+    create = reinterpret_cast<Create>(GetProcAddress(module, "NVSDK_NGX_VULKAN_CreateFeature"));
+    evaluate = reinterpret_cast<Evaluate>(GetProcAddress(module, "NVSDK_NGX_VULKAN_EvaluateFeature"));
+    release = reinterpret_cast<Release>(GetProcAddress(module, "NVSDK_NGX_VULKAN_ReleaseFeature"));
+    return init && create && evaluate && release;
+}
+} // namespace
+
+extern "C" {
+__declspec(dllexport) int dlssnr_vk_probe(const wchar_t* path) { return Load(path) ? 15 : 0; }
+__declspec(dllexport) int dlssnr_vk_init(const wchar_t* path, const wchar_t* data_path,
+                                         void* instance, void* physical, void* device,
+                                         int sdk_version) {
+    if (!Load(path)) return -1;
+    if (initialized) return 1;
+    // An assigned result prevents a tail call; the snippet validates this module's return address.
+    volatile int result = init(0, data_path, instance, physical, device, nullptr, sdk_version);
+    initialized = result == 1;
+    return result;
+}
+__declspec(dllexport) void* dlssnr_vk_create(
+    void* command_buffer, void* parameters, unsigned width, unsigned height, int preset,
+    float intensity, int style, float local_structure, float local_tone, float skin_structure,
+    int auto_mask, int ui_correction) {
+    if (!create || !command_buffer || !parameters) return nullptr;
+    SetUI(parameters, "DLSSNR.Enabled", 1);
+    SetUI(parameters, "DLSSNR.Width", width);
+    SetUI(parameters, "DLSSNR.Height", height);
+    SetUI(parameters, "CreationNodeMask", 1);
+    SetUI(parameters, "VisibilityNodeMask", 1);
+    SetUI(parameters, "DLSSNR.Hint.Render.Preset", unsigned(preset));
+    SetF(parameters, "DLSSNR.Intensity", intensity);
+    SetUI(parameters, "DLSSNR.Style", unsigned(style));
+    SetF(parameters, "DLSSNR.LocalStructureStrength", local_structure);
+    SetF(parameters, "DLSSNR.LocalToneStrength", local_tone);
+    SetF(parameters, "DLSSNR.SkinStructureStrength", skin_structure);
+    SetUI(parameters, "DLSSNR.UseAutoMask", unsigned(auto_mask));
+    SetUI(parameters, "DLSSNR.UICorrection", unsigned(ui_correction));
+    void* feature = nullptr;
+    volatile int result = create(command_buffer, 18, parameters, &feature);
+    return result == 1 ? feature : nullptr;
+}
+__declspec(dllexport) int dlssnr_vk_evaluate(
+    void* command_buffer, void* feature, void* parameters, void* color, void* depth,
+    void* motion, void* output, unsigned width, unsigned height, unsigned guide_width,
+    unsigned guide_height, int depth_inverted, int reset, float intensity, int style,
+    float local_structure, float local_tone, float skin_structure, int auto_mask,
+    float motion_scale_x, float motion_scale_y) {
+    if (!evaluate || !command_buffer || !feature || !parameters) return -1;
+    SetP(parameters, "DLSSNR.Color", color);
+    SetP(parameters, "DLSSNR.Depth", depth);
+    SetP(parameters, "DLSSNR.MVec", motion);
+    SetP(parameters, "DLSSNR.Output", output);
+    SetUI(parameters, "DLSSNR.Enabled", 1);
+    SetUI(parameters, "DLSSNR.Width", width);
+    SetUI(parameters, "DLSSNR.Height", height);
+    SetUI(parameters, "DLSSNR.DepthInverted", unsigned(depth_inverted));
+    SetUI(parameters, "DLSSNR.Reset", unsigned(reset));
+    for (const char* base : {"Color", "Output", "Depth", "MVec"}) {
+        const bool guide = base[0] == 'D' || base[0] == 'M';
+        char name[64];
+        wsprintfA(name, "DLSSNR.%sSubrectBaseX", base); SetUI(parameters, name, 0);
+        wsprintfA(name, "DLSSNR.%sSubrectBaseY", base); SetUI(parameters, name, 0);
+        wsprintfA(name, "DLSSNR.%sSubrectWidth", base);
+        SetUI(parameters, name, guide ? guide_width : width);
+        wsprintfA(name, "DLSSNR.%sSubrectHeight", base);
+        SetUI(parameters, name, guide ? guide_height : height);
+    }
+    SetF(parameters, "DLSSNR.MVecScaleX", motion_scale_x);
+    SetF(parameters, "DLSSNR.MVecScaleY", motion_scale_y);
+    SetF(parameters, "DLSSNR.Intensity", intensity);
+    SetUI(parameters, "DLSSNR.Style", unsigned(style));
+    SetF(parameters, "DLSSNR.LocalStructureStrength", local_structure);
+    SetF(parameters, "DLSSNR.LocalToneStrength", local_tone);
+    SetF(parameters, "DLSSNR.SkinStructureStrength", skin_structure);
+    SetUI(parameters, "DLSSNR.UseAutoMask", unsigned(auto_mask));
+    TraceParameters(parameters);
+    volatile int result = evaluate(command_buffer, feature, parameters, nullptr);
+    return result;
+}
+__declspec(dllexport) void dlssnr_vk_release(void* feature) {
+    if (release && feature) {
+        volatile int ignored = release(feature);
+        (void)ignored;
+    }
+}
+}

+        if (bytes > 0) ok = BCryptHashData(handle, buffer.data(), ULONG(bytes), 0) >= 0;
+    }
+    ok = ok && file.eof() && BCryptFinishHash(handle, digest.data(), DWORD(digest.size()), 0) >= 0 &&
+         std::equal(digest.begin(), digest.end(), expected.begin());

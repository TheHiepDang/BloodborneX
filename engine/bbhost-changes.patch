+             "reqId = {}, targetAccountIdArray = {}, slotId = {}, statusArray = {}, "
+             "statusArraySize = {}, arrayLen = {}, option = {}",
+             reqId, fmt::ptr(targetAccountIdArray), slotId, fmt::ptr(statusArray), statusArraySize,
+             arrayLen, fmt::ptr(option));

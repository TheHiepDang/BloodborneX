+s32 PS4_SYSV_ABI sceNetShutdown(OrbisNetId s, s32 how) {
+    LOG_DEBUG(Lib_Net, "s = {}, how = {}", s, how);
+    if (how < ORBIS_NET_SHUT_RD || how > ORBIS_NET_SHUT_RDWR) {

+    ImGui::PushID("fps_counter");
+    if (const char* label = Item("Frame rate", "Частота кадров")) {
+        Checkbox(label, s.show_fps_rate);
+    }
+    if (const char* label = Item("Frame time", "Время кадра")) {
+        Checkbox(label, s.show_fps_frame_time);

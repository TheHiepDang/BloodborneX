+static void LogRam() {
+    BbPlatform::Memory m;
+    if (!BbPlatform::GetMemory(m)) {
+        return;
+    }
+    const auto mib = [](u64 bytes) { return static_cast<unsigned long long>(bytes >> 20); };
+    std::printf("Memory: game %llu MiB in RAM (%llu MiB committed, peak %llu MiB); PC %llu of %llu "

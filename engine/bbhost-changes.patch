diff --git a/gpu/shadps4/video_core/host_shaders/dlss_nr.comp b/gpu/shadps4/video_core/host_shaders/dlss_nr.comp
new file mode 100644
index 0000000..278ddb8
--- /dev/null
+++ b/gpu/shadps4/video_core/host_shaders/dlss_nr.comp
@@ -0,0 +1,80 @@
+#version 460
+#extension GL_EXT_scalar_block_layout : require
+
+// RenoDX-derived ratio composition (MIT): preserve the original scene's broad colour while
+// applying the neural result's local luminance/detail ratio. All owned targets are RGBA16F.
+layout(local_size_x = 8, local_size_y = 8) in;
+layout(set = 0, binding = 0) uniform sampler2D source_image;
+layout(set = 0, binding = 1) uniform sampler2D model_image;
+layout(set = 0, binding = 2) uniform sampler2D original_image;
+layout(set = 0, binding = 3, rgba16f) uniform writeonly image2D target_image;
+layout(set = 0, binding = 4, rgba16f) uniform writeonly image2D keep_image;
+layout(push_constant, scalar) uniform Push {
+    uint mode;       // 0 encode/copy, 1 ratio resolve, 2 marked four-band diagnostic
+    uint width;
+    uint height;
+    uint hdr;
+    float white_point;
+    float strength;
+} p;
+
+vec3 linear_to_srgb(vec3 x) {
+    vec3 lo = 12.92 * x;
+    vec3 hi = 1.055 * pow(max(x, 0.0), vec3(1.0 / 2.4)) - 0.055;
+    return mix(lo, hi, greaterThan(x, vec3(0.0031308)));
+}
+vec3 srgb_to_linear(vec3 x) {
+    vec3 lo = x / 12.92;
+    vec3 hi = pow(max((x + 0.055) / 1.055, 0.0), vec3(2.4));
+    return mix(lo, hi, greaterThan(x, vec3(0.04045)));
+}
+vec3 encode_hdr(vec3 x) {
+    x = max(x / max(p.white_point, 1e-4), 0.0);
+    return linear_to_srgb(x / (1.0 + x));
+}
+vec3 decode_hdr(vec3 x) {
+    x = clamp(srgb_to_linear(x), 0.0, 0.9995);
+    return x / max(1.0 - x, 1e-4) * p.white_point;
+}
+
+void main() {
+    ivec2 q = ivec2(gl_GlobalInvocationID.xy);
+    if (q.x >= int(p.width) || q.y >= int(p.height)) return;
+    vec4 original = texelFetch(source_image, q, 0);
+    if (p.mode == 0) {
+        imageStore(keep_image, q, original);
+        imageStore(target_image, q, vec4(p.hdr != 0 ? encode_hdr(original.rgb) : original.rgb,
+                                         original.a));
+        return;
+    }
+    original = texelFetch(original_image, q, 0);
+    vec3 encoded = texelFetch(source_image, q, 0).rgb;
+    vec3 model = texelFetch(model_image, q, 0).rgb;
+    vec3 base = p.hdr != 0 ? decode_hdr(encoded) : encoded;
+    vec3 enhanced = p.hdr != 0 ? decode_hdr(model) : model;
+    float base_luma = max(dot(base, vec3(0.2126, 0.7152, 0.0722)), 0.0);
+    float enhanced_luma = max(dot(enhanced, vec3(0.2126, 0.7152, 0.0722)), 0.0);
+    // Symmetric regularisation preserves identity even in near-black pixels.
+    float ratio = clamp((enhanced_luma + 1e-4) / (base_luma + 1e-4), 0.0, 2.0);
+    vec3 luminance_result = max(original.rgb, 0.0) * ratio;
+    vec3 chroma_result = max(original.rgb, 0.0) *
+        clamp((max(enhanced, 0.0) + 1e-4) / (max(base, 0.0) + 1e-4), 0.0, 2.0);
+    vec3 result = mix(original.rgb, mix(luminance_result, chroma_result, 0.25),
+                      clamp(p.strength, 0.0, 1.0));
+    if (p.mode == 2) {
+        // Left to right: untouched source, reversible proxy, raw model answer, composition.
+        uint band = min(uint(q.x) * 4u / max(p.width, 1u), 3u);
+        if (band == 0u) result = original.rgb;
+        else if (band == 1u) result = base;
+        else if (band == 2u) result = enhanced;
+        // Mark the pass even when model == proxy. Colours: source red, proxy green,
+        // model blue, composition yellow. These markers are development-only.
+        if (uint(q.y) < max(p.height / 40u, 8u)) {
+            const vec3 markers[4] = vec3[4](vec3(1,0,0), vec3(0,1,0),
+                                           vec3(0,0,1), vec3(1,1,0));
+            result = markers[band];
+        }
+        if (uint(q.x) % max(p.width / 4u, 1u) < 3u) result = vec3(1,0,1);
+    }
+    imageStore(target_image, q, vec4(result, original.a));
+}
diff --git a/gpu/shadps4/video_core/host_shaders/dlss_ui_alpha.comp b/gpu/shadps4/video_core/host_shaders/dlss_ui_alpha.comp

@@ -0,0 +1,69 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#include "xml.h"
+
+#include <expat.h>
+
+namespace start {
+
+std::optional<std::string> XmlElement::Get(std::string_view key) const {
+    for (const auto& [k, v] : attributes)
+        if (k == key) return v;
+    return std::nullopt;
+}
+
+std::string XmlElement::Get(std::string_view key, std::string_view fallback) const {
+    const auto value = Get(key);
+    return value ? *value : std::string(fallback);
+}
+
+void XmlElement::Iter(std::string_view tag, std::vector<const XmlElement*>& out) const {
+    if (name == tag) out.push_back(this);
+    for (const auto& child : children) child->Iter(tag, out);
+}
+
+namespace {
+struct Builder {
+    std::unique_ptr<XmlElement> root;
+    std::vector<XmlElement*> stack;
+};
+
+void XMLCALL OnStart(void* data, const XML_Char* name, const XML_Char** attributes) {
+    auto* b = static_cast<Builder*>(data);
+    auto element = std::make_unique<XmlElement>();
+    element->name = name;
+    for (int i = 0; attributes[i]; i += 2) element->attributes.emplace_back(attributes[i], attributes[i + 1]);
+    XmlElement* raw = element.get();
+    if (b->stack.empty()) b->root = std::move(element);
+    else b->stack.back()->children.push_back(std::move(element));
+    b->stack.push_back(raw);
+}
+
+void XMLCALL OnEnd(void* data, const XML_Char*) {
+    static_cast<Builder*>(data)->stack.pop_back();
+}
+
+void XMLCALL OnText(void* data, const XML_Char* text, int length) {
+    auto* b = static_cast<Builder*>(data);
+    if (!b->stack.empty()) b->stack.back()->text.append(text, std::size_t(length));
+}
+} // namespace
+
+std::unique_ptr<XmlElement> ParseXml(const fs::path& path) {
+    const Bytes data = ReadFile(path);
+    Builder builder;
+    XML_Parser parser = XML_ParserCreate(nullptr);
+    XML_SetUserData(parser, &builder);
+    XML_SetElementHandler(parser, OnStart, OnEnd);
+    XML_SetCharacterDataHandler(parser, OnText);
+    const bool ok = XML_Parse(parser, reinterpret_cast<const char*>(data.data()), int(data.size()), XML_TRUE) != XML_STATUS_ERROR;
+    std::string message;
+    if (!ok)
+        message = std::string(XML_ErrorString(XML_GetErrorCode(parser))) + ": line " +
+                  std::to_string(XML_GetCurrentLineNumber(parser)) + ", column " +
+                  std::to_string(XML_GetCurrentColumnNumber(parser));
+    XML_ParserFree(parser);
+    if (!ok || !builder.root) throw Error(ok ? "empty XML document" : message);
+    return std::move(builder.root);
+}
+
+} // namespace start
diff --git a/start/xml.h b/start/xml.h
new file mode 100644
index 0000000..bc0dece
--- /dev/null
+++ b/start/xml.h
@@ -0,0 +1,30 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+// A small element tree over expat: what the patch files need (Metadata, Line, ID).
+#pragma once
+#include "common.h"
+
+#include <memory>
+
+namespace start {
+
+struct XmlElement {
+    std::string name;
+    std::vector<std::pair<std::string, std::string>> attributes;
+    std::string text;
+    std::vector<std::unique_ptr<XmlElement>> children;
+
+    std::optional<std::string> Get(std::string_view key) const;
+    std::string Get(std::string_view key, std::string_view fallback) const;
+    /// Every descendant named `tag` (the element itself included), in document order.
+    void Iter(std::string_view tag, std::vector<const XmlElement*>& out) const;
+    std::vector<const XmlElement*> Iter(std::string_view tag) const {
+        std::vector<const XmlElement*> out;
+        Iter(tag, out);
+        return out;
+    }
+};
+
+/// Parses a whole document; throws Error with the parser's message on bad XML.
+std::unique_ptr<XmlElement> ParseXml(const fs::path& path);
+
+} // namespace start
diff --git a/tests/shader_gpu_stats.cpp b/tests/shader_gpu_stats.cpp
new file mode 100644
index 0000000..3b4e6f6
--- /dev/null
+++ b/tests/shader_gpu_stats.cpp
@@ -0,0 +1,378 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+// bbport: the shader lab's GPU half. Builds a pipeline for each SPIR-V module the lab wrote
+// (bb-shader-lab --bench <cache> ... --spv-dir DIR) on this PC's Vulkan driver, without the game,
+// and reports what the driver made of it: the time vkCreate*Pipelines took (no pipeline cache, and
+// the module's bytes made unique per run so the driver's own disk cache misses too) and the
+// driver's statistics of each executable (VK_KHR_pipeline_executable_properties: on NVIDIA
+// instruction and register counts). A compiler change is compared by running both module sets.
+//
+// The manifest (tests/shader_gpu_stats.py writes it, one module a line, tab separated):
+//   name  stage(comp|vert|frag)  module.spv  partner.spv|-  bindings  vertex_inputs  color_outputs
+//   bindings      "binding:kind:count;..." kind ub sb si st sa ut stb cis
+//   vertex_inputs "location:VkFormat;..."   color_outputs "location:VkFormat;..."
+// The partner is the other stage of a graphics pipeline: a vertex shader that writes every input
+// the fragment shader reads, or a fragment shader that reads every output of the vertex shader
+// (so the driver cannot drop them).
+//
+//   bb-shader-gpu-stats <manifest> <report.csv> [rounds] [threads]
+// Build: clang++ -std=c++20 -O2 tests/shader_gpu_stats.cpp -lvulkan-1 -o bb-shader-gpu-stats.exe
+#include <vulkan/vulkan.h>
+
+#include <algorithm>
+#include <atomic>
+#include <mutex>
+#include <thread>
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <fstream>
+#include <map>
+#include <string>
+#include <vector>
+
+namespace {
+
+struct Entry {
+    std::string name, stage, spv, partner;
+    std::vector<VkDescriptorSetLayoutBinding> bindings;
+    std::vector<std::pair<uint32_t, VkFormat>> vertex_inputs, color_outputs;
+};
+
+std::vector<std::string> Split(const std::string& s, char sep) {
+    std::vector<std::string> out(1);
+    for (const char c : s) {
+        if (c == sep) {
+            out.emplace_back();
+        } else {
+            out.back() += c;
+        }
+    }
+    if (out.size() == 1 && out[0].empty()) out.clear();
+    return out;
+}
+
+std::vector<uint32_t> ReadSpv(const std::string& path, uint32_t nonce) {
+    std::ifstream in(path, std::ios::binary);
+    std::vector<char> bytes{std::istreambuf_iterator<char>(in), std::istreambuf_iterator<char>()};
+    std::vector<uint32_t> words(bytes.size() / 4);
+    std::memcpy(words.data(), bytes.data(), words.size() * 4);
+    // A larger id bound is valid and changes the bytes: the driver's disk cache misses.
+    if (words.size() > 5) {
+        words[3] += nonce;
+    }
+    return words;
+}
+
+VkDescriptorType Kind(const std::string& k) {
+    if (k == "ub") return VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER;
+    if (k == "sb") return VK_DESCRIPTOR_TYPE_STORAGE_BUFFER;
+    if (k == "si") return VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE;
+    if (k == "st") return VK_DESCRIPTOR_TYPE_STORAGE_IMAGE;
+    if (k == "sa") return VK_DESCRIPTOR_TYPE_SAMPLER;
+    if (k == "ut") return VK_DESCRIPTOR_TYPE_UNIFORM_TEXEL_BUFFER;
+    if (k == "stb") return VK_DESCRIPTOR_TYPE_STORAGE_TEXEL_BUFFER;
+    return VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER;
+}
+
+std::vector<Entry> ReadManifest(const char* path) {
+    std::vector<Entry> entries;
+    std::ifstream in(path);
+    for (std::string line; std::getline(in, line);) {
+        if (!line.empty() && line.back() == '\r') line.pop_back();
+        const auto f = Split(line, '\t');
+        if (f.size() < 7) continue;
+        Entry e{f[0], f[1], f[2], f[3]};
+        for (const auto& b : Split(f[4], ';')) {
+            const auto p = Split(b, ':');
+            if (p.size() != 3) continue;
+            e.bindings.push_back({uint32_t(std::stoul(p[0])), Kind(p[1]), uint32_t(std::stoul(p[2])),
+                                  VK_SHADER_STAGE_ALL, nullptr});
+        }
+        for (int list = 0; list < 2; ++list) {
+            for (const auto& v : Split(f[5 + list], ';')) {
+                const auto p = Split(v, ':');
+                if (p.size() != 2) continue;
+                (list ? e.color_outputs : e.vertex_inputs)
+                    .push_back({uint32_t(std::stoul(p[0])), VkFormat(std::stoul(p[1]))});
+            }
+        }
+        entries.push_back(std::move(e));
+    }
+    return entries;
+}
+
+#define CHECK(x)                                                                                   \
+    do {                                                                                           \
+        const VkResult r_ = (x);                                                                   \
+        if (r_ != VK_SUCCESS) {                                                                    \
+            std::fprintf(stderr, "%s failed: %d\n", #x, int(r_));                                  \
+            std::exit(1);                                                                          \
+        }                                                                                          \
+    } while (0)
+
+} // namespace
+
+int main(int argc, char** argv) {
+    if (argc < 3) {
+        std::fprintf(stderr, "usage: bb-shader-gpu-stats <manifest> <report.csv> [rounds] [threads]\n");
+        return 2;
+    }
+    const auto entries = ReadManifest(argv[1]);
+    const int rounds = argc >= 4 ? std::max(1, std::atoi(argv[3])) : 1;
+    const int threads = argc >= 5 ? std::max(1, std::atoi(argv[4])) : 1;
+
+    VkApplicationInfo app{VK_STRUCTURE_TYPE_APPLICATION_INFO};
+    app.pApplicationName = "bb-shader-gpu-stats";
+    app.apiVersion = VK_API_VERSION_1_3;
+    VkInstanceCreateInfo ici{VK_STRUCTURE_TYPE_INSTANCE_CREATE_INFO};
+    ici.pApplicationInfo = &app;
+    VkInstance instance;
+    CHECK(vkCreateInstance(&ici, nullptr, &instance));
+    uint32_t count = 0;
+    vkEnumeratePhysicalDevices(instance, &count, nullptr);
+    std::vector<VkPhysicalDevice> gpus(count);
+    vkEnumeratePhysicalDevices(instance, &count, gpus.data());
+    VkPhysicalDevice gpu = VK_NULL_HANDLE;
+    VkPhysicalDeviceProperties props{};
+    for (auto g : gpus) {
+        vkGetPhysicalDeviceProperties(g, &props);
+        if (props.deviceType == VK_PHYSICAL_DEVICE_TYPE_DISCRETE_GPU) {
+            gpu = g;
+            break;
+        }
+    }
+    if (!gpu && !gpus.empty()) gpu = gpus[0];
+    vkGetPhysicalDeviceProperties(gpu, &props);
+
+    // Every feature the device has (the engine's modules use many of them).
+    VkPhysicalDeviceFragmentShaderBarycentricFeaturesKHR bary{
+        VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_FRAGMENT_SHADER_BARYCENTRIC_FEATURES_KHR};
+    VkPhysicalDevicePipelineExecutablePropertiesFeaturesKHR exec{
+        VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_PIPELINE_EXECUTABLE_PROPERTIES_FEATURES_KHR, &bary};
+    VkPhysicalDeviceVulkan13Features f13{VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VULKAN_1_3_FEATURES, &exec};
+    VkPhysicalDeviceVulkan12Features f12{VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VULKAN_1_2_FEATURES, &f13};
+    VkPhysicalDeviceVulkan11Features f11{VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VULKAN_1_1_FEATURES, &f12};
+    VkPhysicalDeviceFeatures2 features{VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_FEATURES_2, &f11};
+    vkGetPhysicalDeviceFeatures2(gpu, &features);
+    features.features.robustBufferAccess = VK_FALSE; // the engine does not turn it on
+
+    uint32_t ext_count = 0;
+    vkEnumerateDeviceExtensionProperties(gpu, nullptr, &ext_count, nullptr);
+    std::vector<VkExtensionProperties> offered(ext_count);
+    vkEnumerateDeviceExtensionProperties(gpu, nullptr, &ext_count, offered.data());
+    std::vector<const char*> extensions;
+    for (const char* wanted : {VK_KHR_PIPELINE_EXECUTABLE_PROPERTIES_EXTENSION_NAME,
+                               VK_KHR_PUSH_DESCRIPTOR_EXTENSION_NAME,
+                               VK_KHR_FRAGMENT_SHADER_BARYCENTRIC_EXTENSION_NAME,
+                               VK_EXT_SHADER_STENCIL_EXPORT_EXTENSION_NAME}) {
+        for (const auto& o : offered) {
+            if (std::strcmp(o.extensionName, wanted) == 0) extensions.push_back(wanted);
+        }
+    }
+    float priority = 1.0f;
+    VkDeviceQueueCreateInfo qci{VK_STRUCTURE_TYPE_DEVICE_QUEUE_CREATE_INFO};
+    qci.queueCount = 1;
+    qci.pQueuePriorities = &priority;
+    VkDeviceCreateInfo dci{VK_STRUCTURE_TYPE_DEVICE_CREATE_INFO, &features};
+    dci.queueCreateInfoCount = 1;
+    dci.pQueueCreateInfos = &qci;
+    dci.enabledExtensionCount = uint32_t(extensions.size());
+    dci.ppEnabledExtensionNames = extensions.data();
+    VkDevice device;
+    CHECK(vkCreateDevice(gpu, &dci, nullptr, &device));
+    const auto get_props = reinterpret_cast<PFN_vkGetPipelineExecutablePropertiesKHR>(
+        vkGetDeviceProcAddr(device, "vkGetPipelineExecutablePropertiesKHR"));
+    const auto get_stats = reinterpret_cast<PFN_vkGetPipelineExecutableStatisticsKHR>(
+        vkGetDeviceProcAddr(device, "vkGetPipelineExecutableStatisticsKHR"));
+
+    std::FILE* out = std::fopen(argv[2], "w");
+    std::fprintf(out, "name,stage,round,create_ms,executable,statistic,value\n");
+    const uint32_t nonce = uint32_t(std::chrono::steady_clock::now().time_since_epoch().count() & 0xFFFF) + 1;
+    size_t built = 0, failed = 0;
+    double total_ms = 0, wall_ms = 0;
+    std::mutex out_mutex;
+    for (int round = 0; round < rounds; ++round) {
+        const auto build = [&](const Entry& e) {
+            const auto make_module = [&](const std::string& path) {
+                const auto words = ReadSpv(path, nonce + uint32_t(round) * 0x10000);
+                VkShaderModuleCreateInfo smci{VK_STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO};
+                smci.codeSize = words.size() * 4;
+                smci.pCode = words.data();
+                VkShaderModule module = VK_NULL_HANDLE;
+                vkCreateShaderModule(device, &smci, nullptr, &module);
+                return module;
+            };
+            VkDescriptorSetLayoutCreateInfo dslci{VK_STRUCTURE_TYPE_DESCRIPTOR_SET_LAYOUT_CREATE_INFO};
+            dslci.flags = VK_DESCRIPTOR_SET_LAYOUT_CREATE_PUSH_DESCRIPTOR_BIT_KHR;
+            dslci.bindingCount = uint32_t(e.bindings.size());
+            dslci.pBindings = e.bindings.data();
+            VkDescriptorSetLayout set_layout;
+            if (vkCreateDescriptorSetLayout(device, &dslci, nullptr, &set_layout) != VK_SUCCESS) {
+                // More bindings than push descriptors allow: an ordinary set.
+                dslci.flags = 0;
+                CHECK(vkCreateDescriptorSetLayout(device, &dslci, nullptr, &set_layout));
+            }
+            VkPushConstantRange push{VK_SHADER_STAGE_ALL, 0,
+                                     std::min<uint32_t>(256, props.limits.maxPushConstantsSize)};
+            VkPipelineLayoutCreateInfo plci{VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO};
+            plci.setLayoutCount = 1;
+            plci.pSetLayouts = &set_layout;
+            plci.pushConstantRangeCount = 1;
+            plci.pPushConstantRanges = &push;
+            VkPipelineLayout layout;
+            CHECK(vkCreatePipelineLayout(device, &plci, nullptr, &layout));
+
+            const VkShaderModule module = make_module(e.spv);
+            const VkShaderModule partner = e.partner == "-" ? VK_NULL_HANDLE : make_module(e.partner);
+            VkPipeline pipeline = VK_NULL_HANDLE;
+            VkResult result = VK_ERROR_UNKNOWN;
+            const auto start = std::chrono::steady_clock::now();
+            if (e.stage == "comp") {
+                VkComputePipelineCreateInfo cpci{VK_STRUCTURE_TYPE_COMPUTE_PIPELINE_CREATE_INFO};
+                cpci.flags = VK_PIPELINE_CREATE_CAPTURE_STATISTICS_BIT_KHR;
+                cpci.stage = {VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO, nullptr, 0,
+                              VK_SHADER_STAGE_COMPUTE_BIT, module, "main", nullptr};
+                cpci.layout = layout;
+                if (module) result = vkCreateComputePipelines(device, VK_NULL_HANDLE, 1, &cpci, nullptr, &pipeline);
+            } else {
+                const bool is_vs = e.stage == "vert";
+                VkPipelineShaderStageCreateInfo stages[2] = {
+                    {VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO, nullptr, 0,
+                     VK_SHADER_STAGE_VERTEX_BIT, is_vs ? module : partner, "main", nullptr},
+                    {VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO, nullptr, 0,
+                     VK_SHADER_STAGE_FRAGMENT_BIT, is_vs ? partner : module, "main", nullptr}};
+                std::vector<VkVertexInputAttributeDescription> attribs;
+                for (const auto& [location, format] : e.vertex_inputs) {
+                    attribs.push_back({location, 0, format, 0});
+                }
+                VkVertexInputBindingDescription vbind{0, 16, VK_VERTEX_INPUT_RATE_VERTEX};
+                VkPipelineVertexInputStateCreateInfo vi{VK_STRUCTURE_TYPE_PIPELINE_VERTEX_INPUT_STATE_CREATE_INFO};
+                vi.vertexBindingDescriptionCount = attribs.empty() ? 0 : 1;
+                vi.pVertexBindingDescriptions = &vbind;
+                vi.vertexAttributeDescriptionCount = uint32_t(attribs.size());
+                vi.pVertexAttributeDescriptions = attribs.data();
+                VkPipelineInputAssemblyStateCreateInfo ia{VK_STRUCTURE_TYPE_PIPELINE_INPUT_ASSEMBLY_STATE_CREATE_INFO};
+                ia.topology = VK_PRIMITIVE_TOPOLOGY_TRIANGLE_LIST;
+                VkPipelineViewportStateCreateInfo vp{VK_STRUCTURE_TYPE_PIPELINE_VIEWPORT_STATE_CREATE_INFO};
+                vp.viewportCount = 1;
+                vp.scissorCount = 1;
+                VkPipelineRasterizationStateCreateInfo rs{VK_STRUCTURE_TYPE_PIPELINE_RASTERIZATION_STATE_CREATE_INFO};
+                rs.lineWidth = 1.0f;
+                VkPipelineMultisampleStateCreateInfo ms{VK_STRUCTURE_TYPE_PIPELINE_MULTISAMPLE_STATE_CREATE_INFO};
+                ms.rasterizationSamples = VK_SAMPLE_COUNT_1_BIT;
+                VkPipelineDepthStencilStateCreateInfo ds{VK_STRUCTURE_TYPE_PIPELINE_DEPTH_STENCIL_STATE_CREATE_INFO};
+                ds.depthTestEnable = VK_TRUE;
+                ds.depthWriteEnable = VK_TRUE;
+                ds.depthCompareOp = VK_COMPARE_OP_LESS_OR_EQUAL;
+                uint32_t max_location = 0;
+                for (const auto& [location, format] : e.color_outputs) {
+                    max_location = std::max(max_location, location + 1);
+                }
+                std::vector<VkFormat> formats(max_location, VK_FORMAT_UNDEFINED);
+                for (const auto& [location, format] : e.color_outputs) {
+                    formats[location] = format;
+                }
+                std::vector<VkPipelineColorBlendAttachmentState> blend(max_location);
+                for (auto& b : blend) {
+                    b.colorWriteMask = 0xF;
+                }
+                VkPipelineColorBlendStateCreateInfo cb{VK_STRUCTURE_TYPE_PIPELINE_COLOR_BLEND_STATE_CREATE_INFO};
+                cb.attachmentCount = max_location;
+                cb.pAttachments = blend.data();
+                const VkDynamicState dyn_states[] = {VK_DYNAMIC_STATE_VIEWPORT, VK_DYNAMIC_STATE_SCISSOR};
+                VkPipelineDynamicStateCreateInfo dyn{VK_STRUCTURE_TYPE_PIPELINE_DYNAMIC_STATE_CREATE_INFO};
+                dyn.dynamicStateCount = 2;
+                dyn.pDynamicStates = dyn_states;
+                VkPipelineRenderingCreateInfo rendering{VK_STRUCTURE_TYPE_PIPELINE_RENDERING_CREATE_INFO};
+                rendering.colorAttachmentCount = max_location;
+                rendering.pColorAttachmentFormats = formats.data();
+                rendering.depthAttachmentFormat = VK_FORMAT_D32_SFLOAT_S8_UINT;
+                rendering.stencilAttachmentFormat = VK_FORMAT_D32_SFLOAT_S8_UINT;
+                VkGraphicsPipelineCreateInfo gpci{VK_STRUCTURE_TYPE_GRAPHICS_PIPELINE_CREATE_INFO, &rendering};
+                gpci.flags = VK_PIPELINE_CREATE_CAPTURE_STATISTICS_BIT_KHR;
+                gpci.stageCount = 2;
+                gpci.pStages = stages;
+                gpci.pVertexInputState = &vi;
+                gpci.pInputAssemblyState = &ia;
+                gpci.pViewportState = &vp;
+                gpci.pRasterizationState = &rs;
+                gpci.pMultisampleState = &ms;
+                gpci.pDepthStencilState = &ds;
+                gpci.pColorBlendState = &cb;
+                gpci.pDynamicState = &dyn;
+                gpci.layout = layout;
+                if (module && partner) result = vkCreateGraphicsPipelines(device, VK_NULL_HANDLE, 1, &gpci, nullptr, &pipeline);
+            }
+            const double ms_taken =
+                std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - start).count();
+            std::scoped_lock lock{out_mutex};
+            if (result != VK_SUCCESS) {
+                std::fprintf(out, "%s,%s,%d,,,failed,%d\n", e.name.c_str(), e.stage.c_str(), round, int(result));
+                ++failed;
+            } else {
+                ++built;
+                total_ms += ms_taken;
+                VkPipelineInfoKHR pinfo{VK_STRUCTURE_TYPE_PIPELINE_INFO_KHR};
+                pinfo.pipeline = pipeline;
+                uint32_t n = 0;
+                get_props(device, &pinfo, &n, nullptr);
+                std::vector<VkPipelineExecutablePropertiesKHR> execs(
+                    n, {VK_STRUCTURE_TYPE_PIPELINE_EXECUTABLE_PROPERTIES_KHR});
+                get_props(device, &pinfo, &n, execs.data());
+                for (uint32_t i = 0; i < n; ++i) {
+                    VkPipelineExecutableInfoKHR einfo{VK_STRUCTURE_TYPE_PIPELINE_EXECUTABLE_INFO_KHR};
+                    einfo.pipeline = pipeline;
+                    einfo.executableIndex = i;
+                    uint32_t sn = 0;
+                    get_stats(device, &einfo, &sn, nullptr);
+                    std::vector<VkPipelineExecutableStatisticKHR> stats(
+                        sn, {VK_STRUCTURE_TYPE_PIPELINE_EXECUTABLE_STATISTIC_KHR});
+                    get_stats(device, &einfo, &sn, stats.data());
+                    for (const auto& s : stats) {
+                        double value = 0;
+                        switch (s.format) {
+                        case VK_PIPELINE_EXECUTABLE_STATISTIC_FORMAT_BOOL32_KHR: value = s.value.b32; break;
+                        case VK_PIPELINE_EXECUTABLE_STATISTIC_FORMAT_INT64_KHR: value = double(s.value.i64); break;
+                        case VK_PIPELINE_EXECUTABLE_STATISTIC_FORMAT_UINT64_KHR: value = double(s.value.u64); break;
+                        case VK_PIPELINE_EXECUTABLE_STATISTIC_FORMAT_FLOAT64_KHR: value = s.value.f64; break;
+                        default: break;
+                        }
+                        std::fprintf(out, "%s,%s,%d,%.3f,%s,%s,%g\n", e.name.c_str(), e.stage.c_str(), round,
+                                     ms_taken, execs[i].name, s.name, value);
+                    }
+                }
+                vkDestroyPipeline(device, pipeline, nullptr);
+            }
+            if (module) vkDestroyShaderModule(device, module, nullptr);
+            if (partner) vkDestroyShaderModule(device, partner, nullptr);
+            vkDestroyPipelineLayout(device, layout, nullptr);
+            vkDestroyDescriptorSetLayout(device, set_layout, nullptr);
+        };
+        // Each thread takes the next module, as the engine's warm-up threads do.
+        std::atomic<size_t> next{0};
+        const auto worker = [&] {
+            for (size_t k; (k = next.fetch_add(1)) < entries.size();) {
+                build(entries[k]);
+            }
+        };
+        const auto round_start = std::chrono::steady_clock::now();
+        std::vector<std::thread> pool;
+        for (int t = 1; t < threads; ++t) {
+            pool.emplace_back(worker);
+        }
+        worker();
+        for (auto& thread : pool) {
+            thread.join();
+        }
+        wall_ms += std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - round_start).count();
+    }
+    std::fclose(out);
+    std::printf("%s (driver %u.%u): %zu pipelines built in %.1f ms on %d threads (%.1f ms of driver "
+                "time), %zu failed\n",
+                props.deviceName, props.driverVersion >> 22, (props.driverVersion >> 14) & 0xFF, built,
+                wall_ms, threads, total_ms, failed);
+    vkDestroyDevice(device, nullptr);
+    vkDestroyInstance(instance, nullptr);
+    return failed ? 1 : 0;
+}
diff --git a/tests/shader_gpu_stats.py b/tests/shader_gpu_stats.py
new file mode 100644
index 0000000..08d31fe
--- /dev/null
+++ b/tests/shader_gpu_stats.py
@@ -0,0 +1,194 @@
+# SPDX-License-Identifier: GPL-2.0-or-later
+# bbport: the manifest for bb-shader-gpu-stats (tests/shader_gpu_stats.cpp). For each SPIR-V module
+# the shader lab wrote (bb-shader-lab --bench <cache> 1 report.csv --spv-dir DIR): its descriptor
+# bindings, vertex inputs and color outputs (spirv-cross --reflect), and for a vertex or fragment
+# shader a partner stage (glslangValidator) that writes every input the fragment shader reads or
+# reads every output of the vertex shader, so the driver keeps them all.
+#
+#   python tests/shader_gpu_stats.py <spv dir> <work dir>       -> <work dir>/manifest.txt
+#   bb-shader-gpu-stats <work dir>/manifest.txt report.csv
+#   python tests/shader_gpu_stats.py --compare before.csv after.csv
+#       per stage: the driver's binary size and registers of the module's own stage, summed, and
+#       the modules whose binary changed most
+# Tessellation and geometry stages are left out (a handful of modules).
+import json
+import os
+import subprocess
+import sys
+
+FLOAT4, SINT4, UINT4 = 109, 108, 107  # VK_FORMAT_R32G32B32A32_{SFLOAT,SINT,UINT}
+FORMATS = {  # base type -> formats by component count (1..4)
+    "f": [100, 103, 106, 109],
+    "i": [99, 102, 105, 108],
+    "u": [98, 101, 104, 107],
+}
+
+
+def base(t):
+    if t.startswith(("int", "ivec")):
+        return "i"
+    if t.startswith(("uint", "uvec")):
+        return "u"
+    return "f"
+
+
+def comps(t):
+    return int(t[-1]) if t[-1].isdigit() and "vec" in t else 1
+
+
+def glsl_vec(b, n=4):
+    return {"f": "vec", "i": "ivec", "u": "uvec"}[b] + str(n) if n > 1 else {"f": "float", "i": "int", "u": "uint"}[b]
+
+
+def run(cmd):
+    return subprocess.run(cmd, capture_output=True, text=True)
+
+
+def bindings(r):
+    out = {}
+
+    def add(items, kind_of):
+        for it in r.get(items, []):
+            if it.get("set", 0) != 0 or "binding" not in it:
+                continue
+            arr = it.get("array", [1])
+            out.setdefault(it["binding"], (kind_of(it), max(1, arr[0] if arr else 1)))
+
+    add("ubos", lambda it: "ub")
+    add("ssbos", lambda it: "sb")
+    add("separate_images", lambda it: "ut" if "Buffer" in it["type"] else "si")
+    add("images", lambda it: "stb" if "Buffer" in it["type"] else "st")
+    add("separate_samplers", lambda it: "sa")
+    add("textures", lambda it: "cis")
+    return ";".join(f"{b}:{k}:{n}" for b, (k, n) in sorted(out.items()))
+
+
+def partner_vs(inputs, path):
+    lines = ["#version 450"]
+    body = []
+    by_loc = {}
+    for i in inputs:
+        by_loc.setdefault(i["location"], base(i["type"]))
+    for loc, b in sorted(by_loc.items()):
+        lines.append(f"layout(location={loc}) out {glsl_vec(b)} o{loc};")
+        if b == "f":
+            body.append(f"    o{loc} = vec4(float(gl_VertexIndex) * {loc + 1}.25);")
+        elif b == "i":
+            body.append(f"    o{loc} = ivec4(gl_VertexIndex * {loc + 1});")
+        else:
+            body.append(f"    o{loc} = uvec4(uint(gl_VertexIndex) * {loc + 1}u);")
+    lines.append("void main() {")
+    lines += body
+    lines.append("    gl_Position = vec4(float(gl_VertexIndex & 1), float(gl_VertexIndex >> 1), 0.5, 1.0);")
+    lines.append("}")
+    open(path, "w").write("\n".join(lines) + "\n")
+
+
+def partner_fs(outputs, path):
+    lines = ["#version 450", "layout(location=0) out vec4 color;"]
+    body = ["    vec4 sum = vec4(0.0);"]
+    for o in outputs:
+        loc, t = o["location"], o["type"]
+        if "array" in o:
+            continue
+        b, n = base(t), comps(t)
+        lines.append(f"layout(location={loc}) {'flat ' if b != 'f' else ''}in {glsl_vec(b, n)} i{loc};")
+        if b == "f":
+            pad = "".join(", 0.0" for _ in range(4 - n))
+            body.append(f"    sum += vec4(i{loc}{pad});")
+        else:
+            body.append(f"    sum += vec4(float(i{loc}{'.x' if n > 1 else ''}));")
+    lines.append("void main() {")
+    lines += body
+    lines.append("    color = sum;")
+    lines.append("}")
+    open(path, "w").write("\n".join(lines) + "\n")
+
+
+OWN = {"vert": "VS", "frag": "FS", "comp": "CS"}
+
+
+def load_report(path):
+    """name -> {statistic: value} of the module's own stage, plus create_ms (fastest round)."""
+    out = {}
+    for line in open(path).read().splitlines()[1:]:
+        f = line.split(",")
+        if len(f) < 7 or f[5] == "failed":
+            continue
+        name, stage, _, ms, exe, stat, value = f[:7]
+        if not exe.startswith(OWN.get(stage, "?")):
+            continue
+        m = out.setdefault(name, {"stage": stage, "create_ms": float(ms)})
+        m["create_ms"] = min(m["create_ms"], float(ms))
+        m[stat] = float(value)
+    return out
+
+
+def compare(a_path, b_path):
+    a, b = load_report(a_path), load_report(b_path)
+    names = sorted(set(a) & set(b))
+    print(f"{len(names)} modules in both ({len(a)} / {len(b)})")
+    for stage in ("vert", "frag", "comp"):
+        ns = [n for n in names if a[n]["stage"] == stage]
+        if not ns:
+            continue
+        line = [f"{stage} {len(ns)}:"]
+        for stat in ("Binary Size", "Register Count", "create_ms"):
+            sa = sum(a[n].get(stat, 0) for n in ns)
+            sb = sum(b[n].get(stat, 0) for n in ns)
+            line.append(f"{stat} {sa:.0f} -> {sb:.0f} ({(sb - sa) / sa * 100 if sa else 0:+.1f}%)")
+        changed = sum(1 for n in ns if a[n].get("Binary Size") != b[n].get("Binary Size"))
+        line.append(f"binary changed in {changed}")
+        print("  ".join(line))
+    worst = sorted(names, key=lambda n: b[n].get("Binary Size", 0) - a[n].get("Binary Size", 0))
+    for n in worst[:5] + worst[-5:]:
+        print(f"  {n} {a[n]['stage']}: binary {a[n].get('Binary Size', 0):.0f} -> {b[n].get('Binary Size', 0):.0f}, "
+              f"registers {a[n].get('Register Count', 0):.0f} -> {b[n].get('Register Count', 0):.0f}")
+
+
+def main():
+    if sys.argv[1] == "--compare":
+        return compare(sys.argv[2], sys.argv[3])
+    spv_dir, work = sys.argv[1], sys.argv[2]
+    os.makedirs(work, exist_ok=True)
+    manifest = []
+    skipped = 0
+    for name in sorted(os.listdir(spv_dir)):
+        if not name.endswith(".spv"):
+            continue
+        spv = os.path.abspath(os.path.join(spv_dir, name))
+        rr = run(["spirv-cross", spv, "--reflect"])
+        if rr.returncode != 0:
+            skipped += 1
+            continue
+        r = json.loads(rr.stdout)
+        mode = r["entryPoints"][0]["mode"]
+        stem = name[:-4]
+        vin, cout, partner = "", "", "-"
+        if mode in ("vert", "frag"):
+            glsl = os.path.join(work, f"{stem}.partner.{'frag' if mode == 'vert' else 'vert'}")
+            if mode == "frag":
+                partner_vs(r.get("inputs", []), glsl)
+                cout = ";".join(f"{o['location']}:{ {'f': FLOAT4, 'i': SINT4, 'u': UINT4}[base(o['type'])] }"
+                                for o in r.get("outputs", []))
+            else:
+                partner_fs(r.get("outputs", []), glsl)
+                vin = ";".join(f"{i['location']}:{FORMATS[base(i['type'])][comps(i['type']) - 1]}"
+                               for i in r.get("inputs", []))
+                cout = f"0:{FLOAT4}"
+            partner = os.path.abspath(glsl + ".spv")
+            cr = run(["glslangValidator", "-V", "--target-env", "vulkan1.3", glsl, "-o", partner])
+            if cr.returncode != 0:
+                print(f"{name}: partner failed:\n{cr.stdout}{cr.stderr}")
+                skipped += 1
+                continue
+        elif mode != "comp":
+            skipped += 1
+            continue
+        manifest.append("\t".join([stem, mode, spv, partner, bindings(r), vin, cout]))
+    open(os.path.join(work, "manifest.txt"), "w").write("\n".join(manifest) + "\n")
+    print(f"{len(manifest)} modules in {os.path.join(work, 'manifest.txt')}, {skipped} left out")
+
+
+if __name__ == "__main__":
+    main()

+        edit_colour(label, s.fps_bg_color);
+    }
+    if (const char* label = Item("Background opacity", "Непрозрачность фона")) {
+        Slider(label, s.fps_bg_opacity, 0.0f, 1.0f);
+    }
+    if (const char* label = Item("Border", "Рамка")) {
+        Checkbox(label, s.fps_border);

diff --git a/gpu/bbnet/include/windows_trust.h b/gpu/bbnet/include/windows_trust.h
new file mode 100644
index 0000000..ac5df41
--- /dev/null
+++ b/gpu/bbnet/include/windows_trust.h
@@ -0,0 +1,77 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+// bbport: HTTPS servers Windows trusts are trusted here too. OpenSSL checks the server's chain
+// against the Windows ROOT and CA stores as they are when the game starts; a root Windows only
+// fetches on demand (ISRG Root X1 on a fresh install) or the certificate an antivirus' HTTPS
+// scanning signs the connection with (Avast, AVG, Kaspersky) can fail that check while the
+// launcher, browsers and the rest of Windows connect ("SSL server verification failed",
+// "Failed to acquire Bloodborne server information"). When OpenSSL rejects the chain, the same
+// certificate and host name go through Windows' own chain building and SSL policy
+// (CertGetCertificateChain, which fetches missing roots and intermediates): accepted when
+// Windows accepts it, rejected otherwise. BB_WINDOWS_TRUST=0: OpenSSL's answer only.
+#pragma once
+
+#include <atomic>
+#include <cstdio>
+#include <cstdlib>
+#include <functional>
+#include <string>
+#include <vector>
+
+#include <httplib.h>
+
+namespace bbnet {
+
+inline std::string HostOf(const std::string& url) {
+    std::string host = url;
+    if (const auto scheme = host.find("://"); scheme != std::string::npos) host.erase(0, scheme + 3);
+    if (const auto end = host.find_first_of("/?#"); end != std::string::npos) host.erase(end);
+    if (const auto at = host.rfind('@'); at != std::string::npos) host.erase(0, at + 1);
+    if (!host.empty() && host[0] == '[') {
+        if (const auto close = host.find(']'); close != std::string::npos) return host.substr(1, close - 1);
+    }
+    if (const auto colon = host.rfind(':'); colon != std::string::npos) host.erase(colon);
+    return host;
+}
+
+inline void TrustWindowsRoots(httplib::Client& client, const std::string& url) {
+#if defined(_WIN32) && defined(CPPHTTPLIB_OPENSSL_SUPPORT)
+    static const bool enabled = [] {
+        const char* env = std::getenv("BB_WINDOWS_TRUST");
+        return !(env && env[0] == '0');
+    }();
+    if (!enabled) return;
+    client.set_session_verifier([host = HostOf(url)](httplib::tls::session_t session) {
+        if (httplib::tls::get_verify_result(session) == 0) {
+            return httplib::SSLVerifierResponse::NoDecisionMade;
+        }
+        auto cert = httplib::tls::get_peer_cert(session);
+        if (!cert) return httplib::SSLVerifierResponse::NoDecisionMade;
+        std::vector<unsigned char> der;
+        const bool have_der = httplib::tls::get_cert_der(cert, der);
+        httplib::tls::free_cert(cert);
+        uint64_t error = 0;
+        if (have_der && httplib::detail::verify_cert_with_windows_schannel(der, host, true, error)) {
+            static std::atomic<int> noted{0};
+            if (noted.fetch_add(1) < 3) {
+                std::printf("Online: %s's certificate is trusted by Windows (not by the bundled TLS "
+                            "library's copy of its stores): connecting\n",
+                            host.c_str());
+                std::fflush(stdout);
+            }
+            return httplib::SSLVerifierResponse::CertificateAccepted;
+        }
+        static std::atomic<int> refused{0};
+        if (refused.fetch_add(1) < 3) {
+            std::printf("Online: %s's certificate is not trusted by Windows either (error %#llx)\n",
+                        host.c_str(), static_cast<unsigned long long>(error));
+            std::fflush(stdout);
+        }
+        return httplib::SSLVerifierResponse::CertificateRejected;
+    });
+#else
+    (void)client;
+    (void)url;
+#endif
+}
+
+} // namespace bbnet
diff --git a/gpu/bbnet/thd/thd.h b/gpu/bbnet/thd/thd.h
new file mode 100644
index 0000000..726db0d
--- /dev/null
+++ b/gpu/bbnet/thd/thd.h
@@ -0,0 +1,33 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// The Hunter's Dream backend, beside the shadNet one. BB_NET_BACKEND=thd (online_pool=huntersdream)
+// replaces the game's NP and sceNet imports with droogie/bbhost's (566184a; see SHADNET-PORT.md):
+// matching and signaling over The Hunter's Dream's session service, its STUN and relay, the PS4
+// P2P framing bbhost players use, and WebAPI answered here. The game's own HTTP stays shadPS4's
+// sceHttp, with the account token and ruleset added. Without BB_NET_BACKEND=thd nothing here runs
+// and the shadNet backend is as it was.
+#pragma once
+
+#include <cstdint>
+#include <string>
+#include <utility>
+#include <vector>
+
+namespace Core::Loader {
+class SymbolsResolver;
+}
+
+namespace BbThd {
+
+// BB_NET_BACKEND=thd.
+bool Enabled();
+// Once the game is loaded: the account from the launcher (BB_THD_TOKEN, BB_THD_ONLINE_ID).
+void Initialize();
+// Every NP and sceNet import the game has, registered ahead of shadPS4's.
+void Register(Core::Loader::SymbolsResolver* sym);
+// The game's image (Binary Ninja 0x400000 at image[0]), for the NpMatching2 signaling gate and the
+// host's area, level and position on create_room. Ignored unless the executable is 1.09.
+void SetImage(std::uint8_t* image, std::uint64_t size);
+// sceHttp: the headers the game server binds a request to the account and ruleset with.
+void AddGameHeaders(std::vector<std::pair<std::string, std::string>>& headers);
+
+} // namespace BbThd
diff --git a/gpu/bbnet/thd/thd_internal.h b/gpu/bbnet/thd/thd_internal.h
new file mode 100644
index 0000000..af24e06
--- /dev/null
+++ b/gpu/bbnet/thd/thd_internal.h
@@ -0,0 +1,151 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// The Hunter's Dream backend's shared pieces: settings, the account, the session service client,
+// the dispatcher that runs the game's callbacks, the peer table and the P2P port's STUN, relay
+// and hole punching. Adapted from droogie/bbhost src/net/{http,account,session,stun}.h (566184a).
+#pragma once
+
+#include <cstdint>
+#include <functional>
+#include <string>
+#include <vector>
+
+#include <nlohmann/json.hpp>
+
+#include "common/types.h"
+
+extern "C" int32_t runtime_thread_spawn(void** out, void* PS4_SYSV_ABI (*entry)(void*),
+                                        void* argument, uint64_t stack, const char* name);
+
+namespace Core::Loader {
+class SymbolsResolver;
+}
+
+namespace BbThd {
+
+using Json = nlohmann::json;
+
+void Log(const char* format, ...) __attribute__((format(printf, 1, 2)));
+// BB_THD_TRACE=1: every datagram and callback in the log, not only the first.
+bool Trace();
+
+struct Config {
+    std::string np_base;   // BB_THD_SERVER: the session service, https://thehuntersdream.com:18671
+    std::string auth_base; // BB_THD_AUTH: the account service, https://thehuntersdream.com
+    std::string stun;      // BB_THD_STUN: host[:port]; empty: the server's host on 3478; "off"
+    std::string ruleset;   // BB_THD_RULESET: X-BBHost-Ruleset, "vanilla"
+    std::string client;    // what the User-Agent names this client by (BB_CLIENT_VERSION)
+    std::string p2p_addr;  // BB_THD_P2P_ADDR: our LAN address for peers (default: detected)
+    int p2p_port = 3658;   // BB_P2P_PORT
+    bool verify_tls = true;
+};
+const Config& Cfg();
+
+// The account the launcher signed in with Discord. Without one the game stays signed out.
+std::string AccountName();
+std::string AccountToken();
+bool SignedIn();
+// The server refused the token (HTTP 401): the poller slows down until the next launch.
+bool Refused();
+void MarkRefused(const std::string& reason);
+// The name the game and the server know this player by.
+std::string OnlineId();
+
+std::string StrOf(const Json& o, const char* key, const std::string& dflt = "");
+long long IntOf(const Json& o, const char* key, long long dflt = 0);
+
+std::string NpBase();
+bool NpPost(const std::string& path, const Json& body, Json& out, std::string& error,
+            int timeout_ms = 8000);
+bool NpGet(const std::string& path, Json& out, std::string& error, int timeout_ms = 8000);
+
+// ---- the dispatcher: one guest thread, so the callbacks run where the game expects them.
+enum class Prio { Context = 0, Request = 1, Signaling = 2, RoomEvent = 3 };
+void DispatchAfter(int delay_ms, Prio prio, std::function<void()> fn);
+std::int64_t NowMs();
+
+// A guest callback (the SysV ABI, integer arguments).
+template <typename... A>
+inline std::int64_t CallGuest(void* fn, A... a) {
+    using F = std::int64_t(PS4_SYSV_ABI*)(A...);
+    return fn ? reinterpret_cast<F>(fn)(a...) : 0;
+}
+
+// ---- our endpoint
+std::string LocalAddrText();
+int P2pPort();
+void SetP2pPortBound(int port);
+int StunRttUs();
+
+// ---- the peer table
+struct Peer {
+    std::uint16_t member_id = 0;
+    std::string online_id;
+    std::uint32_t addr = 0;       // network order: where the peer is reached
+    std::uint16_t port = 0;       // host order
+    std::uint32_t local_addr = 0; // network order: its LAN address
+    std::uint16_t local_port = 0; // host order
+    unsigned conn_id = 0;
+    int sig_status = 0;
+};
+void PeersClear();
+void PeersUpsert(const Peer& p);
+bool PeersGet(std::uint16_t member_id, Peer* out);
+bool PeersFindOnline(const std::string& id, Peer* out);
+void PeersSetConn(std::uint16_t member_id, unsigned conn_id, int sig_status);
+void PeersErase(std::uint16_t member_id);
+std::vector<Peer> PeersAll();
+int PeersFromMembers(const Json& members);
+Peer PeersProvisional(const std::string& id, std::uint32_t addr, std::uint16_t port);
+
+// ---- the session service
+bool ServerContextStart(Json& reply, std::string& error);
+bool ServerCreateRoom(int max_members, const Json& extra, Json& reply, std::string& error);
+bool ServerJoinRoom(std::uint64_t room_id, Json& reply, std::string& error);
+bool ServerLeaveRoom(const std::string& session_id, int member_id, Json& reply, std::string& error);
+int ServerHeartbeat(const std::string& session_id, int member_id); // 1 in the room, 0 not, -1 no answer
+bool ServerKickMember(const std::string& session_id, int member_id, int kicker_id,
+                      const std::uint8_t* opt, std::size_t opt_len, std::string& error);
+bool ServerSignalingResolve(const std::string& id, std::uint32_t* addr, std::uint16_t* port,
+                            std::string& error);
+void RoomSet(const std::string& session_id, int member_id);
+void RoomClear();
+void PollerStart(std::function<void(const Json& event)> handler);
+void PollerStop();
+
+// ---- the P2P port (thd_net.cpp)
+constexpr std::size_t kStunTokenLen = 8;
+struct Relay {
+    bool present = false;
+    std::uint8_t token[kStunTokenLen] = {};
+    std::uint16_t vport = 0;         // host order
+    std::uint32_t observed_addr = 0; // network order
+    std::uint16_t observed_port = 0; // host order
+};
+// A STUN Binding exchange from the P2P port (opened if the game has not bound it); with `relay`,
+// the relay HELLO, and the relay turned on or off by the answer.
+bool P2pStun(const char* host, std::uint16_t port, int timeout_ms, std::uint32_t* mapped_addr,
+             std::uint16_t* mapped_port, Relay* relay);
+// Probes from the P2P port so our NAT lets the peer in (none for a relayed peer).
+void P2pPunch(const char* label, std::uint32_t addr, std::uint16_t port, std::uint32_t local_addr,
+              std::uint16_t local_port);
+// The address of this machine that reaches `host` (the LAN address peers on it use).
+std::string DetectLanAddress(const std::string& host);
+
+// ---- game memory (1.09 only)
+void SetSignalingGate();
+void HostExtra(Json& extra);
+
+// ---- SceNpId / SceNpOnlineId
+void FillNpId(void* out, const char* online);
+std::string NpIdText(const void* npid);
+
+// ---- signaling (thd_np.cpp), driven by matching2
+void SignalingPeerKnown(std::uint16_t member_id);
+void SignalingPeerDead(const std::string& online_id);
+void SignalingReset();

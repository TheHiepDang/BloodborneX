new file mode 100644
index 0000000..cd6cc28
--- /dev/null
+++ b/packaging/linux/README-linux.txt
@@ -0,0 +1,22 @@
+Lantern Engine for Linux (x86-64)
+
+Needs: a Vulkan 1.3 GPU driver (Mesa RADV for AMD, NVIDIA's own driver, Intel ANV), glibc 2.38 or
+later (Ubuntu 24.04, Debian 13, Fedora 39, Arch, SteamOS 3.6, Bazzite), Python 3, X11 or Wayland.
+
+Start: open "Lantern Engine" (the launcher, the same as on Windows): pick the game folder (the
+one with eboot.bin and sce_module), then Play. If your file manager does not run it, run
+    chmod +x "Lantern Engine" lantern.sh engine/out/bb-start
+once in this folder.
+
+From a terminal instead:
+    ./lantern.sh /path/to/CUSA03173
+The folder is remembered, so later starts need only ./lantern.sh. A CUSA03173 folder next to
+this one, or inside it, is found without the argument.
+
+Settings: the launcher, lantern.ini in this folder, or the in-game menu (Insert, or L3+R3 on a
+controller). Saves go to user/, mods to mods/, and each session's log to logs/ (attach the newest
+one to a bug report).
+
+Not on Linux yet: DLSS and DLSS Frame Generation (NVIDIA ships them for Windows here), FSR 4
+through AMD's Windows DLL, the launcher's self-update, and the native PC option pages; the in-game
+menu covers the settings.
diff --git a/packaging/linux/bb-start b/packaging/linux/bb-start
new file mode 100644
index 0000000..184722f
--- /dev/null
+++ b/packaging/linux/bb-start
@@ -0,0 +1,28 @@
+#!/usr/bin/env bash
+# The Linux package's start program (engine/out/bb-start), as engine\out\bb-start.exe is on
+# Windows: the launcher runs it with --game-dir and its environment (BB_DATA_DIR, BB_CONFIG, the
+# settings as BB_* variables); lantern.sh runs it from a terminal. It runs the engine's run.sh,
+# which prepares the boot image, mods and patches and starts out/bb-probe.
+#
+#   bb-start [--game-dir DIR] [bb-probe options...]
+set -euo pipefail
+out=$(cd -- "$(dirname -- "$0")" && pwd)
+engine=$(dirname -- "$out")
+package=$(dirname -- "$engine")
+if [[ ${1:-} == --game-dir ]]; then
+    export BB_GAME_DIR=${2:?--game-dir needs a folder}
+    shift 2
+fi
+export BB_PREBUILT=1
+export BB_DATA_DIR=${BB_DATA_DIR:-$package}
+export BB_CONFIG=${BB_CONFIG:-$BB_DATA_DIR/lantern.ini}
+[[ -f $BB_CONFIG ]] || cp "$engine/lantern.default.ini" "$BB_CONFIG"
+# The shader and pipeline caches in user/cache, as bb-start.exe keeps them on Windows.
+export BB_GPU_USER_DIR=${BB_GPU_USER_DIR:-$BB_DATA_DIR/user}
+mkdir -p "$BB_GPU_USER_DIR"
+# The engine's programs and its generated files in engine/out, as on Windows.
+export BB_PROBE=${BB_PROBE:-$out/bb-probe}
+export BB_OUT_DIR=${BB_OUT_DIR:-$out}
+export BB_SAVE_LOG=${BB_SAVE_LOG:-1}
+command -v python3 >/dev/null || { echo 'The start scripts need Python 3 (python3).' >&2; exit 1; }
+exec bash "$engine/run.sh" "$@"
diff --git a/packaging/linux/build.sh b/packaging/linux/build.sh
new file mode 100644
index 0000000..9f7b575
--- /dev/null
+++ b/packaging/linux/build.sh
@@ -0,0 +1,75 @@
+#!/usr/bin/env bash
+# Linux package of the Lantern Engine: builds the engine (engine/build.sh) in the Ubuntu 24.04
+# environment of setup-ubuntu.sh (or the Dockerfile) and writes
+# engine/out/package/LanternEngine-v<version>-linux-x64.tar.gz.
+#
+#   packaging/linux/build.sh <version> [package-template folder] [launcher folder]
+#
+# The package mirrors the Windows one: the launcher ("Lantern Engine", the Avalonia launcher
+# published for linux-x64, when its folder is given), lantern.sh (starts the game from a terminal),
+# lantern.ini (shipped settings, also kept as engine/lantern.default.ini), and engine/ with run.sh,
+# its Python start scripts, the patches and FSR 4 shaders, and engine/out with bb-start, bb-probe,
+# its GPU library and SDL3. The player's system gives Vulkan, X11 or Wayland, Python 3 and
+# OpenSSL 3; saves, mods and logs stay next to lantern.sh.
+set -euo pipefail
+engine=$(cd -- "$(dirname -- "$0")/../.." && pwd)
+version=${1:?usage: packaging/linux/build.sh <version> [package-template folder] [launcher folder]}
+template=$(cd -- "${2:-$engine/../package-template}" && pwd)
+launcher=${3:-}
+cd "$engine"
+export CC=${CC:-clang} CXX=${CXX:-clang++}
+export PKG_CONFIG_PATH=${PKG_CONFIG_PATH:-/opt/deps/lib/pkgconfig:/opt/deps/share/pkgconfig}
+export CMAKE_PREFIX_PATH=${CMAKE_PREFIX_PATH:-/opt/deps}
+export LDFLAGS=${LDFLAGS:--fuse-ld=lld}
+# The profiles in pgo/ come from Windows runs: built without one.
+BB_PGO=${BB_PGO:-off} bash build.sh
+
+root=out/package/LanternEngine
+bin=$root/engine/out
+rm -rf out/package
+mkdir -p "$bin/gpu"
+install -m755 out/bb-probe out/bb-gpu-capabilities packaging/linux/bb-start "$bin/"
+for tool in bb-engine-assets bb-shader-lab; do
+    [[ ! -f out/$tool ]] || install -m755 "out/$tool" "$bin/"
+done
+install -m755 out/gpu/libbbgpu.so "$bin/gpu/"
+# SDL3 (the one shared library built for the package) beside the GPU library: bb-probe finds both
+# through its $ORIGIN/gpu RUNPATH, the GPU library through its own $ORIGIN. bb-probe itself is not
+# patched (patchelf breaks the non-PIE binary's symbol versions).
+sdl=$(pkg-config --variable=libdir sdl3)/libSDL3.so.0
+install -m755 "$(readlink -f "$sdl")" "$bin/gpu/libSDL3.so.0"
+patchelf --set-rpath '$ORIGIN' "$bin/gpu/libbbgpu.so"
+patchelf --set-rpath '$ORIGIN/gpu' "$bin/bb-gpu-capabilities"
+strip --strip-debug "$bin/gpu/libbbgpu.so" "$bin/gpu/libSDL3.so.0"
+cp out/gpu-cache.id out/gpu-cache.legacy.id "$bin/" 2>/dev/null || true
+
+cp run.sh "$root/engine/"
+cp -r scripts patches data licenses "$root/engine/"
+for item in fsr4_shaders shader-catalog gamecontrollerdb.txt; do
+    [[ ! -e $template/engine/$item ]] || cp -r "$template/engine/$item" "$root/engine/"
+done
+cp "$template/lantern.ini" "$root/engine/lantern.default.ini"
+cp "$template/lantern.ini" "$template/LICENSE" "$root/"
+install -m755 packaging/linux/lantern.sh "$root/lantern.sh"
+cp packaging/linux/README-linux.txt "$root/README.txt"
+if [[ -n $launcher ]]; then
+    cp -r "$launcher"/. "$root/"
+fi
+find "$root" -name __pycache__ -prune -exec rm -rf {} +
+# Files copied from a Windows drive come executable: only the programs and scripts are.
+find "$root" -type d -exec chmod 755 {} +
+find "$root" -type f -exec chmod 644 {} +
+chmod 755 "$root/lantern.sh" "$root/engine/run.sh" "$bin"/bb-* "$bin"/gpu/*.so* "$root"/engine/scripts/*.py
+[[ ! -f "$root/Lantern Engine" ]] || chmod 755 "$root/Lantern Engine"
+# Files checked out on Windows: the scripts need Unix line ends.
+find "$root" -type f \( -name '*.sh' -o -name '*.py' -o -name '*.ini' -o -name '*.txt' -o -name '*.json' \
+    -o -name bb-start \) -exec sed -i 's/\r$//' {} +
+# The engine id is the Windows launcher's (Updater.EngineId), as build.ps1 writes it; BB_ENGINE_ID
+# when the launcher's source is not beside the engine.
+engine_id=${BB_ENGINE_ID:-$(sed -n 's/.*EngineId = "\([^"]*\)".*/\1/p' "$engine/../launcher/BloodborneLauncher/Core/Updater.cs" 2>/dev/null || true)}
+printf '{ "version": "%s", "engine": "%s", "platform": "linux-x64" }\n' "$version" "${engine_id:-unknown}" \
+    > "$root/package.json"
+
+archive=out/package/LanternEngine-v$version-linux-x64.tar.gz
+tar -C out/package -czf "$archive" LanternEngine
+echo "Package: $engine/$archive ($(du -h "$archive" | cut -f1))"
diff --git a/packaging/linux/lantern.sh b/packaging/linux/lantern.sh
new file mode 100644
index 0000000..14e3b56
--- /dev/null
+++ b/packaging/linux/lantern.sh
@@ -0,0 +1,34 @@
+#!/usr/bin/env bash
+# Starts Bloodborne with the Lantern Engine from a terminal (Linux package; the launcher, "Lantern
+# Engine", does the same with its settings).
+#
+#   ./lantern.sh [game folder] [bb-probe options...]
+#
+# The game folder holds the game's files (eboot.bin, sce_module, ...): the first argument, else
+# BB_GAME_DIR, else the last one used, else CUSA03173 next to this folder or inside it.
+# Settings are lantern.ini here (the in-game menu: Insert or L3+R3); saves, mods and logs stay in
+# this folder too.
+set -euo pipefail
+here=$(cd -- "$(dirname -- "$0")" && pwd)
+export BB_DATA_DIR=${BB_DATA_DIR:-$here}
+remembered=$here/engine/out/game_dir.txt
+game=${BB_GAME_DIR:-}
+if [[ $# -gt 0 && -f $1/eboot.bin ]]; then
+    game=$(cd -- "$1" && pwd)
+    shift
+fi
+if [[ -z $game && -f $remembered ]]; then
+    game=$(<"$remembered")
+fi
+if [[ -z $game || ! -f $game/eboot.bin ]]; then
+    for candidate in "$here/../CUSA03173" "$here/CUSA03173"; do
+        if [[ -f $candidate/eboot.bin ]]; then game=$(cd -- "$candidate" && pwd); break; fi
+    done
+fi
+if [[ -z $game || ! -f $game/eboot.bin ]]; then
+    echo 'No game folder found: pass it as the first argument (the folder with eboot.bin),' >&2
+    echo "for example: $0 ~/Games/CUSA03173" >&2
+    exit 1
+fi
+printf '%s\n' "$game" > "$remembered"
+exec "$here/engine/out/bb-start" --game-dir "$game" "$@"
diff --git a/packaging/linux/setup-ubuntu.sh b/packaging/linux/setup-ubuntu.sh
new file mode 100644
index 0000000..f98106c
--- /dev/null
+++ b/packaging/linux/setup-ubuntu.sh
@@ -0,0 +1,122 @@
+#!/usr/bin/env bash
+# Linux build environment of the Lantern Engine on Ubuntu 24.04 (WSL, a VM, a CI runner): the same
+# packages and libraries as packaging/linux/Dockerfile, installed directly. Run as root once;
+# packaging/linux/build.sh then builds and packages the engine.
+#
+# The libraries the Windows build takes from MSYS2 are built at the same versions into /opt/deps,
+# static and position independent where they can be (linked into libbbgpu.so); SDL3 is the one
+# shared library shipped. Vulkan, X11/Wayland and OpenSSL 3 come from the player's system.
+set -euo pipefail
+[[ $(id -u) == 0 ]] || { echo 'Run as root (sudo).' >&2; exit 1; }
+export DEBIAN_FRONTEND=noninteractive
+jobs=${BB_JOBS:-$(nproc)}
+
+apt-get update -qq
+apt-get install -y -qq --no-install-recommends \
+    ca-certificates curl git xz-utils file patchelf rsync \
+    clang-20 lld-20 llvm-20 g++-14 cmake ninja-build make pkg-config python3 nasm \
+    glslang-tools libvulkan-dev libboost-dev libxxhash-dev libssl-dev zlib1g-dev \
+    libexpat1-dev nlohmann-json3-dev libx11-dev \
+    libxext-dev libxrandr-dev libxcursor-dev libxi-dev libxss-dev libxfixes-dev libxtst-dev \
+    libxkbcommon-dev libwayland-dev wayland-protocols libdecor-0-dev libegl-dev libgles-dev \
+    libasound2-dev libpulse-dev libpipewire-0.3-dev libudev-dev libdbus-1-dev libibus-1.0-dev \
+    libdrm-dev libgbm-dev libusb-1.0-0-dev >/dev/null
+for tool in clang clang++ lld ld.lld llvm-ar llvm-ranlib llvm-nm llvm-profdata llvm-symbolizer; do
+    ln -sf "/usr/bin/$tool-20" "/usr/local/bin/$tool"
+done
+
+export CC=clang CXX=clang++ PKG_CONFIG_PATH=/opt/deps/lib/pkgconfig:/opt/deps/share/pkgconfig \
+    CMAKE_PREFIX_PATH=/opt/deps
+deps=(-G Ninja -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/opt/deps
+      -DCMAKE_POSITION_INDEPENDENT_CODE=ON -DBUILD_SHARED_LIBS=OFF)
+work=${BB_DEPS_WORK:-/var/tmp/lantern-deps}
+mkdir -p "$work" /opt/deps
+cd "$work"
+
+# One stamp per library: a rerun skips what is installed.
+built() { [[ -f /opt/deps/.stamp-$1 ]]; }
+stamp() { touch "/opt/deps/.stamp-$1"; }
+fetch() { # name tag url [--recursive]
+    rm -rf "$1"
+    git clone -q --depth 1 -b "$2" ${4:-} "$3" "$1"
+}
+cmake_dep() { # name tag url [cmake args...]
+    local name=$1 tag=$2 url=$3
+    shift 3
+    built "$name" && return
+    echo "deps: $name $tag"
+    fetch "$name" "$tag" "$url" --recursive
+    cmake -S "$name" -B "$name/b" "${deps[@]}" "$@" >/dev/null
+    cmake --build "$name/b" -j "$jobs" >/dev/null
+    cmake --install "$name/b" >/dev/null
+    rm -rf "$name"
+    stamp "$name"
+}
+
+cmake_dep vulkan-headers v1.4.363 https://github.com/KhronosGroup/Vulkan-Headers.git
+cmake_dep vma v3.3.0 https://github.com/GPUOpen-LibrariesAndSDKs/VulkanMemoryAllocator.git
+cmake_dep fmt 12.0.0 https://github.com/fmtlib/fmt.git -DFMT_TEST=OFF -DFMT_DOC=OFF
+cmake_dep magic_enum v0.9.7 https://github.com/Neargye/magic_enum.git \
+    -DMAGIC_ENUM_OPT_BUILD_EXAMPLES=OFF -DMAGIC_ENUM_OPT_BUILD_TESTS=OFF
+cmake_dep robin-map v1.4.0 https://github.com/Tessil/robin-map.git
+cmake_dep miniz 3.1.0 https://github.com/richgel999/miniz.git \
+    -DBUILD_EXAMPLES=OFF -DBUILD_TESTS=OFF -DBUILD_FUZZERS=OFF
+# Zydis with its Zycore installed beside it (zydis-config.cmake looks for Zycore's own config,
+# which the bundled copy does not install; Zydis itself builds with the bundled copy).
+# Build output goes to /dev/null: a failing step stops the script (set -e) without its errors,
+# so rerun that step by hand to see them.
+if ! built zydis-zycore; then
+    echo 'deps: zydis v4.1.1 + zycore'
+    fetch zydis v4.1.1 https://github.com/zyantific/zydis.git --recursive
+    cmake -S zydis/dependencies/zycore -B zydis/zb "${deps[@]}" -DZYCORE_BUILD_TESTS=OFF \
+        -DZYCORE_BUILD_EXAMPLES=OFF >/dev/null
+    cmake --build zydis/zb -j "$jobs" >/dev/null
+    cmake --install zydis/zb >/dev/null
+    cmake -S zydis -B zydis/b "${deps[@]}" -DZYDIS_BUILD_TOOLS=OFF \
+        -DZYDIS_BUILD_EXAMPLES=OFF -DZYDIS_BUILD_DOXYGEN=OFF >/dev/null
+    cmake --build zydis/b -j "$jobs" >/dev/null
+    cmake --install zydis/b >/dev/null
+    rm -rf zydis
+    stamp zydis-zycore
+fi
+# miniupnpc (bbnet's port mapping), static as on Windows: its CMake project is a subfolder.
+if ! built miniupnpc; then
+    echo 'deps: miniupnpc 2.2.8'
+    fetch miniupnp miniupnpc_2_2_8 https://github.com/miniupnp/miniupnp.git
+    cmake -S miniupnp/miniupnpc -B miniupnp/b "${deps[@]}" -DUPNPC_BUILD_STATIC=ON \
+        -DUPNPC_BUILD_SHARED=OFF -DUPNPC_BUILD_TESTS=OFF -DUPNPC_BUILD_SAMPLE=OFF >/dev/null
+    cmake --build miniupnp/b -j "$jobs" >/dev/null
+    cmake --install miniupnp/b >/dev/null
+    rm -rf miniupnp
+    stamp miniupnpc
+fi
+# Protobuf (bbnet's shadNet messages), with its Abseil.
+cmake_dep protobuf v29.5 https://github.com/protocolbuffers/protobuf.git \
+    -Dprotobuf_BUILD_TESTS=OFF -Dprotobuf_ABSL_PROVIDER=module -DABSL_PROPAGATE_CXX_STD=ON \
+    -Dprotobuf_INSTALL=ON -Dutf8_range_ENABLE_INSTALL=ON
+# SDL3: shared (its video, audio and input backends are loaded at run time from the system).
+if ! built sdl3; then
+    echo 'deps: SDL3 release-3.4.18'
+    fetch sdl release-3.4.18 https://github.com/libsdl-org/SDL.git
+    cmake -S sdl -B sdl/b -G Ninja -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/opt/deps \
+        -DSDL_SHARED=ON -DSDL_STATIC=OFF -DSDL_TESTS=OFF -DSDL_EXAMPLES=OFF >/dev/null
+    cmake --build sdl/b -j "$jobs" >/dev/null
+    cmake --install sdl/b >/dev/null
+    rm -rf sdl
+    stamp sdl3
+fi
+# FFmpeg: only what the game's movies need (H.264/HEVC video, AAC audio in MP4), no system
+# libraries.
+if ! built ffmpeg; then
+    echo 'deps: FFmpeg n7.1.1'
+    fetch ffmpeg n7.1.1 https://github.com/FFmpeg/FFmpeg.git
+    (cd ffmpeg && ./configure --prefix=/opt/deps --cc=clang --enable-pic --enable-static --disable-shared \
+        --disable-autodetect --disable-programs --disable-doc --disable-network --disable-everything \
+        --disable-avdevice --disable-avfilter --disable-postproc \
+        --enable-decoder=h264,hevc,aac,aac_latm --enable-parser=h264,hevc,aac \
+        --enable-demuxer=mov,mpegts,h264,hevc,aac --enable-protocol=file --enable-swscale \
+        --enable-swresample >/dev/null && make -j"$jobs" >/dev/null && make install >/dev/null)
+    rm -rf ffmpeg
+    stamp ffmpeg
+fi
+echo "Linux build environment ready (/opt/deps)"

--- /dev/null
+++ b/gpu/shadps4/video_core/host_shaders/froyok_bloom.comp
@@ -0,0 +1,79 @@
+// SPDX-License-Identifier: MIT
+// Copyright (c) 2025 Léna Piquet
+// Adapted from Froyok/Bloom at 6a839ab (data/shader/downsample.FRG.glsl and
+// upsample.FRG.glsl). See engine/licenses/FROYOK-BLOOM.txt.
+#version 450
+
+layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
+layout(set = 0, binding = 0) uniform sampler2D current_image;
+layout(set = 0, binding = 1) uniform sampler2D previous_image;
+layout(rgba16f, set = 0, binding = 2) uniform writeonly image2D output_image;
+layout(push_constant) uniform Params {
+    uvec2 destination_size;
+    vec2 pixel_size;
+    float blend;
+} pc;
+
+const vec2 offsets[13] = vec2[13](
+    vec2(-1, 1), vec2(1, 1), vec2(-1, -1), vec2(1, -1),
+    vec2(-2, 2), vec2(0, 2), vec2(2, 2),
+    vec2(-2, 0), vec2(0, 0), vec2(2, 0),
+    vec2(-2, -2), vec2(0, -2), vec2(2, -2));
+const float weights[13] = float[13](
+    0.125, 0.125, 0.125, 0.125,
+    0.03125, 0.0625, 0.03125, 0.0625, 0.125, 0.0625,
+    0.03125, 0.0625, 0.03125);
+
+vec3 AverageBlock(vec3 a, vec3 b, vec3 c, vec3 d) {
+    const vec4 brightness = vec4(max(max(a.r, a.g), a.b), max(max(b.r, b.g), b.b),
+                                 max(max(c.r, c.g), c.b), max(max(d.r, d.g), d.b));
+    const vec4 weights = 1.0 / (brightness + 1.0);
+    return (a * weights.x + b * weights.y + c * weights.z + d * weights.w) /
+           (weights.x + weights.y + weights.z + weights.w);
+}
+
+vec3 Downsample(vec2 uv) {
+    vec3 samples[13];
+    for (int i = 0; i < 13; ++i) {
+        samples[i] = textureLod(current_image, uv + offsets[i] * pc.pixel_size, 0.0).rgb;
+    }
+#if FIRST
+    const vec3 center = AverageBlock(samples[0], samples[1], samples[2], samples[3]);
+    const vec3 top_left = AverageBlock(samples[4], samples[5], samples[8], samples[7]);
+    const vec3 top_right = AverageBlock(samples[5], samples[6], samples[9], samples[8]);
+    const vec3 bottom_left = AverageBlock(samples[7], samples[8], samples[11], samples[10]);
+    const vec3 bottom_right = AverageBlock(samples[8], samples[9], samples[12], samples[11]);
+    return 0.5 * center + 0.125 * (top_left + top_right + bottom_left + bottom_right);
+#else
+    vec3 color = vec3(0.0);
+    for (int i = 0; i < 13; ++i) {
+        color += weights[i] * samples[i];
+    }
+    return color;
+#endif
+}
+
+vec3 Upsample(vec2 uv) {
+    vec3 color = vec3(0.0);
+    for (int y = -1; y <= 1; ++y) {
+        for (int x = -1; x <= 1; ++x) {
+            const float weight = (x == 0 ? 2.0 : 1.0) * (y == 0 ? 2.0 : 1.0);
+            color += weight * textureLod(previous_image,
+                                         uv + vec2(x, y) * pc.pixel_size, 0.0).rgb;
+        }
+    }
+    return mix(textureLod(current_image, uv, 0.0).rgb, color * (1.0 / 16.0), pc.blend);
+}
+
+void main() {
+    if (any(greaterThanEqual(gl_GlobalInvocationID.xy, pc.destination_size))) {
+        return;
+    }
+    const vec2 uv = (vec2(gl_GlobalInvocationID.xy) + 0.5) / vec2(pc.destination_size);
+#ifdef UPSAMPLE
+    const vec3 color = Upsample(uv);
+#else
+    const vec3 color = Downsample(uv);
+#endif
+    imageStore(output_image, ivec2(gl_GlobalInvocationID.xy), vec4(min(color, vec3(65000.0)), 1.0));
+}

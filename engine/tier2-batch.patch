diff --git a/gpu/shadps4/video_core/renderer_vulkan/vk_tier2_variants.h b/gpu/shadps4/video_core/renderer_vulkan/vk_tier2_variants.h
new file mode 100644
--- /dev/null
+++ b/gpu/shadps4/video_core/renderer_vulkan/vk_tier2_variants.h
@@ -0,0 +1,101 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// BloodborneX: immutable, recording-thread selected alternatives. Disk SPIR-V stays original.
+#pragma once
+#include "video_core/renderer_vulkan/vk_common.h"
+#include <map>
+#include <set>
+#include <mutex>
+#include "bbport_settings.h"
+#include "vk_ggx_patch.h"
+#include "vk_ggx_lobes.h"
+#include "vk_local_falloff.h"
+#include "vk_pom_patch.h"
+#include "shader_recompiler/info.h"
+#include "shader_recompiler/profile.h"
+#include "shader_recompiler/backend/bindings.h"
+
+namespace Vulkan {
+class Tier2Variants {
+    static std::span<const u32> MotionBlurCode();
+    struct Record {
+        u64 hash{};
+        bool motion_fits{};
+        std::vector<u32> original;
+        std::map<u32,vk::UniqueShaderModule> alternatives;
+    };
+    std::mutex mutex;
+    std::map<VkShaderModule,Record> records;
+    std::set<u64> hashes;
+    u32 active{};
+public:
+    // The renderer calls this only at a display boundary. Scalars baked by upstream stay startup-only.
+    bool Latch() {
+        const auto& s=BbSettings::Get();
+        const u32 bits=u32(s.graphics_ggx_mode.load()) |
+            (u32(s.graphics_local_ggx.load())<<2) | (u32(s.graphics_specular_aa.load())<<3) |
+            (u32(s.graphics_env_tails.load())<<4) | (u32(s.graphics_local_falloff.load())<<5) |
+            (u32(s.graphics_pom.load())<<6) | (u32(s.graphics_motion_blur_quality.load())<<7) |
+            (u32(s.graphics_smooth_normals.load())<<8) | (u32(s.graphics_sky_seam.load())<<9) |
+            (u32(s.graphics_sky_zenith.load())<<10) | (u32(s.graphics_bloom_quality.load())<<11) | (u32(s.startup_light_sharpness!=1.0f)<<12) | (u32(s.graphics_auto_exposure.load())<<13) | (u32(s.graphics_native_sss.load())<<14);
+        const bool changed=bits!=active; active=bits; return changed;
+    }
+    bool SmoothNormals() const { return active & 256; }
+    bool SkySeam() const { return active & 512; }
+    bool SkyZenith() const { return active & 1024; }
+    bool Contains(u64 hash) {
+        std::scoped_lock lock(mutex); return hashes.contains(hash);
+    }
+    void Remember(vk::ShaderModule base,const Shader::Info& info,const Shader::Profile& profile,
+                  const Shader::Backend::Bindings& start,std::span<const u32> original) {
+        if(info.sw_stage!=Shader::SwStage::Fragment || !base) return;
+        const bool known=info.pgm_hash==Ggx::DirectionalHash || LocalFalloff::Target(u32(info.pgm_hash)) ||
+            Pom::Targets(info.pgm_hash) || info.pgm_hash==0x29e06868;
+        if(!known) {
+            // Keep only exact upstream lobe matches, never every game's SPIR-V in RAM.
+            std::vector<u32> candidate(original.begin(),original.end());
+            if(!GgxLobes::Patch(candidate,{true,true,true}).Changed()) return;
+        }
+        std::scoped_lock lock(mutex);
+        auto [it,added]=records.try_emplace(VkShaderModule(base)); if(!added) return;
+        it->second.hash=info.pgm_hash;
+        it->second.motion_fits=start.unified==0 && start.buffer==0 && profile.uniform_dword_layout &&
+            !profile.uniform_exact_base && info.buffers.size()==1 && info.images.size()==2 &&
+            info.samplers.size()==2 && info.fmasks.empty() && info.buffers[0].is_uniform;
+        it->second.original.assign(original.begin(),original.end());
+        hashes.insert(info.pgm_hash);
+    }
+    // A failed shape/driver check always selects the exact original module and key.
+    std::pair<vk::ShaderModule,u32> Select(vk::Device device,vk::ShaderModule base) {
+        const u32 bits=active&0x10ff;
+        if(!bits) return {base,0};
+        std::scoped_lock lock(mutex);
+        auto it=records.find(VkShaderModule(base)); if(it==records.end()) return {base,0};
+        auto& r=it->second;
+        auto found=r.alternatives.find(bits);
+        if(found!=r.alternatives.end()) return found->second ? std::pair{*found->second,bits} : std::pair{base,0u};
+        auto spv=r.original;
+        const auto& s=BbSettings::Get();
+        Ggx::Patch(r.hash,true,(bits&3)!=0,spv,(bits&3)==2);
+        GgxLobes::Patch(spv,{bool(bits&4),bool(bits&8),bool(bits&16)});
+        if(LocalFalloff::Target(u32(r.hash))) {
+            LocalFalloff::Patch(spv,u32(r.hash),bits&32,s.startup_light_intensity,s.startup_light_core);
+            // This scalar modifies the light lobe, independent of inverse-square enablement.
+            GgxLobes::ScaleLightSharpness(spv,s.startup_light_sharpness);
+        }
+        if(bits&64) Pom::PatchPom(r.hash,true,spv);
+        if((bits&128) && r.hash==0x29e06868 && r.motion_fits) {
+            const auto code=MotionBlurCode(); spv.assign(code.begin(),code.end());
+        }
+        if(spv==r.original) { r.alternatives.try_emplace(bits); return {base,0}; }
+        try {
+            auto [result,module]=device.createShaderModuleUnique({.codeSize=spv.size()*4,.pCode=spv.data()});
+            if(result==vk::Result::eSuccess) {
+                auto [pos,_]=r.alternatives.emplace(bits,std::move(module));
+                std::printf("Tier 2 shader: %08x variant %u ready (original retained)\n",u32(r.hash),bits);
+                return {*pos->second,bits};
+            }
+        } catch(...) { /* optional enhancement retains original shader */ }
+        r.alternatives.try_emplace(bits); return {base,0};
+    }
+};
+} // namespace Vulkan

+    auto step = [&](double elapsed = 1.0 / 30, bool fresh = true) {
+        in.now += elapsed;
+        if (fresh) in.index = (in.index + 1) % 17;
+        return policy.Update(in);
+    };
+    auto ready = [&] {
+        Policy::Result result;
+        for (int i = 0; i < 100; ++i) result = step(0.1);
+        assert(result.status == Status::Active);
+        assert(std::abs(result.gray - -std::expm1(-0.016f * 3)) < 1e-6);
+        return result;
+    };
+    assert(policy.Update(in).status == Status::Calibrating);
+    for (int i = 0; i < 17; ++i) assert(step().status == Status::Calibrating);
+    ready();
+    in.adapted = 0.01f;
+    auto low = step();
+    assert(std::abs(std::log2(low.exposure / 3) + 1.0f) < 1e-6);
+    in.adapted = 1.84f;
+    assert(step().exposure == 1.84f);
+    in.adapted = 100;
+    auto high = step();
+    assert(std::abs(std::log2(high.exposure / 3) - 0.5f) < 1e-6);
+    in.luminance *= 8; // A sky-facing pan must not relearn the neutral reference.
+    assert(step().gray == high.gray);
+    in.luminance = 0.016f;
+    in.adapted = 3;
+    assert(policy.Update(in, true).status == Status::Calibrating);
+    ready();
+    ++in.area;
+    assert(step().status == Status::Calibrating);
+    ready();
+    ++in.resource;
+    assert(step().status == Status::Calibrating);
+    ready();
+    in.baseline = 2.5;
+    auto reset = step();
+    assert(reset.status == Status::Calibrating && reset.exposure == 2.5);
+    in.baseline = in.adapted = 3;
+    ready();
+    assert(step(1).status == Status::Calibrating);
+    ready();
+    for (int i = 0; i < 60; ++i) reset = step(1.0 / 30, false);
+    assert(reset.status == Status::Calibrating); // No fresh meter result: don't use stale exposure.
+    ready();
+    in.valid_sample = false;
+    assert(step().status == Status::Invalid);
+    in.valid_sample = true;
+    ready();
+    in.adapted = std::numeric_limits<float>::infinity();
+    assert(step().status == Status::Invalid);
+    in.adapted = 3;
+    in.native_dt = 0;
+    assert(step().status == Status::Invalid);
+    in.native_dt = 1.0f / 60;
+    in.baseline = std::numeric_limits<float>::quiet_NaN();
+    assert(step().status == Status::Invalid);
+
+    for (int fps : {30, 60, 120, 144}) {
+        const auto response = Response(1.0 / fps, 1.0f / 60);
+        const double alpha = 1 - std::pow(1 - response.sensitivity, (1.0 / 60) / 0.3);
+        const double residual_after_second = std::pow(1 - alpha, fps);
+        assert(std::abs(residual_after_second - std::pow(0.5, 1 / 0.6)) < 1e-6);
+        assert(std::abs(response.speed * (1.0 / 60) * fps - 0.25) < 1e-6);
+    }
+}
diff --git a/tests/test_ggx_lobes.cpp b/tests/test_ggx_lobes.cpp
new file mode 100644
--- /dev/null
+++ b/tests/test_ggx_lobes.cpp
@@ -0,0 +1,78 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#include "../gpu/shadps4/video_core/renderer_vulkan/vk_ggx_lobes.h"
+#include <cassert>
+#include <filesystem>
+#include <fstream>
+#include <iostream>
+
+namespace {
+std::vector<uint32_t> Read(const std::filesystem::path& path) {
+    std::ifstream file(path, std::ios::binary | std::ios::ate);
+    assert(file);
+    const auto size = file.tellg();
+    std::vector<uint32_t> words(size_t(size) / 4);
+    file.seekg(0);
+    file.read(reinterpret_cast<char*>(words.data()), std::streamsize(words.size() * 4));
+    return words;
+}
+}
+
+// Usage: ggx-lobes-test [cache-dir out-dir]
+int main(int argc, char** argv) {
+    using namespace Vulkan::GgxLobes;
+    std::vector<uint32_t> malformed{0x07230203, 0x10600, 0, 10, 0, 0};
+    const auto original = malformed;
+    assert(!Patch(malformed, {}).Changed() && malformed == original);
+    assert(!ScaleLightSharpness(malformed, 4.0f) && malformed == original);
+    if (argc == 3) {
+        const std::filesystem::path out = argv[2];
+        std::filesystem::create_directories(out);
+        Stats total{};
+        uint32_t shaders = 0, sharpened = 0, sharp_sites = 0;
+        for (const auto& entry : std::filesystem::directory_iterator(argv[1])) {
+            if (entry.path().extension() != ".spv") continue;
+            const auto source = Read(entry.path());
+            auto words = source;
+            assert(!Patch(words, {false, false, false}).Changed() && words == source);
+            assert(!ScaleLightSharpness(words, 1.0f) && words == source);
+            const auto stats = Patch(words, {});
+            // Sharpness runs after the lobe pass in game; check that order and the "removed" end.
+            auto sharp = words;
+            if (const auto sites = ScaleLightSharpness(sharp, 4.0f)) {
+                ++sharpened, sharp_sites += sites;
+                auto removed = source;
+                assert(ScaleLightSharpness(removed, SharpnessRemoved) == sites);
+                for (const auto& [name, data] : {std::pair{"_s4.spv", &sharp}, std::pair{"_sx.spv", &removed}}) {
+                    std::ofstream v(out / (entry.path().stem().string() + name), std::ios::binary);
+                    v.write(reinterpret_cast<const char*>(data->data()), std::streamsize(data->size() * 4));
+                }
+            }
+            if (!stats.Changed()) {
+                assert(words == source);
+                continue;
+            }
+            ++shaders;
+            total.phong += stats.phong, total.blinn += stats.blinn, total.env += stats.env;
+            total.filtered += stats.filtered;
+            std::ofstream file(out / entry.path().filename(), std::ios::binary);
+            file.write(reinterpret_cast<const char*>(words.data()), std::streamsize(words.size() * 4));
+            for (const Options options : {Options{true, false, false}, Options{false, true, false},
+                                          Options{false, false, true}}) {
+                auto variant = source;
+                if (Patch(variant, options).Changed()) {
+                    std::ofstream v(out / (entry.path().stem().string() + "_v" +
+                                           std::to_string(options.local_ggx * 1 +
+                                                          options.specular_aa * 2 +
+                                                          options.env_tails * 4) + ".spv"),
+                                    std::ios::binary);
+                    v.write(reinterpret_cast<const char*>(variant.data()),
+                            std::streamsize(variant.size() * 4));
+                }
+            }
+        }
+        std::cout << shaders << " shaders: " << total.phong << " phong, " << total.blinn
+                  << " blinn, " << total.env << " env, " << total.filtered << " filtered; sharpness: " << sharpened << " shaders, " << sharp_sites
+                  << " sites\n";
+    }
+    std::cout << "GGX lobe patch passed\n";
+}
diff --git a/tests/test_ggx_patch.cpp b/tests/test_ggx_patch.cpp
new file mode 100644
--- /dev/null
+++ b/tests/test_ggx_patch.cpp
@@ -0,0 +1,88 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#include "../gpu/shadps4/video_core/renderer_vulkan/vk_ggx_patch.h"
+#include "../gpu/shadps4/video_core/renderer_vulkan/vk_ggx_lobes.h"
+#include <cassert>
+#include <filesystem>
+#include <fstream>
+#include <iostream>
+
+namespace {
+std::vector<uint32_t> Read(const std::filesystem::path& path) {
+    std::ifstream file(path, std::ios::binary | std::ios::ate);
+    assert(file);
+    const auto size = file.tellg();
+    assert(size > 0 && size % 4 == 0);
+    std::vector<uint32_t> words(size_t(size) / 4);
+    file.seekg(0);
+    file.read(reinterpret_cast<char*>(words.data()), size);
+    assert(file);
+    return words;
+}
+}
+
+int main(int argc, char** argv) {
+    using namespace Vulkan::Ggx;
+    assert(argc == 1 || argc >= 4);
+    std::vector<uint32_t> malformed{0x07230203, 0x10600, 0, 10, 0, 0};
+    const auto original = malformed;
+    assert(Patch(DirectionalHash, true, false, malformed) == Result::Disabled);
+    assert(Patch(DirectionalHash, false, true, malformed) == Result::Unrelated);
+    assert(Patch(0x1234, true, true, malformed) == Result::Unrelated);
+    assert(Patch(DirectionalHash, true, true, malformed) == Result::Unsupported);
+    assert(malformed == original);
+    if (argc >= 4) {
+        const std::filesystem::path output = argv[argc - 1];
+        assert(!std::filesystem::exists(output));
+        std::filesystem::create_directories(output);
+        for (int i = 1; i <= argc - 2; ++i) {
+            const auto source = Read(argv[i]);
+            auto words = source;
+            assert(Patch(DirectionalHash, true, false, words) == Result::Disabled && words == source);
+            assert(Patch(0x1234, true, true, words) == Result::Unrelated && words == source);
+            assert(Patch(DirectionalHash, true, true, words) == Result::Applied);
+            auto second = source;
+            assert(Patch(DirectionalHash, true, true, second) == Result::Applied && second == words);
+            const auto patched = words;
+            assert(Patch(DirectionalHash, true, true, words) == Result::Unsupported && words == patched);
+            auto strict = source;
+            assert(Patch(DirectionalHash, true, true, strict, true) == Result::Applied);
+            assert(strict != words);
+            auto strict_second = source;
+            assert(Patch(DirectionalHash, true, true, strict_second, true) == Result::Applied &&
+                   strict_second == strict);
+            for (const auto* variant : {&words, &strict}) {
+                auto sharpened = *variant;
+                assert(Vulkan::GgxLobes::ScaleLightSharpness(
+                           sharpened, Vulkan::GgxLobes::SharpnessRemoved) == 4);
+            }
+
+            if (i == 1) {
+                auto incomplete = source;
+                bool removed = false;
+                for (size_t at = 5; at < incomplete.size(); at += incomplete[at] >> 16) {
+                    if ((incomplete[at] & 0xffff) == 12 && incomplete[at + 2] == 964) {
+                        incomplete[at] = (incomplete[at] & 0xffff0000) | 140;
+                        removed = true;
+                        break;
+                    }
+                }
+                assert(removed);
+                const auto bad = incomplete;
+                assert(Patch(DirectionalHash, true, true, incomplete) == Result::Unsupported &&
+                       incomplete == bad);
+            }
+
+            const std::string name = i == 1 ? "legacy" : i == 2 ? "current" : "variant-" + std::to_string(i);
+            for (const auto* variant : {&words, &strict}) {
+                auto path = output / name;
+                path += variant == &strict ? "-strict.spv" : ".spv";
+                std::ofstream file(path, std::ios::binary);
+                file.write(reinterpret_cast<const char*>(variant->data()),
+                           std::streamsize(variant->size() * 4));
+                file.close();
+                assert(file);
+            }
+        }
+    }
+    std::cout << "GGX structural matching, binary gates and deterministic transformations passed\n";
+}
diff --git a/tests/test_local_falloff.cpp b/tests/test_local_falloff.cpp
new file mode 100644
--- /dev/null
+++ b/tests/test_local_falloff.cpp
@@ -0,0 +1,88 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#include "../gpu/shadps4/video_core/renderer_vulkan/vk_local_falloff.h"
+#include <cassert>
+#include <filesystem>
+#include <fstream>
+#include <iostream>
+
+namespace {
+std::vector<uint32_t> Read(const std::filesystem::path& path) {
+    std::ifstream file(path, std::ios::binary | std::ios::ate);
+    assert(file);
+    const auto size = file.tellg();
+    assert(size >= 0 && size % 4 == 0);
+    std::vector<uint32_t> words(size_t(size) / 4);
+    file.seekg(0);
+    file.read(reinterpret_cast<char*>(words.data()), std::streamsize(words.size() * 4));
+    return words;
+}
+}
+
+// Usage: local-falloff-test [dumps-dir out-dir]
+int main(int argc, char** argv) {
+    using namespace Vulkan::LocalFalloff;
+    for (const double radius : {0.25, 1.0, 2.5, 10.0}) {
+        constexpr int steps = 10000;
+        constexpr double pi = 3.14159265358979323846;
+        double old_energy = 0, matched_energy = 0;
+        for (int i = 0; i < steps; ++i) {
+            const double x = (i + 0.5) / steps;
+            const double old_falloff = (1 - x) * (1 - x);
+            const double inverse_square = 1 / (radius * radius * x * x) - 1 / (radius * radius);
+            const double matched_falloff = inverse_square * radius * radius / 20;
+            old_energy += old_falloff * x * x;
+            matched_energy += matched_falloff * x * x;
+        }
+        old_energy *= 4 * pi * radius * radius * radius / steps;
+        matched_energy *= 4 * pi * radius * radius * radius / steps;
+        const double relative_error = (matched_energy - old_energy) / old_energy;
+        assert(relative_error > -1e-8 && relative_error < 1e-8);
+    }
+    std::vector<uint32_t> malformed{0x07230203, 0x10600, 0, 10, 0, 0};
+    const auto original = malformed;
+    assert(!Patch(malformed, 0x7cc2c044).Changed() && malformed == original);
+    assert(!Patch(malformed, 0x7cc2c044, false).Changed() && malformed == original);
+    std::vector<uint32_t> no_match{0x07230203, 0x10600, 0, 2, 0, (3u << 16) | 14, 0, 1};
+    const auto untouched = no_match;
+    assert(!Patch(no_match, 0x7cc2c044).Changed() && no_match == untouched);
+    if (argc == 3) {
+        const std::filesystem::path out = argv[2];
+        std::filesystem::create_directories(out);
+        Stats total{};
+        uint32_t shaders = 0, files = 0;
+        for (const auto& entry : std::filesystem::directory_iterator(argv[1])) {
+            if (entry.path().extension() != ".spv") continue;
+            ++files;
+            const auto source = Read(entry.path());
+            const auto stem = entry.path().stem().string();
+            const auto hash = uint32_t(std::stoull(stem.substr(stem.find("0x") + 2), nullptr, 16));
+            auto words = source;
+            assert(!Patch(words, hash, false).Changed() && words == source);
+            const auto stats = Patch(words, hash);
+            if (!stats.Changed()) {
+                assert(words == source);
+                continue;
+            }
+            ++shaders;
+            total.standard += stats.standard;
+            total.special += stats.special;
+            const auto patched = words;
+            assert(!Patch(words, hash).Changed() && words == patched);
+            std::ofstream file(out / entry.path().filename(), std::ios::binary);
+            file.write(reinterpret_cast<const char*>(words.data()),
+                       std::streamsize(words.size() * 4));
+            auto scaled = source;
+            const auto scaled_stats = Patch(scaled, hash, true, 2.5f);
+            assert(scaled_stats.standard == stats.standard && scaled_stats.special == stats.special);
+            assert(scaled != patched);
+            const auto scaled_patched = scaled;
+            assert(!Patch(scaled, hash).Changed() && scaled == scaled_patched);
+            std::ofstream scaled_file(out / (stem + "-intensity.spv"), std::ios::binary);
+            scaled_file.write(reinterpret_cast<const char*>(scaled.data()),
+                              std::streamsize(scaled.size() * 4));
+        }
+        std::cout << files << " files, " << shaders << " shaders: " << total.standard
+                  << " standard, " << total.special << " special\n";
+    }
+    std::cout << "Local falloff patch passed\n";
+}

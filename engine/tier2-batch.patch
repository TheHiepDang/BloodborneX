+
+using F32 = IR::F32;
+using Vec3 = std::array<F32, 3>;
+using Mat3 = std::array<std::array<float, 3>, 3>;
+
+// SDR: GT7 maps to its 250 cd/m^2 paper white (2.5 in frame-buffer units of 100 cd/m^2), then
+// scales that to 1.
+constexpr float Target = 2.5f;
+constexpr float SdrCorrection = 1.0f / Target;
+// GTToneMappingCurveV2 as GT7 initialises it.
+constexpr float Alpha = 0.25f, MidPoint = 0.538f, LinearSection = 0.444f, ToeStrength = 1.28f;
+constexpr float BlendRatio = 0.6f, FadeStart = 0.98f, FadeEnd = 1.16f;
+// ST 2084 (PQ).
+constexpr float PqM1 = 0.1593017578125f, PqM2 = 78.84375f, PqC1 = 0.8359375f, PqC2 = 18.8515625f,
+                PqC3 = 18.6875f;
+// The scene value (k * x, the curve's own units) where the alternatives meet the game's curve.
+constexpr float MatchPoint = 0.3f;
+constexpr float AcesA = 0.0245786f, AcesB = 0.000090537f, AcesC = 0.983729f, AcesD = 0.4329510f,
+                AcesE = 0.238081f;
+constexpr float AcesFit(float v) {
+    return (v * (v + AcesA) - AcesB) / (v * (AcesC * v + AcesD) + AcesE);
+}
+
+// ACES fitted input/output transforms. Their rows sum to one, so AcesFit is also the neutral response.
+constexpr Mat3 AcesInput{{{0.59719f, 0.35458f, 0.04823f},
+                          {0.07600f, 0.90834f, 0.01566f},
+                          {0.02840f, 0.13383f, 0.83777f}}};
+constexpr Mat3 AcesOutput{{{1.60475f, -0.53108f, -0.07367f},
+                           {-0.10208f, 1.10813f, -0.00605f},
+                           {-0.00327f, -0.07276f, 1.07602f}}};
+
+constexpr Mat3 Rec709To2020{{{0.6274040f, 0.3292820f, 0.0433136f},
+                             {0.0690970f, 0.9195400f, 0.0113612f},
+                             {0.0163916f, 0.0880132f, 0.8955950f}}};
+constexpr Mat3 Rec2020To709{{{1.6604910f, -0.5876411f, -0.0728499f},
+                             {-0.1245505f, 1.1328999f, -0.0083494f},
+                             {-0.0181508f, -0.1005789f, 1.1187297f}}};
+constexpr Mat3 RgbToLms{{{1688.0f / 4096, 2146.0f / 4096, 262.0f / 4096},
+                         {683.0f / 4096, 2951.0f / 4096, 462.0f / 4096},
+                         {99.0f / 4096, 309.0f / 4096, 3688.0f / 4096}}};
+constexpr Mat3 LmsToICtCp{{{2048.0f / 4096, 2048.0f / 4096, 0.0f},
+                           {6610.0f / 4096, -13613.0f / 4096, 7003.0f / 4096},
+                           {17933.0f / 4096, -17390.0f / 4096, -543.0f / 4096}}};
+constexpr Mat3 ICtCpToLms{{{1.0f, 0.00860904f, 0.11103f},
+                           {1.0f, -0.00860904f, -0.11103f},
+                           {1.0f, 0.560031f, -0.320627f}}};
+constexpr Mat3 LmsToRgb{{{3.43661f, -2.50645f, 0.0698454f},
+                         {-0.79133f, 1.9836f, -0.192271f},
+                         {-0.0259499f, -0.0989137f, 1.12486f}}};
+
+/// Frame-buffer value (1 = 100 cd/m^2) to PQ, on the host.
+double InversePq(double v) {
+    const double ym = std::pow(v * 100.0 / 10000.0, double(PqM1));
+    return std::exp2(PqM2 * (std::log2(PqC1 + PqC2 * ym) - std::log2(1.0 + PqC3 * ym)));
+}
+
+struct Emit {
+    IR::IREmitter& ir;
+    F32 F(const IR::Value& v) const { return F32{v}; }
+    F32 C(float v) const { return ir.Imm32(v); }
+    F32 Add(F32 a, F32 b) const { return F(ir.FPAdd(a, b)); }
+    F32 Sub(F32 a, F32 b) const { return F(ir.FPSub(a, b)); }
+    F32 Mul(F32 a, F32 b) const { return F(ir.FPMul(a, b)); }
+    F32 Div(F32 a, F32 b) const { return F(ir.FPDiv(a, b)); }
+    F32 Max(F32 a, F32 b) const { return F(ir.FPMax(a, b)); }
+    F32 Min(F32 a, F32 b) const { return F(ir.FPMin(a, b)); }
+    F32 Clamp(F32 v, float lo, float hi) const { return F(ir.FPClamp(v, C(lo), C(hi))); }
+    F32 Exp(F32 v) const { return ir.FPExp2(Mul(v, C(1.4426950f))); }
+    /// x^y for x >= 0, y > 0.
+    F32 Pow(F32 x, float y) const { return ir.FPPow(Max(x, C(0.0f)), C(y)); }
+    F32 Select(const IR::U1& c, F32 a, F32 b) const { return F32{ir.Select(c, a, b)}; }
+
+    Vec3 Apply(const Mat3& m, const Vec3& v) const {
+        Vec3 out;
+        for (size_t row = 0; row < 3; ++row) {
+            out[row] = Add(Mul(C(m[row][0]), v[0]), Add(Mul(C(m[row][1]), v[1]), Mul(C(m[row][2]), v[2])));
+        }
+        return out;
+    }
+    F32 SmoothStep(F32 x, float edge0, float edge1) const {
+        const F32 t = Clamp(Mul(Sub(x, C(edge0)), C(1.0f / (edge1 - edge0))), 0.0f, 1.0f);
+        return Mul(Mul(t, t), Sub(C(3.0f), Mul(C(2.0f), t)));
+    }
+    F32 InversePq(F32 v) const {
+        const F32 ym = Pow(Mul(v, C(100.0f / 10000.0f)), PqM1);
+        return ir.FPExp2(Mul(C(PqM2), Sub(ir.FPLog2(Add(C(PqC1), Mul(C(PqC2), ym))),
+                                          ir.FPLog2(Add(C(1.0f), Mul(C(PqC3), ym))))));
+    }
+    F32 Pq(F32 n) const {
+        const F32 np = Pow(Clamp(n, 0.0f, 1.0f), 1.0f / PqM2);
+        const F32 l = Div(Max(Sub(np, C(PqC1)), C(0.0f)), Sub(C(PqC2), Mul(C(PqC3), np)));
+        return Mul(Pow(l, 1.0f / PqM1), C(10000.0f / 100.0f));
+    }
+    Vec3 ToICtCp(const Vec3& rgb) const {
+        Vec3 lms = Apply(RgbToLms, rgb);
+        for (F32& c : lms) {
+            c = InversePq(c);
+        }
+        return Apply(LmsToICtCp, lms);
+    }
+    Vec3 FromICtCp(const Vec3& ictcp) const {
+        Vec3 lms = Apply(ICtCpToLms, ictcp);
+        for (F32& c : lms) {
+            c = Pq(c);
+        }
+        Vec3 rgb = Apply(LmsToRgb, lms);
+        for (F32& c : rgb) {
+            c = Max(c, C(0.0f));
+        }
+        return rgb;
+    }
+    /// GTToneMappingCurveV2: a toe blending into a linear section, then a shoulder converging on
+    /// the target.
+    F32 Curve(F32 x) const {
+        const float k = (LinearSection - 1.0f) / (Alpha - 1.0f);
+        const float ka = Target * LinearSection + Target * k;
+        const float kb = -Target * k * std::exp(LinearSection / k);
+        const float kc = -1.0f / (k * Target);
+        x = Max(x, C(0.0f));
+        const F32 linear_weight = SmoothStep(x, 0.0f, MidPoint);
+        const F32 toe = Mul(C(MidPoint), Pow(Mul(x, C(1.0f / MidPoint)), ToeStrength));
+        const F32 low = Add(Mul(Sub(C(1.0f), linear_weight), toe), Mul(linear_weight, x));
+        const F32 shoulder = Add(C(ka), Mul(C(kb), Exp(Mul(x, C(kc)))));
+        return Select(ir.FPLessThan(x, C(LinearSection * Target)), low, shoulder);
+    }
+};
+
+/// The colour output component (0..2) each of `clamps` reaches, or nothing when one reaches none
+/// or several, or two reach the same.
+std::optional<std::array<u32, 3>> OutputComponents(const std::array<IR::Inst*, 3>& clamps,
+                                                    const IR::Block& block) {
+    std::array<u32, 3> components{};
+    std::set<u32> taken;
+    for (size_t channel = 0; channel < 3; ++channel) {
+        std::set<u32> reached;
+        std::vector<IR::Inst*> work{clamps[channel]};
+        std::set<IR::Inst*> seen;
+        while (!work.empty()) {
+            IR::Inst* inst = work.back();
+            work.pop_back();
+            for (const IR::Use& use : inst->Uses()) {
+                IR::Inst* user = use.user;
+                if (!seen.insert(user).second) {
+                    continue;
+                }
+                if (user->GetParent() != &block) {
+                    return std::nullopt;
+                }
+                if (user->GetOpcode() == IR::Opcode::SetAttribute) {
+                    if (user->Arg(0).Attribute() != IR::Attribute::RenderTarget0 ||
+                        !user->Arg(2).IsImmediate() || user->Arg(2).U32() > 2) {
+                        return std::nullopt;
+                    }
+                    reached.insert(user->Arg(2).U32());
+                    continue;
+                }
+                work.push_back(user);
+            }
+        }
+        if (reached.size() != 1 || !taken.insert(*reached.begin()).second) {
+            return std::nullopt;
+        }
+        components[channel] = *reached.begin();
+    }
+    return components;
+}
+
+/// Where the curve mixes its channels before export, the clamps' order in the block: the
+/// shader's x, y, z, which the colour buffer's export swizzle moves to the output components.
+std::optional<std::array<u32, 3>> SwizzleComponents(const RuntimeInfo& runtime_info) {
+    const auto& swizzle = runtime_info.hw.fs.color_buffers[0].swizzle;
+    std::array<u32, 3> components{};
+    std::set<u32> taken;
+    for (u32 channel = 0; channel < 3; ++channel) {
+        std::optional<u32> output;
+        for (u32 i = 0; i < 3; ++i) {
+            if (swizzle.Map(i) == channel) {
+                output = i;
+            }
+        }
+        if (!output || !taken.insert(*output).second) {
+            return std::nullopt;
+        }
+        components[channel] = *output;
+    }
+    return components;
+}
+} // namespace
+
+bool IsKnownComposite(u64 hash) {
+    switch (hash) {
+    case 0x15fa3515:
+    case 0x5c02eaf8:
+    case 0x5e67d866:
+    case 0x925d5712:
+    case 0xcbe2dd84:
+    case 0xccb08339:
+        return true;
+    default:
+        return false;
+    }
+}
+
+bool ApplyGt7ToneMap(IR::Program& program, const RuntimeInfo& runtime_info, Pools& pools) {
+    if (gt7_lab_override == 0 || ToneCurveEnabled() ||
+        program.info.sw_stage != SwStage::Fragment) {
+        return false;
+    }
+    auto matches = FindToneCurves(program);
+    if (!IsComposite(matches)) {
+        return false;
+    }
+    program.info.gt7_checked = true;
+    const u64 hash = program.info.pgm_hash;
+    const auto decline = [&](const char* why) {
+        std::printf("GT7 tonemap: composite %#llx keeps the game's curve (%s)\n",
+                    static_cast<unsigned long long>(hash), why);
+        return false;
+    };
+    IR::Block& block = *matches[0].result->GetParent();
+    for (const auto& m : matches) {
+        if (m.result->GetParent() != &block) {
+            return decline("the curve spans blocks");
+        }
+    }
+    std::map<const IR::Inst*, size_t> order;
+    size_t index = 0;
+    for (IR::Inst& inst : block.Instructions()) {
+        order[&inst] = index++;
+    }
+    std::ranges::sort(matches, [&](const auto& a, const auto& b) {
+        return order.at(a.result) < order.at(b.result);
+    });
+    // All curve inputs must dominate the common setup; all clamp uses must follow the branch merge.
+    IR::Inst* inputs_end = nullptr;
+    const auto later = [&](IR::Inst* inst) {
+        if (inst && order.contains(inst) && (!inputs_end || order.at(inst) > order.at(inputs_end))) {
+            inputs_end = inst;
+        }
+    };
+    for (const auto& m : matches) {
+        if (!order.contains(m.exponent)) {
+            return decline("the curve spans blocks");
+        }
+        later(m.exponent);
+    }
+    if (!matches[0].shoulder.IsImmediate()) {
+        IR::Inst* shoulder = matches[0].shoulder.Inst();
+        if (shoulder->GetParent() == &block) {
+            later(shoulder);
+        }
+    }
+    const size_t inputs = order.at(inputs_end);
+    for (const auto& m : matches) {
+        const size_t after = std::max(inputs, order.at(m.result));
+        for (const IR::Use& use : m.result->Uses()) {
+            if (use.user->GetParent() != &block || order.at(use.user) <= after) {
+                return decline("a channel is used before the curve's inputs are all computed");
+            }
+        }
+    }
+    auto components =
+        OutputComponents({matches[0].result, matches[1].result, matches[2].result}, block);
+    if (!components) {
+        components = SwizzleComponents(runtime_info);
+    }
+    if (!components) {
+        return decline("the channels do not map one to one onto the colour output");
+    }
+
+    const auto block_it = std::ranges::find_if(program.syntax_list, [&](const auto& node) {
+        return node.type == IR::AbstractSyntaxNode::Type::Block && node.data.block == &block;
+    });
+    if (block_it == program.syntax_list.end()) {
+        return decline("the curve's block is absent from the structured program");
+    }
+
+    IR::Inst* first_use = nullptr;
+    for (const auto& m : matches) {
+        for (const IR::Use& use : m.result->Uses()) {
+            if (!first_use || order.at(use.user) < order.at(first_use)) {
+                first_use = use.user;
+            }
+        }
+    }
+    std::set<IR::Inst*> curve_insts;
+    std::vector<IR::Inst*> work;
+    for (const auto& m : matches) {
+        work.push_back(m.result);
+    }
+    while (!work.empty()) {
+        IR::Inst* const inst = work.back();
+        work.pop_back();
+        if (!curve_insts.insert(inst).second) {
+            continue;
+        }
+        for (size_t arg = 0; arg < inst->NumArgs(); ++arg) {
+            IR::Inst* const dependency = inst->Arg(arg).TryInst();
+            if (dependency && dependency->GetParent() == &block) {
+                work.push_back(dependency);
+            }
+        }
+    }
+    std::vector<IR::Inst*> original;
+    for (IR::Inst& inst : block.Instructions()) {
+        original.push_back(&inst);
+    }
+    const auto first_use_it = IR::Block::InstructionList::s_iterator_to(*first_use);
+    for (IR::Inst* const inst : original) {
+        if (order.at(inst) <= order.at(first_use) || !curve_insts.contains(inst)) {
+            continue;
+        }
+        if (inst->MayHaveSideEffects()) {
+            return decline("the curve has an operation that cannot be reordered");
+        }
+        block.Instructions().splice(first_use_it, block.Instructions(),
+                                    IR::Block::InstructionList::s_iterator_to(*inst));
+    }
+
+    IR::Block* const gt7_block = pools.block_pool.Create(pools.inst_pool);
+    IR::Block* const gt7_merge = pools.block_pool.Create(pools.inst_pool);
+    IR::Block* const aces_block = pools.block_pool.Create(pools.inst_pool);
+    IR::Block* const final_merge = pools.block_pool.Create(pools.inst_pool);
+
+    final_merge->Instructions().splice(final_merge->begin(), block.Instructions(), first_use_it,
+                                       block.end());
+    for (IR::Inst& inst : final_merge->Instructions()) {
+        inst.SetParent(final_merge);
+    }
+    const auto successors = block.imm_successors;
+    block.imm_successors.clear();
+    for (IR::Block* const successor : successors) {
+        std::erase(successor->imm_predecessors, &block);
+        final_merge->AddBranch(successor);
+    }
+    block.AddBranch(gt7_block);
+    block.AddBranch(gt7_merge);
+    gt7_block->AddBranch(gt7_merge);
+    gt7_merge->AddBranch(aces_block);
+    gt7_merge->AddBranch(final_merge);
+    aces_block->AddBranch(final_merge);
+
+    IR::IREmitter ir{block};
+    const Emit e{ir};
+    const auto& m0 = matches[0];
+
+    // Each channel in the curve's units (k * x), by output component.
+    Vec3 scene;
+    for (size_t channel = 0; channel < 3; ++channel) {
+        const F32 exponent{IR::Value{matches[channel].exponent}};
+        scene[(*components)[channel]] =
+            m0.family == ToneCurveMatch::Family::Exponential
+                ? e.Mul(exponent, e.C(-1.0f / 1.4426950f))
+                : exponent;
+    }
+    // GT7 meets the game's curve at MatchPoint at exposure 1: its linear section is the identity
+    // on frame-buffer values, then scaled by SdrCorrection.
+    const F32 shoulder{m0.shoulder};
+    F32 game_at_match;
+    if (m0.family == ToneCurveMatch::Family::Exponential) {
+        const float ex = std::exp(-MatchPoint);
+        const F32 b = e.Sub(e.C(1.0f), e.Mul(shoulder, e.C(ex)));
+        game_at_match = e.Mul(e.C(1.0f - ex), e.Mul(b, b));
+    } else {
+        game_at_match = e.Mul(e.C(MatchPoint / (1.0f + MatchPoint)),
+                              e.Add(e.C(1.0f), e.Mul(e.Max(shoulder, e.C(0.0f)), e.C(MatchPoint))));
+    }
+    const F32 exposure = e.Clamp(ir.ToneCurveParam(1), 0.05f, 16.0f);
+    const F32 mode = ir.ToneCurveParam(0);
+    const IR::U1 gt7_on = ir.LogicalAnd(ir.FPGreaterThan(mode, e.C(0.5f)),
+                                        ir.FPLessThan(mode, e.C(1.5f)));
+    const IR::U1 aces_on = ir.FPGreaterThan(mode, e.C(1.5f));
+
+    const Vec3 gt7 = [&] {
+        IR::IREmitter ir{*gt7_block};
+        const Emit e{ir};
+        const F32 gt7_gain = e.Clamp(e.Mul(game_at_match, e.C(Target / MatchPoint)), 0.05f, 10.0f);
+        const F32 gt7_scale = e.Mul(gt7_gain, exposure);
+        Vec3 linear;
+        for (size_t c = 0; c < 3; ++c) {
+            linear[c] = e.Mul(e.Max(scene[c], e.C(0.0f)), gt7_scale);
+        }
+        const Vec3 rgb = e.Apply(Rec709To2020, linear);
+
+        // applyToneMapping (SDR): per-channel curve ("skewed"), and the skewed intensity with the
+        // input's chroma faded out towards the target; blended.
+        const Vec3 ucs = e.ToICtCp(rgb);
+        Vec3 skewed;
+        for (size_t c = 0; c < 3; ++c) {
+            skewed[c] = e.Curve(rgb[c]);
+        }
+        const Vec3 skewed_ucs = e.ToICtCp(skewed);
+        const float target_ucs = float(InversePq(Target));
+        const F32 chroma = e.Sub(e.C(1.0f), e.SmoothStep(e.Mul(ucs[0], e.C(1.0f / target_ucs)),
+                                                        FadeStart, FadeEnd));
+        const Vec3 scaled = e.FromICtCp({skewed_ucs[0], e.Mul(ucs[1], chroma), e.Mul(ucs[2], chroma)});
+        Vec3 mapped;
+        for (size_t c = 0; c < 3; ++c) {
+            const F32 blended = e.Add(e.Mul(e.C(1.0f - BlendRatio), skewed[c]), e.Mul(e.C(BlendRatio), scaled[c]));
+            mapped[c] = e.Mul(e.C(SdrCorrection), e.Min(blended, e.C(Target)));
+        }
+        const Vec3 gt7_out = e.Apply(Rec2020To709, mapped);
+        Vec3 result;
+        for (size_t channel = 0; channel < 3; ++channel) {
+            result[channel] = e.Clamp(gt7_out[(*components)[channel]], 0.0f, 1.0f);
+        }
+        return result;
+    }();
+
+    const Vec3 aces = [&] {
+        IR::IREmitter ir{*aces_block};
+        const Emit e{ir};
+        // Fitted ACES: Rec.709 to the working space, the RRT/ODT fit, then back to Rec.709.
+        const F32 aces_gain = e.Clamp(e.Div(game_at_match, e.C(AcesFit(MatchPoint))), 0.05f, 10.0f);
+        const F32 aces_scale = e.Mul(aces_gain, exposure);
+        Vec3 aces_linear;
+        for (size_t c = 0; c < 3; ++c) {
+            aces_linear[c] = e.Mul(e.Max(scene[c], e.C(0.0f)), aces_scale);
+        }
+        const Vec3 aces_input = e.Apply(AcesInput, aces_linear);
+        Vec3 aces_fitted;
+        for (size_t c = 0; c < 3; ++c) {
+            const F32 v = aces_input[c];
+            aces_fitted[c] = e.Div(
+                e.Sub(e.Mul(v, e.Add(v, e.C(AcesA))), e.C(AcesB)),
+                e.Add(e.Mul(v, e.Add(e.Mul(v, e.C(AcesC)), e.C(AcesD))), e.C(AcesE)));
+        }
+        const Vec3 aces_out = e.Apply(AcesOutput, aces_fitted);
+        Vec3 result;
+        for (size_t channel = 0; channel < 3; ++channel) {
+            result[channel] = e.Clamp(aces_out[(*components)[channel]], 0.0f, 1.0f);
+        }
+        return result;
+    }();
+
+    const auto select_phi = [](IR::Block& merge, IR::Block& true_block, F32 true_value,
+                               IR::Block& false_block, F32 false_value) {
+        IR::Inst* const phi = &*merge.PrependNewInst(merge.begin(), IR::Opcode::Phi);
+        phi->SetFlags(IR::Type::F32);
+        phi->AddPhiOperand(&true_block, true_value);
+        phi->AddPhiOperand(&false_block, false_value);
+        return F32{IR::Value{phi}};
+    };
+    Vec3 gt7_selected;
+    Vec3 selected;
+    for (size_t channel = 0; channel < 3; ++channel) {
+        const F32 game{IR::Value{matches[channel].result}};
+        gt7_selected[channel] = select_phi(*gt7_merge, *gt7_block, gt7[channel], block, game);
+        selected[channel] = select_phi(*final_merge, *aces_block, aces[channel], *gt7_merge,
+                                       gt7_selected[channel]);
+    }
+    for (size_t channel = 0; channel < 3; ++channel) {
+        IR::Inst* const clamp = matches[channel].result;
+        std::vector<IR::Use> uses(clamp->Uses().begin(), clamp->Uses().end());
+        for (const IR::Use& use : uses) {
+            if (order.contains(use.user)) {
+                use.user->SetArg(use.operand, selected[channel]);
+            }
+        }
+    }
+
+    std::vector<IR::AbstractSyntaxNode> nodes(8);
+    nodes[0].type = IR::AbstractSyntaxNode::Type::If;
+    nodes[0].data.if_node = {.cond = gt7_on, .body = gt7_block, .merge = gt7_merge};
+    nodes[1].type = IR::AbstractSyntaxNode::Type::Block;
+    nodes[1].data.block = gt7_block;
+    nodes[2].type = IR::AbstractSyntaxNode::Type::EndIf;
+    nodes[2].data.end_if.merge = gt7_merge;
+    nodes[3].type = IR::AbstractSyntaxNode::Type::Block;
+    nodes[3].data.block = gt7_merge;
+    nodes[4].type = IR::AbstractSyntaxNode::Type::If;
+    nodes[4].data.if_node = {.cond = aces_on, .body = aces_block, .merge = final_merge};
+    nodes[5].type = IR::AbstractSyntaxNode::Type::Block;
+    nodes[5].data.block = aces_block;
+    nodes[6].type = IR::AbstractSyntaxNode::Type::EndIf;
+    nodes[6].data.end_if.merge = final_merge;
+    nodes[7].type = IR::AbstractSyntaxNode::Type::Block;
+    nodes[7].data.block = final_merge;
+    program.syntax_list.insert(std::next(block_it), nodes.begin(), nodes.end());
+
+    program.blocks.clear();
+    for (const auto& node : program.syntax_list) {
+        if (node.type == IR::AbstractSyntaxNode::Type::Block) {
+            program.blocks.push_back(node.data.block);
+        }
+    }
+    program.post_order_blocks = IR::PostOrder(program.syntax_list.front().data.block);
+    program.info.uses_tone_curve = true;
+    return true;
+}
+
+} // namespace Shader::Native
diff --git a/gpu/shadps4/shader_recompiler/native/gt7_tonemap.h b/gpu/shadps4/shader_recompiler/native/gt7_tonemap.h
new file mode 100644
--- /dev/null
+++ b/gpu/shadps4/shader_recompiler/native/gt7_tonemap.h
@@ -0,0 +1,46 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// bbport: the GT7 tone mapping operator (Polyphony Digital's sample, MIT licence, via
+// github.com/aletschfirn/gt7tonemapper; notice in gt7_tonemap.cpp) and fitted ACES as alternatives
+// to the game's tone curve in its final composite pixel shaders (docs/hdr-scene-path.md).
+//
+// Composites are compiled with all three: per draw, Gt7Push::mode selects uniform branches for GT7
+// and ACES, or the game's curve (its own instructions, bit for bit), so the choice changes live.
+// The alternatives need the three channels together; pure curve dependencies are moved ahead of
+// the first clamp use when needed, and phi nodes merge the selected channels. Skipped when the HDR
+// extension (BB_HDR_SCENE_CURVE=1, tone_curve.h) owns the curve.
+#pragma once
+
+#include "common/types.h"
+#include "shader_recompiler/native/tone_curve.h"
+#include "shader_recompiler/runtime_info.h"
+
+namespace Shader {
+struct Pools;
+namespace IR {
+struct Program;
+}
+} // namespace Shader
+
+namespace Shader::Native {
+
+/// Adds GT7 and ACES to a composite (a fragment program whose curve is in one block). Sets
+/// Info::gt7_checked for any composite and Info::uses_tone_curve when applied; returns whether it
+/// applied.
+bool ApplyGt7ToneMap(IR::Program& program, const RuntimeInfo& runtime_info, Pools& pools);
+
+/// The composites found in captures (docs/hdr-scene-path.md): a cached record of one without
+/// Info::gt7_checked predates the pass and is compiled again.
+bool IsKnownComposite(u64 hash);
+
+/// Alternative tone mapper parameters, pushed in ToneCurvePush's place when the HDR extension is off.
+struct Gt7Push {
+    float mode;     ///< 0: game (bit for bit), 1: GT7, 2: ACES
+    float exposure; ///< scene scale before GT7/ACES (1: the game's mid-tones)
+    float unused[2];
+};
+static_assert(sizeof(Gt7Push) == sizeof(ToneCurvePush));
+
+/// bb-shader-lab: 0 skips the pass on this thread, -1 leaves it to the normal rules.
+inline thread_local int gt7_lab_override = -1;
+
+} // namespace Shader::Native

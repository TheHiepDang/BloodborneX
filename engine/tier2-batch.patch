diff --git a/tests/test_tier2_post.cpp b/tests/test_tier2_post.cpp
new file mode 100644
--- /dev/null
+++ b/tests/test_tier2_post.cpp
@@ -0,0 +1,120 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#include "shader_recompiler/recompiler.h"
+#include "shader_recompiler/ir/ir_emitter.h"
+#include "shader_recompiler/native/froyok_composite.h"
+#include "shader_recompiler/native/gt7_tonemap.h"
+#include "video_core/renderer_vulkan/vk_pipeline_serialization.h"
+#include "common/serdes.h"
+#include <algorithm>
+#include <array>
+#include <bit>
+#include <cassert>
+#include <cmath>
+#include <cstdio>
+#include <map>
+extern "C" {
+// Offline shader/IR checks must never enter a guest thread or controller service.
+void runtime_blocked_report() { std::abort(); }
+[[noreturn]] void runtime_thread_exit(void*) { std::abort(); }
+int runtime_pad_type() { std::abort(); }
+int runtime_pad_button(uint32_t,int) { std::abort(); }
+}
+using namespace Shader;
+using F=IR::F32;
+struct Fixture {
+    Info info;
+    Pools pools;
+    IR::Program program{info};
+    std::array<IR::Value,3> output;
+    Fixture() {
+        info.sw_stage=SwStage::Fragment; info.pgm_hash=Native::FroyokCompositeHash;
+        auto* block=pools.block_pool.Create(pools.inst_pool);
+        program.blocks.push_back(block); program.post_order_blocks.push_back(block);
+        program.syntax_list.push_back({.data={.block=block},.type=IR::AbstractSyntaxNode::Type::Block});
+        program.syntax_list.push_back({.type=IR::AbstractSyntaxNode::Type::Return});
+        IR::IREmitter ir{*block};
+        const auto k=ir.BitCast<F>(ir.ReadConstBuffer(ir.Imm32(0u),ir.Imm32(833u),{}));
+        const auto w=ir.BitCast<F>(ir.ReadConstBuffer(ir.Imm32(0u),ir.Imm32(834u),{}));
+        const auto sample=ir.ImageSampleExplicitLod(ir.Imm32(131074u),{},ir.Imm32(0.0f),{},{});
+        std::array<F,3> curve,scene,bloom;
+        for(u32 c=0;c<3;++c) {
+            scene[c]=ir.GetAttribute(IR::Attribute::FragCoord,c);
+            bloom[c]=F{ir.CompositeExtract(sample,c)};
+            const F x{ir.FPMax(ir.Imm32(6.1035156e-05f),scene[c])};
+            const F v{ir.FPMul(k,x)};
+            const F n{ir.FPAdd(v,F{ir.FPMul(v,F{ir.FPMul(w,v)})})};
+            curve[c]=F{ir.FPSaturate(F{ir.FPMul(n,F{ir.FPRecip(F{ir.FPAdd(v,ir.Imm32(1.0f))})})})};
+        }
+        for(u32 c=0;c<3;++c) {
+            const F stock{ir.FPAdd(scene[c],F{ir.FPMul(bloom[c],ir.Imm32(0.4f))})};
+            const F graded{ir.FPSaturate(F{ir.FPMul(stock,ir.Imm32(0.8f))})};
+            const F negative{ir.FPNeg(curve[c])};
+            output[c]=ir.FPAdd(F{ir.FPAdd(curve[c],graded)},F{ir.FPMul(negative,graded)});
+            ir.SetAttribute(IR::Attribute::RenderTarget0,F{output[c]},c);
+        }
+        assert(Native::IsComposite(Native::FindToneCurves(program)));
+    }
+};
+float Evaluate(const IR::Value& v,float blend) {
+    if(v.IsImmediate()) return v.F32();
+    auto* i=v.Inst(); const auto a=[&](u32 n){return Evaluate(i->Arg(n),blend);};
+    using O=IR::Opcode;
+    switch(i->GetOpcode()) {
+    case O::GetAttribute: return 0.4f*float(i->Arg(1).U32()+1);
+    case O::CompositeExtractF32x4: return 0.2f*float(i->Arg(1).U32()+1);
+    case O::BitCastF32U32: return i->Arg(0).Inst()->Arg(1).U32()==833 ? 0.75f : 0.25f;
+    case O::FPAdd32: return a(0)+a(1);
+    case O::FPSub32: return a(0)-a(1);
+    case O::FPMul32: return a(0)*a(1);
+    case O::FPRecip32: return 1.0f/a(0);
+    case O::FPMax32: return std::max(a(0),a(1));
+    case O::FPNeg32: return -a(0);
+    case O::FPSaturate32: return std::clamp(a(0),0.0f,1.0f);
+    case O::FPClamp32: return std::clamp(a(0),a(1),a(2));
+    case O::FroyokParam: return blend;
+    case O::FPOrdGreaterThanEqual32: return a(0)>=a(1) ? 1.0f : 0.0f;
+    case O::SelectF32: return a(0)!=0.0f ? a(1) : a(2);
+    default: std::fprintf(stderr,"Unexpected fixture opcode %u\n",unsigned(i->GetOpcode())); std::abort();
+    }
+}
+void Dominance(const IR::Program& p) {
+    for(auto* b:p.blocks) {
+        std::map<const IR::Inst*,size_t> order; size_t n=0;
+        for(auto& i:b->Instructions()) order[&i]=n++;
+        for(auto& i:b->Instructions()) if(i.GetOpcode()!=IR::Opcode::Phi)
+            for(size_t a=0;a<i.NumArgs();++a)
+                if(auto* d=i.Arg(a).TryInst();d && d->GetParent()==b) assert(order.at(d)<order.at(&i));
+    }
+}
+int main() {
+    Native::tone_curve_lab_override=0;
+    Fixture f;
+    std::array<float,3> original;
+    for(u32 c=0;c<3;++c) original[c]=Evaluate(f.output[c],-1.0f);
+    assert(Native::ApplyFroyokComposite(f.program)); Dominance(f.program);
+    bool changed=false;
+    for(u32 c=0;c<3;++c) {
+        assert(std::bit_cast<u32>(Evaluate(f.output[c],-1.0f))==std::bit_cast<u32>(original[c]));
+        const float on=Evaluate(f.output[c],0.2f);
+        assert(std::isfinite(on)); changed|=on!=original[c];
+        assert(std::bit_cast<u32>(Evaluate(f.output[c],-1.0f))==std::bit_cast<u32>(original[c]));
+    }
+    assert(changed);
+    for(bool bloom:{false,true}) {
+        Fixture t;
+        if(bloom) assert(Native::ApplyFroyokComposite(t.program));
+        assert(Native::ApplyGt7ToneMap(t.program,{},t.pools));
+        assert(t.info.uses_tone_curve && t.info.gt7_checked); Dominance(t.program);
+        Serialization::Archive archive;
+        t.info.Serialize(archive);
+        Serialization::Archive encoded{archive.TakeOff()}; Info restored;
+        assert(restored.Deserialize(encoded));
+        assert(restored.uses_tone_curve && restored.uses_froyok_bloom==bloom);
+    }
+    Fixture hdr;
+    assert(Native::ApplyFroyokComposite(hdr.program));
+    Native::tone_curve_lab_override=1;
+    assert(!Native::ApplyGt7ToneMap(hdr.program,{},hdr.pools));
+    assert(Native::ExtendToneCurve(hdr.program)); Dominance(hdr.program);
+    std::puts("Tier 2 post: Original bloom bit-exact, live ON/OFF, GGX-independent tone branches, HDR exclusion and cache tails passed");
+}

+// SPDX-License-Identifier: GPL-2.0-or-later
+#include <algorithm>
+#include <array>
+#include <cassert>
+#include <cmath>
+#include <cstdio>
+#include <cstring>
+#include <vector>
+#define VULKAN_HPP_NO_CONSTRUCTORS
+#define VULKAN_HPP_NO_EXCEPTIONS
+#define VULKAN_HPP_DISPATCH_LOADER_DYNAMIC 1
+#include <vulkan/vulkan.hpp>
+#include "video_core/host_shaders/native_motion_blur_test_comp.h"
+
+using u32 = uint32_t;
+
+int main() {
+    static vk::detail::DynamicLoader loader;
+    vk::detail::DispatchLoaderDynamic d;
+    d.init(loader.getProcAddress<PFN_vkGetInstanceProcAddr>("vkGetInstanceProcAddr"));
+    const vk::ApplicationInfo app{.pApplicationName = "motion-blur-shader-test",
+        .apiVersion = VK_API_VERSION_1_3};
+    auto instance = vk::createInstanceUnique({.pApplicationInfo = &app},nullptr,d).value;
+    d.init(*instance);
+    auto gpus = instance->enumeratePhysicalDevices(d).value;
+    assert(!gpus.empty());
+    const auto physical = gpus[0];
+    auto families = physical.getQueueFamilyProperties(d);
+    u32 family = 0;
+    while (family < families.size() &&
+           !(families[family].queueFlags & vk::QueueFlagBits::eCompute)) ++family;
+    assert(family < families.size());
+    const float priority = 1;
+    const vk::DeviceQueueCreateInfo qi{.queueFamilyIndex = family, .queueCount = 1,
+        .pQueuePriorities = &priority};
+    const char* extension = VK_KHR_PUSH_DESCRIPTOR_EXTENSION_NAME;
+    const vk::PhysicalDeviceVulkan13Features features{.synchronization2 = true};
+    auto owned_device = physical.createDeviceUnique({.pNext = &features, .queueCreateInfoCount = 1,
+        .pQueueCreateInfos = &qi, .enabledExtensionCount = 1,
+        .ppEnabledExtensionNames = &extension},nullptr,d).value;
+    const auto device = *owned_device;
+    d.init(device);
+    const auto queue = device.getQueue(family,0,d);
+    auto pool = device.createCommandPoolUnique({
+        .flags = vk::CommandPoolCreateFlagBits::eResetCommandBuffer,
+        .queueFamilyIndex = family},nullptr,d).value;
+    const auto command = device.allocateCommandBuffers({.commandPool = *pool,
+        .level = vk::CommandBufferLevel::ePrimary, .commandBufferCount = 1},d).value[0];
+    const auto memory_types = physical.getMemoryProperties(d);
+    const auto memory_type = [&](u32 mask, vk::MemoryPropertyFlags flags) {
+        for (u32 i = 0; i < memory_types.memoryTypeCount; ++i)
+            if ((mask & (1u << i)) &&
+                (memory_types.memoryTypes[i].propertyFlags & flags) == flags) return i;
+        std::abort();
+    };
+    constexpr u32 W = 129, H = 17, N = W * H, Bytes = N * 16;
+    using Pixel = std::array<float, 4>;
+    std::array<vk::UniqueDeviceMemory, 3> image_memory;
+    std::array<vk::UniqueImage, 3> images;
+    std::array<vk::UniqueImageView, 3> views;
+    for (u32 i = 0; i < 3; ++i) {
+        images[i] = device.createImageUnique({.imageType = vk::ImageType::e2D,
+            .format = vk::Format::eR32G32B32A32Sfloat, .extent = {W,H,1},
+            .mipLevels = 1, .arrayLayers = 1, .samples = vk::SampleCountFlagBits::e1,
+            .tiling = vk::ImageTiling::eOptimal,
+            .usage = vk::ImageUsageFlagBits::eSampled | vk::ImageUsageFlagBits::eStorage |
+                     vk::ImageUsageFlagBits::eTransferSrc | vk::ImageUsageFlagBits::eTransferDst},nullptr,d).value;
+        const auto requirements = device.getImageMemoryRequirements(*images[i],d);
+        image_memory[i] = device.allocateMemoryUnique({.allocationSize = requirements.size,
+            .memoryTypeIndex = memory_type(requirements.memoryTypeBits,
+                                           vk::MemoryPropertyFlagBits::eDeviceLocal)},nullptr,d).value;
+        assert(device.bindImageMemory(*images[i],*image_memory[i],0,d) == vk::Result::eSuccess);
+        views[i] = device.createImageViewUnique({.image = *images[i],
+            .viewType = vk::ImageViewType::e2D, .format = vk::Format::eR32G32B32A32Sfloat,
+            .subresourceRange = {vk::ImageAspectFlagBits::eColor,0,1,0,1}}, nullptr,d).value;
+    }
+    const std::array<vk::DescriptorSetLayoutBinding,4> bindings{{
+        {0,vk::DescriptorType::eStorageBuffer,1,vk::ShaderStageFlagBits::eCompute},
+        {1,vk::DescriptorType::eCombinedImageSampler,1,vk::ShaderStageFlagBits::eCompute},
+        {2,vk::DescriptorType::eCombinedImageSampler,1,vk::ShaderStageFlagBits::eCompute},
+        {3,vk::DescriptorType::eStorageImage,1,vk::ShaderStageFlagBits::eCompute}}};
+    auto descriptors = device.createDescriptorSetLayoutUnique({
+        .flags = vk::DescriptorSetLayoutCreateFlagBits::ePushDescriptorKHR,
+        .bindingCount = u32(bindings.size()), .pBindings = bindings.data()},nullptr,d).value;
+    const vk::PushConstantRange push{vk::ShaderStageFlagBits::eCompute,0,4};
+    auto layout = device.createPipelineLayoutUnique({.setLayoutCount = 1,
+        .pSetLayouts = &*descriptors, .pushConstantRangeCount = 1,
+        .pPushConstantRanges = &push},nullptr,d).value;
+    auto module = device.createShaderModuleUnique({.codeSize = sizeof(NATIVE_MOTION_BLUR_TEST_COMP),
+        .pCode = NATIVE_MOTION_BLUR_TEST_COMP},nullptr,d).value;
+    auto pipeline = device.createComputePipelineUnique({},{
+        .stage = {.stage = vk::ShaderStageFlagBits::eCompute, .module = *module, .pName = "main"},
+        .layout = *layout},nullptr,d).value;
+    auto sampler = device.createSamplerUnique({.magFilter = vk::Filter::eLinear,
+        .minFilter = vk::Filter::eLinear, .mipmapMode = vk::SamplerMipmapMode::eNearest,
+        .addressModeU = vk::SamplerAddressMode::eClampToEdge,
+        .addressModeV = vk::SamplerAddressMode::eClampToEdge,
+        .addressModeW = vk::SamplerAddressMode::eClampToEdge},nullptr,d).value;
+    std::array<vk::UniqueDeviceMemory, 2> buffer_memory;
+    std::array<vk::UniqueBuffer, 2> buffers;
+    std::array<void*, 2> mapped;
+    for (u32 i = 0; i < 2; ++i) {
+        buffers[i] = device.createBufferUnique({
+            .size = i == 0 ? Bytes * 2 : 1024 * sizeof(float),
+            .usage = i == 0 ? vk::BufferUsageFlagBits::eTransferSrc | vk::BufferUsageFlagBits::eTransferDst :
+                             vk::BufferUsageFlagBits::eStorageBuffer},nullptr,d).value;
+        const auto r = device.getBufferMemoryRequirements(*buffers[i],d);
+        buffer_memory[i] = device.allocateMemoryUnique({.allocationSize = r.size,
+            .memoryTypeIndex = memory_type(r.memoryTypeBits,
+                vk::MemoryPropertyFlagBits::eHostVisible | vk::MemoryPropertyFlagBits::eHostCoherent)},nullptr,d).value;
+        assert(device.bindBufferMemory(*buffers[i],*buffer_memory[i],0,d) == vk::Result::eSuccess);
+        mapped[i] = device.mapMemory(*buffer_memory[i],0,VK_WHOLE_SIZE,{},d).value;
+    }
+    const auto staging = *buffers[0], constants = *buffers[1];
+    auto* cb = static_cast<float*>(mapped[1]);
+    std::fill_n(cb, 1024, 0.0f);
+    cb[744] = cb[745] = 2; cb[746] = cb[747] = -1;
+    cb[748] = 8.0f/W; cb[750] = -4.0f/W;
+    cb[754] = 0.001f; cb[756] = 0.15f; cb[757] = -0.01f;
+    cb[760] = cb[761] = 2; cb[762] = cb[763] = -1;
+    std::fill_n(cb + 636, 4, 1.0f);
+    std::vector<Pixel> color(N, {4,2,1,0.5f}), velocity(N, {1,0.5f,0,0});
+    bool initialized = false;
+    const auto barrier = [&](vk::CommandBuffer cmd, vk::PipelineStageFlags2 src,
+                             vk::AccessFlags2 access, vk::PipelineStageFlags2 dst,
+                             vk::AccessFlags2 dst_access) {
+        const vk::MemoryBarrier2 b{.srcStageMask = src, .srcAccessMask = access,
+            .dstStageMask = dst, .dstAccessMask = dst_access};
+        cmd.pipelineBarrier2({.memoryBarrierCount = 1, .pMemoryBarriers = &b},d);
+    };
+    const auto run = [&](u32 quality) {
+        std::memcpy(mapped[0],color.data(),Bytes);
+        std::memcpy(static_cast<char*>(mapped[0]) + Bytes,velocity.data(),Bytes);
+        auto cmd = command;
+        assert(cmd.reset({},d) == vk::Result::eSuccess);
+        const vk::CommandBufferBeginInfo begin{};
+        assert(cmd.begin(begin,d) == vk::Result::eSuccess);
+        if (!initialized) {
+            std::array<vk::ImageMemoryBarrier2,3> transitions{};
+            for (u32 i = 0; i < 3; ++i) transitions[i] = {
+                .srcStageMask = vk::PipelineStageFlagBits2::eTopOfPipe,
+                .dstStageMask = vk::PipelineStageFlagBits2::eAllCommands,
+                .dstAccessMask = vk::AccessFlagBits2::eMemoryRead | vk::AccessFlagBits2::eMemoryWrite,
+                .oldLayout = vk::ImageLayout::eUndefined, .newLayout = vk::ImageLayout::eGeneral,
+                .image = *images[i],
+                .subresourceRange = {vk::ImageAspectFlagBits::eColor,0,1,0,1}};
+            cmd.pipelineBarrier2({.imageMemoryBarrierCount = 3,
+                                 .pImageMemoryBarriers = transitions.data()},d);
+            initialized = true;
+        }
+        barrier(cmd,vk::PipelineStageFlagBits2::eAllCommands,vk::AccessFlagBits2::eMemoryRead |
+            vk::AccessFlagBits2::eMemoryWrite,vk::PipelineStageFlagBits2::eTransfer,
+            vk::AccessFlagBits2::eTransferWrite);
+        for (u32 i = 0; i < 2; ++i) {
+            const vk::BufferImageCopy copy{.bufferOffset = i * Bytes,
+                .imageSubresource = {vk::ImageAspectFlagBits::eColor,0,0,1},
+                .imageExtent = {W,H,1}};
+            cmd.copyBufferToImage(staging,*images[i],vk::ImageLayout::eGeneral,copy,d);
+        }
+        barrier(cmd,vk::PipelineStageFlagBits2::eTransfer,vk::AccessFlagBits2::eTransferWrite,
+            vk::PipelineStageFlagBits2::eComputeShader,vk::AccessFlagBits2::eShaderRead);
+        const vk::DescriptorBufferInfo buffer{constants,0,1024 * sizeof(float)};
+        std::array<vk::DescriptorImageInfo,3> infos;
+        std::array<vk::WriteDescriptorSet,4> writes{};
+        writes[0] = {.dstBinding = 0, .descriptorCount = 1,
+            .descriptorType = vk::DescriptorType::eStorageBuffer, .pBufferInfo = &buffer};
+        for (u32 i = 0; i < 3; ++i) {
+            infos[i] = {.sampler = i < 2 ? *sampler : vk::Sampler{}, .imageView = *views[i],
+                .imageLayout = vk::ImageLayout::eGeneral};
+            writes[i+1] = {.dstBinding = i+1, .descriptorCount = 1,
+                .descriptorType = bindings[i+1].descriptorType, .pImageInfo = &infos[i]};
+        }
+        cmd.bindPipeline(vk::PipelineBindPoint::eCompute,*pipeline,d);
+        cmd.pushDescriptorSetKHR(vk::PipelineBindPoint::eCompute,*layout,0,writes,d);
+        cmd.pushConstants(*layout,vk::ShaderStageFlagBits::eCompute,0,4,&quality,d);
+        cmd.dispatch((W+7)/8,(H+7)/8,1,d);
+        barrier(cmd,vk::PipelineStageFlagBits2::eComputeShader,vk::AccessFlagBits2::eShaderWrite,
+            vk::PipelineStageFlagBits2::eTransfer,vk::AccessFlagBits2::eTransferRead);
+        const vk::BufferImageCopy copy{.imageSubresource = {vk::ImageAspectFlagBits::eColor,0,0,1},
+            .imageExtent = {W,H,1}};
+        cmd.copyImageToBuffer(*images[2],vk::ImageLayout::eGeneral,staging,copy,d);
+        barrier(cmd,vk::PipelineStageFlagBits2::eTransfer,vk::AccessFlagBits2::eTransferWrite,
+            vk::PipelineStageFlagBits2::eHost,vk::AccessFlagBits2::eHostRead);
+        assert(cmd.end(d) == vk::Result::eSuccess);
+        const vk::SubmitInfo submit{.commandBufferCount = 1, .pCommandBuffers = &cmd};
+        assert(queue.submit(submit,{},d) == vk::Result::eSuccess);
+        assert(queue.waitIdle(d) == vk::Result::eSuccess);
+        std::vector<Pixel> out(N);
+        std::memcpy(out.data(),mapped[0],Bytes);
+        for (const auto& pixel : out) for (float v : pixel) assert(std::isfinite(v));
+        return out;
+    };
+    auto out = run(1);
+    for (const auto& p : out) for (u32 c = 0; c < 4; ++c)
+        assert(std::abs(p[c] - color[0][c]) < 0.001f);
+
+    for (float gain : {13.44f, 1.0f}) {
+        std::fill_n(cb + 636,4,gain);
+        out = run(1);
+        for (const auto& p : out) for (u32 c = 0; c < 4; ++c)
+            assert(std::abs(p[c] - color[0][c] * gain) < 0.001f);
+    }
+    for (auto& v : velocity) v = {0.5f,0.5f,0,0};
+    assert(run(1) == color);
+    for (auto& v : velocity) v = {1,0.5f,0,0};
+
+    for (u32 y = 0; y < H; ++y) for (u32 x = 0; x < W; ++x)
+        color[y*W+x] = {x == W/2 ? 8.0f : 0.0f,0,0,0.5f};
+    const auto stock = run(0);
+    const auto high = run(1);
+    double stock_error = 0, high_error = 0;
+    for (u32 x = 16; x < W-16; ++x) {
+        const float expected = std::abs(int(x) - int(W/2)) <= 8 ? 8.0f/17 : 0;
+        stock_error += std::abs(stock[(H/2)*W+x][0] - expected);
+        high_error += std::abs(high[(H/2)*W+x][0] - expected);
+        assert(std::abs(high[(H/2)*W+x][3] - 0.5f) < 0.001f);
+    }
+    assert(high_error < stock_error * 0.05);
+
+    for (u32 y = 0; y < H; ++y) for (u32 x = 0; x < W; ++x) {
+        color[y*W+x] = x < W/2 ? Pixel{8,0,0,0.1f} : Pixel{0,4,0,0.9f};
+        velocity[y*W+x] = x < W/2 ? Pixel{0,0.5f,0,0} : Pixel{1,0.5f,0,0};
+    }
+    out = run(1);
+    for (u32 x = W/2+1; x < W/2+8; ++x) {
+        assert(std::abs(out[(H/2)*W+x][0]) < 0.001f);
+        assert(std::abs(out[(H/2)*W+x][1] - 4) < 0.001f);
+    }
+
+    cb[748] = 1.0f/W; cb[750] = -0.5f/W;
+    assert(run(1) == run(0));
+    std::printf("PASS: native motion blur HDR/gains, zero/short motion, depth/velocity rejection, "
+                "odd extents and frame edges; long-trail error stock=%g high=%g\n",
+                stock_error,high_error);
+    for (const auto& memory : buffer_memory) device.unmapMemory(*memory,d);
+}
diff --git a/tests/test_native_exposure.cpp b/tests/test_native_exposure.cpp
new file mode 100644
--- /dev/null
+++ b/tests/test_native_exposure.cpp
@@ -0,0 +1,242 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#include "../gpu/shim/engine/auto_exposure.h"
+#include "../gpu/shim/engine/engine_hooks.h"
+#include "../gpu/shim/engine/engine_state.h"
+#include "../gpu/shim/bbport_platform.h"
+#include "../gpu/shim/bbport_settings.h"
+#include <array>
+#include <cassert>
+#include <chrono>
+#include <cstring>
+#include <thread>
+#include <vector>
+
+namespace {
+std::vector<std::uint8_t> image(0x5540800);
+std::array<std::uint8_t, 0xc00> object{};
+std::array<std::uint8_t, 0x68> record{};
+std::array<std::uint8_t, 0x510> resource{}, replacement{};
+std::array<BbEngine::Callback, 2> callbacks{};
+std::size_t prepared = 0;
+bool committed = false, loading = false, cinematic = false, gameplay = true;
+std::uint64_t generation = 0;
+std::uint32_t area = 30;
+
+template <typename T> void Put(void* memory, std::size_t offset, T value) {
+    std::memcpy(static_cast<std::uint8_t*>(memory) + offset, &value, sizeof value);
+}
+template <typename T> T Get(const void* memory, std::size_t offset) {
+    T value;
+    std::memcpy(&value, static_cast<const std::uint8_t*>(memory) + offset, sizeof value);
+    return value;
+}
+struct Frame {
+    // The real stub stores XMM0 144 bytes below the saved integer argument array.
+    std::array<std::uint64_t, 26> words{};
+    std::uint64_t* Saved() { return words.data() + 18; }
+    Frame(std::uint32_t argument) {
+        Saved()[5] = reinterpret_cast<std::uint64_t>(object.data());
+        Saved()[4] = argument;
+        const float baseline = 3;
+        std::memcpy(words.data(), &baseline, sizeof baseline);
+    }
+    float Exposure() { return Get<float>(words.data(), 0); }
+};
+Frame Enable(std::uint32_t index = 0, bool authored = false) {
+    Frame frame(index);
+    frame.Saved()[7] = reinterpret_cast<std::uint64_t>(image.data()) + 0x21d7056;
+    frame.Saved()[3] = authored;
+    const auto before = frame.words;
+    assert(callbacks[0](0, frame.Saved()) == 0);
+    for (std::size_t i = 0; i < frame.words.size(); ++i)
+        if (i != 21) assert(frame.words[i] == before[i]);
+    return frame;
+}
+float Tone(int index = 0, float baseline = 3) {
+    Put(resource.data(), 0x50, index);
+    Frame frame(2);
+    frame.Saved()[7] = reinterpret_cast<std::uint64_t>(image.data()) + 0x21d7168;
+    Put(frame.words.data(), 0, baseline);
+    const auto before = frame.words;
+    assert(callbacks[1](0, frame.Saved()) == 0);
+    for (std::size_t i = 1; i < frame.words.size(); ++i)
+        assert(frame.words[i] == before[i]);
+    return frame.Exposure();
+}
+void Neutral() {
+    for (int i = 0; i < 21; ++i) {
+        Enable();
+        assert(Tone(i % 17) == 3);
+    }
+    for (int i = 0; i < 7; ++i) {
+        std::this_thread::sleep_for(std::chrono::milliseconds(200));
+        Enable();
+        assert(Tone((21 + i) % 17) == 3);
+    }
+    assert(BbEngine::Exposure::CurrentStatus() == BbEngine::Exposure::Status::Active);
+}
+}
+
+namespace BbSettings {
+Values& Get() { static Values values; return values; }
+}
+namespace BbPlatform {
+bool ReadProcessMemory(const void* p, void* out, std::size_t size) {
+    const auto at = reinterpret_cast<std::uintptr_t>(p);
+    const auto contains = [&](const auto& buffer) {
+        const auto start = reinterpret_cast<std::uintptr_t>(buffer.data());
+        return at >= start && size <= buffer.size() && at - start <= buffer.size() - size;
+    };
+    if (!contains(image) && !contains(object) && !contains(record) &&
+        !contains(resource) && !contains(replacement)) return false;
+    std::memcpy(out, p, size);
+    return true;
+}
+}
+namespace BbEngine {
+void host_log(const char*, ...) {}
+bool world_player_block(std::uint32_t* block) { *block = area; return gameplay; }
+bool Prepare(Hook& hook, std::uint8_t* bytes, std::size_t size, std::size_t offset,
+             std::span<const std::uint8_t> expected, Callback callback, bool preserve_context) {
+    assert(preserve_context);
+    if (!bytes || offset > size || expected.size() > size - offset) return false;
+    assert(prepared < callbacks.size());
+    callbacks[prepared++] = callback;
+    hook.site = bytes + offset;
+    return true;
+}
+void Discard(Hook& hook) { hook = {}; }
+void Commit(std::span<Hook> hooks) { assert(hooks.size() == 2); committed = true; }
+namespace Loading {
+bool ScreenUp() { return loading; }
+bool CinematicPlaying() { return cinematic; }
+std::uint64_t Generation() { return generation; }
+}
+}
+
+int main() {
+    using namespace BbEngine::Exposure;
+    assert(!Install(image.data(), 0x100));
+    assert(!committed && prepared == 0);
+    const auto call = [](std::size_t site, std::size_t target) {
+        image[site] = 0xe8;
+        Put(image.data(), site + 1, std::uint32_t(target - (site + 5)));
+    };
+    call(0x21d7051, 0xbb31c0);
+    assert(!Install(image.data(), image.size()) && prepared == 0);
+    call(0x21d7163, 0xbb3550);
+    Put(image.data(), 0x5465ed0, reinterpret_cast<std::uint64_t>(object.data()));
+    Put(image.data(), 0x5540778, 3.0f);
+    Put(object.data(), 0x208, reinterpret_cast<std::uint64_t>(record.data()));
+    Put(object.data(), 0x320, 1);
+    Put(object.data(), 0x6ac, 1.0f / 60);
+    Put(record.data(), 0x60, reinterpret_cast<std::uint64_t>(resource.data()));
+    for (auto offset : {4, 0x24, 0x28, 0x2c, 0x30, 0x34, 0x38, 0x3c, 0x40, 0x44})
+        Put(record.data(), offset, 0.1f + float(offset) / 100);
+    Put(record.data(), 0x54, 3.0f);
+    Put(resource.data(), 0x500, 10);
+    Put(resource.data(), 0x5c, 0.016f);
+    const auto original = record;
+    assert(Install(image.data(), image.size()) && committed);
+    assert(Enable().Saved()[3] == 0);
+    assert(Tone() == 3 && record == original && CurrentStatus() == Status::Off);
+
+    BbSettings::Get().graphics_auto_exposure = true;
+    assert(Enable(UINT32_MAX).Saved()[3] == 1); // SysV esi=-1 is zero-extended.
+    assert(Tone() == 3 && CurrentStatus() == Status::Calibrating);
+    assert(Get<float>(record.data(), 0x24) == 3 && Get<float>(record.data(), 0x28) == 3);
+    Neutral();
+    Put(record.data(), 0x54, 100.0f);
+    assert(std::abs(std::log2(Tone(12) / 3) - 0.5f) < 1e-6);
+    assert(Get<float>(image.data(), 0x5540778) == Get<float>(record.data(), 0x28));
+    const float applied = Get<float>(image.data(), 0x5540778);
+    const float learned_gray = Get<float>(record.data(), 4);
+    assert(Tone(12, applied) == applied);
+    assert(BbEngine::Exposure::CurrentStatus() == Status::Active);
+    assert(Get<float>(record.data(), 4) == learned_gray);
+    for (const auto caller : {0xbb6ab1, 0xbd1b89, 0xbd1c93}) {
+        Frame internal(2);
+        internal.Saved()[7] = reinterpret_cast<std::uint64_t>(image.data()) + caller;
+        Put(internal.words.data(), 0, 4.0f);
+        const auto registers = internal.words;
+        const auto native_record = record;
+        const auto post = Get<float>(image.data(), 0x5540778);
+        callbacks[0](0, internal.Saved());
+        callbacks[1](0, internal.Saved());
+        assert(internal.words == registers && record == native_record);
+        assert(Get<float>(image.data(), 0x5540778) == post);
+        assert(CurrentStatus() == Status::Active);
+    }
+    Enable();
+    assert(Get<float>(image.data(), 0x5540778) == 3);
+    assert(Tone(12, applied) == applied); // Job snapshot predates the enable restore.
+    assert(CurrentStatus() == Status::Active && Get<float>(record.data(), 4) == learned_gray);
+    for (int i = 0; i < 1000; ++i) {
+        const float stale_snapshot = Get<float>(image.data(), 0x5540778);
+        Enable();
+        Put(record.data(), 0x54, 2.2f + float(i % 20) / 10);
+        Tone(i % 17, stale_snapshot);
+        assert(CurrentStatus() == Status::Active);
+        assert(Get<float>(record.data(), 4) == learned_gray);
+        assert(Get<float>(record.data(), 0x24) == 1.5f);
+    }
+    Put(record.data(), 0x54, 0.01f);
+    assert(std::abs(std::log2(Tone(13) / 3) + 1.0f) < 1e-6);
+    const float gray = Get<float>(record.data(), 4);
+    Put(resource.data(), 0x5c, 0.128f);
+    Tone(14);
+    assert(Get<float>(record.data(), 4) == gray);
+
+    BbSettings::Get().graphics_auto_exposure = false;
+    assert(Tone() == 3 && record == original && CurrentStatus() == Status::Off);
+    assert(Get<float>(image.data(), 0x5540778) == 3);
+    assert(Enable().Saved()[3] == 0);
+    BbSettings::Get().graphics_auto_exposure = true;
+    assert(Enable(0, true).Saved()[3] == 1 && record == original);
+    assert(CurrentStatus() == Status::Unsupported);
+    assert(Enable(2).Saved()[3] == 0 && record == original);
+    Put(image.data(), 0x5540730, 1);
+    assert(Enable().Saved()[3] == 0 && record == original);
+    Put(image.data(), 0x5540730, 0);
+    loading = true;
+    assert(Enable().Saved()[3] == 0 && CurrentStatus() == Status::Waiting);
+    loading = false;
+    cinematic = true;
+    assert(Enable().Saved()[3] == 0 && record == original);
+    cinematic = false;
+    gameplay = false;
+    assert(Enable().Saved()[3] == 0);
+    gameplay = true;
+    Put(record.data(), 0x60, std::uint64_t(0));
+    assert(Enable().Saved()[3] == 0 && CurrentStatus() == Status::Invalid);
+    Put(record.data(), 0x60, reinterpret_cast<std::uint64_t>(resource.data()));
+    Put(resource.data(), 0x5c, 0.016f);
+    Enable();
+    Tone();
+    Neutral();
+    ++generation; // A complete quick load can occur between native callbacks.
+    Enable();
+    assert(Tone() == 3 && CurrentStatus() == Status::Calibrating);
+    Put(image.data(), 0x5540778, 2.5f); // A newer area-authored value is not ours to restore.
+    Enable();
+    assert(Get<float>(image.data(), 0x5540778) == 2.5f);
+    assert(Tone(1, 3) == 2.5f); // A real new authored value wins over an older job.
+    assert(Get<float>(record.data(), 0x24) == 2.5f);
+    Put(image.data(), 0x5540778, 3.0f);
+    Enable();
+    Recalibrate();
+    Enable();
+    assert(Tone() == 3 && CurrentStatus() == Status::Calibrating);
+    Put(resource.data(), 0x500, 9);
+    assert(Tone() == 3 && CurrentStatus() == Status::Unsupported && record == original);
+    Put(resource.data(), 0x500, 10);
+    Enable();
+    Tone();
+    const auto modified = record;
+    Put(record.data(), 0x60, reinterpret_cast<std::uint64_t>(replacement.data()));
+    BbSettings::Get().graphics_auto_exposure = false;
+    Tone();
+    auto expected = modified;
+    Put(expected.data(), 0x60, reinterpret_cast<std::uint64_t>(replacement.data()));
+    assert(record == expected); // Never restore fields into a replaced native allocation.
+}
diff --git a/tests/test_native_sss.cpp b/tests/test_native_sss.cpp
new file mode 100644
--- /dev/null
+++ b/tests/test_native_sss.cpp
@@ -0,0 +1,108 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#include "../gpu/shim/engine/native_sss.h"
+#include "../gpu/shim/bbport_settings.h"
+#include <array>
+#include <cassert>
+#include <cstring>
+#include <vector>
+
+namespace {
+std::vector<std::uint8_t> image(0x54b0900);
+std::array<std::uint8_t, 0x2980> view{}, replacement{}, unavailable{};
+std::array<std::uint64_t, 6> resources{1, 2, 3, 4, 5, 6};
+bool readable = true;
+constexpr std::size_t enable = 0x2975, disable = 0x54b0870;
+constexpr std::array<std::size_t, 5> offsets = {0x200, 0x2a8, 0x6c8, 0x6d8, 0x6e0};
+template <typename T> void Put(void* memory, std::size_t offset, T value) {
+    std::memcpy(static_cast<std::uint8_t*>(memory) + offset, &value, sizeof value);
+}
+void Init(auto& buffer, bool enabled = false) {
+    buffer.fill(0);
+    Put(buffer.data(), 0, reinterpret_cast<std::uint64_t>(image.data()) + 0x53b8450);
+    Put(buffer.data(), 0x48, std::uint64_t(0x400000));
+    buffer[enable] = enabled;
+    for (std::size_t i = 0; i < offsets.size(); ++i)
+        Put(buffer.data(), offsets[i], reinterpret_cast<std::uint64_t>(&resources[i]));
+}
+void Render(auto& buffer) {
+    BbEngine::Sss::BeforeRender(reinterpret_cast<std::uint64_t>(buffer.data()));
+}
+}
+namespace BbSettings {
+Values& Get() { static Values values; return values; }
+}
+namespace BbEngine {
+void host_log(const char*, ...) {}
+bool host_read_safe(const void* p, void* out, std::size_t size) {
+    const auto at = reinterpret_cast<std::uintptr_t>(p);
+    const auto contains = [&](const auto& buffer) {
+        const auto begin = reinterpret_cast<std::uintptr_t>(buffer.data());
+        const auto bytes = sizeof(typename std::decay_t<decltype(buffer)>::value_type) * buffer.size();
+        return at >= begin && size <= bytes && at - begin <= bytes - size;
+    };
+    if (!contains(image) && !contains(resources) && !contains(replacement) &&
+        !contains(unavailable) && !(readable && contains(view))) return false;
+    std::memcpy(out, p, size);
+    return true;
+}
+}
+int main() {
+    using namespace BbEngine::Sss;
+    assert(!Install(image.data(), 0x100));
+    assert(!Install(image.data(), image.size()));
+    constexpr std::uint8_t entry[] = {
+        0x55, 0x48, 0x89, 0xe5, 0x41, 0x57, 0x41, 0x56, 0x41, 0x55, 0x41, 0x54, 0x53,
+        0x48, 0x81, 0xec, 0xa8, 0x0e, 0x00, 0x00};
+    std::memcpy(image.data() + 0x229e990, entry, sizeof entry);
+    image[disable] = 1;
+    Init(view);
+    Init(replacement, true);
+    Init(unavailable);
+    Put(unavailable.data(), 0x6c8, std::uint64_t(0));
+    assert(Install(image.data(), image.size()));
+    const auto original = view;
+    Render(view);
+    assert(view == original && image[disable] == 1 && CurrentStatus() == Status::Off);
+    BbSettings::Get().graphics_native_sss = true;
+    Render(unavailable);
+    assert(CurrentStatus() == Status::Waiting && image[disable] == 1);
+    Render(view);
+    assert(CurrentStatus() == Status::Active && view[enable] == 1 && image[disable] == 0);
+    auto expected = original;
+    expected[enable] = 1;
+    assert(view == expected);
+    Render(view);
+    Render(replacement);
+    BbSettings::Get().graphics_native_sss = false;
+    Tick();
+    assert(view == original && replacement[enable] == 1 && image[disable] == 1);
+    assert(CurrentStatus() == Status::Off);
+    BbSettings::Get().graphics_native_sss = true;
+    Render(view);
+    image[disable] = 1; // A native/external override must not be undone on disable.
+    view[enable] = 0;
+    BbSettings::Get().graphics_native_sss = false;
+    Tick();
+    assert(view == original && image[disable] == 1);
+    BbSettings::Get().graphics_native_sss = true;
+    Render(view);
+    Put(view.data(), 0x6c8, reinterpret_cast<std::uint64_t>(&resources[5]));
+    BbSettings::Get().graphics_native_sss = false;
+    Tick();
+    assert(view[enable] == 1 && image[disable] == 1); // Replaced resources are not ours.
+    Init(view);
+    BbSettings::Get().graphics_native_sss = true;
+    Render(view);
+    readable = false;
+    BbSettings::Get().graphics_native_sss = false;
+    Tick();
+    assert(image[disable] == 1);
+    readable = true;
+    Init(view);
+    image[disable] = 0; // An already-enabled native force gate stays enabled afterward.
+    BbSettings::Get().graphics_native_sss = true;
+    Render(view);
+    BbSettings::Get().graphics_native_sss = false;
+    Render(view);
+    assert(view[enable] == 0 && image[disable] == 0);
+}

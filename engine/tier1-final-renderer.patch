+                VideoCore::TextureCache& texture_cache, Runtime& runtime,
+                SceneTargets& scene_targets, CameraMotion& camera_motion);
+    ~PointShadow();
+
+    struct Inputs {
+        vk::Buffer constants;
+        vk::DeviceSize constants_offset = 0;
+        vk::DeviceSize constants_range = 0;
+        vk::Buffer lights;

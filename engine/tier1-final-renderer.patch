+
+// Pre-RT Lantern implementation: snapshot the two additive light targets, then attenuate
+// only their new contribution. Unknown light families and indirect draws retain native lighting.
+bool Rasterizer::Tier1PointShadowBeforeDraw(const GraphicsPipeline* pipeline) {
+    if (!BbSettings::Get().startup_point_shadows ||
+        BbSettings::Get().graphics_point_shadow_strength.load() <= 0.0f ||
+        (pipeline->GetGraphicsKey().mrt_mask & 3) != 3 ||
+        !cb_descs[0].first || !cb_descs[1].first || buffer_infos.size() < 2 ||
+        pipeline->GetStage(Shader::SwStage::Vertex).pgm_hash != 0x8747a367) return false;
+    const auto* ps=pipeline->GetStages()[u32(Shader::SwStage::Fragment)];
+    if (!ps || ps->buffers.size() < 2 || ps->buffers[0].IsSpecial() || ps->buffers[1].IsSpecial()) return false;
+    u32 count=0;
+    switch(ps->pgm_hash) {
+    case 0x370174f7:case 0x7cc2c044:count=1;break;
+    case 0x186d69d5:case 0x600f86b0:count=2;break;
+    case 0xd22cbfd1:count=3;break;case 0x3105494c:count=4;break;case 0xd75fe2ff:count=5;break;
+    case 0x07d07cf3:count=6;break;case 0xf2531727:count=7;break;case 0xc6edb19a:count=8;break;
+    case 0xb59b4c4e:count=9;break;case 0x505ebdbe:count=10;break;case 0x22b357f3:count=11;break;
+    case 0x9f9ef267:count=12;break;default:return false;
+    }
+    const auto& dynamic=scheduler.GetDynamicState();
+    if (dynamic.scissors.size()!=1 || dynamic.viewports.size()!=1) return false;
+    u32 offsets=0;
+    std::memcpy(&offsets,push_data.buf_offsets.data(),sizeof offsets);
+    return point_shadow->OnLightDraw(cb_descs[0].first,cb_descs[1].first,
+        {.constants=buffer_infos[0].buffer,.constants_offset=buffer_infos[0].offset,.constants_range=buffer_infos[0].range,
+         .lights=buffer_infos[1].buffer,.lights_offset=buffer_infos[1].offset,.lights_range=buffer_infos[1].range,
+         .offsets=offsets,.count=count,.tile=dynamic.scissors[0]});
+}

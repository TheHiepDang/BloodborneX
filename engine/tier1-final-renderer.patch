 /// begin/end pair around it reads visible, never occluded.
 constexpr std::uint64_t Unmeasured = 0x2FFFFFFull;
 constexpr std::uint32_t MaxPipes = 16;
+
+constexpr bool Fresh(std::uint64_t frame, std::uint64_t now, std::uint64_t limit) {
+    return now >= frame && now - frame <= limit;
+}
+constexpr bool Writable(std::uint64_t frame, std::uint64_t now,
+                        std::uint64_t limit, bool previously_written) {
+    if (now < frame) return false;
+    const auto age = now - frame;
+    return age <= limit || (previously_written && age - limit <= limit);
+}
+constexpr std::uint64_t Visibility(std::uint64_t any_samples, std::uint32_t queries,
+                                   bool complete, bool fresh) {
+    return queries && complete && fresh && any_samples == 0 ? 0 : Unmeasured;
+}
 

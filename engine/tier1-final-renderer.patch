diff --git a/tests/test_point_shadow.cpp b/tests/test_point_shadow.cpp
new file mode 100644
--- /dev/null
+++ b/tests/test_point_shadow.cpp
@@ -0,0 +1,277 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#include <vulkan/vulkan.h>
+#include <algorithm>
+#include <array>
+#include <cassert>
+#include <cmath>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <vector>
+#include "video_core/host_shaders/point_shadow_comp.h"
+
+namespace {
+#define CHECK(call) do { if ((call) != VK_SUCCESS) { std::fprintf(stderr, "%s failed\n", #call); std::abort(); } } while (false)
+constexpr unsigned W = 19, H = 11;
+struct Push {
+    unsigned offsets=0,frame=0;
+    std::array<float,2> size{float(W),float(H)};
+    float length=2.5f,thickness=0.6f,strength=0.85f,fade_start=18,fade_end=30;
+    unsigned count=1,steps=16;
+    float bias=0.03f;
+    std::array<int,4> rect{0,0,int(W),int(H)};
+};
+static_assert(sizeof(Push) == 64);
+struct Buffer { VkBuffer buffer{}; VkDeviceMemory memory{}; void* data{}; unsigned size{}; };
+struct Image { VkImage image{}; VkDeviceMemory memory{}; VkImageView view{}; };
+struct Test {
+    VkInstance instance{};
+    VkPhysicalDevice gpu{};
+    VkDevice device{};
+    VkQueue queue{};
+    VkPhysicalDeviceMemoryProperties memory{};
+    VkCommandPool pool{};
+    VkCommandBuffer cmd{};
+    VkDescriptorSetLayout set{};
+    VkPipelineLayout layout{};
+    VkPipeline pipeline{};
+    VkSampler sampler{};
+    PFN_vkCmdPushDescriptorSetKHR descriptors{};
+    std::vector<Buffer> buffers;
+    std::vector<Image> images;
+
+    unsigned Memory(unsigned bits, VkMemoryPropertyFlags flags) {
+        for (unsigned i = 0; i < memory.memoryTypeCount; ++i)
+            if ((bits & (1u << i)) && (memory.memoryTypes[i].propertyFlags & flags) == flags) return i;
+        std::abort();
+    }
+    Buffer MakeBuffer(unsigned size) {
+        Buffer b{.size = size};
+        VkBufferCreateInfo info{.sType = VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO, .size = size,
+            .usage = VK_BUFFER_USAGE_STORAGE_BUFFER_BIT | VK_BUFFER_USAGE_TRANSFER_SRC_BIT |
+                     VK_BUFFER_USAGE_TRANSFER_DST_BIT};
+        CHECK(vkCreateBuffer(device, &info, nullptr, &b.buffer));
+        VkMemoryRequirements req;
+        vkGetBufferMemoryRequirements(device, b.buffer, &req);
+        VkMemoryAllocateInfo alloc{.sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO,
+            .allocationSize = req.size, .memoryTypeIndex = Memory(req.memoryTypeBits,
+                VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT | VK_MEMORY_PROPERTY_HOST_COHERENT_BIT)};
+        CHECK(vkAllocateMemory(device, &alloc, nullptr, &b.memory));
+        CHECK(vkBindBufferMemory(device, b.buffer, b.memory, 0));
+        CHECK(vkMapMemory(device, b.memory, 0, VK_WHOLE_SIZE, 0, &b.data));
+        std::memset(b.data, 0, size);
+        buffers.push_back(b);
+        return b;
+    }
+    Image MakeImage(VkFormat format) {
+        Image i;
+        VkImageCreateInfo info{.sType = VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO,
+            .imageType = VK_IMAGE_TYPE_2D, .format = format, .extent = {W, H, 1},
+            .mipLevels = 1, .arrayLayers = 1, .samples = VK_SAMPLE_COUNT_1_BIT,
+            .tiling = VK_IMAGE_TILING_OPTIMAL, .usage = VK_IMAGE_USAGE_SAMPLED_BIT |
+                VK_IMAGE_USAGE_STORAGE_BIT | VK_IMAGE_USAGE_TRANSFER_SRC_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT};
+        CHECK(vkCreateImage(device, &info, nullptr, &i.image));
+        VkMemoryRequirements req;
+        vkGetImageMemoryRequirements(device, i.image, &req);
+        VkMemoryAllocateInfo alloc{.sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO,
+            .allocationSize = req.size, .memoryTypeIndex = Memory(req.memoryTypeBits, VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT)};
+        CHECK(vkAllocateMemory(device, &alloc, nullptr, &i.memory));
+        CHECK(vkBindImageMemory(device, i.image, i.memory, 0));
+        VkImageViewCreateInfo view{.sType = VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO,
+            .image = i.image, .viewType = VK_IMAGE_VIEW_TYPE_2D, .format = format,
+            .subresourceRange = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1}};
+        CHECK(vkCreateImageView(device, &view, nullptr, &i.view));
+        images.push_back(i);
+        return i;
+    }
+    Test() {
+        VkApplicationInfo app{.sType = VK_STRUCTURE_TYPE_APPLICATION_INFO,
+            .pApplicationName = "point-shadow-test", .apiVersion = VK_API_VERSION_1_3};
+        VkInstanceCreateInfo ci{.sType = VK_STRUCTURE_TYPE_INSTANCE_CREATE_INFO, .pApplicationInfo = &app};
+        CHECK(vkCreateInstance(&ci, nullptr, &instance));
+        unsigned count = 0;
+        CHECK(vkEnumeratePhysicalDevices(instance, &count, nullptr));
+        std::vector<VkPhysicalDevice> devices(count);
+        CHECK(vkEnumeratePhysicalDevices(instance, &count, devices.data()));
+        assert(count);
+        gpu = devices[0];
+        vkGetPhysicalDeviceMemoryProperties(gpu, &memory);
+        unsigned families_count = 0, family = 0;
+        vkGetPhysicalDeviceQueueFamilyProperties(gpu, &families_count, nullptr);
+        std::vector<VkQueueFamilyProperties> families(families_count);
+        vkGetPhysicalDeviceQueueFamilyProperties(gpu, &families_count, families.data());
+        while (family < families_count && !(families[family].queueFlags & VK_QUEUE_COMPUTE_BIT)) ++family;
+        assert(family < families_count);
+        const float priority = 1;
+        VkDeviceQueueCreateInfo qi{.sType = VK_STRUCTURE_TYPE_DEVICE_QUEUE_CREATE_INFO,
+            .queueFamilyIndex = family, .queueCount = 1, .pQueuePriorities = &priority};
+        const char* extension = VK_KHR_PUSH_DESCRIPTOR_EXTENSION_NAME;
+        VkPhysicalDeviceFeatures features{}; features.shaderStorageImageExtendedFormats=VK_TRUE;
+        VkDeviceCreateInfo di{.sType = VK_STRUCTURE_TYPE_DEVICE_CREATE_INFO,
+            .queueCreateInfoCount = 1, .pQueueCreateInfos = &qi,
+            .enabledExtensionCount = 1, .ppEnabledExtensionNames = &extension,.pEnabledFeatures=&features};
+        CHECK(vkCreateDevice(gpu, &di, nullptr, &device));
+        vkGetDeviceQueue(device, family, 0, &queue);
+        descriptors = reinterpret_cast<PFN_vkCmdPushDescriptorSetKHR>(
+            vkGetDeviceProcAddr(device, "vkCmdPushDescriptorSetKHR"));
+        assert(descriptors);
+        VkCommandPoolCreateInfo pi{.sType = VK_STRUCTURE_TYPE_COMMAND_POOL_CREATE_INFO,
+            .flags = VK_COMMAND_POOL_CREATE_RESET_COMMAND_BUFFER_BIT, .queueFamilyIndex = family};
+        CHECK(vkCreateCommandPool(device, &pi, nullptr, &pool));
+        VkCommandBufferAllocateInfo ai{.sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO,
+            .commandPool = pool, .level = VK_COMMAND_BUFFER_LEVEL_PRIMARY, .commandBufferCount = 1};
+        CHECK(vkAllocateCommandBuffers(device, &ai, &cmd));
+        const std::array<VkDescriptorType, 7> types{VK_DESCRIPTOR_TYPE_STORAGE_BUFFER,
+            VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER,VK_DESCRIPTOR_TYPE_STORAGE_BUFFER,
+            VK_DESCRIPTOR_TYPE_STORAGE_IMAGE,VK_DESCRIPTOR_TYPE_STORAGE_IMAGE,
+            VK_DESCRIPTOR_TYPE_STORAGE_IMAGE,VK_DESCRIPTOR_TYPE_STORAGE_IMAGE};
+        std::array<VkDescriptorSetLayoutBinding, 7> bindings{};
+        for (unsigned i = 0; i < bindings.size(); ++i)
+            bindings[i] = {i, types[i], 1, VK_SHADER_STAGE_COMPUTE_BIT, nullptr};
+        VkDescriptorSetLayoutCreateInfo si{.sType = VK_STRUCTURE_TYPE_DESCRIPTOR_SET_LAYOUT_CREATE_INFO,
+            .flags = VK_DESCRIPTOR_SET_LAYOUT_CREATE_PUSH_DESCRIPTOR_BIT_KHR,
+            .bindingCount = unsigned(bindings.size()), .pBindings = bindings.data()};
+        CHECK(vkCreateDescriptorSetLayout(device, &si, nullptr, &set));
+        VkPushConstantRange range{VK_SHADER_STAGE_COMPUTE_BIT, 0, sizeof(Push)};
+        VkPipelineLayoutCreateInfo li{.sType = VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO,
+            .setLayoutCount = 1, .pSetLayouts = &set, .pushConstantRangeCount = 1, .pPushConstantRanges = &range};
+        CHECK(vkCreatePipelineLayout(device, &li, nullptr, &layout));
+        VkShaderModule module;
+        VkShaderModuleCreateInfo mi{.sType = VK_STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO,
+            .codeSize = sizeof(POINT_SHADOW_COMP), .pCode = POINT_SHADOW_COMP};
+        CHECK(vkCreateShaderModule(device, &mi, nullptr, &module));
+        VkComputePipelineCreateInfo pc{.sType = VK_STRUCTURE_TYPE_COMPUTE_PIPELINE_CREATE_INFO,
+            .stage = {.sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO,
+                .stage = VK_SHADER_STAGE_COMPUTE_BIT, .module = module, .pName = "main"}, .layout = layout};
+        CHECK(vkCreateComputePipelines(device, {}, 1, &pc, nullptr, &pipeline));
+        vkDestroyShaderModule(device, module, nullptr);
+        VkSamplerCreateInfo sm{.sType = VK_STRUCTURE_TYPE_SAMPLER_CREATE_INFO,
+            .magFilter = VK_FILTER_NEAREST, .minFilter = VK_FILTER_NEAREST,
+            .addressModeU = VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE,
+            .addressModeV = VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE,
+            .addressModeW = VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE};
+        CHECK(vkCreateSampler(device, &sm, nullptr, &sampler));
+    }
+    void Barrier(VkImage image, VkImageLayout old_layout = VK_IMAGE_LAYOUT_GENERAL) {
+        VkImageMemoryBarrier b{.sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER,
+            .srcAccessMask = old_layout == VK_IMAGE_LAYOUT_UNDEFINED ? 0u : VK_ACCESS_MEMORY_WRITE_BIT,
+            .dstAccessMask = VK_ACCESS_MEMORY_READ_BIT | VK_ACCESS_MEMORY_WRITE_BIT,
+            .oldLayout = old_layout, .newLayout = VK_IMAGE_LAYOUT_GENERAL,
+            .srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED, .dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+            .image = image, .subresourceRange = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1}};
+        vkCmdPipelineBarrier(cmd, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT,
+            0, 0, nullptr, 0, nullptr, 1, &b);
+    }
+    ~Test() {
+        vkDeviceWaitIdle(device);
+        for (auto i : images) {
+            vkDestroyImageView(device, i.view, nullptr);
+            vkDestroyImage(device, i.image, nullptr);
+            vkFreeMemory(device, i.memory, nullptr);
+        }
+        for (auto b : buffers) {
+            vkUnmapMemory(device, b.memory);
+            vkDestroyBuffer(device, b.buffer, nullptr);
+            vkFreeMemory(device, b.memory, nullptr);
+        }
+        vkDestroySampler(device, sampler, nullptr);
+        vkDestroyPipeline(device, pipeline, nullptr);
+        vkDestroyPipelineLayout(device, layout, nullptr);
+        vkDestroyDescriptorSetLayout(device, set, nullptr);
+        vkDestroyCommandPool(device, pool, nullptr);
+        vkDestroyDevice(device, nullptr);
+        vkDestroyInstance(instance, nullptr);
+    }
+};
+}
+
+int main() {
+    Test t;
+    const auto cb=t.MakeBuffer(256), lights=t.MakeBuffer(1024), result=t.MakeBuffer(W*H*8);
+    const auto depth=t.MakeImage(VK_FORMAT_R32_SFLOAT);
+    const std::array<Image,4> target{t.MakeImage(VK_FORMAT_B10G11R11_UFLOAT_PACK32),
+        t.MakeImage(VK_FORMAT_B10G11R11_UFLOAT_PACK32),t.MakeImage(VK_FORMAT_B10G11R11_UFLOAT_PACK32),
+        t.MakeImage(VK_FORMAT_B10G11R11_UFLOAT_PACK32)};
+    auto* constants=static_cast<float*>(cb.data);
+    for(unsigned i=0;i<4;++i) constants[i*5]=1;
+    auto* light=static_cast<float*>(lights.data);
+    light[0]=0; light[1]=0; light[2]=0.95f; light[3]=0.01f;
+    light[4]=light[5]=light[6]=1;
+    Push push;
+    bool initialized=false;
+    const auto run=[&](float scene_depth,float current,float previous) {
+        CHECK(vkResetCommandBuffer(t.cmd,0));
+        VkCommandBufferBeginInfo begin{.sType=VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO};
+        CHECK(vkBeginCommandBuffer(t.cmd,&begin));
+        const auto old=initialized?VK_IMAGE_LAYOUT_GENERAL:VK_IMAGE_LAYOUT_UNDEFINED;
+        t.Barrier(depth.image,old);
+        const VkImageSubresourceRange range{VK_IMAGE_ASPECT_COLOR_BIT,0,1,0,1};
+        const VkClearColorValue z{{scene_depth,0,0,0}};
+        vkCmdClearColorImage(t.cmd,depth.image,VK_IMAGE_LAYOUT_GENERAL,&z,1,&range);
+        t.Barrier(depth.image);
+        for(unsigned i=0;i<4;++i) {
+            t.Barrier(target[i].image,old);
+            float v=(i%2==0)?current:previous;
+            const VkClearColorValue colour{{v,v,v,1}};
+            vkCmdClearColorImage(t.cmd,target[i].image,VK_IMAGE_LAYOUT_GENERAL,&colour,1,&range);
+            t.Barrier(target[i].image);
+        }
+        const VkDescriptorBufferInfo cbi{cb.buffer,0,cb.size}, li{lights.buffer,0,lights.size};
+        const VkDescriptorImageInfo di{t.sampler,depth.view,VK_IMAGE_LAYOUT_GENERAL};
+        std::array<VkDescriptorImageInfo,4> ti{};
+        std::array<VkWriteDescriptorSet,7> writes{};
+        writes[0]={.sType=VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET,.dstBinding=0,.descriptorCount=1,
+            .descriptorType=VK_DESCRIPTOR_TYPE_STORAGE_BUFFER,.pBufferInfo=&cbi};
+        writes[1]={.sType=VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET,.dstBinding=1,.descriptorCount=1,
+            .descriptorType=VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER,.pImageInfo=&di};
+        writes[2]={.sType=VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET,.dstBinding=2,.descriptorCount=1,
+            .descriptorType=VK_DESCRIPTOR_TYPE_STORAGE_BUFFER,.pBufferInfo=&li};
+        for(unsigned i=0;i<4;++i) {
+            ti[i]={{},target[i].view,VK_IMAGE_LAYOUT_GENERAL};
+            writes[i+3]={.sType=VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET,.dstBinding=i+3,.descriptorCount=1,
+                .descriptorType=VK_DESCRIPTOR_TYPE_STORAGE_IMAGE,.pImageInfo=&ti[i]};
+        }
+        vkCmdBindPipeline(t.cmd,VK_PIPELINE_BIND_POINT_COMPUTE,t.pipeline);
+        t.descriptors(t.cmd,VK_PIPELINE_BIND_POINT_COMPUTE,t.layout,0,unsigned(writes.size()),writes.data());
+        vkCmdPushConstants(t.cmd,t.layout,VK_SHADER_STAGE_COMPUTE_BIT,0,sizeof push,&push);
+        vkCmdDispatch(t.cmd,(W+7)/8,(H+7)/8,1);
+        t.Barrier(target[0].image); t.Barrier(target[2].image);
+        VkBufferImageCopy copy{.imageSubresource={VK_IMAGE_ASPECT_COLOR_BIT,0,0,1},.imageExtent={W,H,1}};
+        vkCmdCopyImageToBuffer(t.cmd,target[0].image,VK_IMAGE_LAYOUT_GENERAL,result.buffer,1,&copy);
+        copy.bufferOffset=W*H*4;
+        vkCmdCopyImageToBuffer(t.cmd,target[2].image,VK_IMAGE_LAYOUT_GENERAL,result.buffer,1,&copy);
+        VkMemoryBarrier host{.sType=VK_STRUCTURE_TYPE_MEMORY_BARRIER,.srcAccessMask=VK_ACCESS_TRANSFER_WRITE_BIT,
+            .dstAccessMask=VK_ACCESS_HOST_READ_BIT};
+        vkCmdPipelineBarrier(t.cmd,VK_PIPELINE_STAGE_TRANSFER_BIT,VK_PIPELINE_STAGE_HOST_BIT,0,1,&host,0,nullptr,0,nullptr);
+        CHECK(vkEndCommandBuffer(t.cmd));
+        VkSubmitInfo submit{.sType=VK_STRUCTURE_TYPE_SUBMIT_INFO,.commandBufferCount=1,.pCommandBuffers=&t.cmd};
+        CHECK(vkQueueSubmit(t.queue,1,&submit,{})); CHECK(vkQueueWaitIdle(t.queue));
+        initialized=true;
+        const auto* pixels=static_cast<const uint32_t*>(result.data);
+        return std::vector<uint32_t>(pixels,pixels+W*H*2);
+    };
+    // Identity inverse, surface z=.5, light behind it: the screen-space ray hits the surface.
+    const auto shadow=run(.5f,1.0f,.25f);
+    push.strength=0; const auto off=run(.5f,1.0f,.25f);
+    assert(std::ranges::all_of(off,[&](auto v){return v==off[0];}));
+    unsigned changed=0;
+    for(unsigned i=0;i<shadow.size();++i) {assert(shadow[i]<=off[i]);changed+=shadow[i]<off[i];}
+    assert(changed>0);
+    for(unsigned i=0;i<W*H;++i) assert(shadow[i]==shadow[i+W*H]);
+    push.strength=.85f;
+    const auto sky=run(1,1,.25f); assert(sky==off);
+    const auto unchanged=run(.5f,1,1); assert(unchanged==off);
+    push.count=0; assert(run(.5f,1,.25f)==off); push.count=1;
+    light[3]=0; assert(run(.5f,1,.25f)==off); light[3]=.01f;
+    // No contribution may be removed below the pre-draw snapshot.
+    const auto baseline=run(.5f,.25f,.25f);
+    for(unsigned i=0;i<shadow.size();++i) assert(shadow[i]>=baseline[i]);
+    push.rect={4,3,14,9}; const auto tile=run(.5f,1,.25f);
+    for(unsigned y=0;y<H;++y) for(unsigned x=0;x<W;++x)
+        if(x<4||x>=14||y<3||y>=9) {
+            assert(tile[y*W+x]==off[y*W+x]);
+            assert(tile[W*H+y*W+x]==off[W*H+y*W+x]);
+        }
+    std::printf("Point shadows: PASS (%u attenuated pixels, zero strength, sky, no delta, no lights, snapshot floor, clipped odd-size tile)\n",changed);
+}

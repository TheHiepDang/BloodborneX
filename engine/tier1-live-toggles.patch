--- /dev/null
+++ b/tests/test_tier1_live.cpp
@@ -0,0 +1,26 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#include <cassert>
+#include <cstdio>
+#include "gpu/shadps4/video_core/renderer_vulkan/tier1_live_settings.h"
+using namespace Vulkan::Tier1Live;
+constexpr Settings FromBits(unsigned n) {
+    return {bool(n&1),bool(n&2),bool(n&4),bool(n&8),bool(n&16)};
+}
+int main() {
+    FrameState frame;
+    assert(frame.active.Bits()==0);
+    unsigned transitions=0;
+    for(unsigned repeat=0;repeat<8;++repeat) for(unsigned a=0;a<32;++a) {
+        frame.Latch(FromBits(a));
+        for(unsigned b=0;b<32;++b) {
+            auto requested=FromBits(b);
+            assert(frame.active.Bits()==a); // a menu request cannot modify this frame
+            const auto changed=frame.Latch(requested);
+            assert(changed==(a^b)); assert(frame.active.Bits()==b);
+            assert(frame.Latch(requested)==0); // steady state does not invalidate histories
+            frame.Latch(FromBits(a));
+            ++transitions;
+        }
+    }
+    std::printf("Tier 1 live: PASS (%u mixed transitions; stable frame snapshot and no-op changes)\n",transitions);
+}

new file mode 100644
--- /dev/null
+++ b/gpu/shadps4/video_core/renderer_vulkan/tier1_live_settings.h
@@ -0,0 +1,21 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+#include <cstdint>
+namespace Vulkan::Tier1Live {
+struct Settings {
+    bool ssgi=false, contact=false, sunlight=false, point_fog=false, point_shadows=false;
+    constexpr std::uint32_t Bits() const {
+        return unsigned(ssgi) | unsigned(contact)<<1 | unsigned(sunlight)<<2 |
+               unsigned(point_fog)<<3 | unsigned(point_shadows)<<4;
+    }
+};
+struct FrameState {
+    Settings active;
+    // Called only by the recording owner between frames, never from UI callbacks.
+    constexpr std::uint32_t Latch(Settings requested) {
+        const auto changed=active.Bits() ^ requested.Bits();
+        active=requested;
+        return changed;
+    }
+};
+} // namespace Vulkan::Tier1Live

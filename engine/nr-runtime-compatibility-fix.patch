--- /dev/null
+++ b/gpu/shadps4/video_core/renderer_vulkan/nr_runtime_identity.h
@@ -0,0 +1,45 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+#include <array>
+#include <cstdint>
+#include <string_view>
+
+namespace Vulkan::NrRuntime {
+enum class Build { OpenNrFp16, Original };
+struct Identity {
+    std::uint64_t size;
+    std::string_view sha256;
+    const char* name;
+    bool gameplay_validated;
+    Build build;
+};
+// Identity is not runtime validation. Keep the Vulkan export/init/evaluate checks.
+inline constexpr std::array Identities{
+    Identity{276162560,
+        "CDFA6C1EC784867182164C7836F324F087B5C9F374D0C9FE46F54999FEABF3ED",
+        "openNR FP16 compatibility 310.9.16.0", true, Build::OpenNrFp16},
+    Identity{266424944,
+        "2BC19BC09A7B89DD44F73E2AC0108FCC586E2154BDD0830F242F4F040E28789F",
+        "original RenoDX-distributed 310.9.16.0 (2026-10-16)", false, Build::Original},
+};
+constexpr bool ContainsIgnoreCase(std::string_view text, std::string_view part) {
+    const auto upper = [](char c) { return c >= 'a' && c <= 'z' ? char(c-'a'+'A') : c; };
+    for (std::size_t i = 0; i + part.size() <= text.size(); ++i) {
+        bool match = true;
+        for (std::size_t j = 0; j < part.size(); ++j)
+            if (upper(text[i+j]) != upper(part[j])) { match = false; break; }
+        if (match) return true;
+    }
+    return false;
+}
+constexpr bool PrefersOriginal(std::uint32_t vendor, std::string_view gpu) {
+    // Requiring GeForce avoids confusing the Turing workstation RTX 5000 with RTX 50-series.
+    return vendor == 0x10de && ContainsIgnoreCase(gpu, "GeForce RTX 50");
+}
+constexpr const Identity* Identify(std::uint64_t size, std::string_view sha256) {
+    for (const auto& identity : Identities) {
+        if (identity.size == size && identity.sha256 == sha256) return &identity;
+    }
+    return nullptr;
+}
+} // namespace Vulkan::NrRuntime
diff --git a/tests/test_nr_runtime_identity.cpp b/tests/test_nr_runtime_identity.cpp
new file mode 100644
--- /dev/null
+++ b/tests/test_nr_runtime_identity.cpp
@@ -0,0 +1,23 @@
+#include "video_core/renderer_vulkan/nr_runtime_identity.h"
+#include <cassert>
+#include <string>
+#include <cstdio>
+int main() {
+    using namespace Vulkan::NrRuntime;
+    for(const auto& i:Identities) {
+        assert(Identify(i.size,i.sha256)==&i);
+        assert(!Identify(i.size+1,i.sha256));
+        auto corrupt=std::string(i.sha256);corrupt[0]=corrupt[0]=='0'?'1':'0';
+        assert(!Identify(i.size,corrupt));
+    }
+    assert(!Identify(Identities[0].size,Identities[1].sha256));
+    assert(!Identify(Identities[1].size,Identities[0].sha256));
+    assert(!Identify(0,""));
+    assert(PrefersOriginal(0x10de,"NVIDIA GeForce RTX 5080"));
+    assert(PrefersOriginal(0x10de,"nvidia geforce rtx 5090 laptop GPU"));
+    assert(!PrefersOriginal(0x10de,"NVIDIA GeForce RTX 3070"));
+    assert(!PrefersOriginal(0x10de,"NVIDIA GeForce RTX 4090"));
+    assert(!PrefersOriginal(0x10de,"NVIDIA Quadro RTX 5000"));
+    assert(!PrefersOriginal(0x1002,"GeForce RTX 5080"));
+    std::puts("NR runtime identity: both exact builds accepted; mixed size/hash and mutations rejected.");
+}

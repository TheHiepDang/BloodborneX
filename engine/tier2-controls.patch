diff --git a/tests/test_bloom_lifecycle.cpp b/tests/test_bloom_lifecycle.cpp
new file mode 100644
--- /dev/null
+++ b/tests/test_bloom_lifecycle.cpp
@@ -0,0 +1,16 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#include "../gpu/shadps4/video_core/renderer_vulkan/bloom_frame_state.h"
+#include <cassert>
+int main() {
+    Vulkan::BloomFrameState bloom;
+    assert(!bloom.Ready() && !bloom.Consume(true));
+    bloom.SetEnabled(true);bloom.Generated();
+    bloom.SetEnabled(true); // display settings latch must not discard this frame's producer
+    assert(bloom.Ready() && bloom.Consume(true));
+    assert(bloom.Status()==2 && !bloom.Consume(true));
+    bloom.Discard(); assert(!bloom.Ready());
+    bloom.Generated();bloom.Discard();assert(!bloom.Consume(true)); // no stale frame
+    bloom.Generated();assert(!bloom.Consume(false) && bloom.Status()==3);
+    bloom.Generated();bloom.SetEnabled(false);assert(!bloom.Consume(true) && bloom.Status()==0);
+    bloom.SetEnabled(true);assert(!bloom.Ready());bloom.Generated();assert(bloom.Consume(true));
+}

diff --git a/gpu/shadps4/video_core/renderer_vulkan/bloom_frame_state.h b/gpu/shadps4/video_core/renderer_vulkan/bloom_frame_state.h
new file mode 100644
--- /dev/null
+++ b/gpu/shadps4/video_core/renderer_vulkan/bloom_frame_state.h
@@ -0,0 +1,23 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+namespace Vulkan {
+class BloomFrameState {
+    bool enabled=false,ready=false;
+    int status=0;
+public:
+    void SetEnabled(bool value) {
+        if(value==enabled)return;
+        enabled=value;ready=false;status=enabled?1:0;
+    }
+    bool Enabled() const {return enabled;}
+    bool Ready() const {return enabled && ready;}
+    void Generated() {ready=enabled;}
+    void Discard() {ready=false;}
+    void Unsupported() {ready=false;status=enabled?3:0;}
+    bool Consume(bool compatible) {
+        if(!Ready())return false;
+        ready=false;status=compatible?2:3;return compatible;
+    }
+    int Status() const {return status;}
+};
+}

+    const std::array<std::array<float,3>,4> tuning{{{1,.05f,1},{2,.05f,4},{1,.4f,8},{1,.05f,1}}};
+    float baseline=0;
+    for(size_t test=0;test<tuning.size();++test) {
+        const auto [intensity,core,sharpness]=tuning[test];

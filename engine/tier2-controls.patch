+    std::array<uint32_t,4> ids{};
+    constexpr std::array<float,4> magic{0.1111f,0.2222f,0.3333f,0.4444f};
+    for(size_t at=5;at<words.size();at+=words[at]>>16)
+        if((words[at]&65535)==43 && (words[at]>>16)==4)
+            for(size_t c=0;c<4;++c) if(words[at+3]==std::bit_cast<uint32_t>(magic[c])) ids[c]=words[at+2];

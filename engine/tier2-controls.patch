+bool GraphicsChildren(bool selected) { return selected || Searching() || preset_reference_mode; }
+void GraphicsDefault(const char* key,auto& value,auto factory) {
+    if(preset_reference_mode) return;
+    ImGui::SameLine(); ImGui::PushID(key);
+    if(ImGui::SmallButton("Default")) Store(value,factory,true);
+    Hint("Restore this option to its factory default.");ImGui::PopID();
+}
+void GraphicsBool(const char* key,const char* title,std::atomic<bool>& value,bool factory,const char* help) {
+    if(const char* label=Item(title,title,key)) { Checkbox(label,value);Hint(help);GraphicsDefault(key,value,factory); }
+}
+void GraphicsFloat(const char* key,const char* title,std::atomic<float>& value,float lo,float hi,float factory,const char* help) {
+    if(const char* label=Item(title,title,key)) {
+        const auto percent=[&](float native) { return 1.0f+99.0f*std::clamp((native-lo)/(hi-lo),0.0f,1.0f); };
+        float shown=percent(value.load());const float width=ImGui::CalcItemWidth();
+        const bool reset=SliderReset(label,shown,percent(factory));if(reset) shown=percent(factory);
+        ImGui::SetNextItemWidth(std::max(60.0f,width-ImGui::GetFrameHeight()-ImGui::GetStyle().ItemSpacing.x));
+        ImGui::PushStyleVar(ImGuiStyleVar_GrabMinSize,20.0f*base_scale);
+        const bool changed=ImGui::SliderFloat(label,&shown,1.0f,100.0f,"%.1f",ImGuiSliderFlags_AlwaysClamp);
+        ImGui::PopStyleVar();
+        if(changed || reset) Store(value,reset?factory:lo+(std::clamp(shown,1.0f,100.0f)-1.0f)*(hi-lo)/99.0f,true);
+        Hint(help);
+        if(ImGui::IsItemHovered()) ImGui::SetTooltip("%s\n1-100; arrows adjust, Ctrl-click to type.\n%s",title,help);
+    }
+}
+void GraphicsChoice(const char* key,const char* title,std::atomic<int>& value,std::initializer_list<const char*> choices,const char* help) {
+    if(const char* label=Item(title,title,key)) {
+        std::vector<const char*> names(choices);int selected=std::clamp(value.load(),0,int(names.size())-1);
+        if(ImGui::Combo(label,&selected,names.data(),int(names.size()))) Store(value,selected,true);
+        Hint(help);GraphicsDefault(key,value,0);
+    }
+}

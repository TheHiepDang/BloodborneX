diff --git a/gpu/shadps4/video_core/renderer_vulkan/vk_local_light_push.h b/gpu/shadps4/video_core/renderer_vulkan/vk_local_light_push.h
new file mode 100644
--- /dev/null
+++ b/gpu/shadps4/video_core/renderer_vulkan/vk_local_light_push.h
@@ -0,0 +1,72 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+#include <array>
+#include <vector>
+#include <cstdint>
+
+namespace Vulkan::LocalLightPush {
+// Replace only constants inserted by our guarded light patches. Extend the existing
+// game push block at 128 without changing any of its original members/bindings.
+inline bool Convert(std::vector<uint32_t>& spv,std::array<uint32_t,4> ids) {
+    uint32_t push=0,ptr=0,block=0,f32=0,u32=0,vec4=0;
+    for(size_t i=5;i<spv.size();) {
+        const auto n=spv[i]>>16,op=spv[i]&65535;
+        if(!n || i+n>spv.size()) return false;
+        if(op==59 && n>=4 && spv[i+3]==9) { if(push) return false;push=spv[i+2];ptr=spv[i+1]; }
+        if(op==22 && n==3 && spv[i+2]==32) f32=spv[i+1];
+        if(op==21 && n==4 && spv[i+2]==32 && spv[i+3]==0) u32=spv[i+1];
+        i+=n;
+    }
+    if(!push || !f32 || !u32) return false;
+    for(size_t i=5;i<spv.size();i+=spv[i]>>16) {
+        const auto n=spv[i]>>16,op=spv[i]&65535;
+        if(op==32 && spv[i+1]==ptr && spv[i+2]==9) block=spv[i+3];
+        if(op==23 && n==4 && spv[i+2]==f32 && spv[i+3]==4) vec4=spv[i+1];
+    }
+    uint32_t members=0;
+    for(size_t i=5;i<spv.size();i+=spv[i]>>16)
+        if((spv[i]&65535)==30 && spv[i+1]==block) members=(spv[i]>>16)-2;
+    // The existing 128-byte native game block has thirteen members. Decline other ABIs.
+    if(!block || members!=13) return false;
+    uint32_t next=spv[3],pfloat=next++,member=next++;
+    std::array<uint32_t,4> component{}; for(auto& c:component)c=next++;
+    std::vector<uint32_t> globals,vector_type;
+    const auto emit=[&](std::vector<uint32_t>& into,uint32_t op,std::initializer_list<uint32_t> args) {
+        into.push_back((uint32_t(args.size()+1)<<16)|op);into.insert(into.end(),args);
+    };
+    if(!vec4) {vec4=next++;emit(vector_type,23,{vec4,f32,4});}
+    emit(globals,32,{pfloat,9,f32}); emit(globals,43,{u32,member,members});
+    for(uint32_t c=0;c<4;++c)emit(globals,43,{u32,component[c],c});
+    std::vector<uint32_t> result(spv.begin(),spv.begin()+5);
+    bool annotated=false,declared=false,loaded=false,in_function=false,entry=false;
+    size_t removed=0;
+    for(size_t i=5;i<spv.size();) {
+        const auto n=spv[i]>>16,op=spv[i]&65535;
+        if(!annotated && op>=19 && op<=39) {
+            emit(result,72,{block,members,35,128});annotated=true;
+        }
+        if(op==54 && !declared) {result.insert(result.end(),globals.begin(),globals.end());declared=true;in_function=true;}
+        if(op==248) entry=true;
+        if(in_function && entry && !loaded && op!=54 && op!=55 && op!=248 && op!=59 && op!=8 && op!=317) {
+            for(uint32_t c=0;c<4;++c)if(ids[c]) {
+                const auto address=next++;
+                emit(result,65,{pfloat,address,push,member,component[c]});
+                emit(result,61,{f32,ids[c],address});
+            }
+            loaded=true;
+        }
+        bool remove=false;
+        if(op==43 && n==4) for(auto id:ids)if(id && spv[i+2]==id)remove=true;
+        if(remove) ++removed;
+        else if(op==30 && spv[i+1]==block) {
+            result.insert(result.end(),vector_type.begin(),vector_type.end());
+            result.push_back(((n+1)<<16)|op);
+            result.insert(result.end(),spv.begin()+i+1,spv.begin()+i+n);result.push_back(vec4);
+        } else result.insert(result.end(),spv.begin()+i,spv.begin()+i+n);
+        i+=n;
+    }
+    size_t requested=0;for(auto id:ids) requested+=id!=0;
+    if(!loaded || !annotated || !declared || removed!=requested) return false;
+    result[3]=next;spv=std::move(result);return true;
+}
+} // namespace Vulkan::LocalLightPush

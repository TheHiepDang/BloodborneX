+// SPDX-License-Identifier: GPL-2.0-or-later
+#version 460
+#extension GL_EXT_scalar_block_layout : require
+#extension GL_GOOGLE_include_directive : require
+#include "nr_foveation.glsl"
+
+// Reduced model input, full-scene ratio reconstruction. Uses the RC1 composition's
+// RenoDX-derived (MIT) 75% luminance / 25% chroma ratio and original scene alpha.
+layout(local_size_x = 8, local_size_y = 8) in;
+layout(binding = 0) uniform sampler2D scene_image;
+layout(binding = 1) uniform sampler2D scene_depth;
+layout(binding = 2) uniform sampler2D scene_motion;
+layout(binding = 3) uniform sampler2D proxy_image;
+layout(binding = 4) uniform sampler2D model_image;
+layout(binding = 5, rgba16f) uniform writeonly image2D proxy_out;
+layout(binding = 6, r32f) uniform writeonly image2D depth_out;
+layout(binding = 7, rg16f) uniform writeonly image2D motion_out;
+layout(binding = 8, rgba16f) uniform writeonly image2D resolved_out;
+layout(push_constant, scalar) uniform Push {
+    uint mode, width, height, hdr;
+    float white_point, strength;
+    uint scene_width, scene_height;
+    uint composition;
+    uvec2 warp; vec2 center; uvec2 bounds; vec2 blend;
+} p;
+
+vec3 linear_to_srgb(vec3 x) {
+    return mix(12.92 * x, 1.055 * pow(max(x, 0.0), vec3(1.0 / 2.4)) - 0.055,
+               greaterThan(x, vec3(0.0031308)));
+}
+vec3 decode(vec3 x) {
+    if (p.hdr == 0) return x;
+    x = mix(x / 12.92, pow(max((x + 0.055) / 1.055, 0.0), vec3(2.4)),
+            greaterThan(x, vec3(0.04045)));
+    x = clamp(x, 0.0, 0.9995);
+    return x / max(1.0 - x, 1e-4) * p.white_point;
+}
+vec3 ratio_at(ivec2 q) {
+    q = clamp(q, ivec2(0), ivec2(p.width, p.height) - 1);
+    if (p.composition != 0u) return clamp(texelFetch(model_image, q, 0).rgb, vec3(-16), vec3(16));
+    vec3 base = max(decode(texelFetch(proxy_image, q, 0).rgb), 0.0);
+    vec3 model = max(decode(texelFetch(model_image, q, 0).rgb), 0.0);
+    float a = dot(base, vec3(0.2126, 0.7152, 0.0722));
+    float b = dot(model, vec3(0.2126, 0.7152, 0.0722));
+    return mix(vec3(clamp((b + 1e-4) / (a + 1e-4), 0.0, 2.0)),
+               clamp((model + 1e-4) / (base + 1e-4), 0.0, 2.0), 0.25);
+}
+
+void main() {
+    ivec2 q = ivec2(gl_GlobalInvocationID.xy);
+    ivec2 scene_size = ivec2(p.scene_width, p.scene_height);
+    if (p.mode == 0) {
+        if (any(greaterThanEqual(q, ivec2(p.width, p.height)))) return;
+        // Exact box footprint in scene pixels. Select depth and motion from the
+        // SAME nearest visible surface; never average motion across silhouettes.
+        vec2 scale = vec2(scene_size) / vec2(p.width, p.height);
+        vec2 lo = vec2(q) * scale, hi = vec2(q + 1) * scale;
+        FovWorkFootprint(uvec2(q), uvec2(p.width,p.height), uvec2(scene_size),
+                         p.warp, p.center, p.bounds, lo, hi);
+        vec4 color = vec4(0);
+        float weight = 0.0, nearest = 1e30;
+        vec2 motion = vec2(0);
+        for (int y = int(floor(lo.y)); y < int(ceil(hi.y)); ++y)
+        for (int x = int(floor(lo.x)); x < int(ceil(hi.x)); ++x) {
+            ivec2 s = clamp(ivec2(x, y), ivec2(0), scene_size - 1);
+            vec2 overlap = max(min(vec2(x + 1, y + 1), hi) - max(vec2(x, y), lo), 0.0);
+            float w = overlap.x * overlap.y;
+            color += texelFetch(scene_image, s, 0) * w;
+            weight += w;
+            float d = texelFetch(scene_depth, s, 0).r;
+            if (w > 0.0 && d < nearest) {
+                nearest = d;
+                motion = texelFetch(scene_motion, s, 0).xy;
+            }
+        }
+        color /= max(weight, 1e-8);
+        vec3 encoded = color.rgb;
+        if (p.hdr != 0) {
+            vec3 x = max(color.rgb / max(p.white_point, 1e-4), 0.0);
+            encoded = linear_to_srgb(x / (1.0 + x));
+        }
+        imageStore(proxy_out, q, vec4(encoded, color.a));
+        imageStore(depth_out, q, vec4(nearest));
+        // Previous-minus-current pixels now expressed in MODEL pixel units.
+        vec2 now = (vec2(q) + 0.5) / vec2(p.width,p.height);
+        vec2 n = FovUnwarp(now, p.warp, p.center, p.bounds);
+        vec2 previous = FovWarp(n + motion / vec2(scene_size), p.warp, p.center, p.bounds);
+        vec2 warped_motion = (previous - now) * vec2(p.width,p.height);
+        // Invalid motion must reject temporal reuse, never masquerade as static.
+        if (any(isnan(warped_motion)) || any(isinf(warped_motion))) warped_motion = vec2(65504);
+        imageStore(motion_out, q, vec4(clamp(warped_motion,vec2(-65504),vec2(65504)), 0, 0));
+        return;
+    }
+    if (any(greaterThanEqual(q, scene_size))) return;
+    vec4 scene = texelFetch(scene_image, q, 0);
+    vec2 n = (vec2(q) + 0.5) / vec2(scene_size);
+    float zone = FovZoneWeight(n, p.warp, p.bounds, p.blend);
+    if (zone <= 0.0) { imageStore(resolved_out,q,scene); return; }
+    vec2 at = FovFullToWorkPos(uvec2(q), uvec2(scene_size), uvec2(p.width,p.height),
+                                 p.warp,p.center,p.bounds);
+    ivec2 lo = ivec2(floor(at));
+    vec2 f = fract(at);
+    vec3 ratio = vec3(0);
+    float weight = 0.0, z = texelFetch(scene_depth, q, 0).r;
+    for (int y = 0; y < 2; ++y) for (int x = 0; x < 2; ++x) {
+        ivec2 s = clamp(lo + ivec2(x, y), ivec2(0), ivec2(p.width, p.height) - 1);
+        // Reuse binding 2 for the reduced R32F depth during reconstruction.
+        float d = texelFetch(scene_motion, s, 0).r;
+        float w = (x == 0 ? 1.0 - f.x : f.x) * (y == 0 ? 1.0 - f.y : f.y);
+        w /= 1.0 + abs(z - d) * 10000.0;
+        ratio += ratio_at(s) * w;
+        weight += w;
+    }
+    ratio /= max(weight, 1e-8);
+    vec3 result = mix(scene.rgb, max(scene.rgb, 0.0) * ratio, clamp(p.strength, 0.0, 1.0));
+    if (p.composition != 0u)
+        result = clamp(scene.rgb * exp2(ratio), vec3(-65504), vec3(65504));
+    imageStore(resolved_out, q, vec4(mix(scene.rgb,result,zone), scene.a));
+}

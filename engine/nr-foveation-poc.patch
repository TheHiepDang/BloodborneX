@@ -0,0 +1,72 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#include "../gpu/shadps4/video_core/renderer_vulkan/nr_foveation.h"
+#include "../gpu/shadps4/video_core/renderer_vulkan/nr_foveation_trial.h"
+#include <cassert>
+#include <cstdio>
+#include <limits>
+using namespace NrFoveation;
+double Inverse(double v,const Axis& a) {
+    double lo=-8,hi=8;
+    for(int i=0;i<70;++i) {double m=(lo+hi)*0.5;if(Warp(m,a)<v)lo=m;else hi=m;}
+    return (lo+hi)*0.5;
+}
+int main() {
+    for(const char* fault:{"create","evaluate"}) {
+        TrialState state(fault);
+        const auto selected=state.fault;
+        assert(!state.Inject(selected,false)); // A disabled/uniform path cannot be injected.
+        assert(state.Inject(selected,true));
+        assert(!state.Inject(selected,true)); // Exactly once, even before rejection is consumed.
+        state.Reject(17);
+        assert(state.Pending(16) && state.Pending(17) && !state.Pending(18));
+        assert(state.rejected && !state.Inject(selected,true));
+        for(unsigned tick=18;tick<1000;++tick) assert(!state.Pending(tick));
+        // A failed warped create leaves new images but the old successful
+        // uniform feature key. The fallback must inspect actual image sizes.
+        const ResourceShape old_feature{1280,720,1280,720,1};
+        ResourceShape images{840,473,1280,720,1};
+        assert(!(images==old_feature));
+        assert(!state.Pending(18));
+        images=old_feature; // after safe reallocation at the submitted boundary
+        assert(images==old_feature);
+    }
+    assert(TrialState("invalid").fault==TrialState::Fault::None);
+    std::printf("NR trial state: create/evaluate injection, disabled bypass, submission retirement and no retry loop PASS\n");
+    unsigned samples=0;
+    for(auto size : {std::pair{1920u,1080u},std::pair{1280u,720u},std::pair{3440u,1440u},std::pair{7680u,2160u}}) {
+        const auto off=MakeGrid(false,{},size.first,size.second);
+        assert(!off.active() && Warp(-0.25,off.x)==-0.25 && WarpedExtent(size.first,off.x)==size.first);
+        for(float edge:{0.25f,0.5f,1.0f}) for(float centre:{0.1f,0.5f,1.0f}) for(float pos:{0.0f,0.5f,1.0f}) {
+            Params p;p.edge=edge;p.center_w=p.center_h=centre;p.center_x=p.center_y=pos;
+            auto g=MakeGrid(true,p,size.first,size.second);
+            for(const Axis* a:{&g.x,&g.y}) {
+                double previous=-1e30;
+                for(int i=-100;i<=1100;++i) {
+                    double n=i/1000.0,v=Warp(n,*a);
+                    assert(std::isfinite(v) && v>previous);previous=v;
+                    assert(std::abs(Inverse(v,*a)-n)<1e-9);
+                    // Crossing the ramp and even offscreen motion must preserve its sign.
+                    for(double motion:{-0.3,0.0,0.2}) {
+                        const double d=Warp(n+motion,*a)-v;
+                        assert(motion==0?std::abs(d)<1e-12:d*motion>0);
+                    }
+                    ++samples;
+                }
+            }
+        }
+        const auto fixed=MakeGrid(true,{},size.first,size.second);
+        assert(fixed.active() && fixed.PixelFactor()<0.45);
+        const unsigned w=WarpedExtent(size.first,fixed.x),h=WarpedExtent(size.second,fixed.y);
+        printf("fixed grid %ux%u -> %ux%u, tensor area %.2f%% (forecast only)\n",size.first,size.second,w,h,100.0*w*h/size.first/size.second);
+        // Full centre density is retained relative to uniform model, to rounding.
+        const double derivative=(Warp(0.501,fixed.x)-Warp(0.499,fixed.x))/0.002;
+        assert(std::abs(derivative*w/size.first-1)<0.002);
+    }
+    Params p;p.center_w=p.center_h=1;p.contour_w=p.contour_h=0;
+    assert(!MakeGrid(true,p,1920,1080).active());
+    p={};p.center_w=p.center_h=0.99f;p.contour_w=p.contour_h=0.01f;p.edge=1;
+    Inactive why{};assert(!MakeGrid(true,p,1920,1080,&why).active());
+    p={};p.center_w=std::numeric_limits<float>::quiet_NaN();
+    assert(MakeGrid(true,p,1920,1080).active());
+    printf("NR foveation: %u coordinate samples; inverse, monotonicity, endpoint signs, centre density, identity/low-saving bypass PASS\n",samples);
+}

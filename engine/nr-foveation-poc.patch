diff --git a/gpu/shadps4/video_core/renderer_vulkan/nr_foveation_trial.h b/gpu/shadps4/video_core/renderer_vulkan/nr_foveation_trial.h
new file mode 100644
--- /dev/null
+++ b/gpu/shadps4/video_core/renderer_vulkan/nr_foveation_trial.h
@@ -0,0 +1,28 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+#include <cstdint>
+#include <string_view>
+namespace NrFoveation {
+struct ResourceShape {
+    std::uint32_t width{},height{},scene_width{},scene_height{};
+    int passes{};
+    bool operator==(const ResourceShape&) const = default;
+};
+// Developer-only rejection injection. It never injects into the uniform path.
+struct TrialState {
+    enum class Fault { None, Create, Evaluate };
+    Fault fault = Fault::None;
+    bool injected = false, rejected = false;
+    std::uint64_t retire_tick = 0;
+    explicit TrialState(const char* value = nullptr) {
+        if (value && std::string_view(value)=="create") fault=Fault::Create;
+        if (value && std::string_view(value)=="evaluate") fault=Fault::Evaluate;
+    }
+    bool Inject(Fault stage, bool foveated) {
+        if (!foveated || injected || rejected || fault!=stage || stage==Fault::None) return false;
+        injected=true;return true;
+    }
+    void Reject(std::uint64_t tick) { rejected=true;retire_tick=tick; }
+    bool Pending(std::uint64_t current_tick) const { return rejected && current_tick<=retire_tick; }
+};
+}
diff --git a/tests/test_link_closure.py b/tests/test_link_closure.py
new file mode 100644
--- /dev/null
+++ b/tests/test_link_closure.py
@@ -0,0 +1,29 @@
+"""Exercise the exported link line on a shared dependency DAG, aliases and LINK_ONLY."""
+from pathlib import Path
+import os,subprocess,tempfile
+engine=Path(__file__).resolve().parents[1]
+with tempfile.TemporaryDirectory(prefix='link-closure-',dir=os.environ.get('TEMP')) as tmp:
+    root=Path(tmp);source=root/'source';build=root/'build';source.mkdir()
+    lines=['cmake_minimum_required(VERSION 3.24)','project(link_closure C CXX)',
+           f'include("{(engine/"gpu/cmake/LinkClosure.cmake").as_posix()}")']
+    for i in range(14):
+        code=f'int f{i}(void){{return 1;}}' if i<2 else f'int f{i-1}(void);int f{i-2}(void);int f{i}(void){{return f{i-1}()+f{i-2}();}}'
+        (source/f'n{i}.c').write_text(code)
+        lines.append(f'add_library(n{i} STATIC n{i}.c)')
+        if i>=2:lines.append(f'target_link_libraries(n{i} PUBLIC n{i-1} "$<LINK_ONLY:n{i-2}>")')
+    lines+=['add_library(top ALIAS n13)','target_link_options(n13 INTERFACE -mwindows)',
+            'bb_write_link_closure(top "${CMAKE_BINARY_DIR}/closure.txt")']
+    (source/'CMakeLists.txt').write_text('\n'.join(lines))
+    subprocess.run(['cmake','-G','Ninja','-S',str(source),'-B',str(build),'-DCMAKE_C_COMPILER=clang','-DCMAKE_CXX_COMPILER=clang++'],check=True,timeout=30)
+    subprocess.run(['cmake','--build',str(build),'--parallel','4'],check=True,timeout=60)
+    items=(build/'closure.txt').read_text().splitlines()
+    libs=[x for x in items if x.endswith('.a')]
+    assert len(libs)==14 and len(set(libs))==14,items
+    indices={int(Path(x).stem.removeprefix('libn')):items.index(x) for x in libs}
+    for i in range(2,14):assert indices[i]<indices[i-1] and indices[i]<indices[i-2],items
+    assert '-mwindows' not in items
+    (source/'main.c').write_text('int f13(void);int main(void){return f13()==377?0:1;}')
+    exe=build/'linked.exe'
+    subprocess.run(['clang',str(source/'main.c'),*items,'-o',str(exe)],check=True,timeout=30)
+    subprocess.run([str(exe)],check=True,timeout=10)
+    print('PASS: 14-node shared DAG, alias/LINK_ONLY, dependency ordering, unique libraries and actual external link/execution')

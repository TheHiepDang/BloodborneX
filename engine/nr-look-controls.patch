+vec3 decode(vec3 x) {
+    x=finite_rgb(x);
+    if(p.hdr==0) return x;
+    x=mix(x/12.92,pow(max((x+0.055)/1.055,0.0),vec3(2.4)),greaterThan(x,vec3(0.04045)));
+    x=clamp(x,0.0,0.9995);
+    return x/max(1.0-x,1e-4)*p.white;

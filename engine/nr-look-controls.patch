diff --git a/tests/test_preset_ui.cpp b/tests/test_preset_ui.cpp
new file mode 100644
--- /dev/null
+++ b/tests/test_preset_ui.cpp
@@ -0,0 +1,132 @@
+// Headless interaction checks for the shipped preset editor and selection decorators.
+#include <cassert>
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <map>
+#include <set>
+#include <vector>
+#include <string>
+#include <optional>
+#include <memory>
+#include <filesystem>
+#include <algorithm>
+#include <fstream>
+#include <chrono>
+#include "imgui.h"
+#include "imgui_internal.h"
+#include "gpu/shim/bbport_settings.h"
+#define BB_PRESET_UI_TEST
+std::map<std::string,ImVec4> preset_test_hit_rects;
+float base_scale=1.0f;
+std::string search_query, preset_ui_message;
+const char* tab_title=""; const char* section_title=nullptr;
+std::optional<BbSettings::PresetDocument> custom_apply_request;
+bool custom_import_request=false;
+enum {TabUpscaling,TabNeuralRendering,TabDisplay,TabPicture,TabGameplay,TabInterface,TabSpecPreset};
+const char* TabTitle(int group) {static const char* titles[]={"Upscaling","NR","Display","Picture","Gameplay","Interface"};return titles[group];}
+void Section(const char*) {} bool Shown(const char*) {return true;}
+#include "gpu/shim/bbport_preset_reference.inc"
+ImVec2 sharpness_position;
+void DrawTab(int group) {
+    if(group!=0) return;
+    BeginPresetReferenceRow("Sharpness");
+    sharpness_position=ImGui::GetCursorScreenPos();
+    float value=BbSettings::Get().sharpness;
+    if(ImGui::SliderFloat("Sharpness",&value,0,2)) BbSettings::Get().sharpness=value;
+    BeginPresetReferenceRow("Sub-pixel jitter");
+    bool flag=BbSettings::Get().jitter;
+    if(ImGui::Checkbox("Sub-pixel jitter",&flag)) BbSettings::Get().jitter=flag;
+}
+#include "gpu/shim/bbport_custom_presets_ui.inc"
+unsigned char* atlas=nullptr; int atlas_w=0,atlas_h=0;
+void Screenshot(const char* path) {
+    constexpr int width=1000,height=950;
+    std::vector<unsigned char> pixels(width*height*4,24);
+    const auto* data=ImGui::GetDrawData();
+    for(const auto* list:data->CmdLists) for(const auto& cmd:list->CmdBuffer) {
+        if(cmd.UserCallback) continue;
+        for(unsigned i=0;i<cmd.ElemCount;i+=3) {
+            const auto& a=list->VtxBuffer[list->IdxBuffer[cmd.IdxOffset+i]+cmd.VtxOffset];
+            const auto& b=list->VtxBuffer[list->IdxBuffer[cmd.IdxOffset+i+1]+cmd.VtxOffset];
+            const auto& c=list->VtxBuffer[list->IdxBuffer[cmd.IdxOffset+i+2]+cmd.VtxOffset];
+            const float denominator=(b.pos.y-c.pos.y)*(a.pos.x-c.pos.x)+(c.pos.x-b.pos.x)*(a.pos.y-c.pos.y);
+            if(std::abs(denominator)<0.001f) continue;
+            const int x0=std::max({0,int(std::floor(std::min({a.pos.x,b.pos.x,c.pos.x}))),int(cmd.ClipRect.x)});
+            const int x1=std::min({width,int(std::ceil(std::max({a.pos.x,b.pos.x,c.pos.x}))),int(cmd.ClipRect.z)});
+            const int y0=std::max({0,int(std::floor(std::min({a.pos.y,b.pos.y,c.pos.y}))),int(cmd.ClipRect.y)});
+            const int y1=std::min({height,int(std::ceil(std::max({a.pos.y,b.pos.y,c.pos.y}))),int(cmd.ClipRect.w)});
+            for(int y=y0;y<y1;++y) for(int x=x0;x<x1;++x) {
+                const float u=((b.pos.y-c.pos.y)*(x+0.5f-c.pos.x)+(c.pos.x-b.pos.x)*(y+0.5f-c.pos.y))/denominator;
+                const float v=((c.pos.y-a.pos.y)*(x+0.5f-c.pos.x)+(a.pos.x-c.pos.x)*(y+0.5f-c.pos.y))/denominator;
+                const float w=1-u-v;
+                if(u<0 || v<0 || w<0) continue;
+                const int tx=std::clamp(int((a.uv.x*u+b.uv.x*v+c.uv.x*w)*atlas_w),0,atlas_w-1);
+                const int ty=std::clamp(int((a.uv.y*u+b.uv.y*v+c.uv.y*w)*atlas_h),0,atlas_h-1);
+                const float alpha=(((a.col>>24)&255)*u+((b.col>>24)&255)*v+((c.col>>24)&255)*w)/255.0f*atlas[(ty*atlas_w+tx)*4+3]/255.0f;
+                for(int channel=0;channel<3;++channel) {
+                    const float col=((a.col>>(channel*8))&255)*u+((b.col>>(channel*8))&255)*v+((c.col>>(channel*8))&255)*w;
+                    auto& dest=pixels[(y*width+x)*4+(2-channel)];dest=static_cast<unsigned char>(col*alpha+dest*(1-alpha));
+                }
+                pixels[(y*width+x)*4+3]=255;
+            }
+        }
+    }
+    std::ofstream file(path,std::ios::binary);
+    const auto byte=[&](unsigned value,int count){for(int i=0;i<count;++i)file.put(char(value>>(8*i)));};
+    file.write("BM",2);byte(54+pixels.size(),4);byte(0,4);byte(54,4);byte(40,4);byte(width,4);byte(unsigned(-height),4);byte(1,2);byte(32,2);byte(0,4);byte(pixels.size(),4);byte(0,4);byte(0,4);byte(0,4);byte(0,4);
+    file.write(reinterpret_cast<const char*>(pixels.data()),pixels.size());
+}
+void Frame() {
+    ImGui::NewFrame();
+    ImGui::SetNextWindowSize(ImVec2(950,900)); ImGui::Begin("Test host");
+    CustomPresetDialogs(); ImGui::End(); ImGui::Render();
+}
+int main(int argc,char** argv) {
+    const auto temporary=std::filesystem::temp_directory_path()/("preset-ui-test-"+std::to_string(std::chrono::steady_clock::now().time_since_epoch().count()));
+    std::filesystem::create_directories(temporary);
+    const auto config=(temporary/"lantern.ini").string();
+#ifdef _WIN32
+    _putenv_s("BB_CONFIG",config.c_str());
+#else
+    setenv("BB_CONFIG",config.c_str(),1);
+#endif
+    ImGui::CreateContext();auto& io=ImGui::GetIO();io.IniFilename=nullptr;io.DisplaySize=ImVec2(1000,950);io.DeltaTime=1.0f/60;
+    io.Fonts->GetTexDataAsRGBA32(&atlas,&atlas_w,&atlas_h);
+    BbSettings::Get().sharpness=1.41f; BbSettings::Get().jitter=true;
+    custom_editor_request=1;Frame();Frame();
+    for (const auto& binding:preset_row_bindings) assert(preset_included.contains(binding.key));
+    assert(preset_included["sharpness"] && !preset_included["cheat_stamina"] && !preset_included["skip_intro"]);
+    const ImVec2 click(sharpness_position.x+30,sharpness_position.y+10);
+    io.AddMousePosEvent(click.x,click.y);Frame();
+    io.AddMouseButtonEvent(0,true);Frame();io.AddMouseButtonEvent(0,false);Frame();
+    assert(!preset_included["sharpness"]);
+    assert(BbSettings::Get().sharpness==1.41f && preset_reference_values->sharpness==1.41f);
+    assert(SelectedPresetDocument().settings.size()<preset_reference_snapshot.size());
+    if(argc>1) Screenshot(argv[1]);
+    const auto fallback=preset_test_hit_rects.at("upscaler");
+    io.AddMousePosEvent(fallback.x+25,fallback.y+5);Frame();
+    io.AddMouseButtonEvent(0,true);Frame();io.AddMouseButtonEvent(0,false);Frame();
+    assert(!preset_included["upscaler"]);
+    io.AddMouseButtonEvent(0,true);Frame();io.AddMouseButtonEvent(0,false);Frame();
+    assert(preset_included["upscaler"]);
+    auto* context=ImGui::GetCurrentContext();ImGuiWindow* child=nullptr;
+    for(auto* window:context->Windows) if(std::strstr(window->Name,"##reference_settings")) child=window;
+    assert(child && child->ScrollMax.y>0);
+    // Mixed group -> include all; included group -> exclude all, without closing the modal.
+    io.AddMousePosEvent(child->Pos.x+25,child->Pos.y+8); Frame();
+    io.AddMouseButtonEvent(0,true);Frame();io.AddMouseButtonEvent(0,false);Frame();
+    for(const auto& [key,included]:preset_included) if(BbSettings::PresetGroup(key)==0) assert(included);
+    io.AddMouseButtonEvent(0,true);Frame();io.AddMouseButtonEvent(0,false);Frame();
+    for(const auto& [key,included]:preset_included) if(BbSettings::PresetGroup(key)==0) assert(!included);
+    assert(!context->OpenPopupStack.empty());
+    const float header_y=child->ParentWindow->Pos.y;
+    io.AddMousePosEvent(child->Pos.x+child->Size.x/2,child->Pos.y+child->Size.y/2);
+    io.AddMouseWheelEvent(0,-12);Frame();Frame();
+    assert(child->Scroll.y>0 && child->ParentWindow->Scroll.y==0 && child->ParentWindow->Pos.y==header_y);
+    assert(BbSettings::Get().sharpness==1.41f && BbSettings::Get().jitter);
+    ImGui::DestroyContext();
+    std::filesystem::remove_all(temporary);
+    std::puts("PASS: preset reference UI: exclusion click, fallback-row toggle, whole-group toggle, snapshot isolation, graphical defaults and fixed header while scrolling");
+}

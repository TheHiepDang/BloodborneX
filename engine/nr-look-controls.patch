@@ -0,0 +1,24 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Owned synthetic NGX fixture. No NVIDIA code, weights, Vulkan calls or GPU execution.
+#define WIN32_LEAN_AND_MEAN
+#include <windows.h>
+#include "nr_extra_style.h"
+namespace {
+HMODULE self;
+unsigned initializations;
+float Weight() {
+    auto resource=FindResourceW(self,L"WEIGHTS_HT",MAKEINTRESOURCEW(10));
+    auto* data=static_cast<const unsigned char*>(LockResource(LoadResource(self,resource)));
+    std::uint16_t value; std::memcpy(&value,data+NrExtraStyle::First,2);
+    return NrExtraStyle::Decode(value);
+}
+}
+BOOL WINAPI DllMain(HINSTANCE module,DWORD reason,LPVOID) { if(reason==DLL_PROCESS_ATTACH) self=module; return TRUE; }
+extern "C" {
+__declspec(dllexport) int NVSDK_NGX_VULKAN_Init_Ext(unsigned long long,const wchar_t*,void*,void*,void*,const void*,int) { ++initializations; return 1; }
+__declspec(dllexport) int NVSDK_NGX_VULKAN_CreateFeature(void*,int,const void*,void** feature) { *feature=new float(Weight()); return 1; }
+__declspec(dllexport) int NVSDK_NGX_VULKAN_EvaluateFeature(void*,const void* feature,const void*,void*) { return *static_cast<const float*>(feature)==Weight()?1:-1; }
+__declspec(dllexport) int NVSDK_NGX_VULKAN_ReleaseFeature(void* feature) { delete static_cast<float*>(feature); return 1; }
+__declspec(dllexport) float test_weight() { return Weight(); }
+__declspec(dllexport) unsigned test_initializations() { return initializations; }
+}
diff --git a/tests/test_nr_style_forwarder.cpp b/tests/test_nr_style_forwarder.cpp
new file mode 100644
--- /dev/null
+++ b/tests/test_nr_style_forwarder.cpp
@@ -0,0 +1,57 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Run the real forwarder through live reconfiguration against the owned fake NGX fixture.
+#define WIN32_LEAN_AND_MEAN
+#include <windows.h>
+#include <array>
+#include <cassert>
+#include <cmath>
+#include <cstdio>
+#include <limits>
+#include <string>
+struct Parameters { void** table; unsigned preset; };
+void PutP(void*,const char*,unsigned long long) {}
+void PutU(void* p,const char* name,unsigned value) {
+    if(std::string(name)=="DLSSNR.Hint.Render.Preset") static_cast<Parameters*>(p)->preset=value;
+}
+void PutF(void*,const char*,float) {}
+int main(int argc,char** argv) {
+    assert(argc==3);
+    auto forwarder=LoadLibraryA(argv[1]); assert(forwarder);
+    auto symbol=[&](const char* name) { auto address=GetProcAddress(forwarder,name); assert(address); return address; };
+    auto probe=reinterpret_cast<int(*)(const wchar_t*)>(symbol("dlssnr_vk_probe"));
+    auto init=reinterpret_cast<int(*)(const wchar_t*,const wchar_t*,void*,void*,void*,int)>(symbol("dlssnr_vk_init"));
+    auto style=reinterpret_cast<int(*)(float)>(symbol("dlssnr_vk_extra_style"));
+    auto create=reinterpret_cast<void*(*)(void*,void*,unsigned,unsigned,int,float,int,float,float,float,int,int)>(symbol("dlssnr_vk_create"));
+    auto evaluate=reinterpret_cast<int(*)(void*,void*,void*,void*,void*,void*,void*,unsigned,unsigned,unsigned,unsigned,int,int,float,int,float,float,float,int,float,float)>(symbol("dlssnr_vk_evaluate"));
+    auto release=reinterpret_cast<void(*)(void*)>(symbol("dlssnr_vk_release"));
+    const int size=MultiByteToWideChar(CP_ACP,0,argv[2],-1,nullptr,0); std::wstring path(size,L'\0');
+    MultiByteToWideChar(CP_ACP,0,argv[2],-1,path.data(),size);
+    assert(probe(path.c_str())==15);
+    auto module=GetModuleHandleW(path.c_str()); assert(module);
+    auto weight=reinterpret_cast<float(*)()>(GetProcAddress(module,"test_weight"));
+    auto initializations=reinterpret_cast<unsigned(*)()>(GetProcAddress(module,"test_initializations"));
+    assert(weight && initializations && style(0)==1);
+    assert(init(path.c_str(),L".",nullptr,nullptr,nullptr,0x15)==1);
+    std::array<void*,15> table{}; table[0]=reinterpret_cast<void*>(&PutP); table[4]=reinterpret_cast<void*>(&PutU); table[6]=reinterpret_cast<void*>(&PutF);
+    Parameters parameters{table.data(),0};
+    for(float offset : {0.0f,64.0f,-64.0f,16.0f,0.0f,64.0f,0.0f}) {
+        assert(style(offset)==1); // This happens AFTER initialization in the same process.
+        assert(std::abs(weight()-(0.25f+offset/256.0f))<0.001f);
+        assert(style(std::numeric_limits<float>::quiet_NaN())==-1);
+        assert(std::abs(weight()-(0.25f+offset/256.0f))<0.001f); // invalid request leaves weights intact
+        std::array<void*,3> features{};
+        for(auto& feature:features) {
+            feature=create(reinterpret_cast<void*>(1),&parameters,64,32,3,1,0,1,1,-1,1,0);
+            assert(feature && parameters.preset==(offset==0?3u:1u));
+        }
+        assert(style(offset==0?64:0)==-2); // cannot edit while ANY feature exists
+        for(auto feature:features) {
+            assert(evaluate(reinterpret_cast<void*>(1),feature,&parameters,nullptr,nullptr,nullptr,nullptr,64,32,64,32,0,1,1,0,1,1,-1,1,1,1)==1);
+            release(feature);
+        }
+        assert(initializations()==1); // no NGX reinit and no game restart
+    }
+    assert(style(0)==1 && weight()==0.25f);
+    std::puts("PASS: real forwarder live 0/+64/-64/+16/0, 3-pass lifecycle gate, Old preset, invalid request, baseline restore; one NGX initialization");
+    FreeLibrary(forwarder);
+}

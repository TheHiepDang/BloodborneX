+    float white, strength, brighten, darken, colour, hue, shadows, midtones, highlights;
+    float max_brighten, max_darken, max_colour, black_gate;
+    float tone, detail, radius, halo, dark_halo, history_alpha;
+    uint stabilize, stabilize_detail, detail_stability, look;

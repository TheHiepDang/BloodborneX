+    bytes[59]=2; assert(!MakePlan(bytes,1,plan)); bytes=untouched;
+    assert(!MakePlan(std::span(bytes).first(100),1,plan));
+    auto nan=Encode(std::numeric_limits<float>::quiet_NaN());
+    std::memcpy(bytes.data()+First+2,&nan,2); assert(!MakePlan(bytes,1,plan));
+    bytes=untouched;

+    assert(MakePlan(bytes,1024,plan) && Decode(plan[0].replacement)==65504);
+    std::puts("PASS: extra style zero/sign/scale/clamp, immutable planning, invalid layout/nonfinite rejection");
+#ifdef _WIN32
+    if (argc>1) {
+        // Map for resource access only: no model entry point, imports, NGX or GPU execution.
+        const HMODULE module=LoadLibraryExA(argv[1],nullptr,DONT_RESOLVE_DLL_REFERENCES);
+        assert(module);
+        const auto resource=FindResourceW(module,L"WEIGHTS_HT",MAKEINTRESOURCEW(10)); assert(resource);
+        const auto count=SizeofResource(module,resource);
+        auto* data=static_cast<std::uint8_t*>(LockResource(LoadResource(module,resource))); assert(data);
+        const std::vector<std::uint8_t> original(data,data+count);
+        Session session;
+        assert(session.Apply(module,64) && session.Active());
+        Plan expected; assert(MakePlan(original,64,expected));
+        std::size_t changed=0;
+        for (const auto& p:expected) {
+            std::uint16_t value; std::memcpy(&value,data+p.offset,2);
+            assert(value==p.replacement); changed+=value!=p.original;
+        }
+        assert(changed>0 && !session.Apply(module,-64)); // concurrent/double application rejected
+        assert(session.Restore() && !session.Active());
+        assert(std::memcmp(original.data(),data,count)==0); // entire resource restored
+        assert(session.Restore());
+        for (float value : {-64.0f, 16.0f, 64.0f, -16.0f}) {
+            assert(session.Apply(module,value));
+            Plan result; assert(MakePlan(original,value,result));
+            for (const auto& p:result) { std::uint16_t actual; std::memcpy(&actual,data+p.offset,2); assert(actual==p.replacement); }
+            assert(session.Restore() && std::memcmp(original.data(),data,count)==0);
+        }
+        FreeLibrary(module);
+        std::printf("PASS: custom runtime resource layout, %zu changed coefficients, entire resource restored; no DLL code/GPU executed\n",changed);
+    }
+#else
+    (void)argc; (void)argv;
+#endif
+}

+            float sl=dot(base_at(s),Y);
+            float dz=abs(z-sz);
+            float w=exp(-abs(log2((sl+0.001)/(luma+0.001))))/(1.0+dz*10000.0);
+            vec3 e=edit_at(s);
+            broad+=w*e; weights+=w;
+            // Do not propagate edits or extrema across silhouettes.
+            if(dz<0.0002) { low=min(low,e); high=max(high,e); }
+        }
+        broad/=max(weights,1e-8);
+    }
+    vec3 e=raw, current_detail=vec3(0);
+    if(p.look!=0) {
+        // Separate neural edits by scale; the untouched scene is never blurred.
+        e=broad*p.tone+(raw-broad)*p.detail;
+        e=mix(e,clamp(e,low,high),p.halo);
+        float dark_edge=0.0;
+        for(int y=-1;y<=1;++y) for(int x=-1;x<=1;++x) {
+            float sl=dot(base_at(q+ivec2(x,y)),Y);
+            edge=max(edge,abs(sl-luma)/(luma+0.01));
+            dark_edge=max(dark_edge,max(luma-sl,0.0)/(luma+0.01));
+        }
+        e=mix(e,broad,clamp(p.dark_halo*dark_edge,0.0,1.0));
+        // Restrict *amplified* fine edits near strong source edges.
+        if(p.detail_stability==2 || (p.detail_stability==0 && p.detail>1.0))
+            e=mix(e,broad+(raw-broad)*min(p.detail,1.0),clamp(edge,0.0,1.0));
+        vec3 shaped_broad=shape_edit(broad*p.tone,base);
+        e=shape_edit(e,base);
+        if(p.stabilize_detail==0) current_detail=e-shaped_broad;
+    }
+    // Store and reproject edits, not scene colours. History holds depth in full precision.
+    if(p.look!=0 && p.stabilize!=0 && p.reset==0 && p.history_alpha>0.0) {
+        vec2 mv=texelFetch(motion_image,q,0).xy;
+        vec2 at=vec2(q)+mv; // previous-minus-current, MODEL pixel units
+        bool valid=!any(isnan(mv)) && !any(isinf(mv)) &&
+                   all(greaterThanEqual(at,vec2(0))) && all(lessThan(at,vec2(p.width,p.height)));
+        if(p.stabilize==1 && length(mv)>0.25) valid=false;
+        if(valid) {
+            vec4 h=texelFetch(history_image,bounded(ivec2(floor(at+0.5))),0);
+            if(abs(h.a-z)<=max(0.00002,abs(z)*0.001) && !any(isnan(h)) && !any(isinf(h))) {
+                // Restrict historical edits to a neighbourhood of the current answer.
+                vec3 lo=e,hi=e;
+                for(int y=-1;y<=1;++y) for(int x=-1;x<=1;++x) {
+                    vec3 delta=(edit_at(q+ivec2(x,y))-raw)*min(p.strength,1.0);
+                    lo=min(lo,e+delta); hi=max(hi,e+delta);
+                }
+                e=mix(e-current_detail,clamp(h.rgb,lo-current_detail-0.05,hi-current_detail+0.05),p.history_alpha)+current_detail;
+            }
+        }
+    }
+    imageStore(history_out,q,vec4(e-current_detail,z));
+    if(p.look!=0) {
+        float lum=dot(e,Y);
+        vec3 chroma=clamp(e-vec3(lum),-p.max_colour,p.max_colour);
+        e=vec3(clamp(lum,-p.max_darken,p.max_brighten))+chroma;
+        if(p.black_gate>0.0) e*=smoothstep(0.0,p.black_gate,luma);
+    } else {
+        // Neutral transfer retains a bounded log reconstruction when look is disabled.
+        float lum=dot(e,Y);
+        e=vec3(clamp(lum,-2.0,2.0))+clamp(e-vec3(lum),vec3(-2),vec3(2));
+    }
+    imageStore(edits_out,q,vec4(clamp(e,vec3(-16),vec3(16)),0));
+}

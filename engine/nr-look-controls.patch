+++ b/tests/run_nr_style_forwarder_test.py
@@ -0,0 +1,38 @@
+"""Build and run an owned, synthetic NGX fixture; no NVIDIA model or GPU needed."""
+from pathlib import Path
+import argparse
+import struct
+import subprocess
+
+parser = argparse.ArgumentParser()
+parser.add_argument('--forwarder', type=Path, required=True)
+parser.add_argument('--output', type=Path, required=True)
+parser.add_argument('--toolchain', type=Path, default=Path('C:/msys64/clang64/bin'))
+args = parser.parse_args()
+engine = Path(__file__).resolve().parents[1]
+output = args.output.resolve()
+output.mkdir(parents=True, exist_ok=True)
+weights = bytearray(50000)
+struct.pack_into('<QQ', weights, 0, len(weights), 19)
+weights[16:35] = b'block0.layer0.layer'
+struct.pack_into('<QQQI', weights, 35, 21736, 21736, 21696, 1)
+offsets = [8289,8353,8417,8481,8545,8609,8673,8737,8297,8361,8425,8489,8553,8617,8681,8745,
+           8801,8865,8929,8993,9057,9121,9185,9249,8809,8873,8937,9001,9065,9129,9193,9257]
+for offset in offsets:
+    struct.pack_into('<ee', weights, offset, .25, .5)
+resource = output / 'synthetic-weights.bin'
+resource.write_bytes(weights)
+rc = output / 'synthetic-weights.rc'
+rc.write_text(f'WEIGHTS_HT RCDATA "{resource.as_posix()}"\n')
+res = output / 'synthetic-weights.res'
+subprocess.run([str(args.toolchain/'llvm-rc.exe'), '/fo', str(res), str(rc)], check=True)
+model = output / 'owned-fake-nr-runtime.dll'
+exe = output / 'nr-style-forwarder-test.exe'
+for source, target, extra in [
+    ('nr_style_fake_runtime.cpp', model, ['-shared', str(res)]),
+    ('test_nr_style_forwarder.cpp', exe, [])
+]:
+    subprocess.run([str(args.toolchain/'clang++.exe'), '-std=c++23', '-O1',
+                    '-I', str(engine/'gpu'), str(engine/'tests'/source), *extra,
+                    '-o', str(target)], check=True)
+subprocess.run([str(exe), str(args.forwarder.resolve()), str(model)], check=True)

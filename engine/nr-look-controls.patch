diff --git a/gpu/shim/bbport_custom_presets.h b/gpu/shim/bbport_custom_presets.h
new file mode 100644
--- /dev/null
+++ b/gpu/shim/bbport_custom_presets.h
@@ -0,0 +1,29 @@
+#pragma once
+#include <string>
+#include <string_view>
+#include <vector>
+#include <utility>
+#include <filesystem>
+
+namespace BbSettings {
+struct Values;
+using SettingList = std::vector<std::pair<std::string, std::string>>;
+struct PresetDocument { std::string name; SettingList settings; };
+struct SavedPreset { std::filesystem::path path; PresetDocument document; };
+SettingList SnapshotSettings(const Values& values);
+void PopulateSettingsView(Values& values, const SettingList& settings);
+// Thread-local view used only by the read-only overlay clone; renderer threads stay on live values.
+Values* ExchangeSettingsView(Values* view);
+bool DefaultPresetGraphic(const std::string& key);
+int PresetGroup(const std::string& key);
+bool DecodePreset(const std::string& text, PresetDocument& document, std::string& error);
+std::string EncodePreset(const PresetDocument& document);
+bool ApplyPreset(const PresetDocument& document, std::string& error);
+std::filesystem::path PresetPath(std::string_view utf8);
+std::filesystem::path CustomPresetDirectory();
+std::vector<SavedPreset> ListCustomPresets(std::string& error);
+bool WritePreset(const std::filesystem::path& path, const PresetDocument& document, bool overwrite, std::string& error);
+bool ReadPreset(const std::filesystem::path& path, PresetDocument& document, std::string& error);
+bool SaveCustomPreset(const PresetDocument& document, std::string& error);
+bool DeleteCustomPreset(const std::filesystem::path& path, std::string& error);
+}
diff --git a/gpu/shim/bbport_custom_presets.inc b/gpu/shim/bbport_custom_presets.inc
new file mode 100644
--- /dev/null
+++ b/gpu/shim/bbport_custom_presets.inc
@@ -0,0 +1,142 @@
+// Included inside BbSettings after SnapshotSettings, sharing the settings decoder.
+void PopulateSettingsView(Values& values, const SettingList& settings) {
+    for (const auto& [key, value] : settings) Set(values, key, value);
+}
+int PresetGroup(const std::string& key) {
+    if (key.starts_with("dlss_nr")) return 1;
+    if (key == "output_res" || key == "fullscreen" || key.starts_with("hdr") || key == "live_resolution") return 2;
+    if (key.starts_with("graphics_") || key.starts_with("effect_") || key == "model_lod" || key == "skip_intro" || key.starts_with("debug_")) return 3;
+    if (key.starts_with("camera_") || key.starts_with("cheat_") || key == "change_appearance" || key == "rebirth") return 4;
+    if (key.starts_with("fps_") || key.starts_with("show_fps") || key == "hide_cursor" || key == "menu_language" || key == "menu_pos" || key.starts_with("mouse_") || key == "pc_controls" || key == "menu_move" || key == "button_prompts" || key == "pad_icons") return 5;
+    return 0;
+}
+bool DefaultPresetGraphic(const std::string& key) {
+    return PresetGroup(key) < 4 && key != "skip_intro" && !key.starts_with("debug_");
+}
+namespace {
+bool ValidPresetName(const std::string& name) {
+    return !name.empty() && name.size() <= 128 && std::any_of(name.begin(), name.end(), [](unsigned char c) {return c > 32;}) &&
+        std::none_of(name.begin(), name.end(), [](unsigned char c) {return c < 32 || c == 127;});
+}
+bool Numeric(const std::string& text) {
+    if (text.empty()) return false;
+    char* end = nullptr;
+    const double value = std::strtod(text.c_str(), &end);
+    return end == text.c_str() + text.size() && std::isfinite(value);
+}
+bool ValidatePreset(PresetDocument& doc, std::string& error) {
+    if (!ValidPresetName(doc.name)) { error = "Enter a preset name (1-128 bytes, no control characters)."; return false; }
+    if (doc.settings.empty() || doc.settings.size() > 256) { error = "Select at least one setting (maximum 256)."; return false; }
+    Values scratch;
+    const auto schema = SnapshotSettings(scratch);
+    std::set<std::string> seen;
+    for (auto& [key, value] : doc.settings) {
+        const auto known = std::find_if(schema.begin(), schema.end(), [&](const auto& entry) { return entry.first == key; });
+        if (known == schema.end() || !seen.insert(key).second || value.empty() || value.size() > 128 || value.find_first_of("\r\n\0", 0, 3) != std::string::npos) {
+            error = "Unsupported, duplicate or invalid preset setting: " + key; return false;
+        }
+        if (key == "output_res") {
+            int w=0,h=0; char tail=0;
+            if (value != "auto" && (std::sscanf(value.c_str(), "%dx%d%c", &w, &h, &tail) != 2 || !ValidOutputSize(w,h))) { error="Invalid output resolution."; return false; }
+        } else if (Numeric(known->second)) {
+            const bool word = ((key == "live_resolution" || key == "optiscaler_sync_submit") && value == "auto") ||
+                (key.starts_with("cheat_") && (value == "off" || value == "infinite"));
+            if (!Numeric(value) && !word) { error = "Invalid numeric setting: " + key; return false; }
+        }
+        Set(scratch, key, value);
+        const auto canonical = SnapshotSettings(scratch);
+        const auto normalized = std::find_if(canonical.begin(), canonical.end(), [&](const auto& e) {return e.first == key;});
+        if (normalized == canonical.end()) { error = "Unsupported setting: " + key; return false; }
+        if (Numeric(value) && Numeric(normalized->second)) {
+            if (std::abs(std::stod(value)-std::stod(normalized->second)) > 0.0051) { error="Out-of-range setting: " + key; return false; }
+        } else if (value != normalized->second) { error = "Invalid choice for " + key; return false; }
+        value = normalized->second;
+    }
+    return true;
+}
+}
+std::string EncodePreset(const PresetDocument& doc) {
+    std::string out = "# BloodborneX preset v1\nname=" + doc.name + "\n[settings]\n";
+    for (const auto& [key,value] : doc.settings) out += key + "=" + value + "\n";
+    return out;
+}
+bool DecodePreset(const std::string& text, PresetDocument& document, std::string& error) {
+    error.clear();
+    if (text.size() > 65536 || text.find('\0') != std::string::npos) { error="Preset is too large or contains invalid bytes."; return false; }
+    std::istringstream input(text); std::string line;
+    auto next = [&] { if (!std::getline(input,line)) return false; if (!line.empty() && line.back()=='\r') line.pop_back(); return true; };
+    if (!next() || line != "# BloodborneX preset v1") { error="Unsupported preset format or version."; return false; }
+    if (!next() || !line.starts_with("name=")) { error="Missing preset name."; return false; }
+    PresetDocument result; result.name=line.substr(5);
+    if (!next() || line != "[settings]") { error="Missing settings section."; return false; }
+    while (next()) {
+        if (line.empty()) continue;
+        const auto equal=line.find('=');
+        if (equal==std::string::npos) { error="Malformed preset setting."; return false; }
+        result.settings.emplace_back(line.substr(0,equal),line.substr(equal+1));
+    }
+    if (!ValidatePreset(result,error)) return false;
+    document=std::move(result); return true;
+}
+bool ApplyPreset(const PresetDocument& doc, std::string& error) {
+    auto checked=doc;
+    if (!ValidatePreset(checked,error)) return false;
+    PopulateSettingsView(Get(), checked.settings); return true;
+}
+std::filesystem::path PresetPath(std::string_view text) { return std::filesystem::path(std::u8string(reinterpret_cast<const char8_t*>(text.data()),text.size())); }
+std::filesystem::path CustomPresetDirectory() { return std::filesystem::absolute(PresetPath(Path())).parent_path()/"user"/"presets"; }
+bool WritePreset(const std::filesystem::path& path, const PresetDocument& document, bool overwrite, std::string& error) {
+    try {
+        if (path.extension() != ".bbxpreset") { error="Use the .bbxpreset file extension."; return false; }
+        auto checked=document; if (!ValidatePreset(checked,error)) return false;
+        if (std::filesystem::exists(path) && !overwrite) { error="That file already exists."; return false; }
+        if (!path.parent_path().empty()) std::filesystem::create_directories(path.parent_path());
+        const auto temporary=std::filesystem::path(path.wstring()+L".tmp-"+std::to_wstring(std::chrono::steady_clock::now().time_since_epoch().count()));
+        const auto text=EncodePreset(checked);
+        { std::ofstream file(temporary,std::ios::binary); file.write(text.data(),text.size()); file.close(); if (!file) { std::filesystem::remove(temporary); error="Could not write preset file."; return false; } }
+#ifdef _WIN32
+        const bool moved=MoveFileExW(temporary.c_str(),path.c_str(),(overwrite?MOVEFILE_REPLACE_EXISTING:0)|MOVEFILE_WRITE_THROUGH);
+        if (!moved) { std::filesystem::remove(temporary); error="Could not save preset file (permission or existing file)."; return false; }
+#else
+        std::filesystem::rename(temporary,path);
+#endif
+        error.clear(); return true;
+    } catch (const std::exception& e) { error=e.what(); return false; }
+}
+bool ReadPreset(const std::filesystem::path& path, PresetDocument& document, std::string& error) {
+    try {
+        if (std::filesystem::file_size(path)>65536) { error="Preset is too large (maximum 64 KiB)."; return false; }
+        std::ifstream file(path,std::ios::binary);
+        if (!file.is_open()) { error="Could not open preset file."; return false; }
+        std::string text(65537,'\0'); file.read(text.data(),text.size()); text.resize(static_cast<size_t>(file.gcount()));
+        if (file.bad()) { error="Could not read preset file."; return false; }
+        return DecodePreset(text,document,error);
+    } catch (const std::exception& e) {error=e.what(); return false;}
+}
+bool SaveCustomPreset(const PresetDocument& document, std::string& error) {
+    static std::atomic<unsigned> serial{0};
+    const auto id=std::to_string(std::chrono::system_clock::now().time_since_epoch().count())+"-"+std::to_string(serial++);
+    return WritePreset(CustomPresetDirectory()/(id+".bbxpreset"),document,false,error);
+}
+std::vector<SavedPreset> ListCustomPresets(std::string& error) {
+    std::vector<SavedPreset> presets; error.clear();
+    try {
+        const auto directory=CustomPresetDirectory();
+        if (!std::filesystem::exists(directory)) return presets;
+        for (const auto& entry:std::filesystem::directory_iterator(directory)) {
+            if (entry.is_symlink() || !entry.is_regular_file() || entry.path().extension()!=".bbxpreset") continue;
+            PresetDocument doc; std::string why;
+            if (ReadPreset(entry.path(),doc,why)) presets.push_back({entry.path(),std::move(doc)});
+            else error="Some preset files could not be loaded: "+why;
+        }
+        std::sort(presets.begin(),presets.end(),[](const auto& a,const auto& b){return a.document.name==b.document.name?a.path<b.path:a.document.name<b.document.name;});
+    } catch (const std::exception& e) {error=e.what();}
+    return presets;
+}
+bool DeleteCustomPreset(const std::filesystem::path& path, std::string& error) {
+    try {
+        if (path.extension()!=".bbxpreset" || std::filesystem::is_symlink(path) || std::filesystem::canonical(path.parent_path())!=std::filesystem::canonical(CustomPresetDirectory())) {error="Only saved user presets can be deleted here.";return false;}
+        if (!std::filesystem::remove(path)) {error="Preset no longer exists.";return false;}
+        error.clear(); return true;
+    } catch (const std::exception& e) {error=e.what();return false;}
+}
diff --git a/gpu/shim/bbport_custom_presets_ui.inc b/gpu/shim/bbport_custom_presets_ui.inc
new file mode 100644
--- /dev/null
+++ b/gpu/shim/bbport_custom_presets_ui.inc
@@ -0,0 +1,219 @@
+// Preset management. Read-only editor reuses DrawTab; all mutation controls live in its fixed header.
+std::vector<BbSettings::SavedPreset> custom_presets;
+bool custom_presets_dirty=true;
+int custom_editor_request=0; // 1 Save current, 2 Export current
+bool custom_import_browser=false;
+std::optional<std::filesystem::path> custom_delete_request;
+std::unique_ptr<BbSettings::Values> preset_reference_values;
+BbSettings::SettingList preset_reference_snapshot;
+char custom_preset_name[129]="My preset";
+char preset_directory[1024]="", preset_file_path[2048]="";
+std::string preset_browser_message;
+BbSettings::PresetDocument preset_export_document;
+std::string PathUtf8(const std::filesystem::path& path) {
+    const auto text=path.u8string(); return std::string(text.begin(),text.end());
+}
+void SetPresetText(char* buffer,size_t size,const std::string& value) {std::snprintf(buffer,size,"%s",value.c_str());}
+BbSettings::PresetDocument SelectedPresetDocument() {
+    BbSettings::PresetDocument document; document.name=custom_preset_name;
+    for (const auto& entry:preset_reference_snapshot) if (preset_included[entry.first]) document.settings.push_back(entry);
+    return document;
+}
+void OpenPresetBrowser(bool exporting) {
+    const auto directory=BbSettings::CustomPresetDirectory().parent_path()/"exports";
+    SetPresetText(preset_directory,sizeof(preset_directory),PathUtf8(directory));
+    // Display names never become paths; the user chooses the export filename here.
+    SetPresetText(preset_file_path,sizeof(preset_file_path),exporting?PathUtf8(directory/"my-preset.bbxpreset"):"");
+    preset_browser_message.clear();
+    ImGui::OpenPopup(exporting?"Export preset file###preset_export":"Load preset file###preset_import");
+}
+void PresetFileBrowser(bool exporting) {
+    const char* title=exporting?"Export preset file###preset_export":"Load preset file###preset_import";
+    ImGui::SetNextWindowSize(ImVec2(680.0f*base_scale,480.0f*base_scale),ImGuiCond_Appearing);
+    if (!ImGui::BeginPopupModal(title,nullptr,ImGuiWindowFlags_NoScrollbar)) return;
+    ImGui::TextWrapped(exporting?"Choose where to export this preset. Only the selected settings are written.":"Choose a .bbxpreset file. You will confirm before its settings are applied.");
+    ImGui::InputText("Folder",preset_directory,sizeof(preset_directory));
+    if (ImGui::Button("Up")) {
+        const auto parent=BbSettings::PresetPath(preset_directory).parent_path();
+        if (!parent.empty()) SetPresetText(preset_directory,sizeof(preset_directory),PathUtf8(parent));
+    }
+    ImGui::SameLine(); ImGui::TextDisabled("Select a folder to browse, or paste a file path below.");
+    if (ImGui::BeginChild("##files",ImVec2(0,170.0f*base_scale),ImGuiChildFlags_Borders)) {
+        try {
+            const auto folder=BbSettings::PresetPath(preset_directory);
+            if (std::filesystem::exists(folder)) {
+                std::vector<std::filesystem::directory_entry> entries;
+                for (const auto& entry:std::filesystem::directory_iterator(folder)) {if (entries.size()>=512) break; if(entry.is_directory() || entry.path().extension()==".bbxpreset") entries.push_back(entry);}
+                std::sort(entries.begin(),entries.end(),[](const auto& a,const auto& b) {if(a.is_directory()!=b.is_directory()) return a.is_directory();return a.path()<b.path();});
+                for (const auto& entry:entries) {
+                    const bool dir=entry.is_directory(); const auto name=(dir?"[Folder] ":"")+PathUtf8(entry.path().filename());
+                    if (ImGui::Selectable(name.c_str(),false,ImGuiSelectableFlags_NoAutoClosePopups)) {
+                        if(dir) SetPresetText(preset_directory,sizeof(preset_directory),PathUtf8(entry.path()));
+                        else SetPresetText(preset_file_path,sizeof(preset_file_path),PathUtf8(entry.path()));
+                    }
+                }
+            } else ImGui::TextDisabled("Folder does not exist yet; exporting will create it.");
+        } catch (const std::exception& e) {ImGui::TextWrapped("%s",e.what());}
+    }
+    ImGui::EndChild();
+    ImGui::InputText("File path",preset_file_path,sizeof(preset_file_path));
+    if (!preset_browser_message.empty()) ImGui::TextWrapped("%s",preset_browser_message.c_str());
+    bool write=false, overwrite=false;
+    if (ImGui::Button(exporting?"Export file":"Load file")) {
+        if (!preset_file_path[0]) preset_browser_message="Choose a file path first.";
+        else if (exporting) {
+            std::error_code ec;
+            if (std::filesystem::exists(BbSettings::PresetPath(preset_file_path),ec)) ImGui::OpenPopup("Replace preset file?###preset_overwrite");
+            else write=true;
+        } else {
+            BbSettings::PresetDocument document;
+            if (BbSettings::ReadPreset(BbSettings::PresetPath(preset_file_path),document,preset_browser_message)) {
+                custom_apply_request=std::move(document); custom_import_request=true; ImGui::CloseCurrentPopup();
+            }
+        }
+    }
+    ImGui::SameLine();
+    if (ImGui::Button("Cancel") || ImGui::IsKeyPressed(ImGuiKey_Escape)) ImGui::CloseCurrentPopup();
+    if (ImGui::BeginPopupModal("Replace preset file?###preset_overwrite",nullptr,ImGuiWindowFlags_AlwaysAutoResize)) {
+        ImGui::TextUnformatted("This file already exists. Replace it with the current selection?");
+        if (ImGui::Button("Yes, replace")) { write=true; overwrite=true; ImGui::CloseCurrentPopup(); }
+        ImGui::SameLine(); if (ImGui::Button("Cancel")) ImGui::CloseCurrentPopup();
+        ImGui::EndPopup();
+    }
+    if (write && BbSettings::WritePreset(BbSettings::PresetPath(preset_file_path),preset_export_document,overwrite,preset_browser_message)) {
+        preset_ui_message="Exported preset to "+std::string(preset_file_path); ImGui::CloseCurrentPopup();
+    }
+    ImGui::EndPopup();
+}
+void CustomPresetSection() {
+    if (custom_presets_dirty) { custom_presets=BbSettings::ListCustomPresets(preset_ui_message); custom_presets_dirty=false; }
+    Section("My presets");
+    if (Shown("My presets")) {
+        if (ImGui::Button("Save current...")) custom_editor_request=1;
+        ImGui::SameLine(); if (ImGui::Button("Export current...")) custom_editor_request=2;
+        ImGui::SameLine(); if (ImGui::Button("Load / Import...")) custom_import_browser=true;
+        if (ImGui::Button("Refresh presets")) custom_presets_dirty=true;
+        if (custom_presets.empty()) ImGui::TextDisabled("No custom presets saved yet.");
+        for (const auto& preset:custom_presets) {
+            const auto id=PathUtf8(preset.path); ImGui::PushID(id.c_str());
+            if (ImGui::Button("Apply")) { custom_apply_request=preset.document; custom_import_request=false; }
+            ImGui::SameLine(); ImGui::TextUnformatted(preset.document.name.c_str());
+            ImGui::SameLine(); if (ImGui::SmallButton("Delete")) custom_delete_request=preset.path;
+            ImGui::TextDisabled("%zu settings",preset.document.settings.size());
+            ImGui::PopID();
+        }
+        if (!preset_ui_message.empty()) ImGui::TextWrapped("%s",preset_ui_message.c_str());
+    }
+}
+void PresetGroupHeader(int group) {
+    bool any=false, all=true;
+    for (const auto& [key, included]:preset_included) if (BbSettings::PresetGroup(key)==group) { any|=included; all&=included; }
+    ImGui::PushID(group);
+    const auto first=ImGui::GetCursorScreenPos();
+    const std::string label=std::string(all?"[V] ":any?"[-] ":"[X] ")+TabTitle(group)+"###preset_group";
+    if (!any) ImGui::PushStyleColor(ImGuiCol_Text,ImGui::GetStyleColorVec4(ImGuiCol_TextDisabled));
+    if (ImGui::Selectable(label.c_str(),false,ImGuiSelectableFlags_NoAutoClosePopups,ImVec2(0,ImGui::GetFrameHeight()))) {
+        for (auto& [key,included]:preset_included) if (BbSettings::PresetGroup(key)==group) included=!all;
+    }
+    if (!any) ImGui::PopStyleColor();
+    if (!any) {
+        ImGui::GetWindowDrawList()->AddLine(ImVec2(first.x,first.y+ImGui::GetFrameHeight()/2),ImVec2(first.x+ImGui::CalcTextSize(label.c_str(),nullptr,true).x,first.y+ImGui::GetFrameHeight()/2),ImGui::GetColorU32(ImGuiCol_TextDisabled));
+    }
+    if (ImGui::IsItemHovered()) ImGui::SetTooltip("%s all settings under %s",all?"Exclude":"Include",TabTitle(group));
+    ImGui::Separator(); ImGui::PopID();
+}
+void PresetReferenceEditor() {
+    ImGui::SetNextWindowSize(ImVec2(820.0f*base_scale,ImGui::GetMainViewport()->WorkSize.y*0.88f),ImGuiCond_Appearing);
+    ImGui::PushStyleColor(ImGuiCol_Border,ImGui::GetStyleColorVec4(ImGuiCol_CheckMark));
+    ImGui::PushStyleVar(ImGuiStyleVar_WindowBorderSize,2.0f*base_scale);
+    if (ImGui::BeginPopupModal("Choose preset settings###preset_editor",nullptr,ImGuiWindowFlags_NoScrollbar|ImGuiWindowFlags_NoScrollWithMouse)) {
+        // Fixed header. The child below owns the only settings scrollbar.
+        ImGui::TextWrapped("Graphics settings are included by default. Click any option or group to include or exclude it. This is a read-only reference; your game settings will not change.");
+        ImGui::InputText("Preset name",custom_preset_name,sizeof(custom_preset_name));
+        const auto selected=SelectedPresetDocument();
+        ImGui::TextDisabled("%zu of %zu settings included",selected.settings.size(),preset_reference_snapshot.size());
+        ImGui::BeginDisabled(selected.settings.empty());
+        if (ImGui::Button("Save")) {
+            if (BbSettings::SaveCustomPreset(selected,preset_ui_message)) { custom_presets_dirty=true; preset_ui_message="Saved preset: "+selected.name; ImGui::CloseCurrentPopup(); }
+        }
+        ImGui::SameLine();
+        if (ImGui::Button("Export")) {
+            BbSettings::PresetDocument checked;
+            if (BbSettings::DecodePreset(BbSettings::EncodePreset(selected),checked,preset_ui_message)) { preset_export_document=std::move(checked); OpenPresetBrowser(true); }
+        }
+        ImGui::EndDisabled();
+        ImGui::SameLine(); if (ImGui::Button("Cancel")) ImGui::CloseCurrentPopup();
+        if (!preset_ui_message.empty()) ImGui::TextWrapped("%s",preset_ui_message.c_str());
+        ImGui::Separator();
+        if (ImGui::BeginChild("##reference_settings",ImVec2(0,0),ImGuiChildFlags_NavFlattened)) {
+            const auto saved_search=search_query; const auto saved_tab=tab_title; const auto saved_section=section_title;
+            search_query.clear();
+            for (int group=0;group<TabSpecPreset;++group) {
+                PresetGroupHeader(group);
+                preset_reference_rows.clear(); preset_rendered.clear(); preset_reference_group=group; preset_reference_pass=0;
+                preset_reference_mode=true;
+                auto* previous=BbSettings::ExchangeSettingsView(preset_reference_values.get());
+                ImGui::PushStyleVar(ImGuiStyleVar_DisabledAlpha,1.0f);
+                ImGui::PushItemFlag(ImGuiItemFlags_AllowOverlap,true);
+                ImGui::BeginDisabled(); DrawTab(group); FinishPresetReferenceRow(); ImGui::EndDisabled();
+                ImGui::PopItemFlag();
+                ImGui::PopStyleVar();
+                BbSettings::ExchangeSettingsView(previous);
+                DrawPresetReferenceSelection(); preset_reference_mode=false;
+                // Newly serialized options remain available even before receiving a polished widget.
+                for (const auto& [key,value]:preset_reference_snapshot) if (BbSettings::PresetGroup(key)==group && !preset_rendered.contains(key)) {
+                    ImGui::PushID(key.c_str());
+                    bool& included=preset_included[key]; const auto at=ImGui::GetCursorScreenPos();
+                    std::string label=key;
+                    std::replace(label.begin(),label.end(),'_',' ');
+                    if (!label.empty() && label[0]>='a' && label[0]<='z') label[0]-=32;
+                    label+=": "+value;
+                    const bool dimmed=!included;
+                    if (dimmed) ImGui::PushStyleColor(ImGuiCol_Text,ImGui::GetStyleColorVec4(ImGuiCol_TextDisabled));
+                    if (ImGui::Selectable(label.c_str(),false,ImGuiSelectableFlags_NoAutoClosePopups)) included=!included;
+#ifdef BB_PRESET_UI_TEST
+                    preset_test_hit_rects[key]=ImVec4(ImGui::GetItemRectMin().x,ImGui::GetItemRectMin().y,ImGui::GetItemRectMax().x,ImGui::GetItemRectMax().y);
+#endif
+                    if (dimmed) ImGui::PopStyleColor();
+                    if (ImGui::IsItemHovered()) {ImGui::SameLine(); ImGui::TextUnformatted(included?"V":"X");}
+                    if (!included) { ImGui::GetWindowDrawList()->AddLine(ImVec2(at.x,at.y+ImGui::GetTextLineHeight()/2),ImVec2(at.x+ImGui::CalcTextSize(label.c_str(),nullptr,true).x,at.y+ImGui::GetTextLineHeight()/2),ImGui::GetColorU32(ImGuiCol_TextDisabled)); }
+                    ImGui::PopID();
+                }
+                ImGui::Spacing();
+            }
+            search_query=saved_search; tab_title=saved_tab; section_title=saved_section;
+        }
+        ImGui::EndChild();
+        PresetFileBrowser(true);
+        ImGui::EndPopup();
+    }
+    ImGui::PopStyleVar(); ImGui::PopStyleColor();
+}
+void CustomPresetDialogs() {
+    if (custom_editor_request) {
+        preset_reference_snapshot=BbSettings::SnapshotSettings(BbSettings::Get());
+        std::erase_if(preset_reference_snapshot,[](const auto& e){return e.first=="menu_pos";});
+        preset_reference_values=std::make_unique<BbSettings::Values>();
+        BbSettings::PopulateSettingsView(*preset_reference_values,preset_reference_snapshot);
+        // Capabilities are display-only in this isolated view.
+        preset_reference_values->dlss_supported=true; preset_reference_values->fsr4_supported=true; preset_reference_values->fsr411_supported=true;
+        preset_included.clear();
+        for (const auto& [key,value]:preset_reference_snapshot) preset_included[key]=BbSettings::DefaultPresetGraphic(key);
+        preset_ui_message.clear();
+        ImGui::OpenPopup("Choose preset settings###preset_editor");
+        custom_editor_request=0;
+    }
+    PresetReferenceEditor();
+    if (custom_import_browser) {OpenPresetBrowser(false);custom_import_browser=false;}
+    PresetFileBrowser(false);
+    static std::filesystem::path deleting;
+    if (custom_delete_request) {deleting=*custom_delete_request; custom_delete_request.reset(); ImGui::OpenPopup("Delete custom preset?###preset_delete");}
+    if (ImGui::BeginPopupModal("Delete custom preset?###preset_delete",nullptr,ImGuiWindowFlags_AlwaysAutoResize)) {
+        ImGui::TextUnformatted("Delete this saved custom preset? Your current settings will be kept.");
+        BbSettings::PresetDocument doc; std::string ignored;
+        if (BbSettings::ReadPreset(deleting,doc,ignored)) ImGui::TextUnformatted(doc.name.c_str());
+        if (ImGui::Button("Delete preset")) { BbSettings::DeleteCustomPreset(deleting,preset_ui_message); custom_presets_dirty=true; ImGui::CloseCurrentPopup(); }
+        ImGui::SameLine(); if (ImGui::Button("Cancel")) ImGui::CloseCurrentPopup();
+        ImGui::SetItemDefaultFocus(); ImGui::EndPopup();
+    }
+}
diff --git a/gpu/shim/bbport_preset_reference.inc b/gpu/shim/bbport_preset_reference.inc
new file mode 100644
--- /dev/null
+++ b/gpu/shim/bbport_preset_reference.inc
@@ -0,0 +1,64 @@
+// Selection overlays decorate the very same read-only widgets used by the live settings UI.
+bool preset_reference_mode = false;
+int preset_reference_group = 0, preset_reference_pass = 0;
+std::map<std::string,bool> preset_included;
+std::set<std::string> preset_rendered;
+struct PresetReferenceRow { std::string key, label; ImVec2 first, last; };
+std::vector<PresetReferenceRow> preset_reference_rows;
+bool preset_reference_pending=false;
+#include "bbport_preset_bindings.inc"
+void FinishPresetReferenceRow() {
+    if (!preset_reference_mode || preset_reference_rows.empty() || !preset_reference_pending) return;
+    preset_reference_pending=false;
+    auto& row=preset_reference_rows.back();
+    row.last.y=std::max(row.first.y+ImGui::GetFrameHeight(), ImGui::GetCursorScreenPos().y-ImGui::GetStyle().ItemSpacing.y);
+}
+std::string PresetKeyForLabel(const char* english) {
+    if (preset_reference_pass>0) {
+        const std::pair<const char*,const char*> fields[]={{"NR style","style"},{"NR intensity","intensity"},{"NR local structure","local_structure"},{"NR local tone","local_tone"},{"NR skin structure","skin_structure"}};
+        for (const auto& [label,key]:fields) if (std::strcmp(label,english)==0) return "dlss_nr_pass"+std::to_string(preset_reference_pass)+"_"+key;
+    }
+    for (const auto& e:preset_row_bindings) if (e.group==preset_reference_group && std::strcmp(e.label,english)==0) return e.key;
+    for (const auto& e:BbSettings::Effects) if (std::strcmp(e.label,english)==0) return e.key;
+    return {};
+}
+void BeginPresetReferenceRow(const char* english, const char* key_override=nullptr) {
+    if (!preset_reference_mode) return;
+    FinishPresetReferenceRow();
+    const std::string key=key_override?key_override:PresetKeyForLabel(english);
+    if (key.empty() || !preset_included.contains(key)) return;
+    const ImVec2 at=ImGui::GetCursorScreenPos();
+    if (!preset_reference_rows.empty()) {
+        auto& previous=preset_reference_rows.back();
+        if (std::abs(previous.first.y-at.y)<1.0f && at.x>previous.first.x) previous.last.x=at.x-ImGui::GetStyle().ItemSpacing.x;
+    }
+    preset_reference_rows.push_back({key,BbSettings::MenuText(english),at,ImVec2(at.x+ImGui::GetContentRegionAvail().x,at.y+ImGui::GetFrameHeight())});
+    preset_reference_pending=true;
+    preset_rendered.insert(key);
+}
+void DrawPresetReferenceSelection() {
+    FinishPresetReferenceRow();
+    const ImVec2 cursor=ImGui::GetCursorScreenPos();
+    auto* draw=ImGui::GetWindowDrawList();
+    for (const auto& row:preset_reference_rows) {
+        bool& included=preset_included[row.key];
+        ImGui::PushID(row.key.c_str());
+        ImGui::SetCursorScreenPos(row.first);
+        if (ImGui::InvisibleButton("##include",ImVec2(std::max(1.0f,row.last.x-row.first.x),std::max(1.0f,row.last.y-row.first.y)))) included=!included;
+        const bool hovered=ImGui::IsItemHovered();
+        if (!included) {
+            ImVec4 background=ImGui::GetStyleColorVec4(ImGuiCol_WindowBg); background.w=0.60f;
+            draw->AddRectFilled(row.first,row.last,ImGui::ColorConvertFloat4ToU32(background));
+            const float y=row.first.y+ImGui::GetFrameHeight()*0.5f;
+            // The native label sits after the control; strike the full row to include it.
+            draw->AddLine(ImVec2(row.first.x,y),ImVec2(row.last.x-22.0f*base_scale,y),ImGui::GetColorU32(ImGuiCol_TextDisabled),1.0f);
+        }
+        if (hovered || ImGui::IsItemFocused()) {
+            draw->AddRect(row.first,row.last,ImGui::GetColorU32(ImGuiCol_CheckMark),3.0f);
+            draw->AddText(ImVec2(row.last.x-18.0f*base_scale,row.first.y),ImGui::GetColorU32(included?ImGuiCol_CheckMark:ImGuiCol_TextDisabled),included?"V":"X");
+            ImGui::SetTooltip("%s: %s. Click to %s.",row.label.c_str(),included?"Included":"Excluded",included?"exclude":"include");
+        }
+        ImGui::PopID();
+    }
+    ImGui::SetCursorScreenPos(cursor);
+}

diff --git a/gpu/nr_extra_style.h b/gpu/nr_extra_style.h
new file mode 100644
--- /dev/null
+++ b/gpu/nr_extra_style.h
@@ -0,0 +1,63 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+#include <array>
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+#include <cstring>
+#include <span>
+
+namespace NrExtraStyle {
+// The serialized HT first-layer layout, independently checked before any write.
+inline constexpr std::size_t Count = 32, First = 8289, Stride = 64;
+// Packed output lanes: groups of eight, interleaved by four FP16 elements.
+inline constexpr std::size_t Offset(std::size_t i) {
+    return First + (i % 8) * Stride + (i / 16) * 512 + ((i / 8) % 2) * 8;
+}
+inline constexpr float Limit = 1024.0f;
+struct Entry { std::size_t offset; std::uint16_t original, direction, replacement; };
+using Plan = std::array<Entry, Count>;
+// Coalesce slider drags; do not recreate features on every intermediate mouse sample.
+class LiveRequest {
+    float pending{};
+    std::uint64_t changed_at{};
+    bool observed{};
+public:
+    float Select(float requested, float applied, bool has_features, std::uint64_t now_ms) {
+        requested = std::clamp(std::isfinite(requested) ? requested : 0.0f, -Limit, Limit);
+        if (!observed || pending != requested) { observed = true; pending = requested; changed_at = now_ms; }
+        return !has_features || now_ms - changed_at >= 150 ? requested : applied;
+    }
+};
+inline float Decode(std::uint16_t bits) {
+    _Float16 value; std::memcpy(&value, &bits, 2); return float(value);
+}
+inline std::uint16_t Encode(float value) {
+    const _Float16 half = _Float16(value);
+    std::uint16_t bits; std::memcpy(&bits, &half, 2); return bits;
+}
+inline std::uint64_t U64(std::span<const std::uint8_t> bytes, std::size_t at) {
+    std::uint64_t v; std::memcpy(&v, bytes.data() + at, 8); return v;
+}
+inline bool MakePlan(std::span<const std::uint8_t> bytes, float strength, Plan& plan) {
+    if (!std::isfinite(strength) || std::abs(strength) > Limit ||
+        bytes.size() < 63 + 21736 * 2) return false;
+    // Inspect the tensor serializer, element counts and FP16 encoding, not the file hash.
+    if (U64(bytes, 0) != bytes.size() || U64(bytes, 8) != 19 ||
+        std::memcmp(bytes.data() + 16, "block0.layer0.layer", 19) != 0 ||
+        U64(bytes, 35) != 21736 || U64(bytes, 43) != 21736 || U64(bytes, 51) != 21696 ||
+        bytes[59] != 1 || bytes[60] != 0 || bytes[61] != 0 || bytes[62] != 0) return false;
+    bool nonzero_direction = false;
+    for (std::size_t i = 0; i < Count; ++i) {
+        auto& e = plan[i]; e.offset = Offset(i);
+        std::memcpy(&e.original, bytes.data() + e.offset, 2);
+        std::memcpy(&e.direction, bytes.data() + e.offset + 2, 2);
+        const float base = Decode(e.original), direction = Decode(e.direction);
+        if (!std::isfinite(base) || !std::isfinite(direction)) return false;
+        nonzero_direction |= direction != 0;
+        e.replacement = strength == 0 ? e.original : Encode(float(std::clamp(
+            double(base) + double(strength) * double(direction) / 128.0, -65504.0, 65504.0)));
+    }
+    return nonzero_direction;
+}
+} // namespace NrExtraStyle
diff --git a/gpu/nr_extra_style_win.h b/gpu/nr_extra_style_win.h
new file mode 100644
--- /dev/null
+++ b/gpu/nr_extra_style_win.h
@@ -0,0 +1,71 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+#include "nr_extra_style.h"
+#include <windows.h>
+#include <vector>
+
+namespace NrExtraStyle {
+// Owns reversible edits to the loaded module only. The model file is never opened for writing.
+class Session {
+    std::uint8_t* weights{};
+    Plan plan{};
+    bool active{};
+    struct Page { void* address; DWORD protection; };
+    bool Write(bool restore) {
+        SYSTEM_INFO info{}; GetSystemInfo(&info);
+        std::vector<Page> pages;
+        for (const auto& e : plan) {
+            const auto first = std::uintptr_t(weights + e.offset) / info.dwPageSize * info.dwPageSize;
+            const auto last = std::uintptr_t(weights + e.offset + 1) / info.dwPageSize * info.dwPageSize;
+            for (auto at = first; at <= last; at += info.dwPageSize) {
+                if (std::any_of(pages.begin(), pages.end(), [&](const Page& p) { return p.address == reinterpret_cast<void*>(at); })) continue;
+                DWORD previous{};
+                if (!VirtualProtect(reinterpret_cast<void*>(at), info.dwPageSize, PAGE_READWRITE, &previous)) {
+                    for (const auto& p : pages) { DWORD ignored; VirtualProtect(p.address, info.dwPageSize, p.protection, &ignored); }
+                    return false; // No coefficient has been written yet.
+                }
+                pages.push_back({reinterpret_cast<void*>(at), previous});
+            }
+        }
+        for (const auto& e : plan) {
+            const auto value = restore ? e.original : e.replacement;
+            std::memcpy(weights + e.offset, &value, 2);
+        }
+        bool ok = true;
+        for (const auto& p : pages) { DWORD ignored; ok = VirtualProtect(p.address, info.dwPageSize, p.protection, &ignored) && ok; }
+        if (!ok && !restore) {
+            // Roll back data if page-permission restoration failed; retry all protections.
+            bool writable = true;
+            for (const auto& p : pages) { DWORD ignored; writable = VirtualProtect(p.address, info.dwPageSize, PAGE_READWRITE, &ignored) && writable; }
+            if (writable) for (const auto& e : plan) std::memcpy(weights + e.offset, &e.original, 2);
+            for (const auto& p : pages) { DWORD ignored; VirtualProtect(p.address, info.dwPageSize, p.protection, &ignored); }
+        }
+        return ok;
+    }
+public:
+    bool Apply(HMODULE module, float strength) {
+        if (active || !std::isfinite(strength)) return false;
+        if (strength == 0) return true;
+        const auto resource = FindResourceW(module, L"WEIGHTS_HT", MAKEINTRESOURCEW(10));
+        const DWORD size = resource ? SizeofResource(module, resource) : 0;
+        const auto loaded = resource ? LoadResource(module, resource) : nullptr;
+        weights = loaded ? static_cast<std::uint8_t*>(LockResource(loaded)) : nullptr;
+        if (!weights || !MakePlan({weights, size}, strength, plan)) return false;
+        // Never write across an inaccessible/unmapped region.
+        for (const auto& e : plan) {
+            MEMORY_BASIC_INFORMATION mbi{};
+            if (!VirtualQuery(weights + e.offset, &mbi, sizeof(mbi)) || mbi.State != MEM_COMMIT ||
+                mbi.AllocationBase != module || mbi.Protect & (PAGE_NOACCESS | PAGE_GUARD)) return false;
+        }
+        active = true;
+        if (!Write(false)) { Restore(); return false; }
+        return true;
+    }
+    bool Restore() {
+        if (!active) return true;
+        if (!Write(true)) return false;
+        active = false; weights = nullptr; return true;
+    }
+    bool Active() const { return active; }
+};
+} // namespace NrExtraStyle

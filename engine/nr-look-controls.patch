+    assert(request.Select(0, 16, true, 560) == 0);
+    assert(request.Select(-64, 0, false, 570) == -64); // no feature -> no pointless delay
+    std::vector<std::uint8_t> bytes(50000);
+    auto put64 = [&](std::size_t at, std::uint64_t value) { std::memcpy(bytes.data()+at,&value,8); };
+    put64(0,bytes.size()); put64(8,19); std::memcpy(bytes.data()+16,"block0.layer0.layer",19);
+    put64(35,21736); put64(43,21736); put64(51,21696); bytes[59]=1;
+    for (std::size_t i=0;i<Count;++i) {
+        auto a=Encode(0.25f), b=Encode(0.5f);
+        std::memcpy(bytes.data()+expected_offsets[i],&a,2);
+        std::memcpy(bytes.data()+expected_offsets[i]+2,&b,2);
+    }
+    Plan plan;
+    const auto untouched=bytes;
+    assert(MakePlan(bytes,0,plan));
+    for (const auto& p:plan) assert(p.original==p.replacement);
+    assert(MakePlan(bytes,64,plan));
+    for (const auto& p:plan) assert(Decode(p.replacement)==0.5f);
+    assert(MakePlan(bytes,-64,plan));
+    for (const auto& p:plan) assert(Decode(p.replacement)==0);
+    assert(bytes==untouched); // Planning never writes the model.
+    assert(!MakePlan(bytes,std::numeric_limits<float>::quiet_NaN(),plan));
+    assert(!MakePlan(bytes,1025,plan));

+
+// Coherent renderer -> overlay snapshot; never copy atomic settings or touch NGX here.
+struct LiveInfo {
+    Grid grid{};
+    uint32_t scene_w{}, scene_h{}, model_w{}, model_h{};
+    const char* state = "Bypassed";
+    const char* reason = "Waiting for valid pre-SR NR inputs";
+};
+inline std::mutex live_mutex;
+inline LiveInfo live_info;
+inline void PublishLive(const LiveInfo& info) { std::scoped_lock lock(live_mutex); live_info=info; }
+inline LiveInfo ReadLive() { std::scoped_lock lock(live_mutex); return live_info; }
+
+struct LiveRequest {
+    Grid candidate{}, applied{};
+    uint64_t changed_at{};
+    bool settling{};
+    Grid Select(const Grid& requested, uint64_t now, bool debounce) {
+        if (requested != candidate) { candidate=requested; changed_at=now; }
+        settling=debounce && requested!=applied && now-changed_at<500;
+        if (!settling) applied=requested;
+        // Blend is excluded from mapping equality and never rebuilds temporal resources.
+        applied.x.blend=requested.x.blend; applied.y.blend=requested.y.blend;
+        return applied;
+    }
+};
 }  // namespace NrFoveation
